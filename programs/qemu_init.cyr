# qemu_init — PID 1 for the Linux-desktop QEMU harness (M6-B3 verification).
#
# ⛔⛔ WHY THIS EXISTS RATHER THAN A DISTRO IMAGE OR BUSYBOX. The Linux fbdev arm can only be proven
# where there is a framebuffer, and the only framebuffer on a dev box is the one the operator is
# looking at. Running the compositor there means taking over their screen. A QEMU guest has its own
# framebuffer that nobody is using, and QEMU's `screendump` reads it out of the emulated VGA device —
# an oracle OUTSIDE the compositor, which is the property that matters (a compositor that reports
# success while drawing nothing passes any self-check it writes itself).
#
# ⚠ There is no busybox on this box and no distro image is needed: `build/aethersafha` is a **static**
# ELF64, so the entire guest userland is this file plus that binary. This init is ~160 lines of Cyrius
# instead of a 200 MB rootfs, and it is sovereign — no foreign init, no shell.
#
# What PID 1 has to do here, and why each part is not optional:
#   · mount /proc and /sys — bhumi's fbdev arm reads its geometry out of
#     `/sys/class/graphics/fb0/{virtual_size,stride,bits_per_pixel}`. No sysfs, no geometry, and the
#     compositor silently falls back to 1280x720 and reports nothing wrong.
#   · mount devtmpfs on /dev — ⚠ `CONFIG_DEVTMPFS_MOUNT=y` does NOT cover an initramfs, so without
#     this there is no `/dev/fb0` device node even though sysfs describes the framebuffer perfectly.
#   · FORK, do not just execve — PID 1 exiting is a kernel panic. The parent reaps the compositor,
#     prints its exit status (the `--clients` verdict ladder is read from exactly this number) and
#     powers the machine off cleanly, so the harness gets a real exit rather than a timeout.
#
# Build + run: see `scripts/qemu-linux-desktop.sh`, which assembles the initramfs and drives QEMU.

include "src/geom.cyr"

var QI_MS_SILENT = 32768;                 # MS_SILENT — quiet the "unknown option" chatter
var QI_RB_POWER_OFF = 0x4321FEDC;         # LINUX_REBOOT_CMD_POWER_OFF

fn qi_say(s) { sys_write(1, s, strlen(s)); return 0; }

fn qi_num(n) {
    var b[24];
    var i = 24;
    var v = n;
    if (v < 0) { qi_say("-"); v = 0 - v; }
    if (v == 0) { qi_say("0"); return 0; }
    while (v > 0) { i = i - 1; store8(&b + i, 48 + (v % 10)); v = v / 10; }
    sys_write(1, &b + i, 24 - i);
    return 0;
}

# Echo a small file to the console — the harness reads these off the serial log to prove the guest
# saw the same geometry bhumi will.
fn qi_cat(path): i64 {
    var buf[128];
    var fd = sys_open(path, 0, 0);
    if (fd < 0) { qi_say("  (absent) "); qi_say(path); qi_say("\n"); return 0 - 1; }
    var n = sys_read(fd, &buf, 127);
    sys_close(fd);
    if (n < 0) { n = 0; }
    store8(&buf + n, 0);
    qi_say("  "); qi_say(path); qi_say(" = "); sys_write(1, &buf, n);
    if (n == 0) { qi_say("\n"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    qi_say("qemu_init: PID 1 up\n");

    # ⛔⛔ MOUNTS BEFORE `args_init()`, NOT AFTER — and the ordering is not cosmetic. On Linux
    # `args_init` reads **/proc/self/cmdline**; called before /proc is mounted it finds nothing, sets
    # `_args_base = 0`, and `argc()` answers 0 forever. The first cut of this file called it first and
    # every argument the harness passed vanished: the log read `exec /aethersafha with argc 1` and the
    # compositor silently ran its DEFAULT 400-frame cap instead of the requested `--frames`.
    # ⚠ Same class as the note in `src/main.cyr` about `argc()` answering 0 until `args_init` runs —
    # there the prerequisite is `alloc_init`, here it is additionally a mounted /proc. A silent,
    # total argument loss that looks like the flag being unrecognised.
    sys_mkdir("/proc", 0755);
    sys_mkdir("/sys", 0755);
    sys_mkdir("/dev", 0755);
    sys_mkdir("/tmp", 0777);              # the AF_UNIX rendezvous lives here; without it setu_listen -3
    if (sys_mount("proc", "/proc", "proc", QI_MS_SILENT, 0) < 0) { qi_say("qemu_init: WARN /proc mount failed\n"); }
    if (sys_mount("sysfs", "/sys", "sysfs", QI_MS_SILENT, 0) < 0) { qi_say("qemu_init: WARN /sys mount failed\n"); }
    # ⛔⛔ devtmpfs MUST BE MOUNTED BY HAND HERE, and the first cut of this file did not — it assumed
    # `CONFIG_DEVTMPFS_MOUNT=y` covered it. **That option does not apply to an initramfs.** The kernel
    # auto-mounts devtmpfs only when it mounts a real root filesystem; boot on an initramfs and /dev is
    # whatever the cpio contained, which here was an empty directory.
    # ⚠ The failure was maximally confusing: `/sys/class/graphics/fb0/*` read back perfectly — geometry,
    # stride, driver name, all correct — while `/dev/fb0` did not exist, so the framebuffer was
    # simultaneously "obviously present" and "absent". sysfs comes from the sysfs mount; the device NODE
    # comes from devtmpfs, and they are different mounts. Probe both or believe neither.
    if (sys_mount("devtmpfs", "/dev", "devtmpfs", QI_MS_SILENT, 0) < 0) { qi_say("qemu_init: WARN /dev mount failed\n"); }
    # ⛔⛔ /dev/shm IS NOT OPTIONAL WHEN A CLIENT IS IN THE PICTURE, and its absence fails LATE and
    # confusingly. setu's Linux shared buffer is a tmpfs file `/dev/shm/setu-buf-<id>`
    # (`setu/src/buf.cyr:17,26`), so with no /dev/shm a client CONNECTS fine, completes the handshake,
    # and only then dies on `buf_create failed` — the compositor logs `setu client connected` and never
    # a presented surface, which reads like a protocol or compositor bug rather than a missing mount.
    # ⚠ It must be mounted AFTER devtmpfs: /dev/shm is a directory inside the devtmpfs mount, so
    # creating it first would put it in the initramfs's /dev and then be hidden by the mount over it.
    sys_mkdir("/dev/shm", 0777);
    if (sys_mount("tmpfs", "/dev/shm", "tmpfs", QI_MS_SILENT, 0) < 0) { qi_say("qemu_init: WARN /dev/shm mount failed\n"); }

    args_init();                          # AFTER /proc — see the ordering note above

    # ⭐ THE DECISIVE DIAGNOSTIC, PRINTED BEFORE THE COMPOSITOR RUNS. If /dev/fb0 is absent the run is
    # not a failure of aethersafha — it is a failure to give the guest a framebuffer, which is a QEMU
    # or kernel-driver question. Separating those two BEFORE the compositor starts is the whole reason
    # this block exists; without it "no pixels" has two indistinguishable causes.
    qi_say("qemu_init: framebuffer probe --\n");
    if (sys_access("/dev/fb0", 0) < 0) {
        qi_say("qemu_init: NO /dev/fb0 -- the guest has no framebuffer device.\n");
        qi_say("qemu_init: this is a harness/kernel-driver problem, NOT a compositor problem.\n");
    }
    qi_cat("/sys/class/graphics/fb0/virtual_size");
    qi_cat("/sys/class/graphics/fb0/stride");
    qi_cat("/sys/class/graphics/fb0/bits_per_pixel");
    qi_cat("/sys/class/graphics/fb0/name");

    # ⚠ TWO DIAGNOSTIC MODES LIVED HERE AND ARE DELIBERATELY GONE (`--fbfill`, `--fbmmap`). They
    # existed to isolate one defect and they did it: they proved that on a shadow-buffer fbdev an
    # `mmap` store never reaches scanout while a `pwrite` does, which is what bhumi 1.2.1 fixed.
    # ⛔ Retiring them is the point, not an oversight — a harness that keeps every probe it ever
    # needed becomes a thing nobody can read. The FINDINGS live where they are load-bearing:
    # bhumi `src/scanout.cyr` (at the pwrite that replaced the mapping), bhumi CHANGELOG 1.2.1, and
    # the `console=tty0` / no-`quiet` note in `scripts/qemu-linux-desktop.sh`.

    # ⭐ `--hold` IS CONSUMED HERE AND NOT FORWARDED, and it exists because of a real dead end:
    # a guest that draws and exits is UNPHOTOGRAPHABLE. bhumi's scanout-demo drew its bars and powered
    # the machine off **0.365 s** after boot, long before any screendump could connect — and the
    # compositor's own short runs did the same. Racing that window with a sleep is guesswork in both
    # directions: too early photographs the firmware splash, too late photographs a dead machine.
    # ⇒ Hold the framebuffer up AFTER the child has exited, so the dump happens in a window whose
    # start is an observable event (`aethersafha exit`) rather than a guess.
    var hold = 0;
    var argv = alloc(64);
    store64(argv + 0, "/aethersafha");
    var n = argc();
    var w = 1;
    var i = 1;
    while (i < n) {
        if (streq(argv(i), "--hold") == 1) { hold = 1; }
        else { if (w < 6) { store64(argv + w * 8, argv(i)); w = w + 1; } }
        i = i + 1;
    }
    store64(argv + w * 8, 0);

    qi_say("qemu_init: exec /aethersafha with argc ");
    qi_num(w);
    qi_say("\n");

    # ⛔ FORK. `execve` from PID 1 would work right up until the compositor exits, at which point PID 1
    # has exited and the kernel panics — which looks exactly like a compositor crash in the log.
    var pid = sys_fork();
    if (pid < 0) { qi_say("qemu_init: fork failed\n"); sys_reboot(QI_RB_POWER_OFF); return 1; }
    if (pid == 0) {
        sys_execve("/aethersafha", argv, 0);
        qi_say("qemu_init: execve FAILED -- is /aethersafha in the initramfs and static?\n");
        sys_exit(127);
    }
    var st = alloc(8);
    store64(st, 0);
    sys_waitpid(pid, st, 0);
    var raw = load64(st);
    # WEXITSTATUS. ⚠ The `--clients` ladder (95/94/93/92/91) is read from exactly this number, so a
    # raw wait status printed here would be that value times 256 and silently unreadable.
    qi_say("qemu_init: aethersafha exit ");
    qi_num((raw / 256) & 0xFF);
    qi_say("\n");
    if (hold == 1) {
        # ⚠ The harness watches for THIS line and dumps while we sit here. Nothing is redrawn during
        # the hold, so what the device holds is exactly the child's last frame.
        qi_say("qemu_init: holding the framebuffer for the screendump\n");
        sleep_ms(12000);
    }
    qi_say("qemu_init: powering off\n");
    sys_reboot(QI_RB_POWER_OFF);
    return 0;
}
