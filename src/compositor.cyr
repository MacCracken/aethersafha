# aethersafha — compositor core
# Parity: rust-old/src/compositor.rs  (Compositor, Workspace, ContextType)
#
# The compositor owns the window registry (a vec of *Window, z-order), the
# focused index, an id counter, a set of workspaces + the active one, and the
# secure / agent-aware mode flags. Native (sovereign) protocol dispatch is the
# compositor's own job (does NOT move to bhumi/mehman) — this is where the
# surface tree + window management live.

# Workspace context (parity: ContextType).
enum CtxType {
    CTX_DEVELOPMENT   = 0;
    CTX_COMMUNICATION = 1;
    CTX_DESIGN        = 2;
    CTX_GENERAL       = 3;
    CTX_AGENT_OP      = 4;
    CTX_WINDOW        = 5;
    CTX_APPLICATION   = 6;
    CTX_SYSTEM        = 7;
    CTX_USER          = 8;
}

# Workspace (parity: Workspace { id, name, windows: Vec<SurfaceId>, active_window, context_type }).
enum WspOff {
    WSP_ID      = 0;    # workspace id (== index)
    WSP_NAME    = 8;    # cstr
    WSP_WINDOWS = 16;   # vec of surface ids
    WSP_ACTIVE  = 24;   # active surface id, or -1
    WSP_CONTEXT = 32;   # CtxType
    WSP_SZ      = 40;
}

fn wsp_new(id, name, context): i64 {
    var w = alloc(WSP_SZ);
    if (w == 0) { return 0; }
    store64(w + WSP_ID, id);
    store64(w + WSP_NAME, name);
    store64(w + WSP_WINDOWS, vec_new());
    store64(w + WSP_ACTIVE, 0 - 1);
    store64(w + WSP_CONTEXT, context);
    return w;
}
fn wsp_id(w)       { return load64(w + WSP_ID); }
fn wsp_name(w)     { return load64(w + WSP_NAME); }
fn wsp_windows(w)  { return load64(w + WSP_WINDOWS); }
fn wsp_active(w)   { return load64(w + WSP_ACTIVE); }
fn wsp_context(w)  { return load64(w + WSP_CONTEXT); }
fn wsp_count(w)    { return vec_len(load64(w + WSP_WINDOWS)); }

enum CompOff {
    C_WINDOWS    = 0;    # vec of *Window (z-order: last = top)
    C_FOCUSED    = 8;    # index into windows, or -1
    C_NEXTID     = 16;   # next surface id
    C_ACTIVE_WS  = 24;   # active workspace index
    C_WORKSPACES = 32;   # vec of *Workspace
    C_AGENT      = 40;   # agent_aware_mode (0/1)
    C_SECURE     = 48;   # secure_mode (0/1)
    C_SZ         = 56;
}

# comp_new() -> *Compositor (0 on OOM). Starts with one default workspace.
fn comp_new(): i64 {
    var c = alloc(C_SZ);
    if (c == 0) { return 0; }
    store64(c + C_WINDOWS, vec_new());
    store64(c + C_FOCUSED, 0 - 1);
    store64(c + C_NEXTID, 1);
    store64(c + C_ACTIVE_WS, 0);
    var wss = vec_new();
    vec_push(wss, wsp_new(0, "Main", CtxType.CTX_GENERAL));
    store64(c + C_WORKSPACES, wss);
    store64(c + C_AGENT, 0);
    store64(c + C_SECURE, 0);
    return c;
}

fn comp_windows(c)  { return load64(c + C_WINDOWS); }
fn comp_count(c)    { return vec_len(load64(c + C_WINDOWS)); }
fn comp_focused(c)  { return load64(c + C_FOCUSED); }
fn comp_get(c, i)   { return vec_get(load64(c + C_WINDOWS), i); }

# --- workspaces -----------------------------------------------------------
fn comp_workspaces(c)      { return load64(c + C_WORKSPACES); }
fn comp_workspace_count(c) { return vec_len(load64(c + C_WORKSPACES)); }
fn comp_active_workspace(c){ return load64(c + C_ACTIVE_WS); }
fn comp_get_workspace(c, i): i64 {
    if (i < 0) { return 0; }
    if (i >= comp_workspace_count(c)) { return 0; }
    return vec_get(load64(c + C_WORKSPACES), i);
}

# comp_create_workspace(c, name, context) -> new workspace index.
fn comp_create_workspace(c, name, context): i64 {
    var wss = load64(c + C_WORKSPACES);
    var id = vec_len(wss);
    vec_push(wss, wsp_new(id, name, context));
    return id;
}

# comp_switch_workspace(c, ws_id) -> 0 ok / -1 invalid (parity: switch_workspace).
fn comp_switch_workspace(c, ws_id): i64 {
    if (ws_id < 0) { return 0 - 1; }
    if (ws_id >= comp_workspace_count(c)) { return 0 - 1; }
    store64(c + C_ACTIVE_WS, ws_id);
    return 0;
}

# comp_move_window_to_workspace(c, win_id, ws_id) -> 0 / -1 absent (parity).
fn comp_move_window_to_workspace(c, win_id, ws_id): i64 {
    if (comp_find_by_id(c, win_id) < 0) { return 0 - 1; }
    var old = comp_get_workspace(c, load64(c + C_ACTIVE_WS));
    if (old != 0) {
        var idx = vec_find(wsp_windows(old), win_id);
        if (idx >= 0) { vec_remove(wsp_windows(old), idx); }
    }
    var target = comp_get_workspace(c, ws_id);
    if (target != 0) {
        vec_push(wsp_windows(target), win_id);
        store64(target + WSP_ACTIVE, win_id);
    }
    return 0;
}

# --- modes (parity: set_secure_mode / set_agent_aware_mode) ----------------
fn comp_set_secure_mode(c, v)  { store64(c + C_SECURE, v); return 0; }
fn comp_secure_mode(c)         { return load64(c + C_SECURE); }
fn comp_set_agent_aware(c, v)  { store64(c + C_AGENT, v); return 0; }
fn comp_agent_aware(c)         { return load64(c + C_AGENT); }

# comp_create_window: assign next id, push (top of z-order), focus it, and add
# it to the active workspace. -> *Window
fn comp_create_window(c, x, y, w, h, title): i64 {
    var id = load64(c + C_NEXTID);
    store64(c + C_NEXTID, id + 1);
    var win = win_new(id, x, y, w, h, title);
    if (win == 0) { return 0; }
    var v = load64(c + C_WINDOWS);
    vec_push(v, win);
    store64(c + C_FOCUSED, vec_len(v) - 1);
    var aw = comp_get_workspace(c, load64(c + C_ACTIVE_WS));
    if (aw != 0) {
        vec_push(wsp_windows(aw), id);
        store64(aw + WSP_ACTIVE, id);
    }
    return win;
}

# comp_focus(c, i): set focus to window index i if valid.
fn comp_focus(c, i): i64 {
    if (i < 0) { return 0 - 1; }
    if (i >= comp_count(c)) { return 0 - 1; }
    store64(c + C_FOCUSED, i);
    return 0;
}

# comp_focused_window(c) -> *Window (0 if none focused)
fn comp_focused_window(c): i64 {
    var f = load64(c + C_FOCUSED);
    if (f < 0) { return 0; }
    if (f >= comp_count(c)) { return 0; }
    return comp_get(c, f);
}

# comp_find_by_id(c, id) -> index, or -1
fn comp_find_by_id(c, id): i64 {
    var v = load64(c + C_WINDOWS);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (win_id(vec_get(v, i)) == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ⛔⛔ THE RETIRED RECT — where a CLOSED window's pixels are remembered after the window is gone.
#
# This exists because closing a window left it **standing on the panel, flashing**, on the 2026-08-08
# iron burn. The mechanism is worth stating exactly, because it is asymmetric with a MOVE in a way that
# is easy to get wrong twice:
#
#   `AE-0a`'s damage band is `union(cur, prev)`, and `#84 present` FLIPS the render target. So erasing
#   a region takes TWO consecutive frames of band coverage — one per buffer. Anything placed in `cur`
#   gets exactly that for free: it is in `cur` this frame, and next frame the roll makes it `prev`.
#   ⇒ A MOVED window is in `cur` (its rect changed), so it gets two frames and leaves no ghost — which
#     is what the burn proved.
#   ⇒ A CLOSED window is in NEITHER, because every damage producer walks the LIVE window list and it
#     has just left it. It got one frame of coverage from the PREVIOUS frame's `prev` and no more, so
#     the buffer drawn on the close frame lost the window and the other buffer kept it forever. `#84`
#     alternates them ⇒ the window blinks at half the frame rate.
#   ⛔ And a STATIC window with no client buffer (the compositor-seeded one) was in neither `cur` nor
#     `prev` even on the close frame — `win_rect_changed` is 0 and `win_bufid` is 0 — so closing it
#     damaged NOTHING and it simply stayed on screen in both buffers. Two symptoms, one cause.
#
# ⇒ A close records its rect HERE, and render.cyr folds it into `cur` exactly once. That buys the same
# two frames a move gets, through the same mechanism, with no new special case in the band itself.
#
# ⚠ THE RECT IS STORED RAW, WITHOUT THE TITLEBAR. `TITLEBAR_H` is an enum in render.cyr, which is
# included AFTER this file, and Cyrius does not resolve forward references to constants — so the chrome
# extension is added by the consumer, which owns that number anyway.
# ⚠ It is a BOUNDING BOX, unioned, because the band is one box per frame regardless: two windows closed
# in one frame must both be covered, and `rend_dmg_add` would union them anyway.
# First-occurrence latches for the two ways a close can end. See the note at the send site.
var ae_close_told = 0;
var ae_close_orphan = 0;
var ae_retire_valid = 0;
var ae_retire_x = 0;
var ae_retire_y = 0;
var ae_retire_x1 = 0;    # exclusive right edge, kept as an edge so the union is a min/max
var ae_retire_y1 = 0;    # exclusive bottom edge

fn comp_retire_valid(): i64 { return ae_retire_valid; }
fn comp_retire_x(): i64 { return ae_retire_x; }
fn comp_retire_y(): i64 { return ae_retire_y; }
fn comp_retire_w(): i64 { return ae_retire_x1 - ae_retire_x; }
fn comp_retire_h(): i64 { return ae_retire_y1 - ae_retire_y; }
fn comp_retire_clear(): i64 {
    ae_retire_valid = 0;
    ae_retire_x = 0;
    ae_retire_y = 0;
    ae_retire_x1 = 0;
    ae_retire_y1 = 0;
    return 0;
}

# comp_retire_add(x, y, w, h): remember that this rect no longer has a window on it.
# ⚠ A zero-or-negative extent is ignored rather than stored — an empty rect would make the box valid
# while covering nothing, which reads downstream as "a close was handled" when none was.
fn comp_retire_add(x, y, w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var x1 = x + w;
    var y1 = y + h;
    if (ae_retire_valid == 0) {
        ae_retire_valid = 1;
        ae_retire_x = x;
        ae_retire_y = y;
        ae_retire_x1 = x1;
        ae_retire_y1 = y1;
        return 0;
    }
    if (x < ae_retire_x) { ae_retire_x = x; }
    if (y < ae_retire_y) { ae_retire_y = y; }
    if (x1 > ae_retire_x1) { ae_retire_x1 = x1; }
    if (y1 > ae_retire_y1) { ae_retire_y1 = y1; }
    return 0;
}

# comp_close_window(c, id): remove the window from the registry + active
# workspace. -> 0 ok / -1 absent
# comp_close_all_clients(c) -> the number of clients told to close.
#
# ⛔⛔ THE COMPOSITOR HAD NO SESSION TEARDOWN ON agnos AT ALL, and that is a resource leak with a hard
# ceiling behind it. `main.cyr`'s only exit-path release is `sys_close(setu_sfd)` wrapped in
# `#ifndef CYRIUS_TARGET_AGNOS` — so on the ONE target that has no listener, nothing was released.
# Everything the compositor itself holds is reclaimed when its process dies; everything its SPAWNED
# CHILDREN hold is not, because they do not die. A `--clients` probe run or an Esc quit therefore left
# puka, puka's own agnsh and crab **alive forever**, each holding a `#97` channel end, an `#86`
# GPU-visible shm slot and a row in a process table that has exactly **16** of them
# (`agnos/kernel/core/proc.cyr:275`). Relaunching the desktop a few times marches that count to the cap,
# after which `proc_alloc_slot` refuses every spawn and the desktop comes up hosting NOTHING.
#
# ⭐ THE RELEASE MECHANISM ALREADY EXISTS AND IS PROVEN — this is the same `SETU_CLOSE` (kind 7) that
# `comp_close_window` sends for F4, which burned PASS on iron 2026-08-08. As that function's own note
# says: the CLIENT'S EXIT is what releases the endpoint and the slot, so the send is not a courtesy,
# it is the mechanism. Session teardown is the identical operation with a wider scope.
#
# ⚠ It does NOT unlink or retire anything. A closing compositor is about to stop drawing forever, so
# the retired-rect bookkeeping `comp_close_window` needs for a REPAINT has no consumer here — and
# walking the vector while removing from it is how that path would go wrong.
# ⚠ `win_cfd == 0` is a compositor-seeded window with no client. Nothing to notify, and not an error.
fn comp_close_all_clients(c): i64 {
    var v = load64(c + C_WINDOWS);
    var n = vec_len(v);
    var i = 0;
    var told = 0;
    while (i < n) {
        var win = vec_get(v, i);
        if (win != 0) {
            var cfd = win_cfd(win);
            if (cfd != 0) {
                setu_send(cfd, setu_close(win_id(win)));
                told = told + 1;
            }
        }
        i = i + 1;
    }
    return told;
}

fn comp_close_window(c, id): i64 {
    var idx = comp_find_by_id(c, id);
    if (idx < 0) { return 0 - 1; }
    var v = load64(c + C_WINDOWS);
    # ⛔ RETIRE THE RECT BEFORE UNLINKING, because after `vec_remove` this window is unreachable and
    # its geometry is the only record of which pixels need repainting. See the retired-rect note above.
    var dying = vec_get(v, idx);
    if (dying != 0) {
        comp_retire_add(win_x(dying), win_y(dying), win_w(dying), win_h(dying));
        # ⛔⛔ TELL THE CLIENT. A setu client is a SEPARATE PROCESS, and removing its window from this
        # vector is invisible to it — so before this fix, F4 left the process **orphaned alive**, still
        # holding its `#97` channel end and its `#86` GPU-visible shm slot for the rest of the boot.
        # There are only 16 of those slots system-wide, so a handful of closes exhausts GPU compositing
        # for everything. That is the "not closing properly" half of the 2026-08-08 report, and it is a
        # different defect from the flashing above.
        # ⭐ `SETU_CLOSE` (kind 7, C<->S) HAS BEEN IN THE PROTOCOL ALL ALONG (lib/setu.cyr:140) with a
        # constructor ready to use (`setu_close`, :382). Nothing sent it and no client handled it. This
        # is wiring an existing message, not extending the protocol.
        # ⚠ The CLIENT'S EXIT is what actually releases the channel end and the shm slot — the kernel
        # reclaims both when the process dies. So this send is not a courtesy; it is the release
        # mechanism. A client that ignores `SETU_CLOSE` still leaks, which is why crab and puka were
        # taught to honour it in the same change.
        # ⚠ `win_cfd == 0` is a compositor-seeded window with no client at all. Nothing to notify.
        # ⛔ SAY WHICH CASE THIS WAS. The close path used to print nothing at all, and that cost a QEMU
        # run: F4 arrived (the usage trace proved it), no client acknowledged, and the log could not
        # distinguish "correctly told nobody, because this window has no client" from "the send is
        # broken" from "the client ignored it". Three different bugs, one silence. ⚠ The first case is
        # NORMAL — the compositor seeds a window of its own with no `#97` peer — and a diagnosis that
        # cannot see it will go hunting in the wire.
        # ⚠ One latch per case, so two lines maximum however many windows are closed; a close is a
        # human-driven event and the identity of the case is the whole question, not the count.
        var dying_cfd = win_cfd(dying);
        if (dying_cfd != 0) {
            setu_send(dying_cfd, setu_close(win_id(dying)));
            if (ae_close_told == 0) {
                ae_close_told = 1;
                println("aethersafha: closed a window and sent SETU_CLOSE to its client");
            }
        }
        if (dying_cfd == 0) {
            if (ae_close_orphan == 0) {
                ae_close_orphan = 1;
                println("aethersafha: closed a window that has no client -- nothing to notify");
            }
        }
    }
    vec_remove(v, idx);
    var aw = comp_get_workspace(c, load64(c + C_ACTIVE_WS));
    if (aw != 0) {
        var wi = vec_find(wsp_windows(aw), id);
        if (wi >= 0) { vec_remove(wsp_windows(aw), wi); }
    }
    # keep focus in range
    var f = load64(c + C_FOCUSED);
    if (f >= vec_len(v)) { store64(c + C_FOCUSED, vec_len(v) - 1); }
    return 0;
}

# comp_window_at(c, px, py) -> topmost non-minimized *Window containing the
# point, or 0. Top of z-order = last in the vec, so scan back-to-front.
fn comp_window_at(c, px, py): i64 {
    var v = load64(c + C_WINDOWS);
    var i = vec_len(v) - 1;
    while (i >= 0) {
        var win = vec_get(v, i);
        if (win_state(win) != WinState.WS_MINIMIZED) {
            var x = win_x(win);
            var y = win_y(win);
            var inx = 0;
            if ((px >= x) && (px < x + win_w(win))) { inx = 1; }
            if (inx == 1) {
                # ⛔ `win_bottom_y`, NOT `y + win_h`. This used to end the window at `y + win_h`, i.e.
                # chrome-INSIDE, while every rendering path places the content at `y + TITLEBAR_H` for
                # `win_h` rows — so the bottom-most TITLEBAR_H rows of a live client surface were
                # considered OUTSIDE the window and a click there would have hit whatever was behind it.
                # Inert while nothing clicked. The convention lives in src/window.cyr.
                if ((py >= y) && (py < win_bottom_y(win))) { return win; }
            }
        }
        i = i - 1;
    }
    return 0;
}
