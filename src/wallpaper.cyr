# wallpaper.cyr — the desktop backdrop as a SOURCE rather than a constant (M6-C1a).
#
# ⭐ WHY THIS IS THE LOAD-BEARING BITE OF THE WALLPAPER WORK. Everything the design brief wants —
# gradients, shader wallpapers, "computed per frame, not asset-streamed" — needs somewhere to draw.
# Until now the backdrop was a single `bg` i64 handed to `bhumi_fb_clear` / `rend_clear_band`, so there
# was no layer at all and no place a second colour could exist. This introduces the layer and keeps the
# default byte-identical to what shipped.
#
# ⛔⛔ THE FIRST CUT OF THIS FILE BUILT THE WRONG THING, and the wrong thing had a very convincing
# rationale. It shipped as a *colour source* — solid and vertical-gradient — under a doctrine that
# "the colour may depend on `y`, never on `x`", justified by keeping the `AE-0a` band a flat row run
# (1.093 ns/px; going through `fill_rect` cost 23% more in per-row overhead alone). That constraint is
# right for a gradient and **meaningless for a wallpaper, because an image varies in both axes.**
# ⇒ The doctrine is retired. It came from reading the design brief's "generative / shader wallpapers"
# idea log as the spec instead of asking what a wallpaper IS: **a file you load and put on the screen.**
# Solid and gradient survive as cheap special cases; IMAGE is the point.
#
# ⭐ THE COST ARGUMENT SURVIVES INTACT, and it is why this is affordable: `AE-0a` measured the clear at
# **3.83 ms of a 6.40 ms GPU frame — 60%** at 2560x1440. A wallpaper REPLACES that clear rather than
# adding to it, and the damage band still governs how many pixels are touched. An image costs a load
# per pixel where a solid costs none, but it is bounded by the same band.
#
# ⛔ DECODING IS chitra'S JOB, NOT OURS. `[deps.chitra]` is a pure-Cyrius CPU raster decoder — PNG at
# every bit depth including Adam7, and baseline JPEG with YCbCr subsampling — returning canonical
# RGBA8. A hand-rolled PNG decoder was written here before that dep was found and covered a strict
# subset of it; it was deleted, not kept as a "lighter path".
#
# ⚠ NOT a client surface and not a window. The wallpaper is compositor-owned, sits beneath every
# window, and is drawn by the same band the clear used — so it inherits `AE-0a`'s damage tracking for
# free rather than needing its own.

enum AeWallpaperKind {
    AE_WP_SOLID = 0;   # one colour — byte-identical to the pre-C1a backdrop
    AE_WP_VGRAD = 1;   # vertical gradient, `c0` at the top row to `c1` at the bottom
    AE_WP_IMAGE = 2;   # a decoded file, scaled to the screen
}

# Decoded wallpaper image: XRGB8888, `ae_wp_iw` x `ae_wp_ih`.
var ae_wp_img = 0;
var ae_wp_iw  = 0;
var ae_wp_ih  = 0;

fn wp_image(): i64        { return ae_wp_img; }
fn wp_image_width(): i64  { return ae_wp_iw; }
fn wp_image_height(): i64 { return ae_wp_ih; }

# Nearest-neighbour source index for destination column/row. PURE and host-testable — the whole
# scaling policy is these two lines, and an off-by-one here samples past the image on the last
# row/column, which reads as a torn edge rather than as an error.
fn wp_src_index(d, dn, sn): i64 {
    if (dn <= 0) { return 0; }
    if (sn <= 0) { return 0; }
    var i = (d * sn) / dn;
    if (i < 0) { i = 0; }
    if (i > (sn - 1)) { i = sn - 1; }
    return i;
}

var ae_wp_kind = 0;
var ae_wp_c0   = 0;
var ae_wp_c1   = 0;
# ⛔ THE SERIAL IS WHAT KEEPS THE DAMAGE MODEL HONEST. `rend_band_compute` refuses to band a frame when
# the background changed, because a theme switch damages every pixel without moving a window — it
# detects that by comparing the `bg` i64 against the last one. A wallpaper cannot be compared that way:
# two different gradients can share a top colour. So every mutation bumps this, and the band check reads
# it. Without it, switching wallpapers would repaint only the rows a window happened to be moving in.
var ae_wp_serial = 0;
# ⛔ TRACKING IS ON BY DEFAULT, AND WITHOUT IT THE DESKTOP BOOTS BLACK. The backdrop used to be read
# from rupa every frame (`rupa_theme_bg`); turning it into a layer means the layer has to be told what
# colour to be, and an uninitialised source is 0 = black. So the layer FOLLOWS the theme until someone
# sets a wallpaper explicitly, which preserves the pre-C1a behaviour exactly — including repainting on
# a theme switch — and makes an explicit wallpaper an override rather than a race with the theme.
var ae_wp_track = 1;

# Follow the theme's background while no explicit wallpaper is set.
# ⛔⛔ THE SERIAL MUST ONLY MOVE WHEN THE COLOUR ACTUALLY CHANGES. Bumping it unconditionally here would
# invalidate the damage band EVERY FRAME — `rend_band_compute` would refuse to band, every frame would
# repaint the whole screen, and `AE-0a`'s 3.83 ms -> 2.46 ms saving would be silently undone by a
# feature whose entire cost argument is that it REPLACES the clear. Compare first, then set.
fn wp_track_theme(bg): i64 {
    if (ae_wp_track == 0) { return 0; }
    if (ae_wp_kind == AeWallpaperKind.AE_WP_SOLID) { if (ae_wp_c0 == bg) { return 0; } }
    ae_wp_kind = AeWallpaperKind.AE_WP_SOLID;
    ae_wp_c0 = bg;
    ae_wp_c1 = bg;
    ae_wp_serial = ae_wp_serial + 1;
    return 1;
}

fn wp_tracking(): i64 { return ae_wp_track; }
fn wp_kind(): i64   { return ae_wp_kind; }
fn wp_serial(): i64 { return ae_wp_serial; }

# The colour of the TOP row — what a caller needs when it wants one representative colour (the GPU
# solid-fill path, and the `bg` argument the chrome still themes against).
fn wp_base_color(): i64 { return ae_wp_c0; }

fn wp_set_solid(color): i64 {
    ae_wp_track = 0;                       # explicit choice wins over the theme from here on
    ae_wp_kind = AeWallpaperKind.AE_WP_SOLID;
    ae_wp_c0 = color;
    ae_wp_c1 = color;
    ae_wp_serial = ae_wp_serial + 1;
    return 0;
}

fn wp_set_vgrad(top, bottom): i64 {
    ae_wp_track = 0;
    ae_wp_kind = AeWallpaperKind.AE_WP_VGRAD;
    ae_wp_c0 = top;
    ae_wp_c1 = bottom;
    ae_wp_serial = ae_wp_serial + 1;
    return 0;
}

# Interpolate one 8-bit channel of an XRGB8888 pair at `y` of `h` rows. PURE and host-testable.
# ⚠ Integer maths on purpose: no floats in this renderer, and a rounding difference here is invisible
# against an 8-bit channel. `h <= 1` returns the top colour rather than dividing by zero.
fn wp_lerp8(a, b, y, h): i64 {
    if (h <= 1) { return a & 0xFF; }
    var lo = a & 0xFF;
    var hi = b & 0xFF;
    return lo + (((hi - lo) * y) / (h - 1));
}

# The packed XRGB colour for row `y` of an `h`-row screen. PURE — this is the whole source, and the
# reason a unit test can cover the wallpaper without a framebuffer.
# ⚠ Clamps rather than wrapping: a caller asking past the last row gets the last row's colour, which is
# what a band overrunning by a pixel should see.
# The pixel at (x, y) of an `fw` x `fh` screen. ⚠ This — not `wp_row_color` — is the real source API
# now; `wp_row_color` remains for the row-uniform kinds and for the tests that pin their maths.
fn wp_pixel(x, y, fw, fh): i64 {
    if (ae_wp_kind == AeWallpaperKind.AE_WP_IMAGE) {
        if (ae_wp_img == 0) { return ae_wp_c0; }
        var sx = wp_src_index(x, fw, ae_wp_iw);
        var sy = wp_src_index(y, fh, ae_wp_ih);
        return load32(ae_wp_img + (sy * ae_wp_iw + sx) * 4);
    }
    return wp_row_color(y, fh);
}

fn wp_row_color(y, h): i64 {
    if (ae_wp_kind == AeWallpaperKind.AE_WP_SOLID) { return ae_wp_c0; }
    if (ae_wp_kind == AeWallpaperKind.AE_WP_IMAGE) { return ae_wp_c0; }
    var yy = y;
    if (yy < 0) { yy = 0; }
    if (h > 0) { if (yy > (h - 1)) { yy = h - 1; } }
    var r = wp_lerp8(ae_wp_c0 >> 16, ae_wp_c1 >> 16, yy, h);
    var g = wp_lerp8(ae_wp_c0 >> 8,  ae_wp_c1 >> 8,  yy, h);
    var b = wp_lerp8(ae_wp_c0,       ae_wp_c1,       yy, h);
    return ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
}

# ⭐ THE IMAGE SCALED ONCE, then copied by rows: a 720-row band costs 50 ms through `wp_pixel`, and 0.35 this way. One
# `fw * fh * 4` copy, built on the first CPU frame that paints this image at this size, and again only when either
# changes. ⚠ NEVER BUILT WHILE `ae_gpu_wp_on()` HOLDS: `wp_fill_band` returns first, as the GPU paints that frame
# from its own `#86` slot, so a GPU desktop does not hold the screen in memory twice. -> the pixels, or 0.
var ae_wp_sc = 0;
var ae_wp_sc_img = 0;
var ae_wp_sc_w = 0;
var ae_wp_sc_h = 0;
var ae_wp_sc_ser = 0 - 1;
fn wp_scaled(fw, fh): i64 {
    var sized = 0;
    if ((ae_wp_sc != 0) && (ae_wp_sc_w == fw) && (ae_wp_sc_h == fh)) { sized = 1; }
    if ((sized == 1) && (ae_wp_sc_ser == ae_wp_serial) && (ae_wp_sc_img == ae_wp_img)) { return ae_wp_sc; }
    if (sized == 0) {
        if (ae_wp_sc != 0) { fl_free(ae_wp_sc); }
        ae_wp_sc = fl_alloc(fw * fh * 4);
        ae_wp_sc_w = fw;
        ae_wp_sc_h = fh;
        if (ae_wp_sc == 0) { return 0; }
    }
    var y = 0;
    while (y < fh) {
        var srow = ae_wp_img + wp_src_index(y, fh, ae_wp_ih) * ae_wp_iw * 4;
        var d = ae_wp_sc + y * fw * 4;
        var x = 0;
        while (x < fw) {
            store32(d + x * 4, load32(srow + wp_src_index(x, fw, ae_wp_iw) * 4));
            x = x + 1;
        }
        y = y + 1;
    }
    ae_wp_sc_ser = ae_wp_serial;
    ae_wp_sc_img = ae_wp_img;
    return ae_wp_sc;
}

# Paint rows [y, y+h) of `fb` from the source. `fh` is the FULL screen height — the gradient is defined
# over the whole desktop, not over the band, or a damage band would show a different gradient than a
# full repaint of the same pixels.
# ⭐ SOLID TAKES THE ORIGINAL PATH UNCHANGED, which is why the default cannot regress: it is the same
# single `rend_clear_band` call the pre-C1a code made.
fn wp_fill_band(fb, y, h, fh): i64 {
    if (fb == 0) { return 0 - 1; }
    if (h <= 0) { return 0; }
    if (ae_wp_kind == AeWallpaperKind.AE_WP_SOLID) {
        return rend_clear_band(fb, y, h, ae_wp_c0);
    }
    var fw = bhumi_fb_width(fb);
    if (ae_wp_kind == AeWallpaperKind.AE_WP_IMAGE) {
        if (ae_wp_img == 0) { return rend_clear_band(fb, y, h, ae_wp_c0); }
        # ⛔ THE GPU IS ABOUT TO BLIT THIS — do not also paint it on the CPU. `AE-9` deletes the `#39`
        # blit on a GPU frame, so anything written into the userland framebuffer here is discarded
        # work: a full-screen per-pixel loop thrown away every frame. The flag is set by the frame
        # PLAN, which runs before render, so this is a decision already made rather than one guessed at.
        if (ae_gpu_wp_on() == 1) { return 0; }
        # ⭐ ROWS OF THE IMAGE AT SCREEN SIZE, from the copy `wp_scaled` keeps. Rows outside the framebuffer are
        # skipped, as the per-pixel walk below skips them.
        var sc = 0;
        if ((fh == bhumi_fb_height(fb)) && (bhumi_fb_bpp(fb) == 4)) { sc = wp_scaled(fw, fh); }
        if (sc != 0) {
            var y0 = y;
            var y1 = y + h;
            if (y0 < 0) { y0 = 0; }
            if (y1 > fh) { y1 = fh; }
            var pitch = bhumi_fb_pitch(fb);
            var dr = bhumi_fb_pixels(fb) + y0 * pitch;
            var sr = sc + y0 * fw * 4;
            while (y0 < y1) {
                ae_row_copy(dr, sr, fw);
                dr = dr + pitch;
                sr = sr + fw * 4;
                y0 = y0 + 1;
            }
            return 0;
        }
        var iy = 0;
        while (iy < h) {
            var ix = 0;
            while (ix < fw) {
                bhumi_fb_set(fb, ix, y + iy, wp_pixel(ix, y + iy, fw, fh));
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        return 0;
    }
    var r = 0;
    while (r < h) {
        rend_clear_band(fb, y + r, 1, wp_row_color(y + r, fh));
        r = r + 1;
    }
    return 0;
}

# Load a wallpaper from a PNG or JPEG file. -> 0 on success, negative on failure: -1 cannot open it, -2 out of
# memory, -3 empty, -4 chitra could not decode it, -5 no pixels, -6 past the 16 MiB read cap, -7 not a PNG or a JPEG,
# -8 past the decode ceiling.
# ⚠ chitra returns canonical **RGBA8**; the framebuffer is XRGB8888, so the channels are repacked once
# here rather than per frame. Alpha is DISCARDED deliberately: the wallpaper is the bottom layer, so
# there is nothing beneath it for an alpha to blend against and honouring it would only darken the
# image against black. A translucent wallpaper is a different feature from a translucent window.
# ⛔ A SMALL FILE CAN DECLARE A HUGE IMAGE: a 137 KB PNG can cost 269 MB of RSS at startup. A wallpaper is scaled to
# the screen by nearest neighbour, so past twice the screen per axis the extra pixels are thrown away. -> the most
# RGBA8 bytes one wallpaper may decode to on an `fw` x `fh` screen: four screens, and never under one 4K image, so a
# small panel still takes a common file.
fn wp_decode_ceiling(fw, fh): i64 {
    var floor = 3840 * 2160 * 4;
    if ((fw <= 0) || (fh <= 0)) { return floor; }
    var c = fw * fh * 4 * 4;
    if (c < floor) { return floor; }
    return c;
}

# The ceiling for this screen. Asked here because the file is read before the backend opens.
fn wp_screen_ceiling(): i64 {
    var info[24];                       # function-local => 24 BYTES == BHUMI_FBINFO_SIZE
    if (bhumi_output_query(&info) < 0) { return wp_decode_ceiling(0, 0); }
    return wp_decode_ceiling(bhumi_fbinfo_width(&info), bhumi_fbinfo_height(&info));
}

fn wp_load_file(path): i64 { return wp_load_file_budget(path, wp_screen_ceiling()); }

# `max_bytes` is chitra's budget: the RGBA8 output it may begin to make.
fn wp_load_file_budget(path, max_bytes): i64 {
    # ⚠ `sys_open` is one NAME with two CONTRACTS. agnos is open(name, NAMELEN, flags)
    # (SYS_OPEN=7); Linux is open(path, flags, mode). The Linux form compiled fine on agnos and
    # handed the kernel namelen=0 — a zero-length filename — so an entirely valid path failed with
    # -1 and read as "no such file". Confirmed on iron 2026-08-19: `ls` listed the PNG, argv carried
    # the exact path, and this still returned -1. The gate is per-target because the arity matches;
    # only the meaning of a2 differs, so nothing catches it but the kernel's answer.
    var fd = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    fd = sys_open(path, strlen(path), 0);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    fd = sys_open(path, 0, 0);
    #endif
    if (fd < 0) { return 0 - 1; }
    var cap = 16777216;                       # 16 MB — a desktop wallpaper, not a photo library
    var src = alloc(cap);
    if (src == 0) { sys_close(fd); return 0 - 2; }
    # ⚠ Read to EOF. One `sys_read` returning short is normal on a large file, and treating it as the
    # whole file truncates the last chunk — which surfaces as a decode error naming the wrong cause.
    var got = 0;
    var n = 1;
    while (n > 0) {
        n = sys_read(fd, src + got, cap - got);
        if (n > 0) { got = got + n; }
        if (got >= cap) { n = 0; }
    }
    # ⛔ A FILE THE CAP CUT IS NOT A FILE THAT FAILED TO DECODE. One byte more says which this is, and a file of
    # exactly 16 MiB has none.
    var past = 0;
    if (got >= cap) {
        var one[8];                     # function-local => 8 BYTES
        if (sys_read(fd, &one, 1) > 0) { past = 1; }
    }
    sys_close(fd);
    if (past == 1) { return 0 - 6; }
    if (got <= 0) { return 0 - 3; }
    # ⚠ chitra also routes BMP and GIF; `--wallpaper` is documented as PNG or JPEG, so those stop here.
    if ((chitra_png_check_signature(src, got) != 1) && (chitra_jpeg_check_signature(src, got) != 1)) { return 0 - 7; }
    var err = alloc(8);
    store64(err, 0);
    var img = chitra_image_decode_budget(src, got, max_bytes, err);
    if (img == 0) {
        if (chitra_err_code(load64(err)) == CHITRA_ERR_BUDGET) { return 0 - 8; }
        return 0 - 4;
    }
    var iw = chitra_image_width(img);
    var ih = chitra_image_height(img);
    if (iw <= 0) { return 0 - 5; }
    if (ih <= 0) { return 0 - 5; }
    var rgba = chitra_image_pixels(img);
    var pix = alloc(iw * ih * 4);
    if (pix == 0) { return 0 - 2; }
    var i = 0;
    var np = iw * ih;
    while (i < np) {
        var sp = rgba + i * 4;
        store32(pix + i * 4, ((load8(sp) & 0xFF) << 16) | ((load8(sp + 1) & 0xFF) << 8) | (load8(sp + 2) & 0xFF));
        i = i + 1;
    }
    chitra_image_free(img);
    ae_wp_track = 0;
    ae_wp_kind = AeWallpaperKind.AE_WP_IMAGE;
    ae_wp_img = pix;
    ae_wp_iw = iw;
    ae_wp_ih = ih;
    ae_wp_serial = ae_wp_serial + 1;
    return 0;
}

# Paint the whole framebuffer from the source — the no-band path.
fn wp_fill_all(fb, fw, fh): i64 {
    if (fb == 0) { return 0 - 1; }
    # ⛔⛔ THIS SOLID ARM USED TO CALL `bhumi_fb_clear` DIRECTLY, AND THAT LOST THE WHOLE CLEAR ON THE
    # GPU PATH. `bhumi_fb_clear` writes the USERLAND framebuffer; `rend_clear_band` — which the banded
    # sibling below already used — ENQUEUES a `#88` rect when chrome is on the GPU. With chrome on the
    # GPU the `#39` blit is skipped, so anything written only to userland never reaches the screen.
    # ⇒ The no-band path is exactly the one a THEME SWITCH takes (`rend_band_compute` refuses to band
    # across a background change) and the one the FIRST FRAME takes. Both lost their clear:
    #   · 2026-08-18 burn — "theme switching works for the titlebar but not background or top bar".
    #     Titlebars are chrome rects, enqueued separately, so they updated; the background did not.
    #   · the same burn — `--selftest` pixels surviving into the desktop launched after it.
    # ⚠ INVISIBLE IN QEMU, which has no AMD device: with no GPU the `#39` blit runs and the userland
    # framebuffer IS the screen, so a per-region screendump measured both regions repainting.
    # ⇒ Delegate to `wp_fill_band`, whose SOLID arm is `rend_clear_band`. One clear path, not two.
    return wp_fill_band(fb, 0, fh, fh);
}

# ⛔⛔ CAN THE GPU DRAW THIS AS ONE OP? `#88 gpu_fill_rect` fills a rect with ONE colour, and `AE-9`
# routes the whole clear through it — so a SOLID wallpaper is free on that path and anything else is
# not expressible as a single fill.
# ⚠ A vertical gradient IS expressible as N stacked `#88` rects, and that is the C1b follow-on — at
# 1440 rows a per-row decomposition would be 1440 syscalls, but ~64 bands of ~22 rows is visually smooth
# and cheap. Not attempted here: C1a is the layer, and shipping a half-measure on the GPU path would
# make the first measurement of it meaningless.
# ⇒ Until then a non-solid wallpaper must DEMOTE the frame to the CPU path, and say so — silence here
# would look exactly like a wallpaper that failed to draw.
fn wp_gpu_expressible(): i64 {
    if (ae_wp_kind == AeWallpaperKind.AE_WP_SOLID) { return 1; }
    return 0;
}

# ⭐⭐ THE GPU ROUTE FOR AN IMAGE WALLPAPER IS ALREADY PROVEN, AND IT IS NOT mabda.
# A decoded wallpaper is just a full-screen surface, so it takes the SAME path a client surface takes:
# an `#86 shm_create_gpu` slot, then `#87 gpu_blit_shm` into the back buffer before the windows — which
# is `AE-2`, iron-proven for an opaque surface. No new kernel op, no shader, no driver stack.
# ⛔ mabda is NOT involved and must not be re-proposed: its GPU surface rides Linux's driver stack,
# while this band is the agnos kernel's own ring-3 `#82`-`#94` (roadmap, standing rulings). The
# only thing mabda could ever have offered here is decode acceleration, and decode is chitra's on CPU.
# ⭐ WIRED: `ae_gpu_wp_ensure` (gpu.cyr) keeps one persistent `#86` slot and re-uploads it only when the
# image or the geometry changes, and `ae_gpu_present_frame` blits it before anything else in the frame.
