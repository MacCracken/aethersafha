# aethersafha — input routing
# Parity: rust-old/src/compositor.rs (route_input_event) + gestures.rs
#
# Translates bhumi HID key events (physical press/release + USB HID usage) into
# compositor actions, then applies them to the focused window. Keyboard layout /
# keysym / compose belong here (the compositor's job, above bhumi's raw
# evdev-equivalent) — mirrors libxkbcommon.

enum InputAction {
    IA_NONE             = 0;
    IA_QUIT             = 1;
    IA_FOCUS_NEXT       = 2;
    IA_CLOSE_FOCUSED    = 3;
    IA_MAXIMIZE_FOCUSED = 4;
    IA_MINIMIZE_FOCUSED = 5;
    IA_MOVE_LEFT        = 6;
    IA_MOVE_RIGHT       = 7;
    IA_MOVE_UP          = 8;
    IA_MOVE_DOWN        = 9;
}

# USB HID usage IDs (Keyboard/Keypad page 0x07) — see lib/bhumi.cyr
#
# ⛔ F1-F3 ARE FREE BUT F4 IS NOT, AND THAT COST A BURN. The 2026-08-08 flash carried a window mover
# bound to F1-F4, and F4 was ALREADY `IA_CLOSE_FOCUSED` right here — so "move the focused window
# down" and "destroy the focused window" were the same keystroke. Whichever ran, the other was a bug.
# ⇒ The mover uses F7-F10, the contiguous block immediately below the three window-management keys
# this enum already claims. `_bhumi_set1_to_hid` (lib/bhumi.cyr:699) decodes Set-1 0x3B-0x44 to HID
# 0x3A-0x43 as one range, so F7-F10 arrive exactly as reliably as F1-F4 did — the choice costs
# nothing at the seam. ⚠ Before binding another function key, read this enum first.
enum HidUsage {
    HID_ESC = 0x29;
    HID_TAB = 0x2B;
    HID_F4  = 0x3D;   # close focused window
    HID_F5  = 0x3E;   # toggle maximize
    HID_F6  = 0x3F;   # minimize
    HID_F7  = 0x40;   # move focused window left
    HID_F8  = 0x41;   # move focused window right
    HID_F9  = 0x42;   # move focused window up
    HID_F10 = 0x43;   # move focused window down
}

# How far one move keystroke slides a window, in pixels.
# ⚠ LIVES HERE, NOT IN main.cyr. Cyrius resolves forward references to FUNCTIONS but not to
# VARIABLES, and main.cyr's globals are declared after its `include "src/input.cyr"` line — so a
# module-global step defined in main.cyr is invisible to this file. It was, and the mover read it
# only from code that turned out to be unreachable, which hid the ordering problem.
var AE_MOVE_STEP = 40;

# ⛔ WHICH USAGES HAVE ALREADY BEEN NAMED IN THE LOG — the compositor's key-arrival instrument.
#
# ⭐ IT LIVES HERE, NOT IN main.cyr, DELIBERATELY. Its first version sat inline in main.cyr's frame loop
# where no test can call it — the same structural mistake that let the window mover ship as dead code
# earlier the same day. Bit manipulation that nothing can assert on is not an instrument, it is a hope.
#
# ⛔ AND IT TRACKS DISTINCT USAGES, NOT THE FIRST N EVENTS, because the first-N version failed in the
# field on its first outing: on the 2026-08-08 GPU burn the operator held F8, eleven of the twelve trace
# slots went to eleven copies of usage 65, and the budget was gone before they pressed the key whose
# arrival was actually in question. A repeat must cost nothing.
#
# ⚠ MODULE-SCOPE `var X[N]` IS N*8 BYTES in Cyrius (function-local is N bytes), so 4 slots is 32 bytes
# = 256 bits — exactly one bit per possible usage, since `bhumi_key_usage` is `ev & 0xFF`. Relies on
# .bss zeroing like every other global here. [[feedback_cyrius_var_array_u64_units]]
var ae_inp_seen[4];

# ae_usage_first_sight(u): 1 the first time usage `u` is seen, 0 forever after. Marks it as seen.
# ⚠ `>>` IS LOGICAL shift right in Cyrius (`>>>` is the arithmetic one — inverted from C/Java), which is
# what is wanted here: `u` is `ev & 0xFF` so it is always 0..255.
# ⚠ The `& 63` on the shift is DOCUMENTARY, not load-bearing — x86 `shl` already masks the count to its
# low 6 bits, so removing it changes nothing and no test can catch it (verified: that mutant passes).
# The RANGE GUARDS below are what actually keep this in bounds. The `* 8` stride, by contrast, IS
# load-bearing and is mutation-tested — see the collision pairs in tests/input.tcyr.
fn ae_usage_first_sight(u): i64 {
    if (u < 0) { return 0; }
    if (u > 255) { return 0; }
    var w = u >> 6;                           # which of the 4 u64 slots
    var m = 1 << (u & 63);                    # which bit inside it
    var cur = load64(&ae_inp_seen + w * 8);    # *8: module-scope slots are u64-wide
    if ((cur & m) != 0) { return 0; }
    store64(&ae_inp_seen + w * 8, cur | m);
    return 1;
}

# input_map(ev): pure key→action mapping for a pressed key (IA_NONE otherwise).
fn input_map(ev): i64 {
    # ⛔⛔ KIND FIRST. The event batch is MIXED since bhumi 1.1.4 — pointer events share the array — and
    # every read below is `ev & 0xFF`, so an unchecked motion event is interpreted as a keystroke. The
    # numbers are not harmless: `bhumi_key_usage` is the LOW BYTE of dx and `bhumi_key_pressed` is BIT 8
    # of dx, so a horizontal motion of 297 px (0x129) reads as a pressed Escape = `IA_QUIT` and would QUIT
    # THE DESKTOP. ⚠ Derived, not guessed: a first test using dy=41 passed with this guard REMOVED,
    # because dy lives in bits 24-47 and cannot reach bit 8. The main loop routes by kind too; this guard is the second
    # line, and it is here rather than only there because this function is the one a unit test can reach.
    if (bhumi_ev_is_key(ev) == 0) { return InputAction.IA_NONE; }
    if (bhumi_key_pressed(ev) == 0) { return InputAction.IA_NONE; }
    var u = bhumi_key_usage(ev);
    if (u == HidUsage.HID_ESC) { return InputAction.IA_QUIT; }
    if (u == HidUsage.HID_TAB) { return InputAction.IA_FOCUS_NEXT; }
    if (u == HidUsage.HID_F4)  { return InputAction.IA_CLOSE_FOCUSED; }
    if (u == HidUsage.HID_F5)  { return InputAction.IA_MAXIMIZE_FOCUSED; }
    if (u == HidUsage.HID_F6)  { return InputAction.IA_MINIMIZE_FOCUSED; }
    if (u == HidUsage.HID_F7)  { return InputAction.IA_MOVE_LEFT; }
    if (u == HidUsage.HID_F8)  { return InputAction.IA_MOVE_RIGHT; }
    if (u == HidUsage.HID_F9)  { return InputAction.IA_MOVE_UP; }
    if (u == HidUsage.HID_F10) { return InputAction.IA_MOVE_DOWN; }
    return InputAction.IA_NONE;
}

# input_action_is_move(action): does this action slide the focused window?
# Exists so the main loop can recognise the group without repeating the four comparisons — and so
# adding a fifth direction later cannot leave one call site behind.
fn input_action_is_move(action): i64 {
    if (action < InputAction.IA_MOVE_LEFT) { return 0; }
    if (action > InputAction.IA_MOVE_DOWN) { return 0; }
    return 1;
}

# input_move(win, dx, dy, bound_w, bound_h): slide `win` and clamp it inside the bounds.
# Returns 1 if the window's position actually changed, 0 if the clamp held it where it was.
#
# ⛔ THE CLAMP IS NOT COSMETIC. `#88 gpu_fill_rect` and `#87 gpu_blit_shm` REJECT an out-of-range
# rect rather than clipping it, and `ae_gpu_window_admissible` refuses a window that crosses an edge
# — so a mover able to push a window off-screen would turn one keystroke into a silent loss of
# hardware compositing for the whole frame. The clamp is what keeps the GPU path reachable.
#
# ⚠ BOUNDS ARE PASSED IN, NOT READ FROM A GLOBAL. The screen geometry lives in main.cyr
# (`ae_geom_w` / `ae_geom_h`) which is included AFTER this file, and `TITLEBAR_H` lives in
# render.cyr which the input unit test does not include. Taking both as parameters is what makes
# this function testable at all — and an untestable mover is exactly how the first one shipped dead.
# ⇒ The caller passes the *usable* height, i.e. already reduced by any reserved chrome.
fn input_move(win, dx, dy, bound_w, bound_h): i64 {
    var ox = win_x(win);
    var oy = win_y(win);
    var nx = ox + dx;
    var ny = oy + dy;
    if (nx < 0) { nx = 0; }
    if (ny < 0) { ny = 0; }
    if (nx + win_w(win) > bound_w) { nx = bound_w - win_w(win); }
    if (ny + win_h(win) > bound_h) { ny = bound_h - win_h(win); }
    # ⚠ RE-CLAMP LOW. A window WIDER or TALLER than the bound makes the two clamps above disagree,
    # and the high clamp wins with a NEGATIVE coordinate — which is precisely the out-of-range rect
    # the GPU refuses. Pin it at the origin instead; an oversized window shows its top-left corner,
    # which is at least a picture.
    if (nx < 0) { nx = 0; }
    if (ny < 0) { ny = 0; }
    win_move(win, nx, ny);
    if (nx != ox) { return 1; }
    if (ny != oy) { return 1; }
    return 0;
}

# ================================================================
# POINTER STATE (`AE-7`) — the cursor position, kept here so a test can reach it
# ================================================================
#
# ⚠ Lives in input.cyr for the same reason `input_move` does: main.cyr's frame loop is not reachable
# from a unit test, and cursor clamping is arithmetic that fails silently. Bounds are PARAMETERS — the
# screen geometry is a main.cyr global declared after this file is included.
var ae_ptr_x = 0;
var ae_ptr_y = 0;

# input_ptr_move(dx, dy, bound_w, bound_h): advance the cursor and clamp it on screen.
# Returns 1 if the position actually changed, 0 if the clamp held it.
#
# ⚠ THE CLAMP IS EXCLUSIVE ON THE HIGH EDGE: a cursor at `bound_w` is one pixel off the right of a
# `bound_w`-wide screen, so the last legal column is `bound_w - 1`. Getting this wrong puts the hotspot
# outside every window's hit rect at the screen edge, where a user will absolutely try to click.
fn input_ptr_move(dx, dy, bound_w, bound_h): i64 {
    var ox = ae_ptr_x;
    var oy = ae_ptr_y;
    var nx = ox + dx;
    var ny = oy + dy;
    if (nx < 0) { nx = 0; }
    if (ny < 0) { ny = 0; }
    if (nx > bound_w - 1) { nx = bound_w - 1; }
    if (ny > bound_h - 1) { ny = bound_h - 1; }
    # A degenerate bound (0 or negative) would make the two clamps disagree and hand back -1.
    if (nx < 0) { nx = 0; }
    if (ny < 0) { ny = 0; }
    ae_ptr_x = nx;
    ae_ptr_y = ny;
    if (nx != ox) { return 1; }
    if (ny != oy) { return 1; }
    return 0;
}

# Place the cursor outright (screen centre at startup, or a test fixture).
fn input_ptr_set(x, y): i64 { ae_ptr_x = x; ae_ptr_y = y; return 0; }
fn input_ptr_x(): i64 { return ae_ptr_x; }
fn input_ptr_y(): i64 { return ae_ptr_y; }

# ⚠ Edges, not levels, are what a click IS — and deriving them here rather than in the frame loop is
# what lets a test assert the press/release pair without a compositor.
# ⭐⭐ THE BUTTON STATE MACHINE — press and release are NOT symmetric, and treating them as one edge on
# `cur | seen` makes the RELEASE UNREACHABLE.
#
# ⛔⛔ MEASURED AGAINST THE KERNEL, not reasoned from the name. `hid_mouse_take`
# (agnos kernel/arch/x86_64/usb/hid.cyr:232) ends with `hid_mouse_btn_seen = hid_mouse_btn` — the
# OR-accumulator is re-seeded to the current LEVEL, so a HELD button reports `seen = 1` on every drain.
# An edge test on `cur | seen` therefore reads 1 both while the button is down AND on the poll where it
# comes up, so the transition never appears: a titlebar drag is entered and never exited, the window
# follows the pointer for the rest of the session, and no client ever receives a button-up.
#
# ⇒ The two tests need different inputs:
#   PRESS   uses `cur | seen` — `seen` exists precisely so a click that begins AND ends inside one frame
#           is not invisible, and that click has `cur == 0`.
#   RELEASE uses `cur` ALONE — the level is the only thing that says the button is up.
# And a folded click must produce BOTH in the same event, or the client is left with a stuck button.
#
# `believed_down` is the CONSUMER's belief, not the device level. Returns a bitmask:
#   bit 0 = a press happened in this event · bit 1 = a release happened in this event.
fn input_btn_transitions(believed_down, cur, seen, mask): i64 {
    var r = 0;
    var wentdown = (cur | seen) & mask;
    var down = cur & mask;
    if (believed_down == 0) {
        if (wentdown != 0) { r = r | 1; }
    }
    var holding = believed_down;
    if ((r & 1) != 0) { holding = 1; }
    if (holding != 0) {
        if (down == 0) { r = r | 2; }
    }
    return r;
}

fn input_btn_pressed(t): i64 { return t & 1; }
fn input_btn_released(t): i64 { if ((t & 2) != 0) { return 1; } return 0; }

# ⛔ `input_btn_edge` WAS DELETED (2026-08-09). It computed ONE edge from a single level, which is the
# wrong shape for this kernel: `hid_mouse_take` re-seeds `buttons_seen` to the held LEVEL, so a caller had
# to hand it `cur | seen` to catch a folded click — and that made the RELEASE unreachable, which is the
# burn blocker `input_btn_transitions` exists for. It survived only because its own unit test fed it an
# argument pair the real caller could not produce. Two edge APIs where one is subtly wrong is an invitation
# to reach for the wrong one; there is now exactly one. [[feedback_compiled_is_not_reachable]]

# input_apply(comp, action, bound_w, bound_h): apply a window-management action to the compositor.
# Focus-next cycles the z-order; the rest act on the focused window. Returns 1 when a move actually
# changed a window's position, 0 otherwise.
#
# ⚠ `bound_w` / `bound_h` are the usable screen extent for a moved window (height already reduced by
# reserved chrome). They are only consulted by the move actions; every other action ignores them.
fn input_apply(comp, action, bound_w, bound_h): i64 {
    if (action == InputAction.IA_FOCUS_NEXT) {
        var n = comp_count(comp);
        if (n > 0) {
            var f = comp_focused(comp) + 1;
            if (f >= n) { f = 0; }
            comp_focus(comp, f);
        }
        return 0;
    }
    var win = comp_focused_window(comp);
    if (win == 0) { return 0; }
    if (action == InputAction.IA_CLOSE_FOCUSED) {
        comp_close_window(comp, win_id(win));
        return 0;
    }
    if (action == InputAction.IA_MAXIMIZE_FOCUSED) {
        if (win_state(win) == WinState.WS_MAXIMIZED) {
            win_set_state(win, WinState.WS_NORMAL);
        } else {
            win_set_state(win, WinState.WS_MAXIMIZED);
        }
        return 0;
    }
    if (action == InputAction.IA_MINIMIZE_FOCUSED) {
        # ⛔ RETIRE THE RECT, exactly as `comp_close_window` does. A minimized window stops being drawn,
        # and every damage producer walks the LIVE window list — so the region it vacated is in neither
        # `cur` nor `prev` and nothing ever repaints it. That is the same defect the F4 close had: the
        # window would simply stay on screen as a ghost. `#84` FLIPS, so the rect needs two frames of
        # coverage, which is what putting it in `cur` buys.
        comp_retire_add(win_x(win), win_y(win), win_w(win), win_total_h(win));
        win_set_state(win, WinState.WS_MINIMIZED);
        return 0;
    }
    if (action == InputAction.IA_MOVE_LEFT)  { return input_move(win, 0 - AE_MOVE_STEP, 0, bound_w, bound_h); }
    if (action == InputAction.IA_MOVE_RIGHT) { return input_move(win, AE_MOVE_STEP, 0, bound_w, bound_h); }
    if (action == InputAction.IA_MOVE_UP)    { return input_move(win, 0, 0 - AE_MOVE_STEP, bound_w, bound_h); }
    if (action == InputAction.IA_MOVE_DOWN)  { return input_move(win, 0, AE_MOVE_STEP, bound_w, bound_h); }
    return 0;
}

# input_handle(comp, ev, bound_w, bound_h): map + apply one event; returns the action so the main
# loop can observe IA_QUIT — and, just as importantly, so it can tell that the key was CLAIMED.
#
# ⛔ EVERY NON-`IA_NONE` ACTION IS A CONSUMED KEY. Before 2026-08-08 the main loop threw this return
# value away except for the quit test, so F4/F5/F6 were applied here AND then forwarded to the
# focused client — one keypress closing a window and typing into it. Worse, TAB was applied here
# (`IA_FOCUS_NEXT`) and then cycled focus a SECOND time in the loop's own TAB branch, so a single
# TAB advanced focus by two. Both were invisible on iron because nothing logs a double action.
fn input_handle(comp, ev, bound_w, bound_h): i64 {
    var action = input_map(ev);
    input_apply(comp, action, bound_w, bound_h);
    return action;
}
