# aethersafha — desktop session aggregate
# Parity: the assembly the Rust lib.rs / main.rs did across the subsystems.
#
# Wires the compositor together with the leaf subsystems — shell, AI features,
# security UI, accessibility, gestures, theme, shell-integration tray, plugin
# host — so they are instantiated, reachable, and connected from the running
# binary (not just standalone modules). The one live cross-subsystem connection
# so far is compositor → accessibility (the a11y tree mirrors the window stack);
# deeper wiring (shell panel, notifications, input→gestures) follows.

enum DeskOff {
    DSK_COMP  = 0;    # *Compositor
    DSK_SHELL = 8;    # DesktopShell
    DSK_AI    = 16;   # AIDesktopFeatures
    DSK_SEC   = 24;   # SecurityUI
    DSK_A11Y  = 32;   # AccessibilityTree
    DSK_GEST  = 40;   # GestureRecognizer
    DSK_THEME = 48;   # HighContrastTheme
    DSK_PLUG  = 56;   # PluginHost
    DSK_TRAY  = 64;   # vec of *TrayItem (shell_integration)
    DSK_FOREIGN = 72; # vec of *Foreign (mehman "swallow" seam)
    DSK_SZ    = 80;
}

# Default gesture-recognizer config: tap 300ms, double-tap 400ms, long-press
# 500ms, swipe threshold 50px, pinch threshold 100 permille.
fn desk_default_gestures(): i64 {
    return gest_recognizer_new(gest_config_new(300, 400, 500, 50, 100));
}

# desktop_new() -> *Desktop (0 on OOM). Instantiates the compositor + every leaf
# subsystem, and initializes the ones with startup state (security perm defs).
fn desktop_new(): i64 {
    var d = alloc(DSK_SZ);
    if (d == 0) { return 0; }
    store64(d + DSK_COMP, comp_new());
    store64(d + DSK_SHELL, shell_new());
    store64(d + DSK_AI, ai_new());
    store64(d + DSK_SEC, sec_ui_new());   # sec_ui_new seeds the permission definitions
    store64(d + DSK_A11Y, a11y_tree_new());
    store64(d + DSK_GEST, desk_default_gestures());
    store64(d + DSK_THEME, theme_hc_new(0x121218, 0xFFFFFF, 0x3366FF, 0xFF0000, 0xFFAA00, 0x00FF00, 1250));
    store64(d + DSK_PLUG, plug_host_new(16));
    store64(d + DSK_TRAY, vec_new());
    store64(d + DSK_FOREIGN, vec_new());
    return d;
}

fn desk_comp(d)  { return load64(d + DSK_COMP); }
fn desk_shell(d) { return load64(d + DSK_SHELL); }
fn desk_ai(d)    { return load64(d + DSK_AI); }
fn desk_sec(d)   { return load64(d + DSK_SEC); }
fn desk_a11y(d)  { return load64(d + DSK_A11Y); }
fn desk_gest(d)  { return load64(d + DSK_GEST); }
fn desk_theme(d) { return load64(d + DSK_THEME); }
fn desk_plug(d)  { return load64(d + DSK_PLUG); }
fn desk_tray(d)  { return load64(d + DSK_TRAY); }
fn desk_foreign(d) { return load64(d + DSK_FOREIGN); }
fn desk_foreign_count(d): i64 { return vec_len(desk_foreign(d)); }

# desktop_sync_accessibility(d): rebuild the a11y tree from the compositor's
# window stack — one AX_ROLE_WINDOW node per window (name = window title).
# Returns the number of window nodes added. (compositor ↔ accessibility)
fn desktop_sync_accessibility(d): i64 {
    var tree = desk_a11y(d);
    var v = comp_windows(desk_comp(d));
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        a11y_tree_add(tree, AxRole.AX_ROLE_WINDOW, win_title(vec_get(v, i)));
        i = i + 1;
    }
    return n;
}

# desktop_add_tray_item(d, id, app, tooltip): register a system-tray item
# (shell_integration) into the desktop's tray. -> *TrayItem
fn desktop_add_tray_item(d, id, app, tooltip): i64 {
    var item = shint_tray_item_new(id, app, "", tooltip, 1, vec_new());
    vec_push(desk_tray(d), item);
    return item;
}
fn desk_tray_count(d) { return vec_len(desk_tray(d)); }

# desk_bg_color(d): the desktop background as a bhumi XRGB pixel — the theme's
# high-contrast background with its alpha byte masked off. (theme → renderer)
fn desk_bg_color(d): i64 {
    return theme_hc_background(desk_theme(d)) & 0xFFFFFF;
}

# render_desktop(d, fb): the full desktop frame — compute damage, clear to the themed
# background, paint the window stack (focus-tinted), then the shell status panel on top.
#
# ⭐ THIS IS THE ONE FRAME PATH. It absorbed the damage half of the former `render_frame`
# (render.cyr), which nothing called — see the note there. Everything the frame does now happens
# in one place, in one order, so "what the compositor draws" is answerable by reading one function.
#
# ⚠ THE BACKGROUND IS A RUPA TOKEN, NOT `desk_bg_color`. The two frame paths disagreed: this one
# cleared to the a11y HighContrastTheme's background while the windows drawn on top of it were
# already themed from rupa, so the desktop void and its windows came from different palettes.
# rupa is the shared token core every consumer reads (compositor chrome, dhancha, crab, jalwa),
# so it wins. `desk_bg_color` is retained — the accessibility profile is a real, separate concern
# and theme_bridge is still its home — it is simply no longer what paints the desktop.
fn render_desktop(d, fb): i64 {
    var comp = desk_comp(d);
    var bg = ae_bhumi(rupa_theme_bg(rupa_theme_active()));
    # ⛔ BEFORE the clear. Damage is computed from each window's PREVIOUS rect, and the stamp that
    # overwrites it happens at the END of this function. The background goes in because a theme switch
    # damages every pixel without moving a window (see rend_band_compute).
    # ⚠ BEFORE `rend_frame_damage`, which reads the wallpaper serial to decide whether it may band.
    # A theme switch has to be visible to that check on the SAME frame it happens.
    wp_track_theme(bg);
    rend_frame_damage(comp, fb, bg);
    # ⭐⭐ `AE-0a`: CLEAR THE BAND, NOT THE SCREEN. This was the single biggest cost in the frame —
    # measured 3.83 ms of a 6.40 ms GPU frame, **60%**, at 2560x1440. It is already an optimal scalar
    # store loop at 1.03 ns/px, so the only thing left to remove was the pixel COUNT.
    # ⚠ `rend_clear_band` walks the band as ONE flat run, because a full-width band is contiguous when
    # the pitch is unpadded — going through `fill_rect` instead cost 23% more per pixel in pure per-row
    # overhead (measured: 1.347 vs 1.093 ns/px at 2560x1440).
    # ⛔ NO BAND MEANS THE WHOLE SCREEN, and that fallback is load-bearing rather than defensive: it is
    # what runs when the trackers were never allocated (every unit test), and on the frame after a theme
    # switch. A band of height 0 is different and correct — nothing changed in two frames.
    # ⭐ M6-C1a: THE BACKDROP IS A SOURCE NOW. These two calls used to be `rend_clear_band(..., bg)` and
    # `bhumi_fb_clear(fb, bg)` — one colour, no layer, nowhere for a gradient or a shader to exist.
    # ⚠ A wallpaper REPLACES the clear rather than adding to it, so the `AE-0a` band still governs how
    # many pixels are touched and the default (SOLID) takes the identical code path it always did.
    var fbh = bhumi_fb_height(fb);
    if (rend_band_valid() == 1) {
        if (rend_band_h() > 0) { wp_fill_band(fb, rend_band_y(), rend_band_h(), fbh); }
    }
    if (rend_band_valid() == 0) { wp_fill_all(fb, bhumi_fb_width(fb), fbh); }
    var v = comp_windows(comp);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var focused = 0;
        if (i == comp_focused(comp)) { focused = 1; }
        var win = vec_get(v, i);
        # ⛔⛔ A MINIMIZED WINDOW IS NOT DRAWN — and until now it was. `comp_window_at` has always skipped
        # minimized windows for hit-testing, but nothing here skipped them for RENDERING, so pressing F6
        # left the window fully on screen (chrome, buttons, live client surface) while every click passed
        # straight THROUGH it into whatever was behind. A window you can see and cannot click is worse
        # than either state on its own: the desktop looks broken and the cause is invisible.
        # ⇒ Render and hit-test now agree. `win_stamp_prev` still runs below, so the damage model keeps
        # tracking it and the frame it vanishes on repaints the rect it vacated.
        if (win_state(win) != WinState.WS_MINIMIZED) {
            render_window(fb, win, focused);
        }
        # ⛔ STAMP THE PREV RECT LAST, after the window is drawn. Stamping at the top of the frame
        # would destroy the "was" before damage is computed from it, and every move would leave
        # its vacated region uncleared.
        win_stamp_prev(win);
        i = i + 1;
    }
    render_shell_panel(fb, desk_shell(d));
    # ⭐ THE CURSOR LAST — after every window and the shell panel, because a cursor that is not on top
    # of everything is not a cursor.
    render_cursor(fb);
    return 0;
}
