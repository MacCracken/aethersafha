# aethersafha — AI-augmented AGNOS compositor (Cyrius port)
# Ported from 27207 lines of Rust (parity oracle frozen at rust-old/).
#
# Sits directly on the bhumi platform backend (output/input/seat vs the agnos
# kernel) — the sovereign replacement for DRM/KMS + libinput + logind. Native
# sovereign protocol dispatch stays in aethersafha proper; foreign-app surfaces
# (was XWayland) move to the mehman swallow backend, post-MVP.
#
# Stdlib + [deps.*] (bhumi/mehman/agnostik/agnodrm) auto-prepended via cyrius.cyml.

include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme.cyr"          # sovereign desktop theme tokens (MUDRA / SHANTA) — before render
include "src/cursor.cyr"      # pointer bitmap: shape + clipping + 1bpp packing (pure) — before render
include "src/render.cyr"
include "src/gpu.cyr"           # hardware compositing on agnos (#87 + #84) — after render.cyr for TITLEBAR_H
include "src/input.cyr"
# Leaf subsystems + the desktop aggregate that wires them into the compositor.
include "src/theme_bridge.cyr"
include "src/gestures.cyr"
include "src/accessibility.cyr"
include "src/ai_features.cyr"
include "src/shell.cyr"
include "src/shell_render.cyr"   # shell status-panel renderer (shell → render bridge)
include "src/security_ui.cyr"
include "src/shell_integration.cyr"
include "src/plugin_host.cyr"
include "src/desktop.cyr"
include "src/foreign.cyr"
include "src/setu_server.cyr"    # native display-protocol transport (setu)
include "src/setu_dispatch.cyr"  # setu → compositor dispatch (surface → Window + blit)
include "src/selftest.cyr"       # `--selftest`: the iron verdict (exit code, external-invariant oracle)

# ⭐ `--clients`: a BOUNDED, SELF-REPORTING run of the real desktop, for the one question a photo
# cannot answer — did the setu clients actually arrive?
#
# ⛔ THE 2026-08-02 BURN COULD NOT BE READ. The log said "launched setu client #1" and "#2 (crab)"
# and then nothing, and the operator quit at frame 128 because no window had appeared. That is
# consistent with TWO opposite states — the clients died on load, or they were still connecting and
# the run ended too early — and the desktop's normal output cannot distinguish them. Asking the
# operator to hold a desktop open for an unspecified duration and judge by eye is not an experiment.
#
# So this runs the SAME loop, stops on its own at a generous cap or as soon as both clients have
# presented, and exits with a code in the gpucopy convention. No photo, no timing judgement.
var ae_probe = 0;
# Quit keys seen while probing. ⛔ A DIAGNOSTIC A KEYPRESS CAN TRUNCATE IS NOT A DIAGNOSTIC: the
# 2026-08-02 --clients run reported 93 after stopping at frame 191 on an Esc, nowhere near its cap,
# so the verdict meant "nothing yet" and was documented as "nothing ever". Probe runs now ignore the
# quit key and say how many they ignored.
var ae_quit_ignored = 0;
var ae_probe_t0 = 0;
var ae_probe_next_report = 0;
# 1 = at least one spawn_path refused, so a "no client connected" verdict has a known cause.
var ae_spawn_failed = 0;
# ⭐ THE INPUT LADDER — first-occurrence latches, one per rung. Kept PERMANENTLY, because the input path
# has been mysterious twice: once when TAB had no handler at all, and once when keystrokes vanished before
# reaching a client and there was no way to tell WHERE without rebuilding. Each rung prints ONCE, as a
# distinct string rather than a number, because three procs share this console unserialised and a bare int
# lands mid-line in another proc's output. ⛔ Absence of a line is now a signal: the LAST rung printed
# names the layer that failed. [[feedback_instrument_discipline]]
var ae_inp_poll = 0;
var ae_inp_denied = 0;
var ae_inp_down = 0;
var ae_inp_tab = 0;
var ae_inp_fwd = 0;
var ae_inp_nofwd = 0;   # BITMASK of focus indices already reported — NOT a boot-scoped latch (see the site)
var ae_inp_move = 0;
# ⛔⛔ THE DRAG'S OWN RUNGS, because a subject whose only oracle is a REMEMBERED GESTURE goes unmeasured.
# The press-hold-RELEASE transition is what `input_btn_transitions` was written for — the burn blocker of
# this whole cut — and it left NO trace in the serial, so two consecutive iron burns could not say whether
# it worked. Both times the operator simply did not perform the motion, and nothing in the log noticed.
# ⇒ Latch both ends. `drag started` proves the press+titlebar path; `drag released after N frames` proves
# the transition that could not previously happen. ⚠ The FRAME COUNT is the payload: a release at frame
# N+1 is a click, a release hundreds of frames later is a real drag, and a `drag started` with NO release
# line is precisely the glued-window failure — an absence that now MEANS something.
var ae_drag_started = 0;
var ae_drag_released = 0;
var ae_drag_frame = 0;
# ⭐ How many key usages have been named in the log so far. NOT a latch like the rungs above — a
# bounded COUNTER, because the question it answers ("which usages actually arrived?") needs the
# identity of several keys, not the fact that one arrived. Bound and rationale at the print site.
# ⚠ The 2026-08-08 burn is the reason this exists: it could not distinguish a key that was never
# pressed from one that arrived and was dropped, so the burn was unrepeatable-into-an-answer.
var ae_inp_traced = 0;
# ⚠ `AE_MOVE_STEP` USED TO BE DECLARED HERE and is now in src/input.cyr, which owns the mover. It has
# to be: this file's globals are declared AFTER its `include "src/input.cyr"` line, and Cyrius does
# not resolve forward references to VARIABLES (only to functions). A step declared here was therefore
# unreadable from input.cyr — and the only code that did read it was the mover that turned out to be
# unreachable, so nothing ever failed to compile. [[feedback_cyrius_var_array_u64_units]] is the
# sibling trap: in Cyrius, WHERE a declaration sits changes what it means.
enum AeProbe {
    # ⛔ THE BUDGET IS WALL TIME, NOT FRAMES, and the first version got this wrong. What a spawned
    # client needs in order to load from ext2, start, and complete a loopback TCP connect is SECONDS
    # and scheduler slices — neither of which a frame count measures.
    # ⚠ The "loopback TCP connect" leg is retired on agnos (2026-08-03, architectural — see the
    # setu listener banner below); the WALL-TIME-not-frames reasoning is transport-independent and
    # holds unchanged for a anu connect, which still costs an ext2 load and scheduler slices. Frame duration differs by more
    # than an order of magnitude between QEMU and iron, so any frame cap is either far too short on
    # one or far too long on the other.
    AE_PROBE_MS     = 30000;
    # Pure backstop, deliberately far above anything the time budget will reach, so it binds ONLY if
    # the clock is broken. A frame cap that can bind before the timer is the bug above, restated.
    AE_PROBE_FRAMES = 200000;
    AE_PROBE_REPORT_MS = 5000;   # progress cadence, so the log shows the run stayed alive
}

# Monotonic milliseconds, or 0 where there is no such clock (host). ⚠ Returning 0 makes the elapsed
# test inert off agnos rather than wrong — the host loop is already bounded by setu_cap.
fn ae_now_ms(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_uptime_ms();
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

enum AeConfig {
    # ⚠ FALLBACK ONLY — these are what the compositor opens at when it cannot ASK. See
    # ae_query_w/ae_query_h. They are not the desktop size and must never be used as one.
    AE_FALLBACK_W = 1280;
    AE_FALLBACK_H = 720;
    AE_MAXEV      = 64;
}

# ⭐ ASK THE KERNEL HOW BIG THE SCREEN IS. Do not assume.
#
# ⛔ THE COMPOSITOR USED TO HARDCODE 1280x720 AND OPEN bhumi AT THAT SIZE. archaemenid's scanout
# surface is 800x600 (pitch 832 px) — the firmware leaves an 800x600 surface DCN-scaled up to the
# 2560x1440 link, and agnos reads the real viewport out of the live HUBP register at boot and
# prints it in every burn: "console geometry matched to surface 800x600 pitch 3328 bytes".
#
# ⚠ THE FAILURE IS SILENT, WHICH IS WHY IT SURVIVED. `#39 blit` CLIPS to fb_width/fb_height rather
# than erroring, so a 1280x720 desktop presented onto an 800x600 surface simply shows its top-left
# corner. Nothing logs, nothing returns non-zero. The shell status panel — which correctly places
# its indicators at `fb_width - pad - w` — put every one of them past x=1234, entirely outside the
# visible 800 columns. The panel code was right; it was handed a lie.
#
# ⚠ USE fbinfo's WIDTH FOR LAYOUT, NEVER gpu_caps#89's. caps reports `bw = gpu_bb_pitch / 4`, and
# on this box the pitch in pixels (832) EXCEEDS the visible width (800). Laying out to caps would
# push chrome into the invisible gutter — the same class of mistake one register removed.
#
# ⚠ Returns the fallback on any host build (bhumi_output_query is agnos-only and answers -1), so
# the Linux dev build is unaffected.
var ae_geom_w = 0;
var ae_geom_h = 0;
# 1 = the numbers above came from the kernel; 0 = they are AE_FALLBACK_*. See the print in main.
var ae_geom_asked = 0;
fn ae_query_geometry(): i64 {
    ae_geom_w = AE_FALLBACK_W;
    ae_geom_h = AE_FALLBACK_H;
    ae_geom_asked = 0;
    var info[24];                       # function-local => 24 BYTES == BHUMI_FBINFO_SIZE
    # ⛔ THIS USED TO READ `!= BHUMI_FBINFO_SIZE` AND THEREFORE FELL BACK ON EVERY REAL BOOT.
    # agnos `#38 fbinfo` fills the struct and returns **0** (the band's 0-ok convention); bhumi passed
    # that 0 through while documenting "returns 24". So `0 != 24` sent every agnos run to the
    # hardcoded 1280x720 — on a panel whose scanout is 800x600. The 2026-08-02 archaemenid burn
    # printed `gpu: console geometry matched to surface 800x600` and then, four lines later, the
    # compositor printing `1280 / 720`. Fixed at the source in bhumi 1.1.3.
    # ⚠ NOW CONVENTION-INDEPENDENT ON PURPOSE. Any non-negative return is treated as "the kernel
    # answered", and the ANSWER is then validated on its contents — the present bit plus sane
    # dimensions. A geometry probe should not be able to break again because a return code changed
    # shape one repo away; the struct either describes a usable surface or it does not.
    var rc = bhumi_output_query(&info);
    if (rc < 0) { return 0; }
    # flags bit0 — the kernel's own answer to "is there a framebuffer at all".
    if (bhumi_fbinfo_present(&info) == 0) { return 0; }
    var w = bhumi_fbinfo_width(&info);
    var h = bhumi_fbinfo_height(&info);
    # ⚠ A zero or absurd answer is worse than no answer: it would open a framebuffer nothing can
    # be drawn into. Keep the fallback rather than trust a degenerate reading.
    if (w < 64) { return 0; }
    if (h < 64) { return 0; }
    ae_geom_w = w;
    ae_geom_h = h;
    ae_geom_asked = 1;
    ae_centre_pointer();
    return 1;
}

# ⛔ THE POINTER MUST START SOMEWHERE DELIBERATE, AND (0,0) IS THE WORST AVAILABLE CHOICE.
# `input_ptr_set` existed with ZERO production call sites — an audit found it — so `ae_ptr_x`/`ae_ptr_y`
# kept their .bss zeros and the pointer booted at the top-left pixel. That is exactly where the shell
# status panel is drawn, so the very first composited frame puts a 10x20 arrow on top of the panel, and it
# stays there until the user happens to move the mouse. It also makes "the cursor never appeared" and "the
# cursor is parked under the panel" look identical on a burn photo.
# ⚠ Called from `ae_query_geometry` only after the geometry is KNOWN — centring against the 1280x720
# fallback and then learning the real 2560x1440 would park it off-centre with no second chance.
fn ae_centre_pointer(): i64 {
    input_ptr_set(ae_geom_w / 2, ae_geom_h / 2);
    return 0;
}

# ================================================================
# `AE-7` — POINTER HANDLING
# ================================================================
#
# ⭐ THIS IS MOSTLY WIRING, WHICH IS THE POINT. `comp_window_at` (z-ordered, skips minimized), the
# 9-region `deco_hit`, and `input_move`'s GPU-safe clamp were all written long ago and never called —
# they were waiting for a pointer. The setu protocol likewise already carries `SETU_INPUT_PTR_MOVE`
# (kind 9) and `SETU_INPUT_PTR_BTN` (kind 10). Nothing here is a new mechanism.
var ae_ptr_btn = 0;        # last button bitmap, for edge detection
var ae_ptr_fwd_x = 0 - 1;  # last surface-relative position forwarded (dedupe; -1 = none yet)
var ae_ptr_fwd_y = 0 - 1;
var ae_ptr_drag = 0;       # 1 = dragging a window by its titlebar
# ⛔⛔ THE WINDOW **ID**, NEVER A RAW Window POINTER. A drag outlives the thing it drags: F4, a
# close-button click, or the client simply exiting all run `comp_close_window`, which unlinks the Window
# from the compositor's vector — and a stored pointer then addresses an object that is no longer in the
# scene. Every later motion would call `input_move` on it, writing geometry nobody composites and, once
# the allocator reuses that memory, writing into whatever now lives there. An id is re-resolved against
# the live vector each motion, so a closed window ENDS the drag instead of continuing it invisibly.
var ae_ptr_drag_id = 0;    # window id being dragged (0 = none)
var ae_ptr_first = 0;      # one-shot marker latch
var ae_ptr_click = 0;      # one-shot marker latch

# Forward a pointer event to the window under the cursor, using the setu messages that already exist.
# ⚠ Coordinates are sent SURFACE-RELATIVE: a client knows nothing about where the compositor placed it,
# so screen coordinates would make every client's hit-testing wrong by its own window origin.
fn ae_ptr_forward(comp, kind_is_btn, btn, pressed): i64 {
    var win = comp_window_at(comp, input_ptr_x(), input_ptr_y());
    if (win == 0) { return 0; }
    var cfd = win_cfd(win);
    if (cfd == 0) { return 0; }                 # a compositor-seeded window has no client
    var rx = input_ptr_x() - win_x(win);
    var ry = input_ptr_y() - win_body_y(win);   # relative to the CONTENT rect, not the chrome
    # ⛔⛔ CHROME IS NOT THE CLIENT'S SURFACE. `comp_window_at` hit-tests from `win_y` so the TITLEBAR is
    # inside the window (it has to be — that is what makes a drag possible), but coordinates handed to a
    # client are CONTENT-relative. A pointer anywhere on the titlebar therefore produced `ry` in [-30, -1]
    # and sent it down the wire: a client indexing a row array by `ry / row_h` reads BEFORE its buffer.
    # setu carries these as full i64 so nothing corrupts them — the number arrives intact and wrong.
    # ⇒ A position outside the content rect is not this client's event. Drop it: chrome interaction is the
    # compositor's (drag, close), and forwarding it as well was double-handling the same press.
    if (ry < 0) { return 0; }
    if (rx < 0) { return 0; }
    if (rx >= win_w(win)) { return 0; }
    if (ry >= win_h(win)) { return 0; }
    # ⚠ MOTION IS DEDUPED. Every frame the pointer is over a client cost a `#97` ring slot even when the
    # surface-relative position had not changed, and that ring drops the OLDEST record when it fills — so a
    # stationary pointer could push a client's real events out. No shipped client decodes PTR_MOVE yet, so
    # this is pure cost today; a proper per-surface opt-in flag is the real fix and needs a protocol bit.
    if (kind_is_btn == 0) {
        if (rx == ae_ptr_fwd_x) {
            if (ry == ae_ptr_fwd_y) { return 0; }
        }
        ae_ptr_fwd_x = rx;
        ae_ptr_fwd_y = ry;
        setu_send(cfd, setu_input_ptr_move(win_id(win), rx, ry));
    }
    if (kind_is_btn == 1) { setu_send(cfd, setu_input_ptr_btn(win_id(win), btn, pressed)); }
    return 1;
}

# ae_pointer_event(comp, ev, frame): handle one MOTION or BUTTON event from the bhumi batch.
# ⚠ `frame` is passed, not read from a global: the frame counter is a LOCAL of the frame loop, and Cyrius
# would not resolve a forward reference to it from here even if it were module-scope and declared below.
# ⚠ Only ever called for events whose kind is NOT key — the frame loop routes on `bhumi_ev_is_key`.
fn ae_pointer_event(comp, ev, frame): i64 {
    var k = bhumi_ev_kind(ev);

    if (k == BhumiEvKind.BHUMI_EV_MOTION) {
        var dx = bhumi_motion_dx(ev);
        var dy = bhumi_motion_dy(ev);
        # ⭐⭐ THE FULL SCREEN, because the cursor CLIPS now. This used to be reduced by the glyph extent
        # (`ae_geom_w - FONT_ADV + 1`) so the cursor's rect could never leave the buffer and be refused by
        # `#92` op 0x03 — correct at the time, but it meant the pointer stopped short of the right and
        # bottom edges and the last columns of the screen were unreachable. A 20 px arrow would make that
        # the whole bottom-right corner, including anything you might want to click there.
        # ⇒ `cursor_visible_rect` computes the on-surface sub-rectangle and only that is sent, so the
        # hotspot is free to sit on the final pixel while the arrow simply runs off the edge — which is
        # what every real cursor does. `input_ptr_move` clamps a POINT to `bound - 1`, so passing the raw
        # geometry lands the hotspot on the last addressable pixel exactly.
        input_ptr_move(dx, dy, ae_geom_w, ae_geom_h);
        if (ae_ptr_first == 0) {
            ae_ptr_first = 1;
            println("aethersafha: pointer motion received -- the cursor is live");
        }
        # ⭐ A DRAG IS A MOVE BY A DELTA, so it reuses the mover F7-F10 already proved on iron —
        # including its clamp, which is what keeps a dragged window from crossing an edge and dropping
        # the whole frame off the GPU (`#88`/`#87` REJECT an out-of-range rect rather than clipping).
        if (ae_ptr_drag == 1) {
            # Re-resolve by id: if it is gone, the drag is over.
            var didx = comp_find_by_id(comp, ae_ptr_drag_id);
            if (didx < 0) {
                ae_ptr_drag = 0;
                ae_ptr_drag_id = 0;
            }
            if (didx >= 0) {
                var dwin = comp_get(comp, didx);
                if (dwin != 0) {
                    input_move(dwin, dx, dy, ae_geom_w, ae_geom_h - TITLEBAR_H);
                }
            }
        }
        ae_ptr_forward(comp, 0, 0, 0);
        return 0;
    }

    if (k == BhumiEvKind.BHUMI_EV_BUTTON) {
        var cur = bhumi_button_state(ev);
        # ⚠ `buttons_seen` OR-folds a click that began AND ended inside one frame. Without this a fast
        # click is invisible: the level is back to 0 by the time the compositor looks.
        var seen = bhumi_button_seen(ev);
        # ⛔ NOT an edge on `cur | seen` — that makes the RELEASE unreachable, because the kernel re-seeds
        # `seen` to the held level on every drain. See `input_btn_transitions`.
        var tr = input_btn_transitions(ae_ptr_btn, cur, seen, 1);   # left button only, for now
        var closed = 0;
        if (input_btn_pressed(tr) == 1) {
            var win = comp_window_at(comp, input_ptr_x(), input_ptr_y());
            if (win != 0) {
                # CLICK TO FOCUS — the first consumer `comp_window_at` has ever had.
                var idx = comp_find_by_id(comp, win_id(win));
                if (idx >= 0) { comp_focus(comp, idx); }
                var hit = deco_hit(win, input_ptr_x(), input_ptr_y());
                # ⛔ A CLOSE CONSUMES THE CLICK. Without `closed`, the forward below re-derives
                # `comp_window_at` at the SAME cursor position — the window it found is gone, so it now
                # finds whatever was underneath and sends THAT client a button press at a coordinate the
                # user never clicked in it. A click that destroys a window must not also be delivered.
                if (hit == Deco.DECO_CLOSE) {
                    comp_close_window(comp, win_id(win));
                    closed = 1;
                }
                # ⭐ THE MAXIMIZE AND MINIMIZE BUTTONS DO SOMETHING NOW. `deco_hit` has returned nine
                # regions since it was written and this handler consumed exactly two of them, so both
                # buttons were PAINTED on every titlebar in their own theme colours — they looked live and
                # were inert. Worse than absent: a control that ignores you reads as a broken desktop.
                # ⚠ The actions already existed (F5/F6 drive them); this is wiring, not new behaviour, and
                # it routes through `input_apply` so click and key take the identical path.
                if (hit == Deco.DECO_MAX) { input_apply(comp, InputAction.IA_MAXIMIZE_FOCUSED, ae_geom_w, ae_geom_h - TITLEBAR_H); closed = 1; }
                if (hit == Deco.DECO_MIN) { input_apply(comp, InputAction.IA_MINIMIZE_FOCUSED, ae_geom_w, ae_geom_h - TITLEBAR_H); closed = 1; }
                if (hit == Deco.DECO_TITLEBAR) {
                    ae_ptr_drag = 1;
                    ae_ptr_drag_id = win_id(win);
                    ae_drag_frame = frame;
                    if (ae_drag_started == 0) {
                        ae_drag_started = 1;
                        println("aethersafha: drag started -- a titlebar press was caught");
                    }
                }
            }
            if (ae_ptr_click == 0) {
                ae_ptr_click = 1;
                println("aethersafha: pointer button click routed");
            }
            if (closed == 0) { ae_ptr_forward(comp, 1, 1, 1); }
        }
        if (input_btn_released(tr) == 1) {
            # ⭐ THE LINE THE BURN BLOCKER NEEDED. Before `input_btn_transitions` this branch was
            # UNREACHABLE: the kernel re-seeds `seen` to the held level, so an edge on `cur | seen` never
            # saw the button come up and a titlebar drag never ended. Printing here makes the fix
            # self-evidencing on any boot, and makes its absence-after-`drag started` the failure signal.
            if (ae_ptr_drag == 1) {
                if (ae_drag_released == 0) {
                    ae_drag_released = 1;
                    println("aethersafha: drag released -- the window stopped, frames held:");
                    println_int(frame - ae_drag_frame);
                }
            }
            ae_ptr_drag = 0;
            ae_ptr_drag_id = 0;
            # ⛔ `closed` GUARDS THIS TOO — an earlier cut guarded only the press. `ae_ptr_forward`
            # re-derives `comp_window_at` at the same cursor position, so after a close-button click the
            # window it finds is the one UNDERNEATH, and that client receives a button RELEASE it never
            # got a press for. Half a guard is not a guard.
            if (closed == 0) { ae_ptr_forward(comp, 1, 1, 0); }
        }
        # ⚠ THE BELIEF, not the device level. A folded click (press and release inside one frame) emits
        # both transitions above and must end BELIEVED-UP, or the next press is swallowed.
        ae_ptr_btn = 0;
        if (input_btn_pressed(tr) == 1) { if (input_btn_released(tr) == 0) { ae_ptr_btn = 1; } }
        if (input_btn_pressed(tr) == 0) { if (input_btn_released(tr) == 0) { ae_ptr_btn = (cur & 1); } }
        return 0;
    }
    return 0;
}

# Open the bhumi backend under a full output+input+pointer capability. -> *BhumiBackend (0 fail)
#
# ⭐ `BHUMI_DEV_POINTER` IS THE OPT-IN, and asking for it here is what turns pointer events on. bhumi
# gates the pointer drain on this bit precisely so a consumer that has NOT asked cannot be handed an
# event it would misread: `bhumi_key_usage` is the LOW BYTE of dx and `bhumi_key_pressed` is BIT 8 of
# dx, so a horizontal motion of 297 px (0x129 — bit 8 set, low byte 0x29) reads as Escape, which this
# compositor maps to QUIT. Every capability in the tree was OUTPUT|INPUT until now.
# ⇒ Adding this bit is a commitment that every consumer of the event batch checks `bhumi_ev_kind` FIRST.
fn ae_backend_open(w, h): i64 {
    var cap = bhumi_cap_new(1, BHUMI_DEV_OUTPUT | BHUMI_DEV_INPUT | BHUMI_DEV_POINTER, 0, 0);
    if (cap == 0) { return 0; }
    return bhumi_backend_open(cap, w, h);
}

# 1 if any argument equals `flag`. Scans from 1: argv(0) is the program path, and on agnos that is
# what `run /bin/aethersafha` puts there.
fn ae_has_flag(flag): i64 {
    var n = argc();
    var i = 1;
    while (i < n) {
        if (streq(argv(i), flag) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    kashi_font_init();   # populate the VGA 8x16 glyph tables (kashi font-data core)
    # ⛔ `argc()`/`argv()` RETURN 0/NULL UNTIL THIS RUNS. They are not ambient: on the host
    # `args_init` reads /proc/self/cmdline into a buffer, and on agnos it walks the captured init
    # rsp — with neither done, `_args_base` is 0 and `argc()` answers 0 forever. The failure is
    # silent and total: the first `--selftest` build launched the DESKTOP instead, exit 0, looking
    # for all the world like the flag was unrecognised. Every staged agnos tool (klug, kriya, owl,
    # bnrmr) opens `main` with this call for exactly this reason. ⚠ It allocates, so it must follow
    # `alloc_init`.
    args_init();

    # ⭐ DISPATCHED BEFORE THE BANNER AND BEFORE THE FRAME LOOP. --selftest is not a mode of the
    # desktop; it is a different program that happens to share the desktop's code, and it must be
    # able to return a verdict without a compositor loop that never exits standing in its way.
    # ⚠ Reading argv here is only safe because this file now enters through a BARE top-level
    # `_ae_entry()` — see the note at the bottom. Under the old implicit entry the arguments would
    # have read null and `--selftest` would have silently launched the desktop instead.
    if (ae_has_flag("--selftest") == 1) { return ae_selftest(); }
    if (ae_has_flag("--clients") == 1) { ae_probe = 1; }

    println("aethersafha: AI-augmented AGNOS compositor (Cyrius port)");

    ae_query_geometry();
    var be = ae_backend_open(ae_geom_w, ae_geom_h);
    if (be == 0) {
        println("aethersafha: bhumi backend open failed");
        return 1;
    }
    var fb = bhumi_backend_fb(be);
    # Probe hardware compositing ONCE, here, before the frame loop — never from a render path (a renderer
    # must not be the thing that issues a syscall). ae_gpu_frame_plan then reads the result each frame.
    ae_gpu_probe();
    # The per-frame damage tracker. ⚠ ALLOCATED HERE OR NOT AT ALL: rend_dmg_new was previously
    # reached only from a test, so ae_frame_dmg stayed 0 and every damage computation in the frame
    # path was a no-op guarded by `if (ae_frame_dmg != 0)`. Damage is COMPUTED now; it deliberately
    # does not drive the blit — see CHANGELOG [Unreleased] "the damage tracker is allocated and
    # computed, and deliberately NOT wired to the blit", and the #84 buffer-flip note in gpu.cyr.
    ae_frame_dmg = rend_dmg_new();
    println("aethersafha: bhumi backend up");
    # ⭐ SAY WHERE THE GEOMETRY CAME FROM, NOT JUST WHAT IT IS.
    # ⛔ This used to print two bare integers. On the 2026-08-02 burn they read `1280` / `720`, which
    # is a perfectly plausible desktop size — nothing about it said "I asked the kernel and threw the
    # answer away". Four lines earlier the kernel had printed the real 800x600. A number alone cannot
    # distinguish a measurement from a default, and that is the entire difference here.
    if (ae_geom_asked == 1) {
        println("aethersafha: screen size read from the kernel");
    }
    if (ae_geom_asked == 0) {
        println("aethersafha: the kernel did not report a screen, using the built-in default");
    }
    println_int(ae_geom_w);
    println_int(ae_geom_h);

    # Desktop session: the compositor + all leaf subsystems (shell, AI, security,
    # a11y, gestures, theme, tray, plugins) wired together.
    var desk = desktop_new();
    var comp = desk_comp(desk);
    # ⛔⛔ THE "Files" DEMO WINDOW IS GONE (2026-08-09, operator call). It was a compositor-SEEDED
    # placeholder from before there were real clients — an empty rect with chrome and no process behind it
    # — and every real client now arrives over setu. Keeping it past that point was not neutral:
    #   · It had **no client fd**, so it silently swallowed every key focused onto it. That produced the
    #     "puka didn't register key commands" report, cost a burn to diagnose, and then needed a latched
    #     `a key reached NO client` line to explain — an instrument that only existed to describe a window
    #     that should not have been there.
    #   · It sat at index 0 in the TAB cycle, so ONE tab from the last-presented client wrapped onto it.
    #     Both the previous cards had to carry a "keep TABbing" warning for that.
    #   · It made every window count off by one, so `desktop up — windows: 1` before any client connected
    #     read as "something is up" when nothing was.
    # ⇒ The desktop now starts EMPTY and every window on screen belongs to a real process.
    desktop_add_tray_item(desk, 1, "network", "Network");
    # Host a foreign-ABI app as a kavach-sandboxed guest (mehman "swallow" seam),
    # run it, and present its captured stdout as the window's content (M2 handoff).
    # Linux-only: the kavach sandbox forks (sys_fork), which agnos lacks by design
    # — the swallow lane is a compat feature, not the sovereign compositor's job.
    #ifndef CYRIUS_TARGET_AGNOS
    var greeter = desktop_host_foreign(desk, "/bin/echo aethersafha guest", 320, 200, 480, 300, "echo (foreign)");
    if (greeter != 0) {
        println("aethersafha: foreign guest ran (0=OK):");
        println_int(foreign_run(greeter));
    }
    #endif
    var axn = desktop_sync_accessibility(desk);
    println("aethersafha: desktop up — windows:");
    println_int(comp_count(comp));
    println("aethersafha: a11y nodes synced:");
    println_int(axn);

    # ⛔ RETIRED ON agnos (2026-08-03) — TCP-on-loopback is the WRONG PRIMITIVE for local
    # display IPC on the sovereign kernel. Operator ruling; retired on ARCHITECTURAL grounds,
    # not because it failed to work. The replacement is the agnos socket `anu` — agnos
    # docs/development/planning/ipc.md §9 (decision) and §10 (revert inventory). The code below
    # stands until the anu seam lands; treat it as a path being replaced, not a design to copy.
    # ⚠ setu's LINUX arm is NOT retired. Linux is a separate target, not a fallback — BSD
    # sockets under `#ifndef CYRIUS_TARGET_AGNOS` remain the supported host transport.
    #
    # Native display protocol. ⭐ TCP IS GONE FROM BOTH TARGETS: agnos places clients on an endowed
    # `#97` channel end, and the Linux host now listens on **AF_UNIX / SOCK_SEQPACKET** — a local,
    # connected, RECORD transport with the same semantics as the band, and with filesystem permissions
    # as the access control loopback:7700 never had.
    var setu_path = "/tmp/aethersafha-setu.sock";   # AF_UNIX rendezvous (Linux); unused on agnos
    var setu_sfd = 0 - 1;
    # ⭐⭐ BITE 7: ON agnos THE COMPOSITOR NO LONGER LISTENS. There is no socket, no port, no accept.
    # A listener is a NAMESPACE, and a namespace is the thing the channel band deletes: `tcp_listen`
    # gates only on duplicate-bind, so whoever bound 7700 first owned the display protocol AND every
    # keystroke on it. Minting a channel per client and endowing it at spawn means a client cannot be
    # impersonated by whoever gets there first, because there is nothing to get to.
    # ⛔ REMOVED, NOT BYPASSED (ipc.md §9.6). The Linux arm keeps its listener because Linux is a
    # different target, not a fallback.
    #ifndef CYRIUS_TARGET_AGNOS
    setu_sfd = setu_srv_listen(setu_path);
    if (setu_sfd >= 0) {
        println("aethersafha: setu listener up (AF_UNIX SOCK_SEQPACKET)");
    }
    #endif
    # ⛔ A FAILED LISTEN USED TO PRINT NOTHING AT ALL, and that cost a burn's second run. The
    # compositor came up, drew its desktop, reported "windows: 1", and looked completely healthy
    # while being STRUCTURALLY INCAPABLE of hosting a client — there was no socket to accept on.
    # The absence of one line is not a signal anyone reads; the desktop simply looked like it had
    # no clients, which is also what a working listener with slow clients looks like.
    #ifndef CYRIUS_TARGET_AGNOS
    if (setu_sfd < 0) {
        println("aethersafha: the display socket could not be opened — no app can connect this run");
        println_int(setu_sfd);
    }
    #endif
    var setu_cap = 3;
    #ifndef CYRIUS_TARGET_AGNOS
    if (setu_sfd >= 0) { setu_cap = 400; }           # host: spin (render-paced) long enough to catch a client
    #endif

    # First resident: on agnos the compositor LAUNCHES its first setu client — the
    # on-device analog of the Linux puka_launch_probe. agnos has no fork; spawn_path
    # #43 loads /bin/puka from ext2 and returns immediately (a pid), and the client
    # connects back over setu loopback:7700 (composited in the frame loop below).
    # ⛔ The loopback:7700 leg of this connect-back is RETIRED on agnos (architectural — see the
    # listener banner above); the launch-then-connect-back SHAPE survives onto anu unchanged.
    # /bin/puka is the first-resident slot; the agnos smoke seeds a slim setu client
    # there until full puka builds --agnos (blocked on mabda's Linux SYS_IOCTL).
    # ⭐⭐ BITE 7 — MINT, ENDOW, SPAWN PLACED. Each client gets a channel minted for it, one end
    # endowed so the child is BORN holding it, and `AGNOS_CHAN=<fd>` in its environment so it knows
    # which fd that is. The compositor keeps the other end. No dial, no accept, no race for a port.
    #
    # ⛔ ENDOWMENT IS A MOVE: once placed, the compositor's OWN claim on the endowed end goes inert, so
    # it must keep the PEER end (`mint[1]`) and endow `mint[0]`. Getting that backwards hands the
    # client the end the compositor needs and leaves both sides mute.
    # ⛔ ORDER MATTERS: endow immediately before the spawn it is for. The arm is per-CPU and one-shot,
    # so minting both channels first and then spawning both would place the SECOND endowment into the
    # FIRST child and leave the second with nothing.
    # ⛔ FUNCTION-LOCAL `var X[N]` IS N **BYTES** IN CYRIUS, not N u64s — module-scope is the 8N form.
    # These were [4] and indexed with `+ pi * 8`, so client 0 filled the whole 4-byte allocation and
    # client 1's store ran straight off the end into the adjacent locals. That is exactly why ONE
    # client presented and TWO presented nothing: the second spawn corrupted the first's state.
    # 4 slots x 8 bytes = 32. [[feedback_cyrius_var_array_u64_units]]
    var chan_fd[32];       # compositor-side ends, one per spawned client
    var chan_served[32];   # 1 once that client's surface has been committed
    var chan_st[32];       # per-client handshake scratch (see setu_srv_handshake_step)
    var chan_fail[32];     # consecutive handshake failures per client
    # ⭐ THE APPLICATION NAME, captured where it is already known. The compositor spawns these clients by
    # path, so it knows what each channel will carry before the client says a word — no protocol change and
    # no guessing. 4 slots x 8 bytes = 32, same sizing rule as the arrays above.
    var chan_name[32];     # window title for the client on this channel
    var chan_n = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    var envbuf = alloc(64);
    var ci = 0;
    while (ci < 2) {
        var mint = alloc(32);
        if (sys_chan_mint(mint) != 0) { println("aethersafha: chan_mint FAILED — this client cannot be hosted"); ae_spawn_failed = 1; ci = ci + 1; }
        else {
            var mine = load64(mint + 8);                  # the compositor keeps the PEER end
            var give = load64(mint);                      # the child is endowed this one
            var afd = sys_chan_endow(give);
            if (afd < 3) { println("aethersafha: chan_endow FAILED — spawning without a channel would be pointless"); ae_spawn_failed = 1; }
            else {
                # "AGNOS_CHAN=<fd>\0" — the announcement. Wayland's WAYLAND_SOCKET shape.
                var w = 0;
                var lit = "AGNOS_CHAN=";
                while (w < 11) { store8(envbuf + w, load8(lit + w)); w = w + 1; }
                if (afd >= 10) { store8(envbuf + w, 48 + (afd / 10)); w = w + 1; }
                store8(envbuf + w, 48 + (afd % 10)); w = w + 1;
                store8(envbuf + w, 0); w = w + 1;
                var pk = 0 - 1;
                var cname = "setu-surface";
                if (ci == 0) { pk = sys_spawn_path_env("/bin/puka", 9, envbuf, w); cname = "puka"; }
                if (ci == 1) { pk = sys_spawn_path_env("/bin/crab", 9, envbuf, w); cname = "crab"; }
                if (pk < 0) { println("aethersafha: spawn_path_env FAILED"); ae_spawn_failed = 1; }
                else {
                    store64(&chan_fd + chan_n * 8, mine);
                    store64(&chan_served + chan_n * 8, 0);
                    var stbuf = alloc(64);          # [0]=state [1]=win [2]=pix [3]=w [4]=h
                    var zi = 0;
                    while (zi < 8) { store64(stbuf + zi * 8, 0); zi = zi + 1; }
                    store64(&chan_st + chan_n * 8, stbuf);
                    store64(&chan_fail + chan_n * 8, 0);
                    store64(&chan_name + chan_n * 8, cname);
                    chan_n = chan_n + 1;
                    println("aethersafha: client spawned on a placed channel");
                    println_int(afd);
                }
            }
            ci = ci + 1;
        }
    }
    if (chan_n == 0) { println("aethersafha: NO client could be given a channel this run"); }
    #endif
    # ⛔ THE RETIRED TCP LAUNCH BLOCK IS DELETED (was `#ifdef CYRIUS_TARGET_AGNOS` + `if (0 == 1)`).
    # It was unreachable by construction AND it held the only two writers of `ae_spawn_failed`, so the
    # verdict ladder's exit 91 ("a client could not be spawned") could never fire while the LIVE spawn path
    # a few lines above set nothing. Keeping dead code that owns a live flag's only assignments is how a
    # verdict silently stops meaning anything. The live path now sets the flag; this block is gone.

    # Frame loop: poll bhumi input, dispatch, render, composite setu clients,
    # scan out. Bounded so the host build terminates; on agnos this becomes
    # `while (running == 1)`.
    var events[512];   # AE_MAXEV (64) * 8 bytes
    var now = 1;
    var frame = 0;
    var running = 1;
    var accepted = 0;  # count of setu clients composited so far — cascades each new one
    var prev_focus = 0 - 1;  # last-notified focus index; -1 forces the first notification
    ae_probe_t0 = ae_now_ms();
    ae_probe_next_report = AE_PROBE_REPORT_MS;
    #ifdef CYRIUS_TARGET_AGNOS
    while (running == 1) {                            # agnos: the real compositor loop — renders until quit
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        while ((running == 1) && (frame < setu_cap)) {    # host: bounded so the dev build terminates
            #endif
            var n = bhumi_backend_poll(be, &events, AE_MAXEV, now);
            if (n == BHUMI_SEAT_DENIED) {
                if (ae_inp_denied == 0) {
                    ae_inp_denied = 1;
                    println("aethersafha: input poll answered SEAT_DENIED");
                }
            }
            if (n > 0) {
                if (ae_inp_poll == 0) {
                    ae_inp_poll = 1;
                    println("aethersafha: input poll delivered its first event");
                }
            }
            if (n != BHUMI_SEAT_DENIED) {
                var i = 0;
                while (i < n) {
                    var ev = load64(&events + i * 8);
                    # ⛔⛔ CLASSIFY BEFORE READING. Since bhumi 1.1.4 this batch carries POINTER events
                    # alongside keys, and every key accessor below is `ev & 0xFF` — so an unrouted motion
                    # event is read as a usage. dx = 297 (0x129: bit 8 set, low byte 0x29) reads as a
                    # PRESSED Escape and quits the desktop. Routing once here keeps the six key call sites
                    # below exactly as they were, instead of six independent chances to forget.
                    if (bhumi_ev_is_key(ev) == 0) {
                        ae_pointer_event(comp, ev, frame);
                        i = i + 1;
                        continue;
                    }
                    if (bhumi_key_pressed(ev) == 1) {
                        if (ae_inp_down == 0) {
                            ae_inp_down = 1;
                            println("aethersafha: first key-down seen");
                        }
                    }
                    # ⭐ NAME THE KEY THAT QUIT, because on the 2026-08-02 burn the desktop
                    # rendered and then exited immediately and nothing said why. IA_QUIT has exactly
                    # one source (HID_ESC), so either an Esc really arrived or the Set-1 decode
                    # produced one — and those want opposite fixes. Printing the usage and the frame
                    # separates them on the next boot instead of costing a burn to guess.
                    # ⚠ kbscan#42 is a RAW drain: the compositor sees every scancode buffered since
                    # boot, including everything typed at the agnsh prompt to launch it.
                    # ⛔ CAPTURE THE ACTION. Throwing it away and only testing it for IA_QUIT is what
                    # let TAB cycle focus twice and let F4/F5/F6 be applied here AND forwarded to the
                    # client. `act` now drives both the quit test and the consume below.
                    # ⚠ The usable height is `ae_geom_h - TITLEBAR_H`: a window's chrome sits ABOVE
                    # its content rect, so the bottom clamp has to reserve it or the titlebar of a
                    # window pushed to the floor lands off-screen and the GPU refuses the rect.
                    var act = input_handle(comp, ev, ae_geom_w, ae_geom_h - TITLEBAR_H);
                    if (act == InputAction.IA_QUIT) {
                        # ⛔ A PROBE RUN IGNORES THE QUIT KEY. --clients exists to answer a question
                        # deterministically, and the previous build let a single Esc at frame 191 end
                        # it 30 seconds early while still reporting the "nothing ever connected" code.
                        # ⚠ Counted, not silently dropped — an ignored keypress is a fact about the
                        # run, and on this box a stray scancode is plausible (the console echoed
                        # `-0 -clients` for a line whose argv was demonstrably correct).
                        if (ae_probe == 1) {
                            ae_quit_ignored = ae_quit_ignored + 1;
                        }
                        if (ae_probe == 0) {
                            running = 0;
                            println("aethersafha: quit on a key, usage then frame:");
                            println_int(bhumi_key_usage(ev));
                            println_int(frame);
                        }
                    }
                    # ⭐ THE COMPOSITOR'S OWN KEYS ARE CLAIMED HERE, and `input_handle` above has
                    # already APPLIED whichever one this is. This block only reports and consumes.
                    #
                    # ⛔ IT USED TO RE-DO THE WORK. A TAB was applied by `input_apply`
                    # (`IA_FOCUS_NEXT` → `comp_focus`) and then this block called `comp_focus` AGAIN,
                    # so one TAB press advanced focus by TWO. With three windows that reads as
                    # cycling backwards, and the 2026-08-08 burn's four "focus cycled by TAB" lines
                    # are four DOUBLE hops. Nothing logged it because both hops are legal.
                    # ⛔ AND THE MOVER USED TO LIVE INSIDE THE `usage == 0x2B` BRANCH — a guard of
                    # `usage >= 0x3A` nested inside `usage == 0x2B` is a contradiction, so the whole
                    # F1-F4 mover was DEAD CODE that no input could reach. It shipped, it burned, and
                    # the only symptom was one absent log line. ⇒ The mapping now lives in
                    # `input_map` where a unit test can reach it; this loop can no longer hide it.
                    # ⚠ CLAIMED KEYS ARE CONSUMED, NOT FORWARDED. A focus key that also reached the
                    # client would type a literal tab into the window you just switched away from,
                    # and a move key would scroll a file list while its window slid out from under it.
                    var kdone = 0;
                    if (bhumi_key_pressed(ev) == 1) {
                        if (act != InputAction.IA_NONE) { kdone = 1; }
                        if (act == InputAction.IA_FOCUS_NEXT) {
                            if (ae_inp_tab == 0) {
                                ae_inp_tab = 1;
                                println("aethersafha: a TAB reached the compositor");
                            }
                            # ⚠ REPORT WHAT `input_apply` DID, do not re-decide it. `IA_FOCUS_NEXT`
                            # is a no-op for a single window (it wraps 0 → 0), so the count is the
                            # honest way to say whether focus could have moved at all.
                            var n_win = comp_count(comp);
                            if (n_win < 2) { println("aethersafha: TAB ignored -- fewer than two windows"); }
                            if (n_win > 1) { println("aethersafha: focus cycled by TAB"); }
                        }
                        # ⭐⭐ THE WINDOW MOVER — F7/F8/F9/F10 slide the focused window left/right/up/down,
                        # and this is the stimulus `AE-0a` was written for and has never once had. The
                        # damage band unions the current rect with the PREVIOUS one precisely because a
                        # window that moves leaves its old pixels behind otherwise, and five flashes
                        # carried that reasoning with nothing on the system able to move a window.
                        # ⛔ NOT F1-F4: F4 is `IA_CLOSE_FOCUSED` in input.cyr, so "move down" and
                        # "destroy the window" would be one keystroke. See the note on `HidUsage`.
                        if (input_action_is_move(act) == 1) {
                            if (ae_inp_move == 0) {
                                ae_inp_move = 1;
                                println("aethersafha: F7-F10 moved the focused window");
                            }
                        }
                        # ⭐ NAME EVERY DISTINCT USAGE THE COMPOSITOR SEES. This is the instrument the
                        # 2026-08-08 burn did not have: it printed every other line of that boot and
                        # not the mover's, and from the log alone "the keys were never pressed" and
                        # "they arrived and were dropped" were INDISTINGUISHABLE. A burn that cannot
                        # say which usages arrived cannot be re-run into an answer.
                        # ⛔ DISTINCT, NOT FIRST-N, and the difference is not cosmetic. The first cut
                        # traced the first twelve key-downs; on the GPU burn the operator held F8, so
                        # ELEVEN slots went to eleven copies of usage 65 and the budget was exhausted
                        # before they pressed F4 — the one key whose arrival was then in question. A
                        # repeat now costs nothing, so holding a key cannot crowd out a key you have
                        # not pressed yet. ⚠ The distinct-set is itself the bound (each usage prints at
                        # most once), and `ae_inp_traced < 32` is a second belt so a pathological run
                        # cannot flood a console three procs share unserialised.
                        if (ae_inp_traced < 32) {
                            if (ae_usage_first_sight(bhumi_key_usage(ev)) == 1) {
                                ae_inp_traced = ae_inp_traced + 1;
                                println("aethersafha: key usage seen:");
                                println_int(bhumi_key_usage(ev));
                            }
                        }
                    }
                    if (kdone == 0) {
                        var fk = setu_srv_forward_key(comp, ev);   # key-DOWN -> focused client
                        if (ae_inp_fwd == 0) {
                            if (fk > 0) {
                                ae_inp_fwd = 1;
                                println("aethersafha: forwarded a key to the focused client");
                            }
                        }
                        # ⛔ AND SAY SO WHEN IT GOES NOWHERE. On the 1.56.42 burn the operator reported
                        # "puka didn't register key commands", eleven letter usages were traced arriving at
                        # the compositor, and NO forward line printed — which is consistent with two
                        # different things: the forward is broken, or focus was simply on a window with no
                        # client (the compositor seeds one, and TAB cycles onto it). The log could not tell
                        # them apart, so the next boot has to. ⚠ Latched, and it names the USAGE and the
                        # FOCUS INDEX so the reader can see which key went where.
                        #
                        # ⛔⛔ KEY-DOWN ONLY, AND THAT GUARD IS THE WHOLE POINT OF THIS BLOCK WORKING. A
                        # press-only surface (the default) drops every key-UP *by design*, so a one-shot
                        # latch armed on releases is spent by the FIRST RELEASE of the boot — and then
                        # reports nothing about the key actually under test. ⚠ MEASURED, not reasoned:
                        # this printed at serial line 148 during crab's startup, focus index 0, while the
                        # QEMU gate simultaneously reported "neither marker fired" for two letters that
                        # demonstrably reached the compositor. A budget an uninteresting event can exhaust
                        # is not an instrument. [[feedback_instrument_discipline]]
                        # ⚠ Gated on THIS key (`fk == 0`), not on "no key has ever been forwarded" — a key
                        # that goes nowhere after a successful forward is still a fact worth one line.
                        # ⛔⛔ ONE REPORT PER DISTINCT FOCUS INDEX, NOT ONE PER BOOT. A boot-scoped latch is
                        # SPENT BY THE UNINTERESTING CASE here, and the procedure guarantees it: focus lands
                        # on the last client to present, so the first TAB WRAPS onto the compositor's own
                        # clientless window — press a key there and the latch is gone, after which a REAL
                        # failure on the terminal prints nothing and the burn cannot distinguish it from
                        # success. ⇒ Bound by the DISTINCT value that matters (which window swallowed it),
                        # so a repeat costs nothing and every window that eats a key still gets one line.
                        # [[feedback_instrument_discipline]] rule 13, in its per-latch form.
                        if (bhumi_key_pressed(ev) == 1) {
                            if (fk == 0) {
                                var fidx = comp_focused(comp);
                                # Bitmask, so index 0 is representable; 63 windows is far past any real desktop.
                                if (fidx >= 0) {
                                    if (fidx < 63) {
                                        var fbit = 1 << fidx;
                                        if ((ae_inp_nofwd & fbit) == 0) {
                                            ae_inp_nofwd = ae_inp_nofwd | fbit;
                                            println("aethersafha: a key reached NO client -- focused window has none, usage then focus index:");
                                            println_int(bhumi_key_usage(ev));
                                            println_int(fidx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
            }
            # ⛔ PLAN BEFORE YOU DRAW. ae_gpu_frame_plan decides, for the WHOLE frame and without
            # issuing a syscall, whether the GPU will composite it — and render_window reads that
            # decision to know whether to do its own per-pixel client composite. Calling this after
            # the render (or not at all) is the bug this ordering exists to prevent: the renderer
            # skipping its work for a frame the GPU then refuses, leaving chrome and no content.
            ae_gpu_frame_plan(comp, fb);
            render_desktop(desk, fb);
            render_desktop_foreign(desk, fb);
            # setu: accept + composite client presents (over the desktop) — BOTH
            # targets now (setu 0.3.0 TCP transport runs on Linux AND agnos).
            # ⛔ "runs on Linux AND agnos" is a statement about the CURRENT code, not a design
            # endorsement: the agnos side of this wire is RETIRED (architectural — see the listener
            # banner) and moves to anu. The accept/dispatch/composite logic below is transport-
            # agnostic and carries over; only the fd's provenance changes.
            # ⭐ agnos: POLL THE MINTED CHANNELS. There is no accept — the channel existed before the
            # client did. A client that has not been scheduled yet returns 0 from the polled serve,
            # which is NOT an error: the difference between "has not spoken yet" and "never will" is
            # time, not state, so it is simply retried next frame.
            # ⛔ The blocking `setu_srv_serve_accepted_at` must NOT be used here — a minted channel is
            # ready the instant it exists, so its 5000 x 2 ms handshake budget would stall the frame
            # loop up to TEN SECONDS per client that has not run yet.
            #ifdef CYRIUS_TARGET_AGNOS
            var pi = 0;
            while (pi < chan_n) {
                if (load64(&chan_served + pi * 8) == 0) {
                    var pstep = accepted % 3;
                    var pcx = 30 + pstep * (ae_geom_w / 6);
                    var pcy = 50 + pstep * (ae_geom_h / 6);
                    # ⛔ DRAIN, NOT ONE STEP. `..._step` consumes ONE record; a client that presents every
                    # frame emits two per its (much faster) frame and wraps the 64-slot ring between two
                    # compositor frames, and the ring drops the OLDEST — so sipping loses the handshake's
                    # phase permanently. That is exactly why puka never got a client fd on iron and every
                    # key it should have received died at forward_key's `cfd == 0`.
                    var psid = setu_srv_handshake_drain(load64(&chan_st + pi * 8), load64(&chan_fd + pi * 8), comp, pcx, pcy, load64(&chan_name + pi * 8));
                    if (psid > 0) {
                        store64(&chan_served + pi * 8, 1);
                        println("aethersafha: setu client presented surface");
                        println_int(psid);
                        comp_focus(comp, comp_count(comp) - 1);
                        accepted = accepted + 1;
                    }
                    # ⛔ A HANDSHAKE ERROR IS NOT TERMINAL ON THE FIRST OCCURRENCE. This used to mark
                    # the client served (i.e. give up forever) the first time it saw a negative — but a
                    # client that stats a directory tree before it connects (crab does, ~37 entries)
                    # is merely SLOW, and a transient read error while it is still starting is not the
                    # same fact as a client that died. Count consecutive failures and only give up
                    # after several, so "not ready yet" and "gone" stop being the same verdict.
                    #
                    # ⛔⛔ AND RESET IT ON PROGRESS, or "consecutive" is a claim the comment makes and the
                    # code does not keep. Nothing zeroed this counter after the initial store, so it was
                    # CUMULATIVE: 200 transient errors spread over a long run killed a perfectly live
                    # client, and the reader of the comment above would never suspect it. A frame that
                    # consumed records without erroring is the definition of "the client is alive and
                    # behaving" — that is the reset. [[feedback_audit_re_derive_dont_validate_comments]]
                    if (psid == 0) {
                        if (setu_hs_drained > 0) { store64(&chan_fail + pi * 8, 0); }
                    }
                    if (psid < 0) {
                        var fails = load64(&chan_fail + pi * 8) + 1;
                        store64(&chan_fail + pi * 8, fails);
                        if (fails < 200) { psid = 0; }
                    }
                    if (psid < 0) {
                        # A handshake error is terminal for THIS client — mark it served so the loop
                        # does not retry a dead channel every frame for the rest of the run.
                        # ⛔ DISTINCT STRINGS, NOT println_int: three procs share this console
                        # unserialised (spawn_path #43 does not apply an fd redirect unless one is
                        # armed), so a bare number lands mid-line in somebody else's output and is
                        # unreadable. That already cost one diagnosis this session.
                        store64(&chan_served + pi * 8, 1);
                        # ⛔⛔ EVERY RETIREMENT MUST SAY SOMETHING, AND TWO CODES USED TO SAY NOTHING.
                        # `-9` (comp_create_window refused — window table full) and `-12` (attach geometry
                        # or buffer id refused) are both returnable by the handshake and neither had a line
                        # here, so a client could be retired in COMPLETE SILENCE. That silence is
                        # indistinguishable from "the retry budget has not expired yet", which is exactly
                        # the reading a burn card would give it — a wrong verdict with no way to catch it.
                        # ⇒ `pnamed` makes silence IMPOSSIBLE: any code without its own line still prints.
                        # [[feedback_instrument_discipline]] — a readout that suppresses a value makes
                        # ABSENT and THAT VALUE indistinguishable.
                        var pnamed = 0;
                        if (psid == 0 - 6) { println("aethersafha: placed client: channel read failed, peer gone or bad fd"); pnamed = 1; }
                        if (psid == 0 - 8) { println("aethersafha: placed client: first frame was not create_surface"); pnamed = 1; }
                        if (psid == 0 - 7) { println("aethersafha: placed client: could not write surface_created back"); pnamed = 1; }
                        if (psid == 0 - 9) { println("aethersafha: placed client: the compositor could not create a window -- table full"); pnamed = 1; }
                        if (psid == 0 - 12) { println("aethersafha: placed client: attach refused -- surface geometry or buffer id out of range"); pnamed = 1; }
                        # ⚠ NO LONGER "the second/third frame" — the machine resyncs past records the
                        # channel ring dropped, so these fire only on a kind that is wrong in a way LOSS
                        # cannot explain: neither attach nor commit at a point where one of them is due.
                        if (psid == 0 - 11) { println("aethersafha: placed client: expected attach, got neither attach nor commit"); pnamed = 1; }
                        if (psid == 0 - 13) { println("aethersafha: placed client: attached, then got neither commit nor a re-attach"); pnamed = 1; }
                        if (psid == 0 - 14) { println("aethersafha: placed client: buffer read or alloc failed"); pnamed = 1; }
                        if (pnamed == 0) { println("aethersafha: placed client: retired on a handshake error with NO name -- add a line for this code"); }
                    }
                }
                pi = pi + 1;
            }
            #endif
            if (setu_sfd >= 0) {
                var cfd = setu_srv_accept(setu_sfd);   # non-blocking; -5 = none pending
                if (cfd >= 0) {
                    println("aethersafha: setu client connected");   # DBG: TCP accept fired
                    # Cascade each accepted client to a distinct position — the multi-window desktop.
                    # ⛔ THE OLD STEP RAN CLIENTS OFF THE SCREEN, and `#87` REJECTS rather than clips,
                    # so the third client (690,470) with a 400-tall surface put dy+h past the bottom
                    # edge and took the WHOLE FRAME down to the CPU path — or, before the plan existed,
                    # to a blank desktop. Step proportionally and WRAP, so the cascade stays inside the
                    # top-left third of whatever surface we were given and cannot run off it.
                    # ⚠ The compositor cannot know a client's surface size before CREATE_SURFACE, so
                    # this bounds the ORIGIN, not the extent — the plan still has to catch an
                    # oversized client, and now it does so without blanking anything.
                    var step = accepted % 3;
                    var cx = 30 + step * (ae_geom_w / 6);
                    var cy = 50 + step * (ae_geom_h / 6);
                    var sid = setu_srv_serve_accepted_at(cfd, comp, fb, cx, cy);
                    # NOTE: cfd is NOT closed — serve_accepted_at stored it on the Window
                    # (win_set_cfd) so the compositor can forward input to this client.
                    if (sid > 0) {
                        println("aethersafha: setu client presented surface");
                        println_int(sid);
                        comp_focus(comp, comp_count(comp) - 1);   # focus the just-added client → input routes to it
                        accepted = accepted + 1;
                        #ifndef CYRIUS_TARGET_AGNOS
                        running = 0;                   # host: one present proves the wire; exit the bounded loop
                        #endif
                        # agnos: keep compositing so the harness screendumps the client windows
                    }
                }
            }
            # Focus-change detector: if focus moved this frame — a TAB in the input loop above,
            # or a newly-connected client taking focus in the accept block — notify the affected
            # setu clients (SETU_INPUT_FOCUS) so they re-render their focus indicator. One detector
            # covers both focus sources.
            var cur_focus = comp_focused(comp);
            if (cur_focus != prev_focus) {
                setu_srv_notify_focus(comp, prev_focus, cur_focus);
                prev_focus = cur_focus;
            }
            # Hardware compositing first: gpu.cyr blits the chrome layer DEFERRED, composites each
            # client surface with gpu_blit_shm #87 straight out of its GPU-visible shm slot, and flips
            # once with #84. Returns 0 on any refusal (no GPU, an off-screen window, a failed blit) and
            # we fall through to the untouched CPU present — so QEMU and every non-AMD box are unaffected.
            if (ae_gpu_present_frame(comp, fb) == 0) {
                bhumi_backend_present(be, now);
            }
            # agnos: cede the CPU each frame so the spawned setu client (puka, a
            # spawn_path background proc) is scheduled to connect + present. The
            # foreground compositor otherwise spins its render loop and starves it.
            #ifdef CYRIUS_TARGET_AGNOS
            sys_sched_yield();
            #endif
            # --clients: stop as soon as the question is answered, or at the cap. ⚠ Placed with the
            # frame counter so it sees the SAME frame the accept block just ran.
            if (ae_probe == 1) {
                if (accepted >= 2) { running = 0; }
                if (frame >= AE_PROBE_FRAMES) { running = 0; }
                var el = ae_now_ms() - ae_probe_t0;
                if (el >= AE_PROBE_MS) { running = 0; }
                # Progress, so the log proves the run stayed alive rather than wedged. Only while
                # nothing has connected — once a client is up the accept lines say it.
                if (el >= ae_probe_next_report) {
                    ae_probe_next_report = ae_probe_next_report + AE_PROBE_REPORT_MS;
                    if (accepted == 0) {
                        println("aethersafha: still waiting for an app, milliseconds so far:");
                        println_int(el);
                    }
                }
            }
            frame = frame + 1;
        }
        # ⛔ CLOSE THE LISTENER. The lesson that produced this line predates the transport and outlives
        # it: when this close sat inside `#ifndef CYRIUS_TARGET_AGNOS`, the one target whose loop runs
        # forever — and therefore the one that actually gets quit and relaunched by hand — never
        # released its endpoint. Run 1 printed "setu listener up" and hosted two clients; run 2 printed
        # NO listener line, hosted nothing, and otherwise looked like a perfectly healthy desktop.
        # ⚠ On AF_UNIX the socket FILE also outlives the process, which is why `setu_listen` unlinks
        # the path before binding rather than relying on this close running — a crash skips it.
        #ifndef CYRIUS_TARGET_AGNOS
        if (setu_sfd >= 0) { sys_close(setu_sfd); }
        #endif

        # ⛔⛔ AND RELEASE THE CLIENTS, WHICH ON agnos NOTHING DID. The listener close above is the
        # WHOLE of this exit path's release and it is `#ifndef CYRIUS_TARGET_AGNOS` — so on agnos, the
        # one target that reaches here by being quit and relaunched by hand, the compositor exited
        # holding nothing and freeing nothing, and left every client it spawned ALIVE. Nothing reaps
        # them: `--clients` returns its verdict, Esc ends the frame loop, this function returns, the
        # process dies, and puka + puka's agnsh + crab keep running with their `#97` ends, their `#86`
        # slots and their process-table rows held for the rest of the boot.
        # ⛔ THE CEILING IS 16 (`agnos/kernel/core/proc.cyr:275`) and the refusal is silent on both
        # sides of the syscall — so the symptom is not an error, it is a desktop that starts, draws
        # its chrome and hosts nothing. That is the shape reported from iron on 2026-08-09.
        # ⚠ The comment on the line above says the lesson "predates the transport and outlives it".
        # It did outlive it, and the fix was applied only to the arm that no longer matters.
        var ae_told = comp_close_all_clients(comp);
        println("aethersafha: at exit — clients told to close:");
        println_int(ae_told);

        # ⭐ SAY WHAT THE RUN ACTUALLY ACHIEVED. "frame loop ok" is true of a desktop that hosted two
        # apps and of one that hosted none, which is why the burn above could not be read: both
        # clients printed "launched" and then nothing ever said whether either arrived. Reporting the
        # accepted count against the frame count separates "the clients died" from "you quit before
        # they connected" without another boot.
        println("aethersafha: at exit — frames, then apps that connected:");
        println_int(frame);
        println_int(accepted);
        println("aethersafha: frame loop ok");

        # --clients verdict. Read as `run: exit N`.
        #   95 both apps connected and presented    94 one did    93 neither, though both started
        #   92 the display socket never opened      91 an app could not be started at all
        # ⚠ 93 vs 91 is the distinction the last burn could not make, and they point at different
        # repos: 91 is the kernel's spawn_path / the image, 93 is the client or the setu path.
        # ⚠ 93 is NOT "too early" — this ran to a fixed cap, so it means they genuinely never arrived.
        if (ae_probe == 1) {
            # ⭐ REPORT THE BUDGET THAT WAS ACTUALLY SPENT. A verdict is only as good as the run
            # behind it, and the previous build emitted 93 from a run cut short at frame 191. These
            # two numbers make that unmistakable: an elapsed time near AE_PROBE_MS means the budget
            # was genuinely spent, anything far below it means the run ended for another reason.
            println("aethersafha: probe ran for milliseconds, and ignored this many quit keys:");
            println_int(ae_now_ms() - ae_probe_t0);
            println_int(ae_quit_ignored);
            # ⛔⛔ 92 IS A LINUX-ONLY VERDICT AND IT WAS FIRING ON EVERY agnos RUN. `setu_sfd` is assigned
            # in exactly one place, inside `#ifndef CYRIUS_TARGET_AGNOS`, so on agnos it keeps its -1
            # initialiser for the whole run — and this test then returned 92 ("the display socket never
            # opened") no matter what happened. The entire 95/94/93/91 ladder was DEAD on the only target
            # the probe is used on, and every iron run that read this exit code was told the wrong thing.
            # ⇒ On agnos there IS no listener by design (the channel band replaced it), so a missing socket
            # is not a failure and must not be tested. [[feedback_compiled_is_not_reachable]]
            #ifndef CYRIUS_TARGET_AGNOS
            if (setu_sfd < 0) { return 92; }
            #endif
            if (ae_spawn_failed == 1) { return 91; }
            if (accepted >= 2) { return 95; }
            if (accepted == 1) { return 94; }
            return 93;
        }
        return 0;
    }

    # ⭐ THE COMPOSITOR HAD NO ENTRY POINT AND NO WAY TO REPORT ANYTHING.
    #
    # Until now this file ended at `main`'s closing brace and relied on cycc auto-emitting the call.
    # That runs, which is why nobody noticed, but it costs two things that only matter on iron:
    #
    # ⛔ **There was no exit code.** `main`'s return value went nowhere — cycc's implicit tail-exit is
    # what ended the process. Every self-validating binary agnos stages (`gpufill`, `gpublit`, `gpucopy`,
    # `gputri`, `modeset`, `mine-cart`) reports its verdict as `run: exit N`, because that is the only
    # channel a graphical program has on a box whose screen it has taken over. A compositor that cannot
    # set an exit code cannot be burned and read; it can only be photographed.
    #
    # ⚠ **And argv would have been unsafe to add.** On agnos a module-scope `var r = main();` runs during
    # the gvar-init phase — BEFORE cycc emits the init-rsp capture (`_agnos_capture_rsp`, placed after
    # gvar-inits since 6.1.14) — so `argc()`/`argv()` read 0/null and every argument silently vanishes.
    # `bnrmr agnos` printing its help text instead of rendering is the same bug. A BARE top-level
    # statement runs in PARSE_PROG, after the capture, and is the form every staged agnos tool uses
    # (klug, kriya, owl, bnrmr all ship exactly this).
    #
    # ⚠ `SYS_EXIT`, never a literal 60. agnos renumbers the syscall enum — exit is **0** there, not
    # Linux's 60 — so `syscall(60, r)` is a silent no-op on agnos that only appears to work because
    # cycc's implicit exit runs afterwards. `SYS_EXIT` resolves correctly on both targets.
    fn _ae_entry(): i64 {
        var r = main();
        syscall(SYS_EXIT, r);
        return 0;
    }
    _ae_entry();
