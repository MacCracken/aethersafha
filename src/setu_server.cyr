# aethersafha — setu display-protocol listener (server-side TRANSPORT).
#
# ⛔⛔ RETIREMENT BANNER (2026-08-03) — THE agnos ARM OF THIS TRANSPORT IS RETIRED.
# Operator ruling: TCP-on-loopback is the WRONG PRIMITIVE for local display IPC on the sovereign
# kernel. This is an ARCHITECTURAL retirement — it is NOT a claim that the transport never worked
# (an honest, hook-free harness did connect and present two clients on agnos on 2026-08-02). The
# replacement is the agnos socket `anu`: agnos docs/development/planning/ipc.md §9 for the
# decision, §10 for the revert inventory. When anu lands, the `setu_srv_*` names and every
# caller below stay put — only what `setu_listen`/`setu_accept` sit on changes.
# ⚠ setu's LINUX arm is NOT retired and must not be removed. Linux is a separate target, not a
# fallback; BSD sockets under `#ifndef CYRIUS_TARGET_AGNOS` remain the supported host transport.
# ⛔ The transport itself lives in the setu dep (materialized at lib/setu.cyr — hand edits there
# are reverted on the next repin). Changing it is a setu tag bump, not an edit in this repo.
#
# ⛔ DELETED 2026-08-12 — a paragraph here described the transport as "CROSS-PLATFORM TCP loopback via
# the cyrius `net.cyr` socket layer" and "agnos kernel-TCP #47-57", and ended mid-clause. Both were
# retracted three lines below by the banner that follows, so this file argued with itself. TCP is gone
# from both targets: Linux is AF_UNIX/SOCK_SEQPACKET, agnos is the `#97` channel band.
# ⚠ The rendezvous NAME is setu's, not this repo's (setu 0.8.5) — pass 0 and let `setu_un_path` resolve
# `$SETU_SOCKET` then `SETU_UNIX_PATH`. The earlier AF_UNIX path — Linux-only, fail-closed on
# ⭐ TCP IS GONE FROM BOTH TARGETS. agnos does not listen at all — clients are minted a channel and
# spawned holding an endowed end. Linux listens on AF_UNIX/SOCK_SEQPACKET, the same record semantics
# as the band. All fns stay `setu_srv_*`; the message→Window dispatch lives in setu_dispatch.cyr.
# ⚠ `setu_srv_listen` / `setu_srv_accept` / `setu_srv_accept_one` are LINUX-ONLY paths now: setu's
# agnos arm refuses both, so on agnos they return a negative code and the compositor never calls them.

# Bind + listen the setu endpoint. Returns the listening fd (>= 0) or a negative
# code. The fd is non-blocking (setu_accept polls) so the frame loop never stalls.
fn setu_srv_listen(path): i64 { return setu_listen(path); }

# Accept the next pending client (NON-BLOCKING). Returns the client fd (>= 0), or
# -5 when none is pending (WOULD_BLOCK — poll again next frame).
fn setu_srv_accept(sfd): i64 { return setu_accept(sfd); }

# Framing — delegate to setu (agnos would-block + partial-send handled there).
fn setu_srv_read_exact(fd, buf, n): i64 { return setu_read_exact(fd, buf, n); }
fn setu_srv_read_msg(fd, msg_out): i64  { return setu_read_msg(fd, msg_out); }
fn setu_srv_write_frame(cfd, msg): i64  { return setu_send(cfd, msg); }

# Bind, accept ONE client (poll the non-blocking accept), read ONE frame, close
# all. -> decoded len (> 0) or a negative step code. A pure "receive one" probe.
fn setu_srv_accept_one(path, msg_out): i64 {
    var sfd = setu_srv_listen(path);
    if (sfd < 0) { return sfd; }
    var cfd = 0 - 5;
    var tries = 0;
    while (cfd < 0) {
        cfd = setu_srv_accept(sfd);
        if (cfd < 0) {
            tries = tries + 1;
            if (tries > 5000) { sys_close(sfd); return 0 - 5; }
            sleep_ms(2);                             # portable (chrono): poll() on Linux, #41 on agnos
        }
    }
    var rc = setu_recv(cfd, msg_out);
    sys_close(cfd);
    sys_close(sfd);
    return rc;
}
