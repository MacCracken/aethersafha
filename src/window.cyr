# aethersafha — window model
# Parity: rust-old/src/compositor.rs  (Window, WindowState)
#
# A Window is a heap object (arena-allocated); fields via named-offset enum +
# load64/store64 — the same layout convention lib/bhumi.cyr and the stdlib use.

enum WinState {
    WS_NORMAL     = 0;
    WS_MINIMIZED  = 1;
    WS_MAXIMIZED  = 2;
    WS_FULLSCREEN = 3;
    WS_FLOATING   = 4;
}

enum WinOff {
    W_ID    = 0;    # i64 surface id
    W_X     = 8;
    W_Y     = 16;
    W_W     = 24;
    W_H     = 32;
    W_STATE = 40;   # WinState
    W_TITLE = 48;   # cstr pointer
    W_AGENT = 56;   # 1 = agent-owned window
    W_PIX   = 64;   # cached BGRA surface pixels (a setu client's presented frame), or 0.
    # Dims = W_W x W_H. render_window re-composites it EVERY frame so the
    # surface persists on screen (not overwritten by the next desktop redraw).
    W_BUFID = 72;   # setu shared-buffer id for a LIVE surface (> 0), or 0 for a static frame.
    # When set, render_window RE-READS the client's buffer into W_PIX each frame,
    # so a client that keeps writing its buffer produces a live-updating window.
    W_CFD   = 80;   # persistent setu client connection fd (a tagged sock fd, always > 0), or 0
    # for a compositor-seeded window with no client. Kept open AFTER the present
    # handshake so the compositor can forward input (SETU_INPUT_*) to the client.
    W_KEYMODE = 88; # 1 = client requested FULL key events (SETU_SURF_FULL_KEYS in CREATE_SURFACE
    # flags): forward press AND release with the make/break in mods. 0 = press-only
    # (default) — the pre-0.5.0 behaviour every nav client keeps.
    W_PREMUL = 96;  # 1 = client declared SETU_SURF_PREMULTIPLIED: its pixels are premultiplied BGRA
    # (c <= a), so the compositor may BLEND it per-pixel (gpu_shader_op#92 op 0x01)
    # instead of copying it opaquely (gpu_blit_shm#87). 0 = default, opaque copy.
    # ⚠ Must stay opt-in — but NOT for the reason three documents in this stack say.
    # ⛔ "a surface whose byte 3 is 0 is FULLY TRANSPARENT under #92 and its window
    # VANISHES" is WRONG, and it was asserted here, in setu's client.cyr and in
    # dhancha's CHANGELOG. The kernel shader is `out = src + dst*(1 - src_a)`
    # (agnos kernel/core/gpu.cyr, "PREMULTIPLIED f32"). At src_a = 0 that is
    # `out = src + dst` — an ADDITIVE, OVER-BRIGHT GHOST, not a disappearance.
    # It is nearly invisible over the near-black desktop void and blows out to
    # clipped white over lighter chrome, which makes it HARDER to spot than a
    # missing window, not easier. Anyone hunting a vanished window will not find it.
    # The opt-in rule stands; only the predicted symptom was wrong.
    # ⭐ PREVIOUS-FRAME RECT — the 3D arc's Phase-0 damage chain.
    # Damage is the union of where a window WAS and where it IS. Without the "was", a window that
    # moves leaves its old pixels on screen: the vacated region is never cleared and never
    # re-copied, and the bug looks like a stale framebuffer rather than a damage-model error.
    # ⚠ Seeded to an IMPOSSIBLE rect (-1) so the first frame after creation is always treated as
    # fully damaged — a window that has never been drawn must not be mistaken for one that has
    # not moved.
    W_PX    = 104;
    W_PY    = 112;
    W_PW    = 120;
    W_PH    = 128;
    # ⭐ M6-C3: per-window opacity, 0..255 (255 = opaque). A LEVEL the compositor applies, distinct from
    # W_PREMUL, which describes the per-pixel alpha the CLIENT authored. The two multiply: a
    # premultiplied surface at 50% window opacity is that surface's own alpha scaled by 128.
    W_OPACITY = 136;
    # ⭐⭐ M7 — THE RESTORE RECT: where a window goes back to when it stops being maximized.
    # ⛔ MAXIMIZE WAS A NO-OP UNTIL 2026-08-17, AND THIS IS THE FIELD IT WAS MISSING. `IA_MAXIMIZE_FOCUSED`
    # flipped `W_STATE` to `WS_MAXIMIZED` and NOTHING read it — no renderer, no GPU path, nothing sized a
    # window from it — so F5 changed a number and the screen never moved. Making it real needs somewhere
    # to remember the pre-maximize geometry, or "restore" has nothing to restore TO.
    # ⚠ Distinct from W_PX..W_PH, which are LAST FRAME's rect for the damage model and are overwritten
    # every frame. These four survive until the window is un-maximized.
    W_RX    = 144;
    W_RY    = 152;
    W_RW    = 160;
    W_RH    = 168;
    W_SZ    = 176;
}

# win_new(id, x, y, w, h, title_cstr) -> *Window (0 on OOM)
fn win_new(id, x, y, w, h, title): i64 {
    var p = alloc(W_SZ);
    if (p == 0) { return 0; }
    store64(p + W_ID, id);
    store64(p + W_X, x);
    store64(p + W_Y, y);
    store64(p + W_W, w);
    store64(p + W_H, h);
    store64(p + W_STATE, WinState.WS_NORMAL);
    store64(p + W_TITLE, title);
    store64(p + W_AGENT, 0);
    store64(p + W_PIX, 0);
    store64(p + W_BUFID, 0);
    store64(p + W_CFD, 0);
    store64(p + W_KEYMODE, 0);
    # ⛔ W_PREMUL WAS MISSING HERE while every other slot was zeroed, and the allocator does not
    # cover for it: lib/alloc.cyr is a bump pointer with no memset, so an uninitialised field reads
    # whatever the previous tenant of that address left behind. A garbage premul flag routes an
    # ORDINARY OPAQUE surface down the `#92` blend path, where its zero alpha byte then makes it an
    # additive ghost — a wrong picture with no error anywhere.
    store64(p + W_PREMUL, 0);
    # ⛔ DEFAULT 255, NOT 0. Zeroed memory means "invisible" for an opacity field, so a window created
    # before anyone sets one would vanish. Every other slot here is zero-init and this is the one that
    # cannot be — the same class as the W_PREMUL slot that was missed above.
    store64(p + W_OPACITY, ae_win_default_opacity);
    store64(p + W_PX, 0 - 1);
    store64(p + W_PY, 0 - 1);
    store64(p + W_PW, 0);
    store64(p + W_PH, 0);
    return p;
}

# The previous-frame rect. render_frame reads these to compute damage, then stamps the current
# rect over them at the END of the frame — never at the start, or the "was" is lost.
fn win_px(p) { return load64(p + W_PX); }
fn win_py(p) { return load64(p + W_PY); }
fn win_pw(p) { return load64(p + W_PW); }
fn win_ph(p) { return load64(p + W_PH); }
fn win_stamp_prev(p): i64 {
    store64(p + W_PX, load64(p + W_X));
    store64(p + W_PY, load64(p + W_Y));
    store64(p + W_PW, load64(p + W_W));
    store64(p + W_PH, load64(p + W_H));
    return 0;
}
# 1 = this window's rect differs from last frame's (moved, resized, or never drawn).
fn win_rect_changed(p): i64 {
    if (load64(p + W_PX) != load64(p + W_X)) { return 1; }
    if (load64(p + W_PY) != load64(p + W_Y)) { return 1; }
    if (load64(p + W_PW) != load64(p + W_W)) { return 1; }
    if (load64(p + W_PH) != load64(p + W_H)) { return 1; }
    return 0;
}

# ⛔⛔ THE WINDOW'S VERTICAL CONVENTION, AND IT HAS EXACTLY ONE DEFINITION FROM NOW ON.
#
# `win_h` is the **CONTENT** height — the client surface — and the titlebar sits ABOVE it. So a window
# occupies `win_y .. win_y + TITLEBAR_H + win_h` on screen. Chrome is OUTSIDE the content rect.
#
# ⚠ IT WAS NOT ONE CONVENTION BEFORE, AND THE DISAGREEMENT WAS INERT ONLY BECAUSE NOTHING CLICKS YET.
# Five consumers, three conventions, in one codebase:
#   - the damage model (render.cyr) unions `win_h + TITLEBAR_H`     -> chrome OUTSIDE  ✅ iron-proven
#   - the GPU client composite (gpu.cyr) puts the body at `y + TITLEBAR_H` -> OUTSIDE  ✅ iron-proven
#   - `render_window`'s CLIENT BLIT lands at `y + TITLEBAR_H`, height `h` -> OUTSIDE   ✅ iron-proven
#   - `render_window`'s THEME BODY FILL used `h - TITLEBAR_H`             -> INSIDE    ⛔ contradicted
#     the client blit **in the same function**
#   - `deco_hit` + `comp_window_at` treated the window as `y .. y + h`   -> INSIDE    ⛔
# ⇒ Chrome-OUTSIDE wins because it is what all three *rendering* paths do and those are the ones burned
# to hardware. Had the hit-tests shipped as they were, the first pointer click would have landed 30 px
# out on every live setu window, and the bottom resize strip would have fallen INSIDE the client surface.
#
# ⭐ WHY THIS LIVES IN window.cyr AND NOT THE RENDERER. `TITLEBAR_H` was an entry in render.cyr's
# `RenderK` enum next to button widths, so `compositor.cyr` — included EARLIER — could not reach it, and
# `comp_window_at` open-coded the wrong extent instead. A window-geometry fact belongs with the window
# model. ⚠ Button geometry stays in the renderer; only this one constant moved.
#
# ⇒ **Use `win_total_h` / `win_body_y`. Do not open-code `+ TITLEBAR_H` at a call site again** — that is
# how five consumers drifted into three conventions in the first place.
enum WinGeom {
    TITLEBAR_H = 30;
}

# The window's full on-screen height: chrome plus content.
fn win_total_h(p): i64 { return TITLEBAR_H + load64(p + W_H); }
# The y at which the content (client surface / theme body) begins.
fn win_body_y(p): i64 { return load64(p + W_Y) + TITLEBAR_H; }
# The PREVIOUS frame's full on-screen height, for the damage model's `prev` term. ⚠ Needed as its own
# accessor because a stamped prev rect must be extended by the same chrome the current rect is, or the
# band under-covers the rows a moved window vacated — which is precisely the ghost `AE-0a` exists to stop.
fn win_prev_total_h(p): i64 { return TITLEBAR_H + load64(p + W_PH); }
# The first y BELOW the window — exclusive bottom edge.
fn win_bottom_y(p): i64 { return load64(p + W_Y) + TITLEBAR_H + load64(p + W_H); }

fn win_id(p)    { return load64(p + W_ID); }
fn win_x(p)     { return load64(p + W_X); }
fn win_y(p)     { return load64(p + W_Y); }
fn win_w(p)     { return load64(p + W_W); }
fn win_h(p)     { return load64(p + W_H); }
fn win_state(p) { return load64(p + W_STATE); }
fn win_title(p) { return load64(p + W_TITLE); }
fn win_is_agent(p) { return load64(p + W_AGENT); }
fn win_pix(p) { return load64(p + W_PIX); }
fn win_set_pix(p, ptr) { store64(p + W_PIX, ptr); return 0; }
fn win_bufid(p) { return load64(p + W_BUFID); }
fn win_set_bufid(p, id) { store64(p + W_BUFID, id); return 0; }
fn win_cfd(p) { return load64(p + W_CFD); }
fn win_set_cfd(p, fd) { store64(p + W_CFD, fd); return 0; }
fn win_keymode(p) { return load64(p + W_KEYMODE); }

# @public — SETU_SURF_PREMULTIPLIED opt-in (see W_PREMUL).
# The opacity every NEW window starts at. ⚠ A default rather than a per-call argument because windows
# are created deep in `setu_dispatch` when a client presents, and threading an opacity through the
# protocol path to set a compositor-side preference would be the wrong seam entirely.
var ae_win_default_opacity = 255;
fn win_default_opacity(): i64 { return ae_win_default_opacity; }
fn win_set_default_opacity(a): i64 {
    var v = a;
    if (v < 0) { v = 0; }
    if (v > 255) { v = 255; }
    ae_win_default_opacity = v;
    return 0;
}

fn win_opacity(win): i64 { return load64(win + W_OPACITY); }
# Clamped on the way in: an out-of-range opacity is a caller bug, and silently storing 300 would make
# `rend_blend`'s `255 - a` negative and wrap the arithmetic into garbage rather than erroring.
fn win_set_opacity(win, a): i64 {
    var v = a;
    if (v < 0) { v = 0; }
    if (v > 255) { v = 255; }
    store64(win + W_OPACITY, v);
    return 0;
}
fn win_translucent(win): i64 { if (win_opacity(win) < 255) { return 1; } return 0; }

fn win_premul(win): i64 { return load64(win + W_PREMUL); }
fn win_set_premul(win, v): i64 { store64(win + W_PREMUL, v); return 0; }
fn win_set_keymode(p, m) { store64(p + W_KEYMODE, m); return 0; }

fn win_set_state(p, s) { store64(p + W_STATE, s); return 0; }
fn win_set_agent(p, a) { store64(p + W_AGENT, a); return 0; }
fn win_move(p, x, y)   { store64(p + W_X, x); store64(p + W_Y, y); return 0; }
fn win_resize(p, w, h) { store64(p + W_W, w); store64(p + W_H, h); return 0; }

# ============================================================================================
# ⭐⭐ MAXIMIZE / RESTORE — geometry, not just a flag
# ============================================================================================
# ⛔ THE STATE FLAG ALONE WAS THE WHOLE FEATURE FOR MONTHS, and it did nothing. `win_set_state(win,
# WS_MAXIMIZED)` was written by F5 and read by no renderer, so a "maximized" window kept its original
# rect and the operator saw nothing happen. A state that nothing acts on is not a state.
fn win_restore_rect_save(p): i64 {
    store64(p + W_RX, load64(p + W_X));
    store64(p + W_RY, load64(p + W_Y));
    store64(p + W_RW, load64(p + W_W));
    store64(p + W_RH, load64(p + W_H));
    return 0;
}
fn win_restore_x(p) { return load64(p + W_RX); }
fn win_restore_y(p) { return load64(p + W_RY); }
fn win_restore_w(p) { return load64(p + W_RW); }
fn win_restore_h(p) { return load64(p + W_RH); }

# Fill the work area. `sw` / `content_h` are the SAME bounds the window MOVER is already clamped to —
# `ae_geom_w` and `ae_geom_h - TITLEBAR_H`, derived from the geometry the kernel reports. Taking the
# content height directly, rather than a screen height this function re-adjusts, keeps ONE subtraction
# in the whole path: three conversions to express one fact is where an off-by-one lives.
# ⚠ `win_h` is the CONTENT height and chrome sits ABOVE it, so a window at `content_h` occupies exactly
# the screen. Maximizing to the full screen height instead would push the titlebar off the top AND make
# the total extent exceed the back buffer — and `#88`/`#87` REJECT an out-of-range rect rather than
# clipping it, so the GPU would refuse the whole frame rather than draw a slightly-too-tall window.
fn win_maximize(p, sw, content_h): i64 {
    if (win_state(p) == WinState.WS_MAXIMIZED) { return 0; }
    win_restore_rect_save(p);
    store64(p + W_X, 0);
    store64(p + W_Y, 0);
    store64(p + W_W, sw);
    store64(p + W_H, content_h);
    win_set_state(p, WinState.WS_MAXIMIZED);
    return 1;
}

# ============================================================================================
# ⭐⭐ M7 — RESIZE. The regions existed; nothing consumed them.
# ============================================================================================
# ⛔ `deco_hit` has returned DECO_RESIZE_R / _B / _BR since it was written, and the pointer handler
# consumed CLOSE, MAX, MIN and TITLEBAR — so the grips were hit-tested on every frame and the answer
# thrown away. Same shape as the maximize/minimize buttons, which were PAINTED and inert until wired:
# a control that responds to nothing reads as a broken desktop, which is worse than one that is absent.
#
# ⚠ A MINIMUM SIZE IS NOT COSMETIC. A window dragged to zero (or negative) width produces `w < 1`, and
# `#88`/`#87` REJECT such a rect rather than clipping it — the GPU refuses the whole frame, so one
# over-drag would blank the desktop rather than pinch one window. The floor also has to leave room for
# the three deco buttons or the titlebar's own controls fall outside the window that owns them.
# ⭐ MOVED HERE FROM render.cyr (2026-08-17): these name WINDOW regions, and this file now ACTS on them
# (`win_grip_is_resize`, `win_resize_by`). `deco_hit` in render.cyr still produces them; the producer
# living a layer above the definition is fine, the reverse was not.
enum Deco {
    DECO_NONE      = 0;
    DECO_BODY      = 1;
    DECO_TITLEBAR  = 2;   # draggable region
    DECO_CLOSE     = 3;
    DECO_MAX       = 4;
    DECO_MIN       = 5;
    DECO_RESIZE_R  = 6;
    DECO_RESIZE_B  = 7;
    DECO_RESIZE_BR = 8;
}

var WIN_MIN_W = 120;
var WIN_MIN_H = 60;

# Resize by a pointer delta on the given grip. `bound_w`/`bound_h` are the same usable extent the mover
# clamps to. -> 1 if the size actually changed.
# ⚠ ONLY RIGHT/BOTTOM GRIPS EXIST, so x/y never move and the window cannot walk off the top-left while
# being resized. Left/top grips would have to move the origin AND resize in one step; that is a second
# behaviour with its own clamp interactions, and it is not written here rather than half-written.
fn win_resize_by(p, grip, dx, dy, bound_w, bound_h): i64 {
    var w = load64(p + W_W);
    var h = load64(p + W_H);
    var nw = w;
    var nh = h;
    if (grip == Deco.DECO_RESIZE_R)  { nw = w + dx; }
    if (grip == Deco.DECO_RESIZE_B)  { nh = h + dy; }
    if (grip == Deco.DECO_RESIZE_BR) { nw = w + dx; nh = h + dy; }
    if (nw < WIN_MIN_W) { nw = WIN_MIN_W; }
    if (nh < WIN_MIN_H) { nh = WIN_MIN_H; }
    # ⛔ CLAMP TO THE EDGE, not to the screen: the window keeps its origin, so the most it may grow is
    # the distance from that origin to the bound. Growing past it is the out-of-range rect the GPU
    # refuses, and the failure would be a dropped FRAME, not a clipped window.
    var maxw = bound_w - load64(p + W_X);
    var maxh = bound_h - load64(p + W_Y);
    if (nw > maxw) { nw = maxw; }
    if (nh > maxh) { nh = maxh; }
    if (nw < WIN_MIN_W) { nw = WIN_MIN_W; }
    if (nh < WIN_MIN_H) { nh = WIN_MIN_H; }
    if (nw == w) { if (nh == h) { return 0; } }
    store64(p + W_W, nw);
    store64(p + W_H, nh);
    return 1;
}

# Is this hit region a resize grip?
fn win_grip_is_resize(hit): i64 {
    if (hit == Deco.DECO_RESIZE_R)  { return 1; }
    if (hit == Deco.DECO_RESIZE_B)  { return 1; }
    if (hit == Deco.DECO_RESIZE_BR) { return 1; }
    return 0;
}

# Put it back where it was. -> 1 if it moved, 0 if it was not maximized.
fn win_unmaximize(p): i64 {
    if (win_state(p) != WinState.WS_MAXIMIZED) { return 0; }
    store64(p + W_X, load64(p + W_RX));
    store64(p + W_Y, load64(p + W_RY));
    store64(p + W_W, load64(p + W_RW));
    store64(p + W_H, load64(p + W_RH));
    win_set_state(p, WinState.WS_NORMAL);
    return 1;
}
fn win_set_title(p, t) { store64(p + W_TITLE, t); return 0; }
