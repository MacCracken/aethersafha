# aethersafha — software renderer over the bhumi framebuffer
# Parity: rust-old/src/renderer.rs  (Framebuffer, window decorations, damage)
#
# Draws the compositor's window stack into the bhumi XRGB8888 framebuffer.
# Minimal skeleton: solid desktop bg + per-window body + titlebar (focus-tinted).
# Damage tracking / scene graph / bitmap text are follow-on parity work.

enum RenderK {
    TITLEBAR_H = 30;
    BTN_W      = 18;   # titlebar button width
    BTN_H      = 18;
    BTN_GAP    = 4;    # gap between buttons
    BTN_MARGIN = 6;    # gap from the window's right edge to the close button
    RESIZE_M   = 6;    # resize-edge grab margin
}

# Which part of a window's decoration a point hits (parity: renderer.rs DecorationHit).
enum Deco {
    DECO_NONE      = 0;
    DECO_BODY      = 1;
    DECO_TITLEBAR  = 2;   # draggable region
    DECO_CLOSE     = 3;
    DECO_MAX       = 4;
    DECO_MIN       = 5;
    DECO_RESIZE_R  = 6;
    DECO_RESIZE_B  = 7;
    DECO_RESIZE_BR = 8;
}

# fill_rect: fill [x,x+w) x [y,y+h) with color, clamped to framebuffer bounds.
#
# ⭐ CLAMP ONCE, THEN WRITE ROWS. This used to call `bhumi_fb_set` per pixel, and that was THE
# compositor frame cost — the thing behind the operator's "aethersafha is a little slow" on the
# 1.56.36 burn, which is the same burn that took the panel from 800x600 to native 2560x1440
# (7.68x the pixels).
#
# ⛔ THE PIXEL COUNT WAS NEVER THE INTERESTING NUMBER — THE PER-PIXEL COST WAS. Measured on the
# host at 2560x1440 (`tests/aethersafha.bcyr`), BEFORE this change:
#
#     bhumi_fb_clear, whole screen  3,686,400 px   3.790 ms   ->  1.03 ns/px
#     chrome, 2 windows             1,843,200 px  23.448 ms   -> 12.72 ns/px
#
# HALF the pixels, SIX TIMES the time — 12.3x more expensive per pixel for byte-identical stores.
# All of that gap is per-pixel overhead, not memory: every single pixel went through a function
# call, four bounds comparisons, and `_bhumi_fb_addr` — which between them re-read **seven**
# `load64`s out of the framebuffer header (width, height, pixels, pitch, bpp) and did two
# multiplies, to store four bytes. None of those seven values can change inside a fill.
#
# So: resolve the header once, clip the rectangle once, and walk rows with a precomputed base and
# stride. Identical pixels land — the old loop clipped per pixel and simply skipped out-of-bounds
# writes, which for a rectangle is exactly a clipped rectangle — and `bhumi_fb_set` remains the
# right call for genuinely scattered single pixels. Uses only bhumi's PUBLIC accessors, so this
# needs no change to bhumi and no tag bump.
fn fill_rect(fb, x, y, w, h, color): i64 {
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    # Empty after clipping — also the h<=0 / w<=0 case the old loop handled by never entering.
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }

    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var row   = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var span  = (x1 - x0) * bpp;
    var yy    = y0;
    while (yy < y1) {
        var p = row;
        var e = row + span;
        while (p < e) {
            store32(p, color);
            p = p + bpp;
        }
        row = row + pitch;
        yy = yy + 1;
    }
    return 0;
}

# blit_rect: copy an sw x sh XRGB8888 source at `src` to (dx,dy), clipped to the framebuffer.
#
# ⭐ The row-walking peer of fill_rect, for the client-surface copy. Same finding, same fix: the
# copy loop in render_window called `bhumi_fb_set` per pixel and measured 23.974 ms/frame for two
# 1280x720 surfaces on the host — marginally WORSE than the chrome fill, for a straight copy.
#
# ⚠ This path does NOT run on iron when the GPU takes the frame (the kernel composites the surface
# out of its GPU-visible shm slot via `gpu_blit_shm #87` and the pixels never enter userland). It
# is still worth fixing and is not dead code: it is the live path on **every QEMU run**, and on any
# iron frame `ae_gpu_frame_plan` refuses. A fallback nobody measures is how a "GPU-accelerated"
# desktop ends up shipping its slow path.
#
# ⛔ CLIPPING MUST SKIP SOURCE PIXELS, NOT JUST DESTINATION ONES. The old per-pixel loop got this
# for free — an out-of-bounds `bhumi_fb_set` dropped the write and the source index moved on. Here
# the source offset has to be advanced by the same amount the destination was clipped by, or a
# partly-offscreen window draws the wrong part of its own surface.
fn blit_rect(fb, dx, dy, src, sw, sh): i64 {
    if (src == 0) { return 0; }
    if (sw <= 0) { return 0; }
    if (sh <= 0) { return 0; }

    var sx0 = 0;
    var sy0 = 0;
    var x0 = dx;
    var y0 = dy;
    if (x0 < 0) { sx0 = 0 - x0; x0 = 0; }        # clipped off the left: skip that many src columns
    if (y0 < 0) { sy0 = 0 - y0; y0 = 0; }        # clipped off the top:  skip that many src rows
    var x1 = dx + sw;
    var y1 = dy + sh;
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }

    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var drow  = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var srow  = (src + sy0 * sw * 4) + sx0 * 4;
    var n     = x1 - x0;
    var yy    = y0;
    while (yy < y1) {
        var d = drow;
        var s = srow;
        var i = 0;
        while (i < n) {
            store32(d, load32(s));
            d = d + bpp;
            s = s + 4;
            i = i + 1;
        }
        drow = drow + pitch;
        srow = srow + sw * 4;
        yy = yy + 1;
    }
    return 0;
}

# rend_blend(dst, src, a): alpha-blend src over dst, a in 0..255. XRGB8888.
# Parity: renderer.rs blend() (premultiplied-alpha compositing).
fn rend_blend(dst, src, a): i64 {
    var ia = 255 - a;
    var dr = (dst >> 16) & 0xFF;
    var dg = (dst >> 8) & 0xFF;
    var db = dst & 0xFF;
    var sr = (src >> 16) & 0xFF;
    var sg = (src >> 8) & 0xFF;
    var sb = src & 0xFF;
    var r = (sr * a + dr * ia) / 255;
    var g = (sg * a + dg * ia) / 255;
    var b = (sb * a + db * ia) / 255;
    return (r << 16) | (g << 8) | b;
}

# ⛔ DECLARED HERE, NOT IN gpu.cyr, AND THE PLACEMENT IS LOAD-BEARING.
# render.cyr is included BEFORE gpu.cyr (main.cyr:16 vs :17). A cyrius FUNCTION forward-reference
# resolves but a VARIABLE forward-reference does NOT. These were first written into gpu.cyr, where
# `cyrius build src/main.cyr` succeeded while three tests failed to compile with "undefined
# variable 'ae_frame_dmg'" — the harness compiles render.cyr in a unit that never reaches gpu.cyr.
# ⚠ The lesson is not "move the variable" — it is that a green `cyrius build` on the umbrella
# does NOT prove the modules compile independently. Run `cyrius test`.
var ae_frame_dmg = 0;              # the per-frame damage tracker (allocated at startup)
var ae_dmg_primed = 0;             # 0 until the first frame has done a FULL clear

# ⭐ THE FRAME PLAN — the single place "is this a GPU frame?" is decided.
# Written once per frame by ae_gpu_frame_plan (gpu.cyr) BEFORE anything is rendered; read by
# render_window below and by ae_gpu_present_frame. ⛔ Nothing else may set these, and nothing may
# re-derive the answer: the bug this replaced was two places deciding the same question from
# different data, so the renderer skipped its CPU composite for a frame the GPU then refused,
# and the desktop showed chrome with no window content.
# ⚠ Declared here rather than in gpu.cyr for the forward-reference reason above — and it also
# keeps render.cyr free of any call INTO gpu.cyr, so the module still compiles standalone (which
# is what tests/render.tcyr and tests/shell_render.tcyr rely on).
var ae_gpu_frame_ok = 0;           # 1 = the GPU will composite this whole frame
var ae_gpu_plan_n = 0;             # window count the plan was computed against (staleness guard)

# Damage tracker — a per-frame dirty-rect bounding box (parity: DamageTracker).
enum DmgOff {
    D_VALID = 0;
    D_X0    = 8;
    D_Y0    = 16;
    D_X1    = 24;
    D_Y1    = 32;
    D_SZ    = 40;
}
fn rend_dmg_new(): i64 {
    var d = alloc(D_SZ);
    if (d == 0) { return 0; }
    store64(d + D_VALID, 0);
    return d;
}
fn rend_dmg_valid(d) { return load64(d + D_VALID); }
fn rend_dmg_add(d, x, y, w, h): i64 {
    var x1 = x + w;
    var y1 = y + h;
    if (load64(d + D_VALID) == 0) {
        store64(d + D_X0, x);
        store64(d + D_Y0, y);
        store64(d + D_X1, x1);
        store64(d + D_Y1, y1);
        store64(d + D_VALID, 1);
        return 0;
    }
    if (x < load64(d + D_X0)) { store64(d + D_X0, x); }
    if (y < load64(d + D_Y0)) { store64(d + D_Y0, y); }
    if (x1 > load64(d + D_X1)) { store64(d + D_X1, x1); }
    if (y1 > load64(d + D_Y1)) { store64(d + D_Y1, y1); }
    return 0;
}
fn rend_dmg_x(d) { return load64(d + D_X0); }
fn rend_dmg_y(d) { return load64(d + D_Y0); }
fn rend_dmg_w(d) { return load64(d + D_X1) - load64(d + D_X0); }
fn rend_dmg_h(d) { return load64(d + D_Y1) - load64(d + D_Y0); }
fn rend_dmg_clear(d) { store64(d + D_VALID, 0); return 0; }

# Titlebar button x-positions (right-aligned: close, then maximize, then minimize).
fn deco_close_x(win) { return win_x(win) + win_w(win) - BTN_MARGIN - BTN_W; }
fn deco_max_x(win)   { return deco_close_x(win) - BTN_GAP - BTN_W; }
fn deco_min_x(win)   { return deco_max_x(win) - BTN_GAP - BTN_W; }
fn deco_btn_y(win)   { return win_y(win) + (TITLEBAR_H - BTN_H) / 2; }

# Is (px,py) inside the BTN_W x BTN_H button at (bx,by)?
fn deco_in_btn(px, py, bx, by): i64 {
    if (px < bx) { return 0; }
    if (px >= bx + BTN_W) { return 0; }
    if (py < by) { return 0; }
    if (py >= by + BTN_H) { return 0; }
    return 1;
}

# deco_hit(win, px, py): which decoration part of the window is under the point.
# Used by input routing to dispatch clicks (close/min/max/drag/resize).
fn deco_hit(win, px, py): i64 {
    var x = win_x(win);
    var y = win_y(win);
    var w = win_w(win);
    var h = win_h(win);
    if (px < x) { return Deco.DECO_NONE; }
    if (py < y) { return Deco.DECO_NONE; }
    if (px >= x + w) { return Deco.DECO_NONE; }
    if (py >= y + h) { return Deco.DECO_NONE; }
    # resize edges — bottom-right corner takes priority
    var nr = 0;
    var nb = 0;
    if (px >= x + w - RESIZE_M) { nr = 1; }
    if (py >= y + h - RESIZE_M) { nb = 1; }
    if ((nr == 1) && (nb == 1)) { return Deco.DECO_RESIZE_BR; }
    if (nr == 1) { return Deco.DECO_RESIZE_R; }
    if (nb == 1) { return Deco.DECO_RESIZE_B; }
    # titlebar: buttons first, else the draggable strip
    if (py < y + TITLEBAR_H) {
        var by = deco_btn_y(win);
        if (deco_in_btn(px, py, deco_close_x(win), by) == 1) { return Deco.DECO_CLOSE; }
        if (deco_in_btn(px, py, deco_max_x(win), by) == 1) { return Deco.DECO_MAX; }
        if (deco_in_btn(px, py, deco_min_x(win), by) == 1) { return Deco.DECO_MIN; }
        return Deco.DECO_TITLEBAR;
    }
    return Deco.DECO_BODY;
}

fn render_window(fb, win, focused): i64 {
    var x = win_x(win);
    var y = win_y(win);
    var w = win_w(win);
    var h = win_h(win);
    var th = rupa_theme_active();
    # body — the window content surface
    fill_rect(fb, x, y + TITLEBAR_H, w, h - TITLEBAR_H, ae_bhumi(rupa_theme_widget(th)));
    # titlebar: panel when idle, raised (widget) when focused
    var tb = ae_bhumi(rupa_theme_panel(th));
    if (focused == 1) { tb = ae_bhumi(rupa_theme_widget(th)); }
    fill_rect(fb, x, y, w, TITLEBAR_H, tb);
    # a focused window gets a 2px accent seal-strip along the titlebar's lower edge
    # (the theme's ONE bold hue = "this window is active/verified")
    if (focused == 1) { fill_rect(fb, x, y + TITLEBAR_H - 2, w, 2, ae_bhumi(rupa_theme_accent(th))); }
    # title text — primary ink when focused, muted otherwise
    var tc = ae_bhumi(rupa_theme_mute(th));
    if (focused == 1) { tc = ae_bhumi(rupa_theme_ink(th)); }
    draw_text(fb, win_title(win), x + 6, y + (TITLEBAR_H - FONT_H) / 2, tc);
    # decoration buttons: close = alert, maximize = held, minimize = faint
    var by = deco_btn_y(win);
    fill_rect(fb, deco_close_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_alert(th)));
    fill_rect(fb, deco_max_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_held(th)));
    fill_rect(fb, deco_min_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_faint(th)));
    # Composite the client's PRESENTED surface (setu shared-buffer pixels), if any, into the
    # window body below the titlebar. Re-run EVERY frame from the cached buffer so the surface
    # persists on screen — the desktop redraw above would otherwise overwrite it (it did: the
    # present composited for one frame, then vanished, leaving the screendump blank). w×h are
    # the surface dims (comp_create_window used the CREATE_SURFACE w/h). bhumi_fb_set clips to fb.
    var spix = win_pix(win);
    var bid = win_bufid(win);
    #
    # ⚠ SKIPPED ENTIRELY when the GPU has committed to this frame. The client surface is then
    # composited by the KERNEL straight out of its GPU-visible shm slot via gpu_blit_shm #87 (see
    # src/gpu.cyr), which replaces BOTH of the things below: the setu_buf_read #73 full-surface copy AND
    # the per-pixel loop. The pixels never enter userland and never touch the CPU. Chrome above still
    # renders here — #87 composites on top of it, which is exactly why gpu.cyr blits the chrome layer with
    # blit#39's DEFER bit first and presents once at the end.
    #
    # ⛔ THE GATE IS ae_gpu_frame_ok, NOT "is there a GPU". It used to be `ae_gpu_active()` — a flag set
    # once at startup meaning only "a GPU exists and is armed". But ae_gpu_present_frame refuses
    # individual FRAMES for reasons this function cannot see (a window past an edge, a premultiplied
    # surface with no shader path), and on refusal the caller presented the framebuffer as it stood:
    # chrome, and no window content at all. ae_gpu_frame_plan now settles the question for the whole
    # frame BEFORE any of it is drawn, so "the GPU will do it" and "so I will not" are the same fact
    # read from the same place.
    if (ae_gpu_frame_ok == 0) {
        # LIVE surface: pull the client's LATEST frame out of the shared buffer into the cache each
        # frame. A client that keeps writing its buffer (setu_buf_write, no re-present) animates the
        # window. bid == 0 (a one-shot static present) skips this and just blits the cached frame.
        if (bid != 0) {
            if (spix != 0) { setu_buf_read(bid, spix, w * h * 4); }
        }
        # Row-walking copy (blit_rect) rather than the per-pixel bhumi_fb_set loop this used to be.
        # Same pixels, same clipping; measured 23.974 ms -> see blit_rect's header for the numbers.
        if (spix != 0) { blit_rect(fb, x, y + TITLEBAR_H, spix, w, h); }
    }
    return 0;
}

# rend_frame_damage(comp, fb): compute this frame's damage into ae_frame_dmg. Call ONCE at the
# top of the frame, before anything is drawn.
#
# ⛔ THIS WAS `render_frame`, A WHOLE SECOND FRAME PATH THAT NOTHING CALLED.
# 0.9.8 shipped `render_frame` carrying the damage model and the GPU clear, while the live loop
# called `render_desktop` — so none of it ever executed: `#85` was never issued, `rend_dmg_new`
# was reached only from a test, and the `#39` chrome blit was unconditionally full-frame while
# the CHANGELOG described it as damage-limited. Two frame paths is the defect; the fix is one.
# ⚠ THE MERGE DIRECTION WAS FORCED, NOT STYLISTIC: `render_desktop` paints the shell status panel
# and `render_frame` does not, so making the loop call `render_frame` instead would silently have
# dropped the panel. The damage half moved here, as a function `render_desktop` calls.
# ⚠ The two paths also read DIFFERENT theme sources — `desk_bg_color` (the a11y HighContrastTheme,
# via theme_bridge) versus `rupa_theme_bg`. rupa is the arc's shared token lib and the one the
# window chrome, dhancha, crab and jalwa all read, so rupa wins and the desktop background now
# matches the windows drawn on it.
fn rend_frame_damage(comp, fb): i64 {
    # ============================================================================================
    # ⭐ THE DAMAGE MODEL. Computed every frame; NOT yet driving the blit — see gpu.cyr for why
    # (the #84 buffer flip makes a single-frame band two-frames-stale on the other buffer).
    # ============================================================================================
    # 0.9.8 shipped the plumbing and it reduced NOTHING, because the clear touched every pixel and
    # so damage was always the whole screen. The fix is not a bigger clear-optimisation — it is
    # computing damage from what ACTUALLY CHANGED:
    #
    #     damage = union over windows whose rect differs from last frame of { old rect, new rect }
    #
    # ⛔ BOTH RECTS ARE REQUIRED. Without the OLD one, a window that moves leaves its previous
    # pixels behind: the vacated region is never cleared and never re-copied. That failure reads
    # as "the framebuffer is stale", not as "the damage model is wrong", which is the expensive
    # way to find it.
    # ⚠ A window that has never been drawn has an impossible prev-rect (-1) and therefore always
    # counts as changed — a new window must not be mistaken for a stationary one.
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    var wv = comp_windows(comp);
    var wn = vec_len(wv);
    var wi = 0;
    if (ae_frame_dmg != 0) { rend_dmg_clear(ae_frame_dmg); }
    while (wi < wn) {
        var w0 = vec_get(wv, wi);
        if (win_rect_changed(w0) == 1) {
            if (ae_frame_dmg != 0) {
                if (win_px(w0) >= 0) {
                    rend_dmg_add(ae_frame_dmg, win_px(w0), win_py(w0),
                                 win_pw(w0), win_ph(w0) + TITLEBAR_H);
                }
                rend_dmg_add(ae_frame_dmg, win_x(w0), win_y(w0),
                             win_w(w0), win_h(w0) + TITLEBAR_H);
            }
        }
        wi = wi + 1;
    }

    # ⚠ A LIVE CLIENT SURFACE CHANGES WITHOUT ITS RECT MOVING. render_window re-reads a bufid
    # window's buffer every frame, so its CONTENT is damaged even when its geometry is not.
    # Treating those as undamaged would freeze animating windows — the one bug this model could
    # introduce that looks like a client problem rather than a compositor one.
    wi = 0;
    while (wi < wn) {
        var w1 = vec_get(wv, wi);
        if (win_bufid(w1) != 0) {
            if (ae_frame_dmg != 0) {
                rend_dmg_add(ae_frame_dmg, win_x(w1), win_y(w1),
                             win_w(w1), win_h(w1) + TITLEBAR_H);
            }
        }
        wi = wi + 1;
    }

    # ⛔ THE FIRST FRAME IS FULLY DAMAGED, and this is not a corner case — it is the common startup
    # path. On frame 1 every window is "changed" (prev rect = -1), so damage is the union of the
    # WINDOW rects, and the background OUTSIDE every window is not in it. A consumer that trusted
    # that band would leave whatever the framebuffer held at boot showing around the windows — the
    # kind of thing dismissed as a boot artifact instead of diagnosed.
    if (ae_dmg_primed == 0) {
        ae_dmg_primed = 1;
        if (ae_frame_dmg != 0) { rend_dmg_add(ae_frame_dmg, 0, 0, fw, fh); }
    }
    return 0;
}

# The shell status-panel renderer (render_shell_panel + panel_* helpers) lives in
# src/shell_render.cyr — it couples to shell.cyr's SystemStatus + SH_NetStatus,
# so it is kept out of this file to keep render.cyr reusable on its own.

# --- bitmap text (kashi IBM VGA 8x16 console font — see [deps.kashi]) ---------
enum FontK {
    FONT_W   = 8;
    FONT_H   = 16;
    FONT_ADV = 9;   # 8px glyph + 1px spacing
}

# draw_char(fb, ch, x, y, color): blit one kashi VGA 8x16 glyph. Each row is a
# byte; bit (7 - col) = leftmost-first pixel. Requires kashi_font_init() first.
fn draw_char(fb, ch, x, y, color): i64 {
    var row = 0;
    while (row < FONT_H) {
        var bits = kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, row);
        var col = 0;
        while (col < FONT_W) {
            if ((bits & (1 << (7 - col))) != 0) {
                bhumi_fb_set(fb, x + col, y + row, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 1;
}

# draw_text(fb, s, x, y, color): render a NUL-terminated cstring. -> width in px.
fn draw_text(fb, s, x, y, color): i64 {
    var cx = x;
    var i = 0;
    while (1) {
        var ch = load8(s + i);
        if (ch == 0) { break; }
        draw_char(fb, ch, cx, y, color);
        cx = cx + FONT_ADV;
        i = i + 1;
    }
    return cx - x;
}

# draw_text_lines(fb, s, x, y, color): like draw_text, but honors '\n' (0x0A) as a
# line break — a foreign guest's captured stdout is multi-line. NUL ends. Returns
# the total pixel height drawn (from y to the last line's baseline).
fn draw_text_lines(fb, s, x, y, color): i64 {
    var cx = x;
    var cy = y;
    var i = 0;
    while (1) {
        var ch = load8(s + i);
        if (ch == 0) { break; }
        if (ch == 10) {
            cx = x;
            cy = cy + FONT_H + 2;
        } else {
            draw_char(fb, ch, cx, cy, color);
            cx = cx + FONT_ADV;
        }
        i = i + 1;
    }
    return cy - y;
}

# text_width(s): pixel width of a cstring in this font (chars*6 - 1; 0 if empty).
fn text_width(s): i64 {
    var n = 0;
    while (load8(s + n) != 0) { n = n + 1; }
    if (n == 0) { return 0; }
    return n * FONT_ADV - 1;
}
