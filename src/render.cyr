# aethersafha — software renderer over the bhumi framebuffer
# Parity: rust-old/src/renderer.rs  (Framebuffer, window decorations, damage)
#
# Draws the compositor's window stack into the bhumi XRGB8888 framebuffer: per window a themed body, a
# focus-tinted titlebar with its caption and buttons, a 1 px border, and the client surface — blended with the
# kernel's own `#92` arithmetic, so a CPU frame holds the words a GPU frame does. Plus the damage band, the
# chrome rect and glyph queues the GPU frame drains, and the kashi bitmap text.

# ⚠ THE DECODER IS INCLUDED BY THE MODULE THAT NEEDS IT, NOT BY EVERY UNIT THAT COMPILES THIS ONE. All text
# below decodes through it, and render.cyr is compiled by main.cyr, the test and bench files that exercise
# it, and a probe. A unit that missed the include would link `utf8_next` undefined-but-unreachable and trap
# (SIGILL) on the first string it drew — the failure tests/shell_render.tcyr's include note records.
# Include-once makes a unit that also names it free.
include "src/utf8.cyr"

# ⚠ `TITLEBAR_H` USED TO LIVE HERE and now lives in src/window.cyr's `WinGeom`, with the window's
# vertical convention documented beside it. It moved because `compositor.cyr` is included EARLIER than
# this file and therefore could not reach it — so `comp_window_at` open-coded the wrong extent instead.
# Button geometry below is genuinely the renderer's, and stays.
enum RenderK {
    BTN_W      = 18;   # titlebar button width
    BTN_H      = 18;
    BTN_GAP    = 4;    # gap between buttons
    BTN_MARGIN = 6;    # gap from the window's right edge to the close button
    RESIZE_M   = 6;    # resize-edge grab margin
    TITLE_PAD  = 6;    # title inset from the left edge, and its clearance before the minimize button
    BORDER_W   = 1;    # the window border's thickness — Rust's BORDER_WIDTH (renderer.rs:477); see render_border
}

# Which part of a window's decoration a point hits (parity: renderer.rs DecorationHit).
# ⚠ `enum Deco` MOVED TO `src/window.cyr` (2026-08-17). It names WINDOW decoration regions and
# `window.cyr` now acts on them (`win_grip_is_resize`, `win_resize_by`), so leaving the enum here made
# the lower layer depend on the higher one. Every file that includes render.cyr already includes
# window.cyr — verified — so the move costs no consumer anything.

# fill_rect: fill [x,x+w) x [y,y+h) with color, clamped to framebuffer bounds.
#
# ⭐ CLAMP ONCE, THEN WRITE ROWS. This used to call `bhumi_fb_set` per pixel, and that was THE
# compositor frame cost — the thing behind the operator's "aethersafha is a little slow" on the
# 1.56.36 burn, which is the same burn that took the panel from 800x600 to native 2560x1440
# (7.68x the pixels).
#
# ⛔ THE PIXEL COUNT WAS NEVER THE INTERESTING NUMBER — THE PER-PIXEL COST WAS. Measured on the
# host at 2560x1440 (`tests/aethersafha.bcyr`), BEFORE this change:
#
#     bhumi_fb_clear, whole screen  3,686,400 px   3.790 ms   ->  1.03 ns/px
#     chrome, 2 windows             1,843,200 px  23.448 ms   -> 12.72 ns/px
#
# HALF the pixels, SIX TIMES the time — 12.3x more expensive per pixel for byte-identical stores.
# All of that gap is per-pixel overhead, not memory: every single pixel went through a function
# call, four bounds comparisons, and `_bhumi_fb_addr` — which between them re-read **seven**
# `load64`s out of the framebuffer header (width, height, pixels, pitch, bpp) and did two
# multiplies, to store four bytes. None of those seven values can change inside a fill.
#
# So: resolve the header once, clip the rectangle once, and walk rows with a precomputed base and
# stride. Identical pixels land — the old loop clipped per pixel and simply skipped out-of-bounds
# writes, which for a rectangle is exactly a clipped rectangle — and `bhumi_fb_set` remains the
# right call for genuinely scattered single pixels. Uses only bhumi's PUBLIC accessors, so this
# needs no change to bhumi and no tag bump.
# fill_rect_a: fill with `color` at opacity `a` (0..255), blending against what is already there.
# ⭐ M6-C3. `a == 255` delegates to `fill_rect` UNCHANGED — including its `#88` GPU enqueue — so an
# opaque window costs exactly what it did before and the common path is untouched.
# ⭐ THE CPU ARM IS THE KERNEL'S op 0x02, byte for byte (0.17.4): the colour at a constant coverage `a`, each
# destination byte looked up in the colour's rows of the opaque-source table (`rend_blend_utab`). It used to
# blend straight colour and TRUNCATE, so a translucent titlebar on a CPU frame sat up to one step per channel
# off the same titlebar on iron, with an alpha byte of 0 where iron's holds the kernel's. ⚠ Clamped once and
# walked by rows like `fill_rect`; it was a `bhumi_fb_get` / `bhumi_fb_set` pair per pixel.
fn fill_rect_a(fb, x, y, w, h, color, a): i64 {
    if (a >= 255) { return fill_rect(fb, x, y, w, h, color); }
    if (a <= 0) { return 0; }
    # ⭐⭐ THE GPU ROUTE THIS FUNCTION SPENT TWO BURNS WITHOUT. `#92` op 0x02 blends a uniform colour
    # through a coverage mask; a mask of constant `a` makes that `rend_blend` exactly. Queued here, routed
    # by `ae_gpu_emit_chrome_range`, ordered per-window by `ae_gpu_present_frame`.
    # ⛔ GATED ON `ae_chrome_on_gpu()` LIKE EVERY OTHER FILL, so a frame is never half-migrated — and that
    # predicate is itself false whenever the coverage path is unavailable, which is what keeps the CPU arm
    # below reachable AND visible (`#39` carries it). The two must agree; see `ae_chrome_on_gpu`'s banner.
    if (ae_chrome_on_gpu() == 1) {
        if (ae_rect_enqueue_a(fb, x, y, w, h, color, a) == 1) { return 0; }
    }
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    var u = rend_blend_utab(a);
    # the colour's three rows of U, and row 255 for the alpha lane — gpu.cyr makes the colour opaque
    var r0 = u + ((color & 0xFF) << 8);
    var r1 = u + (((color >> 8) & 0xFF) << 8);
    var r2 = u + (((color >> 16) & 0xFF) << 8);
    var r3 = u + 65280;
    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var row   = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var span  = (x1 - x0) * bpp;
    var yy    = y0;
    while (yy < y1) {
        var p = row;
        var e = row + span;
        while (p < e) {
            var d = load32(p);
            if (u == 0) { store32(p, rend_blend(d, color, a)); }
            else {
                var lo = (load8(r1 + ((d >> 8) & 0xFF)) << 8) | load8(r0 + (d & 0xFF));
                var hi = (load8(r3 + ((d >> 24) & 0xFF)) << 24) | (load8(r2 + ((d >> 16) & 0xFF)) << 16);
                store32(p, hi | lo);
            }
            p = p + bpp;
        }
        row = row + pitch;
        yy = yy + 1;
    }
    return 0;
}

fn fill_rect(fb, x, y, w, h, color): i64 {
    # ⭐ `AE-9`: on a GPU frame every chrome rect goes to `#88 gpu_fill_rect` instead of a CPU store loop.
    # ⛔ Decided by `ae_chrome_on_gpu()`, which is a per-FRAME answer — a half-migrated frame has the `#39`
    # blit and the GPU rects overwriting each other. A refused enqueue falls through to the row walk below,
    # and gpu.cyr then retires the path so later frames are consistent rather than partly drawn.
    if (ae_chrome_on_gpu() == 1) {
        if (ae_rect_enqueue(fb, x, y, w, h, color) == 1) { return 0; }
    }
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    # Empty after clipping — also the h<=0 / w<=0 case the old loop handled by never entering.
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }

    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var row   = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var span  = (x1 - x0) * bpp;
    var yy    = y0;
    while (yy < y1) {
        var p = row;
        var e = row + span;
        while (p < e) {
            store32(p, color);
            p = p + bpp;
        }
        row = row + pitch;
        yy = yy + 1;
    }
    return 0;
}

# rend_clear_band: fill rows [y, y+h) across the FULL width with `color`.
#
# ⭐ A FULL-WIDTH BAND IS ONE FLAT RUN, SO WALK IT AS ONE. Measured at 2560x1440 on the host: the band
# via `fill_rect` cost **1.347 ns/px** against `bhumi_fb_clear`'s **1.093 ns/px** for byte-identical
# stores — 23% more, entirely per-ROW overhead (recomputing a base, a span and a loop bound 780 times)
# for rows that are already contiguous when `pitch == width * bpp`. That is the same finding as the
# per-pixel fix one level up, and it matters here because this runs every frame on the biggest span.
# ⚠ Falls back to `fill_rect` when the framebuffer has a PADDED pitch, where the rows genuinely are not
# contiguous. Correct either way; only the constant changes.
fn rend_clear_band(fb, y, h, color): i64 {
    # ⭐ `AE-9`: the clear is a full-width rect, so it rides the same `#88` path. This is the big one —
    # `AE-0a` measured the clear at 3.83 ms of a 6.40 ms frame and then cut it to 2.46 ms by shrinking it
    # to a band; on the GPU it becomes a CP-DMA fill instead of a CPU store loop entirely.
    if (ae_chrome_on_gpu() == 1) {
        if (ae_rect_enqueue(fb, 0, y, bhumi_fb_width(fb), h, color) == 1) { return 0; }
    }
    var fh = bhumi_fb_height(fb);
    var y0 = y;
    var y1 = y + h;
    if (y0 < 0) { y0 = 0; }
    if (y1 > fh) { y1 = fh; }
    if (y1 <= y0) { return 0; }
    var fw = bhumi_fb_width(fb);
    var pitch = bhumi_fb_pitch(fb);
    var bpp = bhumi_fb_bpp(fb);
    if (pitch != fw * bpp) { return fill_rect(fb, 0, y0, fw, y1 - y0, color); }
    var p = bhumi_fb_pixels(fb) + y0 * pitch;
    var e = bhumi_fb_pixels(fb) + y1 * pitch;
    while (p < e) {
        store32(p, color);
        p = p + 4;
    }
    return 0;
}

# blit_rect: copy an sw x sh XRGB8888 source at `src` to (dx,dy), clipped to the framebuffer.
#
# ⭐ The row-walking peer of fill_rect, for the client-surface copy. Same finding, same fix: the
# copy loop in render_window called `bhumi_fb_set` per pixel and measured 23.974 ms/frame for two
# 1280x720 surfaces on the host — marginally WORSE than the chrome fill, for a straight copy.
#
# ⚠ This path does NOT run on iron when the GPU takes the frame (the kernel composites the surface
# out of its GPU-visible shm slot via `gpu_blit_shm #87` and the pixels never enter userland). It
# is still worth fixing and is not dead code: it is the live path on **every QEMU run**, and on any
# iron frame `ae_gpu_frame_plan` refuses. A fallback nobody measures is how a "GPU-accelerated"
# desktop ends up shipping its slow path.
#
# ⛔ CLIPPING MUST SKIP SOURCE PIXELS, NOT JUST DESTINATION ONES. The old per-pixel loop got this
# for free — an out-of-bounds `bhumi_fb_set` dropped the write and the source index moved on. Here
# the source offset has to be advanced by the same amount the destination was clipped by, or a
# partly-offscreen window draws the wrong part of its own surface.
fn blit_rect(fb, dx, dy, src, sw, sh): i64 {
    if (src == 0) { return 0; }
    if (sw <= 0) { return 0; }
    if (sh <= 0) { return 0; }

    var sx0 = 0;
    var sy0 = 0;
    var x0 = dx;
    var y0 = dy;
    if (x0 < 0) { sx0 = 0 - x0; x0 = 0; }        # clipped off the left: skip that many src columns
    if (y0 < 0) { sy0 = 0 - y0; y0 = 0; }        # clipped off the top:  skip that many src rows
    var x1 = dx + sw;
    var y1 = dy + sh;
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }

    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var drow  = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var srow  = (src + sy0 * sw * 4) + sx0 * 4;
    var n     = x1 - x0;
    var yy    = y0;
    while (yy < y1) {
        var d = drow;
        var s = srow;
        var i = 0;
        while (i < n) {
            store32(d, load32(s));
            d = d + bpp;
            s = s + 4;
            i = i + 1;
        }
        drow = drow + pitch;
        srow = srow + sw * 4;
        yy = yy + 1;
    }
    return 0;
}

# rend_composite_surface(fb, dx, dy, src, sw, sh, premul, alpha): put a client surface on a CPU frame the way
# gpu.cyr's per-window routing puts it on a GPU frame (`ae_gpu_present_frame` step 2). A PREMULTIPLIED surface
# is blended — `#92` op 0x01 at full opacity, op 0x06 at the window's `alpha` — and any other surface is
# copied, as `#87` copies it, at any opacity: `#87` has no alpha, and neither does this copy.
# ⚠ The GPU arm falls back to `#87` for a premultiplied surface on a boot with no shader envelope; a CPU frame
# always blends, i.e. it draws what iron with the envelope draws, which is the iron-proven configuration.
fn rend_composite_surface(fb, dx, dy, src, sw, sh, premul, alpha): i64 {
    if (premul == 1) { return rend_composite_premul(fb, dx, dy, src, sw, sh, alpha); }
    return blit_rect(fb, dx, dy, src, sw, sh);
}

# rend_composite_premul(fb, dx, dy, src, sw, sh, alpha): src-over a premultiplied sw x sh surface at (dx,dy),
# clipped exactly as `blit_rect` clips — source pixels skipped by the amount the destination was clipped.
# ⭐ Exact shortcuts keep the common case cheap: a pixel with alpha 255 IS the op 0x01 result (ia = 0) and is
# four lookups in the opaque-source table under op 0x06, and a zero pixel leaves the destination as it was
# under either op (sa = sc = 0). Measured on the host, 1280x720, per frame: a copy 2.2 ms; op 0x01 over
# opaque pixels 3.3 ms, over sa = 128 pixels 19.2 ms; op 0x06 at alpha 128 over opaque pixels 11.4 ms.
fn rend_composite_premul(fb, dx, dy, src, sw, sh, alpha): i64 {
    if (src == 0) { return 0; }
    if (sw <= 0) { return 0; }
    if (sh <= 0) { return 0; }
    if (alpha <= 0) { return 0; }                # op 0x06 at alpha 0: fa = 0, so every pixel stays as it was
    var sx0 = 0;
    var sy0 = 0;
    var x0 = dx;
    var y0 = dy;
    if (x0 < 0) { sx0 = 0 - x0; x0 = 0; }
    if (y0 < 0) { sy0 = 0 - y0; y0 = 0; }
    var x1 = dx + sw;
    var y1 = dy + sh;
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    var u = 0;
    if (alpha < 255) { u = rend_blend_utab(alpha); }       # also builds the per-alpha tables
    var pitch = bhumi_fb_pitch(fb);
    var bpp   = bhumi_fb_bpp(fb);
    var drow  = (bhumi_fb_pixels(fb) + y0 * pitch) + x0 * bpp;
    var srow  = (src + sy0 * sw * 4) + sx0 * 4;
    var n     = x1 - x0;
    var yy    = y0;
    while (yy < y1) {
        var d = drow;
        var s = srow;
        var i = 0;
        while (i < n) {
            var sp = load32(s);
            if (sp != 0) {
                if (alpha >= 255) {
                    if ((sp >> 24) == 255) { store32(d, sp); }
                    else { store32(d, rend_px_premul(sp, load32(d))); }
                }
                else {
                    var dp = load32(d);
                    if ((sp >> 24) == 255) {
                        if (u != 0) {
                            # four lookups in U, the alpha lane in row 255 — inline: a call cost more than they do
                            var b0 = load8(u + ((sp & 0xFF) << 8) + (dp & 0xFF));
                            var b1 = load8(u + (((sp >> 8) & 0xFF) << 8) + ((dp >> 8) & 0xFF));
                            var b2 = load8(u + (((sp >> 16) & 0xFF) << 8) + ((dp >> 16) & 0xFF));
                            var b3 = load8(u + 65280 + ((dp >> 24) & 0xFF));
                            store32(d, ((b3 << 24) | (b2 << 16)) | ((b1 << 8) | b0));
                        }
                        else { store32(d, rend_px_alpha(sp, dp)); }
                    }
                    else { store32(d, rend_px_alpha(sp, dp)); }
                }
            }
            d = d + bpp;
            s = s + 4;
            i = i + 1;
        }
        drow = drow + pitch;
        srow = srow + sw * 4;
        yy = yy + 1;
    }
    return 0;
}

# ============================================================================================
# ⭐⭐ THE CPU BLEND IS THE KERNEL'S BLEND — `#92` op 0x01, op 0x06 and op 0x02, byte for byte (0.17.4)
# ============================================================================================
# On iron the kernel composites a premultiplied client surface with `#92` op 0x01 (op 0x06 under a window
# opacity) and every alpha chrome rect with op 0x02. A CPU frame — QEMU, Linux, a demoted agnos frame — copied
# every surface opaquely and blended chrome straight-colour with truncation, so one scene was two pictures.
# These functions compute what the shaders compute, ALL FOUR BYTES (the alpha lane included), so the two frame
# kinds hold the same words. The oracle is agnos, read-only: kernel/shaders/blend_rect.s, blend_alpha.s and
# blend_cov.s; `blend_ref_px` in kernel/core/gpu.cyr; and the shader interpreter, tests/gpu/shaderexec.cyr.
#
# ⭐ op 0x02 AND op 0x06 ARE ONE COMPUTATION. blend_cov.s with a constant mask `a` over the opaque colour
# gpu.cyr forms (`colour | 0xFF000000`) runs, instruction for instruction, what blend_alpha.s runs at alpha `a`
# over an opaque source pixel: f = R(a·INV), sa' = R(255·f), ia = R(1 − sa'·INV), sc' = R(c·f) and
# out = cvt(R(d·ia + sc')), where R is f32 rounding and INV = 0x3B808081 is f32's 1/255.
#
# ⭐⭐ EVERY f32 THESE SHADERS FORM IS AN INTEGER IN 2^-31 UNITS, which is what lets a CPU run them exactly in
# integers. INV is 8421505·2^-31. fa = R(α·INV) and sa' = sc' = R(fa·v) are 0 or ≥ 2^-8, whose last bit is
# ≥ 2^-31. ia ≥ 1/256 for any α < 255, and at α = 255 fa is exactly 1.0, so ia = R((2^31 − 8421505·sa)·2^-31).
# Only `1 − sa'·INV` itself needs 2^-62 units, and it is rounded straight back. The final d·ia + sc' is below
# 510·2^31 < 2^40, so nothing here comes near i64's range.
# ⚠ CHECKED, NOT JUST DERIVED (0.17.4): an IEEE-f32 model of the three shaders (numpy's float32 multiply, the
# FMA rounded once from its exact value) was run over all 2^32 (α, sa, sc, d) lane inputs, and its 64-bit
# digest per alpha equals this file's for all 256 alphas; the same model of blend_rect.s equals `blend_ref_px`
# input for input on all 2^24 of its own. tests/render.tcyr carries the model's words and digests.

# The f32 constants of op 0x06 / 0x02 for one alpha, in 2^-31 units. Rebuilt only when the alpha changes.
# ⚠ MODULE SCOPE, so `var X[256]` is 256 x u64; a function-local one would be 256 BYTES.
var ae_bl_alpha = 0 - 1;     # the alpha the two tables were built for (-1 = none yet)
var ae_bl_s2[256];           # R(fa·v): v_mul_f32 of a source byte — sc' for a colour byte, sa' for the alpha
var ae_bl_ia[256];           # R(1 − sa'·INV): v_fma_f32's destination weight, indexed by the source alpha

# rend_f32_round(n): the integer n > 0 rounded to 24 significant bits, ties to even — f32's RNE rounding of
# n·2^-k for any fixed k, because a power-of-two scale only moves the binary point. Below 2^24 n is exact.
fn rend_f32_round(n): i64 {
    if (n < 16777216) { return n; }
    var s = 0;
    var t = n;
    while (t >= 16777216) { t = t >> 1; s = s + 1; }
    var q = n >> s;
    var r = n - (q << s);
    var h = 1 << (s - 1);
    if (r > h) { q = q + 1; }
    if (r == h) { q = q + (q & 1); }
    return q << s;
}

# rend_u8_of(v): what v_cvt_pk_u8_f32 makes of the FMA's result, where `v` is the EXACT d·ia + sc' in 2^-31
# units: R(v) saturated to 0..255 and rounded to the nearest integer, ties to EVEN.
# ⭐ R only matters within half an f32 ulp of a half-integer — at most 2^15 units below 512 — so outside that
# window the exact value rounds the same way and the 24-bit rounding is skipped; inside it, it runs.
# ⛔ TIES TO EVEN IS THE KERNEL'S ASSUMPTION, NOT A BURNED FACT. op 0x01 never reaches a tie; op 0x06 does
# (agnos tests/gpu/shaderexec.cyr gate 4: α = 4, sa = sc = 64, d = 128 lands on 128.5 exactly, RTNE 128,
# half-away 129). The shaders declare `.amdhsa_float_round_mode_32 0` (round to nearest even) and the
# kernel's interpreter models RTNE; no burn has discriminated it. A burn that overturns it changes this.
fn rend_u8_of(v): i64 {
    if (v <= 0) { return 0; }
    var q = v >> 31;
    if (q >= 255) { return 255; }
    var dh = (v & 0x7FFFFFFF) - 0x40000000;
    if (dh > 32768) { return q + 1; }
    if (dh < 0 - 32768) { return q; }
    var f = rend_f32_round(v);
    q = f >> 31;
    var r = f & 0x7FFFFFFF;
    if (r > 0x40000000) { return q + 1; }
    if (r < 0x40000000) { return q; }
    return q + (q & 1);
}

# Build the per-alpha tables (no-op when they already hold `alpha`). -> 1 if rebuilt.
fn rend_blend_tables(alpha): i64 {
    var al = alpha;
    if (al < 0) { al = 0; }
    if (al > 255) { al = 255; }
    if (al == ae_bl_alpha) { return 0; }
    var fa = rend_f32_round(al * 8421505);                  # v_mul_f32 INV, f32(alpha)
    var v = 0;
    while (v < 256) {
        var s2 = rend_f32_round(fa * v);                    # v_mul_f32 fa, f32(byte)
        store64(&ae_bl_s2 + v * 8, s2);
        # v_fma_f32 sa', -INV, 1.0: exact in 2^-62 units, rounded once; the result is a whole 2^-31 unit
        var e = (1 << 62) - s2 * 8421505;
        var ia = 0;
        if (e > 0) { ia = rend_f32_round(e) >> 31; }
        if (e < 0) { ia = 0 - (rend_f32_round(0 - e) >> 31); }   # only at α = 255, sa = 255: −127·2^-31
        store64(&ae_bl_ia + v * 8, ia);
        v = v + 1;
    }
    ae_bl_alpha = al;
    return 1;
}

# rend_px_premul(src, dst): `#92` op 0x01 BLEND_RECT for one pixel — premultiplied src-over, all four bytes.
# ⭐ The kernel's own integer reference, `blend_ref_px` (kernel/core/gpu.cyr):
#     out = min(255, sc + round_half_up(d·(255 − sa) / 255))
# which its burned f32 shader matches on all 2^24 (sa, sc, d) — and a tie is unreachable, since 2·d·(255 − sa)
# is even and 255·(2k + 1) is odd.
# Parity: renderer.rs:46-69 `blend()` is the same premultiplied src-over, but it TRUNCATES (`d * inv / 255`)
# and returns `dst` for any zero-alpha source; the kernel rounds to nearest and ADDS a zero-alpha source's
# colour (the additive ghost of a client that writes alpha 0). The two agree on every opaque and every
# transparent-black pixel and differ by one step in a channel elsewhere (ADR 0003).
fn rend_px_premul(src, dst): i64 {
    var ia2 = (255 - ((src >> 24) & 0xFF)) * 2;
    var out = 0;
    var sh = 0;
    while (sh < 32) {
        var r = ((src >> sh) & 0xFF) + ((((dst >> sh) & 0xFF) * ia2) + 255) / 510;
        if (r > 255) { r = 255; }
        out = out | (r << sh);
        sh = sh + 8;
    }
    return out;
}

# rend_px_alpha(src, dst): `#92` op 0x06 BLEND_ALPHA for one pixel at the alpha `rend_blend_tables` holds —
# the source's four bytes scaled by fa = R(α/255), then src-over.
# ⭐ HOW WINDOW OPACITY COMPOSES WITH THE CLIENT'S ALPHA: they multiply. A premultiplied pixel (sa, sc) under
# window opacity α composites as (sa·α/255, sc·α/255), so premultiplication (sc ≤ sa) survives the scaling.
fn rend_px_alpha(src, dst): i64 {
    var ia = load64(&ae_bl_ia + ((src >> 24) & 0xFF) * 8);
    var out = 0;
    var sh = 0;
    while (sh < 32) {
        var v = ((dst >> sh) & 0xFF) * ia + load64(&ae_bl_s2 + ((src >> sh) & 0xFF) * 8);
        out = out | (rend_u8_of(v) << sh);
        sh = sh + 8;
    }
    return out;
}

# rend_blend_alpha_px(src, dst, alpha): op 0x06 for one pixel at any alpha 0..255 (255 equals op 0x01).
fn rend_blend_alpha_px(src, dst, alpha): i64 {
    rend_blend_tables(alpha);
    return rend_px_alpha(src, dst);
}

# rend_blend(dst, color, a): `#92` op 0x02 BLEND_COV for one pixel — the opaque `color` at a constant coverage
# `a`, over `dst`, all four bytes. The per-pixel form of what `fill_rect_a` does to a rect.
# ⚠ THE COLOUR IS MADE OPAQUE HERE because gpu.cyr makes it opaque at the emit (`| 0xFF000000`): op 0x02 forms
# sa' from the colour's alpha byte, and a theme colour arrives with a 0 there.
# ⚠ Not Rust: renderer.rs had no alpha fill — `fill_rect` overwrote with the ARGB colour, alpha and all.
fn rend_blend(dst, color, a): i64 {
    return rend_blend_alpha_px(color | 0xFF000000, dst, a);
}

# ⭐ THE OPAQUE-SOURCE TABLE: op 0x06's output byte for every (source byte, destination byte), U[(s << 8) | d],
# at one alpha — for a source pixel whose alpha byte is 255, which shares one destination weight ia(255). That
# is every chrome fill (an opaque colour) and nearly every pixel of a client surface, so both walks become four
# lookups per pixel. Measured on the host, a 1280x720 rect at alpha 128: an opaque surface 36 ns/px through
# `rend_px_alpha` and 12 through U (11.4 ms a frame); a chrome fill 6.3 ns/px (5.8 ms), where 0.17.3's
# straight-colour `bhumi_fb_get` / `bhumi_fb_set` walk took 34 (31.4 ms).
# ⚠ 64 KB, ALLOCATED ONCE and rebuilt (65,536 conversions) only when the alpha changes. One alpha at a time:
# `--opacity` gives every window the same one. An allocation per build would leak — the allocator never frees.
var ae_bl_u = 0;
var ae_bl_u_alpha = 0 - 1;   # the alpha U holds (-1 = none yet)
# -> U for `alpha`, or 0 if it could not be allocated (the caller then blends per pixel, as exactly).
fn rend_blend_utab(alpha): i64 {
    rend_blend_tables(alpha);
    if (ae_bl_u_alpha == ae_bl_alpha) { return ae_bl_u; }
    if (ae_bl_u == 0) { ae_bl_u = alloc(65536); }
    if (ae_bl_u == 0) { return 0; }
    var ia = load64(&ae_bl_ia + 255 * 8);
    var sv = 0;
    while (sv < 256) {
        var s2 = load64(&ae_bl_s2 + sv * 8);
        var row = ae_bl_u + (sv << 8);
        var dv = 0;
        while (dv < 256) {
            store8(row + dv, rend_u8_of(dv * ia + s2));
            dv = dv + 1;
        }
        sv = sv + 1;
    }
    ae_bl_u_alpha = ae_bl_alpha;
    return ae_bl_u;
}

# ⛔ DECLARED HERE, NOT IN gpu.cyr, AND THE PLACEMENT IS LOAD-BEARING.
# render.cyr is included BEFORE gpu.cyr (main.cyr:16 vs :17). A cyrius FUNCTION forward-reference
# resolves but a VARIABLE forward-reference does NOT. These were first written into gpu.cyr, where
# `cyrius build src/main.cyr` succeeded while three tests failed to compile with "undefined
# variable 'ae_frame_dmg'" — the harness compiles render.cyr in a unit that never reaches gpu.cyr.
# ⚠ The lesson is not "move the variable" — it is that a green `cyrius build` on the umbrella
# does NOT prove the modules compile independently. Run `cyrius test`.
var ae_frame_dmg = 0;              # the per-frame damage tracker (allocated at startup)
var ae_dmg_primed = 0;             # 0 until the first frame has done a FULL clear

# ⭐⭐ `AE-0a` — THE DAMAGE BAND, AND WHY IT IS `union(cur, prev)` AND FULL-WIDTH.
#
# Two constraints decide this shape, and both are in the kernel rather than here:
#
# 1. ⛔ `#84 present` FLIPS THE RENDER TARGET on every present (agnos `kernel/core/gpu.cyr`:
#    `if (gpu_bb_back == 0) { gpu_bb_back = 1; } else { gpu_bb_back = 0; }`), and `#39` renders into
#    whichever buffer that predicate selects. So a band-limited blit updates buffer A this frame and B
#    the next, and A's rows OUTSIDE this frame's band still hold what was there TWO frames ago.
#    ⇒ The band written each frame must cover everything that changed in THIS frame **or the last**:
#    `union(cur, prev)`. Anything narrower leaves a trailing ghost at a two-frame lag in exactly the
#    rows a window vacated — which reads as "the framebuffer is stale", not "the damage model is
#    wrong", and that misreading is why this bite stalled twice.
#    ⭐ The first two frames come out full-screen for free: frame 1 is primed full, so frame 2's union
#    still contains it — which is exactly what is needed to initialise BOTH buffers.
#
# 2. ⛔ FULL-WIDTH ROWS ONLY. `#39 blit` takes its source **tightly packed, w*4 bytes per row, with no
#    stride parameter**, so an arbitrary damage RECT's rows are not contiguous and cannot be handed to
#    it at all. A full-width band IS contiguous (the userland fb has pitch == width*4), so the band is
#    expressed as rows `[y, y+h)` and the x extent is discarded. True rect damage needs a stride on
#    `#39` — a kernel ABI change, and not this bite.
#
# ⚠ ONE BAND FOR BOTH CONSUMERS, deliberately. The clear only strictly needs `cur` (the userland fb
# persists across frames and is never flipped), but a second, narrower band would be a second
# invariant to keep in step with the first — and for a desktop with any live client the two are the
# same rows anyway, because a bufid window's CONTENT is damaged every frame.
var ae_prev_dmg = 0;               # the PREVIOUS frame's damage — the other half of the union
var ae_band_valid = 0;             # 1 = ae_band_y/h describe this frame's band; 0 = fall back to full
var ae_band_y = 0;
var ae_band_h = 0;
# ⚠ THE BACKGROUND COLOUR IS PART OF THE DAMAGE INPUT. A theme switch changes every un-damaged pixel
# without moving a single window, so a band-limited clear would leave the old colour everywhere outside
# the band — a stale desktop that no window rect can explain. -1 = no frame has been cleared yet.
var ae_last_bg = 0 - 1;
var ae_last_wp = 0 - 1;   # last-seen wallpaper serial; see rend_band_compute
# ⛔⛔ FRAMES OF FULL-SCREEN REPAINT STILL OWED. A whole-screen invalidation costs TWO consecutive
# no-band frames, not one, for exactly the reason `comp_retire` exists (compositor.cyr:196): `#84
# present` FLIPS the render target, so a repaint applied for one frame lands in ONE buffer and the
# other keeps the old pixels — and `#84` alternates them, so the background blinks at half the frame
# rate FOREVER, not for a frame. That is the 2026-08-19 iron report ("themes bg flicker ... happened
# more often than not"), and it is invisible in QEMU because there is no GPU, no flip, one buffer.
var ae_inval_owed = 0;
# ⛔⛔ THE BAND IS ALSO THE GPU'S CLEAR. Since AE-9 the `#39` chrome blit is GONE on iron and the
# back-buffer clear "is simply the first rect in the queue" (gpu.cyr) — i.e. the clear covers the
# BAND, not the buffer. `#84` FLIPS, so any region outside the band keeps THAT buffer's older
# content and the two buffers can disagree there indefinitely. Iron 2026-08-19: background flicker
# outside a launched window's rows (mostly below it), healed by a theme switch — which invalidates
# fully for two frames — and returning on the next launch. QEMU cannot show it: no GPU, no flip.
#
# `--fullclear` forces every frame to take the no-band path, so the whole buffer is repainted each
# frame. It is a DIAGNOSTIC, not a fix: it discards the AE-0a optimisation (3.83 ms -> 2.46 ms of a
# 6.40 ms frame) and costs a full clear per frame. If the flicker disappears under it, the cause is
# "regions outside the band differ between the flipped buffers" and nothing else.
# LAST frame's RAW band (pre-union), so the emitted band can cover both frames without ratcheting.
var ae_band_prev_valid = 0;
var ae_band_prev_y = 0;
var ae_band_prev_h = 0;

# Clear the two-frame carry. ⚠ For TESTS and for a hard discontinuity only: consecutive frames must
# keep it, or the band stops covering both buffers, which is the defect it exists to fix.
fn rend_band_carry_reset(): i64 { ae_band_prev_valid = 0; ae_band_prev_y = 0; ae_band_prev_h = 0; return 0; }

var ae_stale_said    = 0;
var ae_stale_bg_prev = 0 - 1;
var ae_stale_wp_prev = 0 - 1;

# `--clearbg`: full-screen BACKGROUND clear every frame, band kept for everything else. See desktop.cyr.
var ae_clear_bg_all = 0;
fn rend_clear_bg_all_set(v): i64 { ae_clear_bg_all = v; return 0; }
fn rend_clear_bg_all(): i64 { return ae_clear_bg_all; }

# ⚠ DIAGNOSTIC, `--bandbg`: force the BANDED background clear even where the chrome is on the GPU,
# i.e. undo 0.16.18's fix on purpose. It makes the screen FLICKER on iron by design — its only job is
# to put the pre-0.16.18 cost beside the post-0.16.18 cost inside ONE burn, under identical actions.
# ⛔ Never ship a default that sets this.
var ae_clear_bg_band = 0;
fn rend_clear_bg_band_set(v): i64 { ae_clear_bg_band = v; return 0; }
fn rend_clear_bg_band(): i64 { return ae_clear_bg_band; }

var ae_force_full = 0;
fn rend_force_full_set(v): i64 { ae_force_full = v; return 0; }
fn rend_force_full(): i64 { return ae_force_full; }

# Bounded report of the band's extent whenever it CHANGES. A band that oscillates between two
# extents would leave rows covered on one frame and not the next — one buffer updated, the other
# not. Silence here means the band is steady, which is itself the answer to a different question.
var ae_band_last_v = 0 - 1;
var ae_band_last_y = 0 - 1;
var ae_band_last_h = 0 - 1;
var ae_band_said   = 0;
fn rend_band_note(): i64 {
    # ⛔ `valid` IS PART OF THE STATE. Comparing only y/h made (valid 0, 0, 0) and (valid 1, 0, 0)
    # indistinguishable — and the invalid<->valid transition is the single most important one here,
    # since invalid means "repaint everything" and valid means "repaint the band only". Measured on
    # the host build: the reporter printed once and then never again while the band flipped state.
    var same = 1;
    if (ae_band_last_v != ae_band_valid) { same = 0; }
    if (ae_band_last_y != ae_band_y) { same = 0; }
    if (ae_band_last_h != ae_band_h) { same = 0; }
    if (same == 1) { return 0; }
    ae_band_last_v = ae_band_valid;
    ae_band_last_y = ae_band_y;
    ae_band_last_h = ae_band_h;
    if (ae_band_said >= 14) { return 0; }
    ae_band_said = ae_band_said + 1;
    println("aethersafha: damage band changed (valid, y, h):");
    println_int(ae_band_valid);
    println_int(ae_band_y);
    println_int(ae_band_h);
    return 0;
}

# ⭐ THE FRAME PLAN — the single place "is this a GPU frame?" is decided.
# Written once per frame by ae_gpu_frame_plan (gpu.cyr) BEFORE anything is rendered; read by
# render_window below and by ae_gpu_present_frame. ⛔ Nothing else may set these, and nothing may
# re-derive the answer: the bug this replaced was two places deciding the same question from
# different data, so the renderer skipped its CPU composite for a frame the GPU then refused,
# and the desktop showed chrome with no window content.
# ⚠ Declared here rather than in gpu.cyr for the forward-reference reason above — and it also
# keeps render.cyr free of any call INTO gpu.cyr, so the module still compiles standalone (which
# is what tests/render.tcyr and tests/shell_render.tcyr rely on).
var ae_gpu_frame_ok = 0;           # 1 = the GPU will composite this whole frame
var ae_gpu_plan_n = 0;             # window count the plan was computed against (staleness guard)
# ⛔⛔ 1 = THIS FRAME HAS A TRANSLUCENT WINDOW, SO ITS CHROME CANNOT GO ON THE GPU. Third member of the
# plan, written in the same place and for the same reason; read by `ae_chrome_on_gpu()` below.
#
# ⛔ THE 1.56.44 IRON BURN IS WHY IT EXISTS, AND THE DEFECT WAS MINE. Narrowing the frame plan's
# translucency demote let an `--opacity 128` desktop stay on the GPU — but `fill_rect_a` (:64) has NO
# GPU route: it is a per-pixel read-modify-write into the USERLAND framebuffer and it never calls
# `ae_rect_enqueue`. Everything else about that frame still behaved as if chrome were on the GPU,
# including gpu.cyr's band decision, which zeroes the `#39` blit the moment ANY rect is queued — and the
# three deco buttons (plain `fill_rect`) always are. ⇒ The window BODY fill, the TITLEBAR and the focus
# accent strip were painted into a framebuffer nothing copied to screen. On iron: every window lost its
# titlebar background at `--opacity 128` and kept it at `--opacity 255`.
# ⭐ The mode this selects is COHERENT, not a fallback: chrome, glyphs and the backdrop go on the CPU and
# ride the band blit, while the CLIENT SURFACES still composite on the GPU with `#92` op 0x06 — the
# split the alpha op was built for, with the per-pixel work left on the shader cores.
var ae_gpu_alpha_chrome = 0;
fn ae_gpu_alpha_chrome_on(): i64 { return ae_gpu_alpha_chrome; }

# Damage tracker — a per-frame dirty-rect bounding box (parity: DamageTracker).
enum DmgOff {
    D_VALID = 0;
    D_X0    = 8;
    D_Y0    = 16;
    D_X1    = 24;
    D_Y1    = 32;
    D_SZ    = 40;
}
fn rend_dmg_new(): i64 {
    var d = alloc(D_SZ);
    if (d == 0) { return 0; }
    store64(d + D_VALID, 0);
    return d;
}
fn rend_dmg_valid(d) { return load64(d + D_VALID); }
fn rend_dmg_add(d, x, y, w, h): i64 {
    var x1 = x + w;
    var y1 = y + h;
    if (load64(d + D_VALID) == 0) {
        store64(d + D_X0, x);
        store64(d + D_Y0, y);
        store64(d + D_X1, x1);
        store64(d + D_Y1, y1);
        store64(d + D_VALID, 1);
        return 0;
    }
    if (x < load64(d + D_X0)) { store64(d + D_X0, x); }
    if (y < load64(d + D_Y0)) { store64(d + D_Y0, y); }
    if (x1 > load64(d + D_X1)) { store64(d + D_X1, x1); }
    if (y1 > load64(d + D_Y1)) { store64(d + D_Y1, y1); }
    return 0;
}
# Damage a window's whole on-screen extent: its rect, titlebar included (`total_h`), AND the BORDER_W ring
# `render_border` draws OUTSIDE that rect. ⚠ Every window rect the damage pass folds goes through here, or
# the ring's rows fall outside the band: a moved window leaves its old ring behind, and a translucent one
# re-blends its ring over itself every frame.
fn rend_dmg_add_win(d, x, y, w, total_h): i64 {
    return rend_dmg_add(d, x - BORDER_W, y - BORDER_W, w + 2 * BORDER_W, total_h + 2 * BORDER_W);
}
fn rend_dmg_x(d) { return load64(d + D_X0); }
fn rend_dmg_y(d) { return load64(d + D_Y0); }
fn rend_dmg_w(d) { return load64(d + D_X1) - load64(d + D_X0); }
fn rend_dmg_h(d) { return load64(d + D_Y1) - load64(d + D_Y0); }
fn rend_dmg_clear(d) { store64(d + D_VALID, 0); return 0; }

# ⛔ THE BAND IS READ THROUGH FUNCTIONS, NEVER AS A VARIABLE, AND THAT IS NOT STYLE.
# A cyrius FUNCTION forward-reference resolves; a VARIABLE forward-reference does NOT. desktop.cyr and
# gpu.cyr both consume the band, and `tests/desktop.tcyr` compiles desktop.cyr in a unit that never
# reaches render.cyr at all — so reading `ae_band_valid` directly there compiled fine under
# `cyrius build src/main.cyr` and failed the moment `cyrius test` ran. That is the same trap already
# recorded above for `ae_frame_dmg`, sprung again by a new consumer. Accessors make it impossible.
fn rend_band_valid(): i64 { return ae_band_valid; }
fn rend_band_y(): i64     { return ae_band_y; }
fn rend_band_h(): i64     { return ae_band_h; }

# Copy one tracker over another (used to roll cur -> prev at the top of each frame).
fn rend_dmg_copy(dst, src): i64 {
    if (dst == 0) { return 0; }
    if (src == 0) { return 0; }
    store64(dst + D_VALID, load64(src + D_VALID));
    store64(dst + D_X0, load64(src + D_X0));
    store64(dst + D_Y0, load64(src + D_Y0));
    store64(dst + D_X1, load64(src + D_X1));
    store64(dst + D_Y1, load64(src + D_Y1));
    return 0;
}

# rend_band_compute(fh, bg): fold cur and prev into this frame's full-width row band.
#
# Sets ae_band_valid / ae_band_y / ae_band_h. `ae_band_valid == 0` means "no band — do the whole
# screen", which is the honest answer whenever a tracker is missing (tests allocate neither) or the
# background changed. ⚠ A VALID band of height 0 is a real and correct result: nothing changed in two
# frames, so both buffers already hold the right pixels and there is nothing to write.
# Frames of full-screen repaint still owed after an invalidation. Exposed so a test can assert the
# DEBT and not just its symptom.
fn rend_inval_owed(): i64 { return ae_inval_owed; }

fn rend_band_compute(fh, bg): i64 {
    ae_band_valid = 0;
    ae_band_y = 0;
    ae_band_h = 0;
    if (ae_frame_dmg == 0) { return 0; }
    if (ae_prev_dmg == 0) { return 0; }
    # ⚠ DIAGNOSTIC: repaint everything, every frame. See ae_force_full.
    if (ae_force_full == 1) { return 0; }
    # A background change damages every pixel, so refuse to band this frame at all — and so does a
    # WALLPAPER change, which the `bg` compare cannot see (M6-C1a): two different gradients can share a
    # top colour, so comparing one i64 would band a frame in which every pixel changed, repainting only
    # the rows a window happened to be moving in and leaving the rest of the old wallpaper on screen.
    #
    # ⛔⛔ BOTH ARE SAMPLED AND STORED BEFORE EITHER CAN RETURN, AND THAT IS NOT STYLE. Written as two
    # sequential `if (x != last) { last = x; return 0; }` gates, each one CONSUMES A FRAME on first
    # sight: the `bg` gate returns before the wallpaper gate ever stores its baseline, so priming took
    # two frames instead of one and the first real band arrived a frame late. `render.tcyr`'s
    # "idle: a band IS computed" caught it immediately — the failure was a THIRD call being needed.
    # ⇒ One sample, one store, one decision. Adding a third invalidation source later must follow this
    # shape, not append another early-returning gate.
    var wps = wp_serial();
    var stale = 0;
    if (bg != ae_last_bg) { stale = 1; }
    if (wps != ae_last_wp) { stale = 1; }
    ae_last_bg = bg;
    ae_last_wp = wps;
    # ⛔ TWO FRAMES, ONE PER BUFFER — see ae_inval_owed. Returning here on the change frame ALONE was
    # the defect: `render.tcyr` even asserted it ("the frame AFTER a theme switch bands normally
    # again"), so the suite enshrined the stale buffer as correct.
    # ⛔ NAME WHAT WENT STALE. Iron 2026-08-19 (b7): with the two-frame carry in place the band still
    # alternated invalid <-> valid-height-0 while a client ran — i.e. `stale` was firing over and
    # over — and a full repaint every other frame against a FLIPPED buffer is itself the flicker.
    # Which of the two inputs moves, and to what, cannot be inferred from the band extent alone.
    if (stale == 1) {
        if (ae_stale_said < 10) {
            ae_stale_said = ae_stale_said + 1;
            println("aethersafha: band invalidated (bg, last_bg, wp_serial, last_wp):");
            println_int(bg);
            println_int(ae_stale_bg_prev);
            println_int(wps);
            println_int(ae_stale_wp_prev);
        }
    }
    ae_stale_bg_prev = bg;
    ae_stale_wp_prev = wps;
    if (stale == 1) { ae_inval_owed = 2; }
    if (ae_inval_owed > 0) {
        ae_inval_owed = ae_inval_owed - 1;
        return 0;
    }
    var y0 = fh;
    var y1 = 0;
    if (rend_dmg_valid(ae_frame_dmg) == 1) {
        if (rend_dmg_y(ae_frame_dmg) < y0) { y0 = rend_dmg_y(ae_frame_dmg); }
        if (rend_dmg_y(ae_frame_dmg) + rend_dmg_h(ae_frame_dmg) > y1) {
            y1 = rend_dmg_y(ae_frame_dmg) + rend_dmg_h(ae_frame_dmg);
        }
    }
    if (rend_dmg_valid(ae_prev_dmg) == 1) {
        if (rend_dmg_y(ae_prev_dmg) < y0) { y0 = rend_dmg_y(ae_prev_dmg); }
        if (rend_dmg_y(ae_prev_dmg) + rend_dmg_h(ae_prev_dmg) > y1) {
            y1 = rend_dmg_y(ae_prev_dmg) + rend_dmg_h(ae_prev_dmg);
        }
    }
    # Neither tracker was valid — nothing changed in two frames.
    if (y1 <= y0) {
        ae_band_valid = 1;
        ae_band_y = 0;
        ae_band_h = 0;
        return 0;
    }
    if (y0 < 0) { y0 = 0; }
    if (y1 > fh) { y1 = fh; }
    if (y1 <= y0) {
        ae_band_valid = 1;
        ae_band_y = 0;
        ae_band_h = 0;
        return 0;
    }
    # ⛔⛔ THE BAND ITSELF OWES TWO FRAMES — `#84` FLIPS AND THE BAND *IS* THE GPU'S CLEAR.
    #
    # Since AE-9 the `#39` chrome blit is gone on iron and the back-buffer clear is the band's first
    # rect, so a row outside the band is not merely "not re-copied": it is never painted at all this
    # frame, in THIS buffer. `union(cur, prev)` already buys two frames for anything that goes
    # through the damage trackers — but any row that was inside the band on frame N and outside it on
    # frame N+1 gets painted into ONE buffer and not the other, and `#84` alternates them forever.
    #
    # Iron 2026-08-19 measured exactly that shape: the band moved 458..552 (launcher panel) -> 0..0
    # -> 0..414 -> 0..464 -> 50..464 (settled on the window), so rows the panel had painted fell out
    # of the band, and rows 464..1440 were never painted again. `--fullclear` removed the flicker
    # completely, which is the controlled proof that staleness OUTSIDE the band is the whole cause.
    #
    # ⇒ Emit union(this frame's band, LAST frame's band). Every row painted at N is painted again at
    # N+1, so both buffers converge, whatever produced the damage — including producers that never
    # touch `cur`/`prev`. ⚠ The union is taken against the RAW band, not the emitted one, or it would
    # ratchet outward and never shrink back.
    var ry0 = y0;
    var ry1 = y1;
    if (ae_band_prev_valid == 1) {
        if (ae_band_prev_y < y0) { y0 = ae_band_prev_y; }
        if (ae_band_prev_y + ae_band_prev_h > y1) { y1 = ae_band_prev_y + ae_band_prev_h; }
    }
    ae_band_prev_valid = 1;
    ae_band_prev_y = ry0;
    ae_band_prev_h = ry1 - ry0;
    if (y0 < 0) { y0 = 0; }
    if (y1 > fh) { y1 = fh; }
    ae_band_valid = 1;
    ae_band_y = y0;
    ae_band_h = y1 - y0;
    return 0;
}

# Titlebar button x-positions (right-aligned: close, then maximize, then minimize).
fn deco_close_x(win) { return win_x(win) + win_w(win) - BTN_MARGIN - BTN_W; }
fn deco_max_x(win)   { return deco_close_x(win) - BTN_GAP - BTN_W; }
fn deco_min_x(win)   { return deco_max_x(win) - BTN_GAP - BTN_W; }
fn deco_btn_y(win)   { return win_y(win) + (TITLEBAR_H - BTN_H) / 2; }

# The title's box (parity: renderer.rs:544, `rect.width.saturating_sub(80) // Leave room for buttons`).
# ⚠ Rust's 80 is ITS geometry — the title at x+8, a 50 px cluster of 12 px buttons, 22 px of slack — so the
# box is derived, not copied: it runs from TITLE_PAD inside the left edge to TITLE_PAD short of the minimize
# button. Today that comes to `w - 80`, Rust's own number; it moves with the buttons if they ever change.
fn deco_title_x(win) { return win_x(win) + TITLE_PAD; }
fn deco_title_w(win): i64 {
    var tw = deco_min_x(win) - TITLE_PAD - deco_title_x(win);
    if (tw < 0) { return 0; }                     # Rust: saturating_sub
    return tw;
}

# Is (px,py) inside the BTN_W x BTN_H button at (bx,by)?
fn deco_in_btn(px, py, bx, by): i64 {
    if (px < bx) { return 0; }
    if (px >= bx + BTN_W) { return 0; }
    if (py < by) { return 0; }
    if (py >= by + BTN_H) { return 0; }
    return 1;
}

# deco_hit(win, px, py): which decoration part of the window is under the point (parity: renderer.rs
# decoration_hit_test, :607-669). Used by input routing (src/route.cyr) to dispatch clicks
# (close/min/max/drag/resize).
fn deco_hit(win, px, py): i64 {
    var x = win_x(win);
    var y = win_y(win);
    var w = win_w(win);
    # ⛔ THE BOTTOM EDGE IS `win_bottom_y`, NOT `y + win_h`. This function used to end the window at
    # `y + h`, i.e. chrome-INSIDE, while the damage model, the GPU composite and the client blit all
    # place the content at `y + TITLEBAR_H` for `h` rows. On a live setu window that put every hit 30 px
    # out and dropped the bottom-most 30 px of the client surface outside the window entirely — and the
    # bottom resize strip landed INSIDE the surface rather than on its edge. Inert until something
    # clicked; `AE-7` is the something. See the convention note in src/window.cyr.
    var yb = win_bottom_y(win);
    if (px < x) { return Deco.DECO_NONE; }
    if (py < y) { return Deco.DECO_NONE; }
    if (px >= x + w) { return Deco.DECO_NONE; }
    if (py >= yb) { return Deco.DECO_NONE; }
    # resize edges — the bottom corners take priority, then the sides, then the bottom strip.
    # ⭐ THE LEFT GRIPS (0.17.4) mirror the right ones exactly: the side strips run the full height, titlebar
    # rows included, as the right one always has. Neither covers a button — the close button stops
    # BTN_MARGIN (= RESIZE_M) short of the right edge and the other two sit left of it, far from the left
    # strip at any width the floor allows. ⚠ Rust tested the titlebar FIRST, so its 1-px side borders began
    # below it (renderer.rs:624-666); there is no top grip in either (ADR 0004).
    var nl = 0;
    var nr = 0;
    var nb = 0;
    if (px < x + RESIZE_M) { nl = 1; }
    if (px >= x + w - RESIZE_M) { nr = 1; }
    if (py >= yb - RESIZE_M) { nb = 1; }
    if ((nr == 1) && (nb == 1)) { return Deco.DECO_RESIZE_BR; }
    if ((nl == 1) && (nb == 1)) { return Deco.DECO_RESIZE_BL; }
    if (nr == 1) { return Deco.DECO_RESIZE_R; }
    if (nl == 1) { return Deco.DECO_RESIZE_L; }
    if (nb == 1) { return Deco.DECO_RESIZE_B; }
    # titlebar: buttons first, else the draggable strip
    if (py < win_body_y(win)) {
        var by = deco_btn_y(win);
        if (deco_in_btn(px, py, deco_close_x(win), by) == 1) { return Deco.DECO_CLOSE; }
        if (deco_in_btn(px, py, deco_max_x(win), by) == 1) { return Deco.DECO_MAX; }
        if (deco_in_btn(px, py, deco_min_x(win), by) == 1) { return Deco.DECO_MIN; }
        return Deco.DECO_TITLEBAR;
    }
    return Deco.DECO_BODY;
}

# ⭐⭐ THE CURSOR (`AE-7`) — drawn through `draw_text`, and that choice is load-bearing.
#
# ⛔ IT CANNOT GO THROUGH `fill_rect`. On an agnos GPU frame the chrome rect queue is emitted BEFORE the
# client surfaces and the `#39` blit is skipped entirely, so anything drawn as chrome lands UNDER every
# client window — a cursor that disappears the moment it crosses an app. `draw_text`'s queue is drained
# AFTER the client blits (that ordering exists for exactly this reason), so a glyph composites on top
# with no new GPU path and no change to the frame plan.
#
# ⭐⭐ A REAL ARROW NOW, NOT A GLYPH. The first cut drew the character `+` — deliberately, to reuse the
# iron-proven `#92` op 0x03 path instead of debugging a second overlay kind alongside the pointer itself.
# That cut is spent: `+` has no direction and no visible hotspot, and the operator's verdict on seeing it
# was exactly right — it is a *pixel*, not a cursor.
# ⭐ The arrow needs no new kernel path either, because op 0x03 paints an arbitrary 1bpp mask in a colour
# and is not font-specific: the cursor is TWO masks through the same op, outline in black then fill in
# white. Shape, clipping and packing live in `src/cursor.cyr`, which is pure and unit-tested.

# ⚠ THE CURSOR MOVES EVERY FRAME IT MOVES AT ALL, so it damages every frame — and its OLD position must
# be damaged too or it smears a trail. That is the same `union(cur, prev)` requirement a moving window
# has, and the same trap as the CLOSED window whose rect left the live list: the damage model only
# knows about things it is told about, and the cursor is not in the window vector.
var ae_cursor_px = 0 - 1;      # previous frame's cursor position (-1 = never drawn)
var ae_cursor_py = 0 - 1;

# Fold the cursor's current AND previous rects into this frame's damage. Called by the damage pass.
fn rend_cursor_damage(dmg): i64 {
    if (dmg == 0) { return 0; }
    var x = input_ptr_x();
    var y = input_ptr_y();
    # ⛔ ONLY WHEN IT MOVED. The first cut damaged both rects unconditionally, which made an IDLE desktop
    # write 18 rows every frame forever — and "an idle desktop writes NOTHING" is the entire value of the
    # `AE-0a` band. Four asserts caught it immediately. A stationary cursor is already correct in both
    # flip buffers, so it needs no damage at all.
    if (x == ae_cursor_px) {
        if (y == ae_cursor_py) { return 0; }
    }
    # ⚠ THE ARROW'S OWN EXTENT, not the font's. This was `FONT_W + 2` x `FONT_H + 2` when the cursor was a
    # `+` glyph; a 10x20 bitmap damaged with a 10x18 rect leaves its bottom two rows smeared behind it.
    var cw = cursor_w();
    var ch = cursor_h();
    # ⚠ BOTH rects, exactly like a moved window: the OLD one so the vacated pixels are repainted, the NEW
    # one so the glyph lands. Being in `cur` this frame puts it in `prev` next frame, which is the two
    # frames of coverage `#84`'s buffer flip requires.
    if (ae_cursor_px >= 0) { rend_dmg_add(dmg, ae_cursor_px, ae_cursor_py, cw, ch); }
    rend_dmg_add(dmg, x, y, cw, ch);
    return 0;
}

# Record where the cursor was last DRAWN. ⚠ `rend_cursor_damage` and `render_cursor` are a PAIR — a
# caller that damages without drawing leaves the previous position stale, so the cursor re-damages the
# same rows every frame forever and an idle desktop stops being free. Exposed separately so a test can
# settle the cursor without a framebuffer or a font.
# ⛔ THE PAIR'S MISSING HALF. `render_cursor` marks the position drawn BEFORE the emit can refuse, so a
# refused frame leaves a position recorded as painted that never was. The move-gate in
# `rend_cursor_damage` then sees no movement and damages nothing — a stationary pointer stays invisible
# until it happens to move. Clearing the record forces the next frame to treat it as moved.
fn rend_cursor_unmark(): i64 {
    ae_cursor_px = 0 - 1;
    ae_cursor_py = 0 - 1;
    return 0;
}

fn rend_cursor_mark_drawn(x, y): i64 {
    ae_cursor_px = x;
    ae_cursor_py = y;
    return 0;
}

# ⭐ THE CURSOR'S COLOURS ARE NOT THEMED, AND THAT IS THE POINT. A themed cursor disappears against any
# surface near the theme colour — which is exactly how the `+` failed. White-on-black is the two-tone
# every real cursor uses because it is legible on *every* background, light or dark.
fn ae_cursor_fill_colour(): i64 { return bhumi_xrgb(255, 255, 255); }
fn ae_cursor_line_colour(): i64 { return bhumi_xrgb(0, 0, 0); }

# ⭐ A ONE-ENTRY QUEUE, DRAINED BY gpu.cyr AFTER THE TEXT RUNS — which is what puts the cursor ON TOP of
# everything, chrome and client surfaces alike. It is deliberately NOT part of the text queue: that queue
# drains in enqueue order, so a cursor sharing it would be painted under any caption enqueued later.
# ⚠ Lives here rather than in gpu.cyr for the same reason `ae_frame_dmg` and `ae_gpu_frame_ok` do — a
# Cyrius forward reference to a VARIABLE does not resolve, and `tests/render.tcyr` compiles this module
# without gpu.cyr. The syscall stays on the far side of that line.
var ae_cur_q = 0;
var ae_cur_qx = 0;
var ae_cur_qy = 0;
# ⛔⛔ THE CURSOR NEEDS ITS OWN RETIREMENT LATCH, AND SHIPPING WITHOUT ONE REPRODUCED THE 1.56.42 BUG IN A
# NEW PLACE. `render_cursor` QUEUES instead of drawing, so if the GPU emit then refuses, the cursor is
# simply absent — and because the next frame queues again and refuses again, it is absent FOREVER, with one
# log line to explain it. That is exactly what the glyph path did to every caption on the desktop.
# ⇒ gpu.cyr clears this on the first refusal, which sends every later frame to `render_cursor_cpu`. One
# frame of missing pointer instead of a boot without one.
# ⚠ SEPARATE from `ae_text_gpu_ok` on purpose: retiring captions because the POINTER was refused would be
# the same mistake pointing the other way.
var ae_cursor_gpu_ok = 1;
fn ae_cursor_gpu_ok_get(): i64 { return ae_cursor_gpu_ok; }
fn ae_cursor_gpu_disable(): i64 { ae_cursor_gpu_ok = 0; return 0; }
fn ae_cursor_q_pending(): i64 { return ae_cur_q; }
fn ae_cursor_q_x(): i64 { return ae_cur_qx; }
fn ae_cursor_q_y(): i64 { return ae_cur_qy; }
fn ae_cursor_q_clear(): i64 { ae_cur_q = 0; return 0; }

# Per-pixel arrow, for a frame the GPU is not compositing. Outline first, then fill over it — drawing fill
# first would let the outline pass overwrite the interior's edge pixels.
# ⚠ No clipping needed here: `bhumi_fb_set` bounds-checks every write, so a cursor hanging off the edge
# simply loses those pixels. That is the CPU path's advantage over `#92`, which refuses instead.
fn render_cursor_cpu(fb, x, y): i64 {
    var line = ae_cursor_line_colour();
    var fill = ae_cursor_fill_colour();
    var r = 0;
    while (r < cursor_h()) {
        var c = 0;
        while (c < cursor_w()) {
            if (cursor_outline_at(c, r) == 1) { bhumi_fb_set(fb, x + c, y + r, line); }
            if (cursor_fill_at(c, r) == 1) { bhumi_fb_set(fb, x + c, y + r, fill); }
            c = c + 1;
        }
        r = r + 1;
    }
    return 0;
}

fn render_cursor(fb): i64 {
    var x = input_ptr_x();
    var y = input_ptr_y();
    # ⛔ THE SAME LATCH THE TEXT PATH USES, and it must be: if `#92` op 0x03 has been retired then
    # `ae_chrome_on_gpu()` brings the `#39` blit back, which is the only thing that makes CPU-drawn pixels
    # reach the screen. Queueing for a GPU emit that will not happen loses the cursor silently; drawing on
    # the CPU while the blit is skipped loses it just as silently. These two flags have to agree.
    if (ae_gpu_frame_ok == 1) {
        if (ae_text_gpu_ok == 1) {
            if (ae_cursor_gpu_ok == 1) {
                ae_cur_q = 1;
                ae_cur_qx = x;
                ae_cur_qy = y;
                rend_cursor_mark_drawn(x, y);
                return 0;
            }
        }
    }
    render_cursor_cpu(fb, x, y);
    rend_cursor_mark_drawn(x, y);
    return 0;
}

# rend_title_caption(dst, title, box_w): the caption a title box `box_w` px wide shows, written to `dst`
# (AE_TEXT_CAP_B bytes) as NUL-terminated UTF-8. -> its length in glyph CELLS, which is also its width.
#
# Parity: renderer.rs:543-562. A title wider than its box is cut to `max_chars = box_w / FONT_ADV` cells: its
# first `max_chars - 1` scalars, then U+2026 '…' in ONE cell — unless that budget is 2 cells or fewer, where
# Rust draws the whole title rather than a stub. Counted in scalars, as Rust counts chars.
# ⭐ THE ELLIPSIS IS RUST'S OWN '…'. kashi 1.1.0 draws U+2026 in an extension cell (its ADR 0011), so the cut no
# longer spends the last three cells on an ASCII "...". Rust drew a BLANK there — its 5x7 font has no '…', so
# its `draw_char` returned false — and the port draws the real glyph.
# ⚠ RE-ENCODED, NOT COPIED. Each kept scalar is written back through `utf8_encode`, so an ill-formed byte of the
# title lands as U+FFFD's three bytes and the caption is always well-formed: it decodes to exactly the title's
# cells. Whole units only, so a cut never splits a sequence.
#
# ⛔⛔ AND NO CAPTION IS LONGER THAN AE_TEXT_CHARS CELLS, however wide the window — including when the box cuts it
# to more cells than that. `ae_text_enqueue` refuses a longer run, `draw_text` falls back to the CPU, and on a
# GPU frame nothing presents the CPU layer — gpu.cyr skips the `#39` band once chrome is queued — so such a
# title was never on screen at all. Rust drew it whole; it is cut here like any other title too long for its
# box, ending in '…' the same way, on every frame kind, so a CPU frame (QEMU) and a GPU frame (iron) show the
# same caption.
fn rend_title_caption(dst, title, box_w): i64 {
    store8(dst, 0);
    if (title == 0) { return 0; }
    var n = utf8_count(title);
    var lim = AE_TEXT_CHARS;
    if (text_width(title) > box_w) {
        var mc = box_w / FONT_ADV;
        if (mc > 2) { if (mc < lim) { lim = mc; } }
    }
    var keep = n;
    if (n > lim) { keep = lim - 1; }                # Rust: `title.chars().take(max_chars - 1)`, then '…'
    var si = 0;                                     # bytes of `title` consumed
    var di = 0;                                     # bytes of `dst` written
    var c = 0;                                      # cells written
    while (c < keep) {
        var r = utf8_next(title + si);
        if (utf8_next_len(r) == 0) { break; }
        # LAST: never past `dst`, whatever came above — four bytes stay free for the '…' and the NUL.
        if (di + utf8_enc_len(utf8_next_cp(r)) > AE_TEXT_CAP_B - 4) { break; }
        di = di + utf8_encode(dst + di, utf8_next_cp(r));
        si = si + utf8_next_len(r);
        c = c + 1;
    }
    if (c < n) {                                    # cut: the ellipsis is the last cell
        di = di + utf8_encode(dst + di, AE_TEXT_ELLIPSIS);
        c = c + 1;
    }
    store8(dst + di, 0);
    return c;
}

# render_title(fb, win, color): draw the window's caption in its titlebar. -> width drawn, px.
#
# ⛔⛔ ONLY THE CELLS WHOLLY ON THE FRAMEBUFFER — a cell being the 9 px glyph-plus-gap, the same extent
# `ae_text_fits` measures. That check drops a run that leaves the framebuffer — `#92` op 0x03 refuses rather
# than clips — and a dropped run's CPU fallback is invisible on a GPU frame for the reason above. So a window
# partly past an edge lost its ENTIRE title on every GPU frame, while its rects, clipped by
# `ae_rect_enqueue`, still drew. The cells an edge cuts are skipped and the rest keep their grid, so both
# frame kinds draw the same caption. ⚠ A CPU frame pays for that: it loses the glyph at each edge that a
# per-pixel clip drew in part — or whole, when only its gap column is off the right edge.
# ⚠ Horizontal only. A glyph row crossing the TOP or BOTTOM edge still drops its run — a 1bpp run cannot
# lose rows without per-run stride surgery — and neither the mover nor the spawn cascade puts one there.
fn render_title(fb, win, color): i64 {
    var cap[AE_TEXT_CAP_B];                         # function-local => AE_TEXT_CAP_B BYTES
    var n = rend_title_caption(&cap, win_title(win), deco_title_w(win));
    var tx = deco_title_x(win);
    var k = 0;                                      # the first cell wholly right of x = 0
    if (tx < 0) { k = (FONT_ADV - 1 - tx) / FONT_ADV; }
    var e = (bhumi_fb_width(fb) - tx) / FONT_ADV;   # the cells that end by the right edge
    if (e > n) { e = n; }
    if (e <= k) { return 0; }
    # ⚠ `k` and `e` are CELL indices, and a cell is 1..4 bytes of the caption: cut and start at their BYTE
    # offsets. Indexing the caption by cell number starts on the wrong scalar, or splits one into U+FFFD.
    var kb = utf8_offset(&cap, k);
    store8(&cap + utf8_offset(&cap, e), 0);
    return draw_text(fb, &cap + kb, tx + k * FONT_ADV, win_y(win) + (TITLEBAR_H - FONT_H) / 2, color);
}

fn render_window(fb, win, focused): i64 {
    # ⛔ A MINIMIZED WINDOW IS NOT DRAWN — said by the drawing site itself (0.17.4). `render_desktop` skips one and
    # so does the GPU present loop; this guard means no caller draws one by forgetting to. Rust dropped a hidden
    # surface in `surfaces_in_order` (renderer.rs:749-758), so `render_frame` never saw it.
    if (win_state(win) == WinState.WS_MINIMIZED) { return 0; }
    var x = win_x(win);
    var y = win_y(win);
    var w = win_w(win);
    var h = win_h(win);
    var th = rupa_theme_active();
    # body — the window content surface.
    # ⛔ THIS USED TO BE `h - TITLEBAR_H`, which contradicted the CLIENT BLIT in this same function
    # (`blit_rect(... win_body_y, w, h)`) — the theme body was 30 px shorter than the surface drawn over
    # it. Invisible while a client covered it, and 30 px short on the compositor's own clientless window.
    # `win_h` is the CONTENT height; see the convention note in src/window.cyr.
    # ⭐ M6-C3: the window's opacity applies to its CHROME as well as its content — a "translucent
    # window" that kept an opaque titlebar and border would look like a rendering fault, not a setting.
    var wa = win_opacity(win);
    fill_rect_a(fb, x, win_body_y(win), w, h, ae_bhumi(rupa_theme_widget(th)), wa);
    # titlebar: panel when idle, raised (widget) when focused
    var tb = ae_bhumi(rupa_theme_panel(th));
    if (focused == 1) { tb = ae_bhumi(rupa_theme_widget(th)); }
    fill_rect_a(fb, x, y, w, TITLEBAR_H, tb, wa);
    # a focused window gets a 2px accent seal-strip along the titlebar's lower edge
    # (the theme's ONE bold hue = "this window is active/verified")
    if (focused == 1) { fill_rect_a(fb, x, win_body_y(win) - 2, w, 2, ae_bhumi(rupa_theme_accent(th)), wa); }
    # title text — primary ink when focused, muted otherwise
    var tc = ae_bhumi(rupa_theme_mute(th));
    if (focused == 1) { tc = ae_bhumi(rupa_theme_ink(th)); }
    render_title(fb, win, tc);
    # decoration buttons: close = alert, maximize = held, minimize = faint
    var by = deco_btn_y(win);
    fill_rect(fb, deco_close_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_alert(th)));
    fill_rect(fb, deco_max_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_held(th)));
    fill_rect(fb, deco_min_x(win), by, BTN_W, BTN_H, ae_bhumi(rupa_theme_faint(th)));
    # the border, last of the chrome as in Rust (renderer.rs:602-603) — the theme's hairline, at the window's
    # opacity like the rest of its chrome. ⛔ After the body, never before it: see render_border.
    render_border(fb, win, ae_bhumi(rupa_theme_line(th)), wa);
    # Composite the client's PRESENTED surface (setu shared-buffer pixels), if any, into the
    # window body below the titlebar. Re-run EVERY frame from the cached buffer so the surface
    # persists on screen — the desktop redraw above would otherwise overwrite it (it did: the
    # present composited for one frame, then vanished, leaving the screendump blank). w×h are
    # the surface dims (comp_create_window used the CREATE_SURFACE w/h). bhumi_fb_set clips to fb.
    var spix = win_pix(win);
    var bid = win_bufid(win);
    # ⛔ SAME GUARD AS THE GPU GATE, and it must be here too: refusing on the GPU side only routes an
    # over-sized window to THIS path, which would then read past the client's slot itself. Clamp the
    # extent to what the client actually attached until it re-attaches at the CONFIGURE size.
    var bw = win_buf_w(win);
    var bh = win_buf_h(win);
    if (bid != 0) {
        if (bw > 0) { if (w > bw) { w = bw; } }
        if (bh > 0) { if (h > bh) { h = bh; } }
    }
    # ⛔ AND NEVER PAST THE CACHE ITSELF (0.17.6). A setu client's cache is now a `fl_alloc` block the window
    # owns (`win_pix_adopt`), sized `h * stride` at its last applied attach, and a block over 4 KB is its own
    # mapping, so reading past it can fault where the bump heap read a neighbour. The clamp above trusts
    # `win_buf_w` / `win_buf_h`; this bounds the copy and the composite by the bytes that exist, whatever they say.
    var pcap = win_pixcap(win);
    if (pcap > 0) {
        if (w > 0) {
            var prows = pcap / (w * 4);
            if (h > prows) { h = prows; }
        }
    }
    #
    # ⚠ SKIPPED ENTIRELY when the GPU has committed to this frame. The client surface is then
    # composited by the KERNEL straight out of its GPU-visible shm slot via gpu_blit_shm #87 (see
    # src/gpu.cyr), which replaces BOTH of the things below: the setu_buf_read #73 full-surface copy AND
    # the per-pixel loop. The pixels never enter userland and never touch the CPU. Chrome above still
    # renders here — #87 composites on top of it, which is exactly why gpu.cyr blits the chrome layer with
    # blit#39's DEFER bit first and presents once at the end.
    #
    # ⛔ THE GATE IS ae_gpu_frame_ok, NOT "is there a GPU". It used to be `ae_gpu_active()` — a flag set
    # once at startup meaning only "a GPU exists and is armed". But ae_gpu_present_frame refuses
    # individual FRAMES for reasons this function cannot see (a window past an edge, a premultiplied
    # surface with no shader path), and on refusal the caller presented the framebuffer as it stood:
    # chrome, and no window content at all. ae_gpu_frame_plan now settles the question for the whole
    # frame BEFORE any of it is drawn, so "the GPU will do it" and "so I will not" are the same fact
    # read from the same place.
    if (ae_gpu_frame_ok == 0) {
        # LIVE surface: pull the client's LATEST frame out of the shared buffer into the cache each
        # frame. A client that keeps writing its buffer (setu_buf_write, no re-present) animates the
        # window. bid == 0 (a one-shot static present) skips this and just blits the cached frame.
        # ⚠ setu's reader (0.8.13) cannot wait on the client-named path: a FIFO, a symlink or a short file at
        # the buffer's name is refused at once and the cache keeps the last frame (setu_dispatch.cyr).
        if (bid != 0) {
            if (spix != 0) { setu_buf_read(bid, spix, w * h * 4); }
        }
        # Row-walking copy (blit_rect) rather than the per-pixel bhumi_fb_set loop this used to be.
        # Same pixels, same clipping; measured 23.974 ms -> see blit_rect's header for the numbers.
        # ⭐ 0.17.4: routed as gpu.cyr routes it — a premultiplied surface is BLENDED with the kernel's op 0x01
        # / op 0x06 arithmetic at this window's opacity, anything else copied as `#87` copies it. A CPU frame
        # copied every surface, so the same window was opaque here and translucent on iron.
        if (spix != 0) { rend_composite_surface(fb, x, win_body_y(win), spix, w, h, win_premul(win), wa); }
    }
    return 0;
}

# ============================================================================================
# ⭐ THE WINDOW BORDER — Rust's `draw_rect_outline(rect, COLOR_BORDER)` (renderer.rs:174-198, :602-603)
# ============================================================================================
# Rust outlined every window in ONE colour, focused or not (COLOR_BORDER, :78; focus changed only the titlebar),
# BORDER_WIDTH = 1 px (:477), as the last of its decorations. Ported with the rupa hairline token (`line`).
#
# ⚠ OUTSIDE THE WINDOW RECT, WHERE RUST'S WAS INSIDE IT. Rust's ring lay on its rect's outermost pixels with the
# content inset by BORDER_WIDTH (renderer.rs:890-892). Here the content and the titlebar are NOT inset — the
# client surface is at the window origin, and setu, input routing and the GPU blit all place it there — so a
# ring inside would paint over the client's own edge pixels. The ring is drawn BORDER_W outside the rect
# instead, and nothing inside it moves. The damage model covers it (`rend_dmg_add_win`).
# ⚠ AND IT DROPS ITS OFF-SCREEN PART. Rust clamped an off-screen edge onto the framebuffer's edge (`x0 =
# rect.x.max(0)`, then the left edge drawn at x0), so a window dragged past the left edge got a line at x = 0
# over its content. Here each side is a clipped `fill_rect`, as every other chrome fill is — and as the GPU
# queue clips (`ae_rect_enqueue_a`), so both frame kinds draw the same ring.
#
# rend_outline(fb, x, y, w, h, t, color, a): a ring `t` px thick on the rect's outermost pixels, at opacity
# `a`. Four DISJOINT rects — top and bottom carry the corners, the sides run between them — so no pixel of a
# translucent ring is blended twice. A rect no wider or taller than 2t is all ring.
fn rend_outline(fb, x, y, w, h, t, color, a): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    if (t <= 0) { return 0; }
    if (w <= 2 * t) { return fill_rect_a(fb, x, y, w, h, color, a); }
    if (h <= 2 * t) { return fill_rect_a(fb, x, y, w, h, color, a); }
    fill_rect_a(fb, x, y, w, t, color, a);                       # top, corners included
    fill_rect_a(fb, x, y + h - t, w, t, color, a);               # bottom, corners included
    fill_rect_a(fb, x, y + t, t, h - 2 * t, color, a);           # left, between the corners
    fill_rect_a(fb, x + w - t, y + t, t, h - 2 * t, color, a);   # right
    return 0;
}

# draw_rect_outline(fb, x, y, w, h, color): Rust's `Framebuffer::draw_rect_outline` — a 1 px opaque outline.
fn draw_rect_outline(fb, x, y, w, h, color): i64 { return rend_outline(fb, x, y, w, h, 1, color, 255); }

# render_border(fb, win, color, a): the ring BORDER_W outside the window's rect, titlebar included.
# ⛔⛔ CALLED AFTER THE BODY AND TITLEBAR FILLS, AND THE ORDER IS LOAD-BEARING ON THE GPU. gpu.cyr's op 0x02
# coverage slot takes its capacity from the FIRST alpha rect it ever stages and refuses a larger one later
# (`ae_gpu_cov_ensure`), and a refusal retires the chrome path for the run. A 1 px ring side staged first
# would cap the slot below the body that follows it.
fn render_border(fb, win, color, a): i64 {
    return rend_outline(fb, win_x(win) - BORDER_W, win_y(win) - BORDER_W, win_w(win) + 2 * BORDER_W,
      win_total_h(win) + 2 * BORDER_W, BORDER_W, color, a);
}

# rend_frame_damage(comp, fb): compute this frame's damage into ae_frame_dmg. Call ONCE at the
# top of the frame, before anything is drawn.
#
# ⛔ THIS WAS `render_frame`, A WHOLE SECOND FRAME PATH THAT NOTHING CALLED.
# 0.9.8 shipped `render_frame` carrying the damage model and the GPU clear, while the live loop
# called `render_desktop` — so none of it ever executed: `#85` was never issued, `rend_dmg_new`
# was reached only from a test, and the `#39` chrome blit was unconditionally full-frame while
# the CHANGELOG described it as damage-limited. Two frame paths is the defect; the fix is one.
# ⚠ THE MERGE DIRECTION WAS FORCED, NOT STYLISTIC: `render_desktop` paints the shell status panel
# and `render_frame` does not, so making the loop call `render_frame` instead would silently have
# dropped the panel. The damage half moved here, as a function `render_desktop` calls.
# ⚠ The two paths also read DIFFERENT theme sources — a `theme_bridge` high-contrast colour (that module
# was retired at 0.17.0, ADR 0004) versus `rupa_theme_bg`. rupa is the arc's shared token lib and the one the
# window chrome, dhancha, crab and jalwa all read, so rupa wins and the desktop background now
# matches the windows drawn on it.
fn rend_frame_damage(comp, fb, bg): i64 {
    # ============================================================================================
    # ⭐ THE DAMAGE MODEL. Computed every frame; NOT yet driving the blit — see gpu.cyr for why
    # (the #84 buffer flip makes a single-frame band two-frames-stale on the other buffer).
    # ============================================================================================
    # 0.9.8 shipped the plumbing and it reduced NOTHING, because the clear touched every pixel and
    # so damage was always the whole screen. The fix is not a bigger clear-optimisation — it is
    # computing damage from what ACTUALLY CHANGED:
    #
    #     damage = union over windows whose rect differs from last frame of { old rect, new rect }
    #
    # ⛔ BOTH RECTS ARE REQUIRED. Without the OLD one, a window that moves leaves its previous
    # pixels behind: the vacated region is never cleared and never re-copied. That failure reads
    # as "the framebuffer is stale", not as "the damage model is wrong", which is the expensive
    # way to find it.
    # ⚠ A window that has never been drawn has an impossible prev-rect (-1) and therefore always
    # counts as changed — a new window must not be mistaken for a stationary one.
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    var wv = comp_windows(comp);
    var wn = vec_len(wv);
    var wi = 0;
    # ⛔ THE ROLL HAPPENS HERE, NOT AT A CALL SITE. `prev` must become last frame's `cur` exactly once
    # per frame, and doing it in the caller means every caller — the frame loop AND the selftest — has
    # to remember. One that forgot would silently union against a stale band, which is conservative
    # (still correct, just slower) and therefore invisible. Same reasoning as the line discipline
    # clearing its own pending buffer inside ld_feed.
    # ⭐ `AE-8`: clear last frame's text runs here, for the same reason the damage roll lives here —
    # one place, once per frame, so no caller can forget. A queue that survived a frame would re-emit
    # every title on top of the next one.
    ae_text_reset();
    ae_rect_reset();
    # ⚠ Cleared with the queues they index, in the same place and for the same reason: a mark that
    # outlived its queue would slice this frame's rects at last frame's window boundaries.
    ae_marks_reset();
    if (ae_prev_dmg == 0) { ae_prev_dmg = rend_dmg_new(); }
    rend_dmg_copy(ae_prev_dmg, ae_frame_dmg);
    if (ae_frame_dmg != 0) { rend_dmg_clear(ae_frame_dmg); }
    while (wi < wn) {
        var w0 = vec_get(wv, wi);
        if (win_rect_changed(w0) == 1) {
            if (ae_frame_dmg != 0) {
                if (win_px(w0) >= 0) {
                    rend_dmg_add_win(ae_frame_dmg, win_px(w0), win_py(w0),
                      win_pw(w0), win_prev_total_h(w0));
                }
                rend_dmg_add_win(ae_frame_dmg, win_x(w0), win_y(w0),
                  win_w(w0), win_total_h(w0));
            }
        }
        wi = wi + 1;
    }

    # ⚠ A LIVE CLIENT SURFACE CHANGES WITHOUT ITS RECT MOVING. render_window re-reads a bufid
    # window's buffer every frame, so its CONTENT is damaged even when its geometry is not.
    # Treating those as undamaged would freeze animating windows — the one bug this model could
    # introduce that looks like a client problem rather than a compositor one.
    #
    # ⛔⛔ A TRANSLUCENT WINDOW IS DAMAGED FOR THE SAME REASON, AND OMITTING IT MEANT OPACITY HAS
    # NEVER WORKED FOR A STATIONARY WINDOW. `fill_rect_a` is read-modify-write — every destination pixel
    # goes through the op 0x02 blend — and so is a premultiplied surface's op 0x06. `render_desktop`
    # calls `render_window` every frame while the clear is band-limited, so an undamaged translucent
    # window is re-blended OVER ITS OWN PREVIOUS OUTPUT. That iteration's fixed point is (near) the
    # source colour: the window fades in and then **converges to opaque in about four frames**.
    #
    # ⛔ AND THE 0.15.0 NULL-TEST MEASURED EXACTLY THAT, NOT BLENDING. It published, at identical
    # coordinates over one gradient wallpaper, inside-pixels `1A1D24` at a=150 and `171A24` at a=60
    # with the outside pixel `151727` at both. Solving `rend_blend` for a backdrop that yields both
    # under a SINGLE blend from the widget colour `1B1E24`: red admits {25,26} at a=150 and {22,23}
    # at a=60; green admits {28,29} and {25,26}. **Both intersections are EMPTY — no backdrop
    # explains both samples.** Iterating the blend from the published backdrop `151727` reproduces
    # `1A1D24` and `171A24` EXACTLY, in 4 frames. The run was real; its interpretation was not.
    # ⚠ Cost, stated: the AE-0a damage band can no longer shrink below a translucent window's rows.
    # That is the honest price of blending against a fresh backdrop every frame.
    wi = 0;
    while (wi < wn) {
        var w1 = vec_get(wv, wi);
        var dmg1 = 0;
        if (win_bufid(w1) != 0) { dmg1 = 1; }
        if (win_translucent(w1) == 1) { dmg1 = 1; }
        if (dmg1 == 1) {
            if (ae_frame_dmg != 0) {
                rend_dmg_add_win(ae_frame_dmg, win_x(w1), win_y(w1),
                  win_w(w1), win_total_h(w1));
            }
        }
        wi = wi + 1;
    }

    # ⛔ THE FIRST FRAME IS FULLY DAMAGED, and this is not a corner case — it is the common startup
    # path. On frame 1 every window is "changed" (prev rect = -1), so damage is the union of the
    # WINDOW rects, and the background OUTSIDE every window is not in it. A consumer that trusted
    # that band would leave whatever the framebuffer held at boot showing around the windows — the
    # kind of thing dismissed as a boot artifact instead of diagnosed.
    if (ae_dmg_primed == 0) {
        ae_dmg_primed = 1;
        if (ae_frame_dmg != 0) { rend_dmg_add(ae_frame_dmg, 0, 0, fw, fh); }
    }

    # ⛔⛔ A CLOSED WINDOW'S PIXELS, which no loop above can see because every one of them walks the
    # LIVE window list. Fold the retired rect into `cur` — and `cur` is the right tracker, not the band
    # directly: anything in `cur` is in `prev` next frame, so this buys the SAME two frames of coverage
    # a moved window gets, which is exactly what `#84`'s buffer flip requires. One frame erases the
    # window from one buffer and leaves it standing in the other, which is what "flashing" was.
    # ⚠ MUST BE AFTER the `rend_dmg_clear` above — a close is handled during input, earlier in the same
    # frame than this function runs, so a rect written straight into `cur` at close time would be wiped
    # by this frame's own clear before anyone read it.
    # ⚠ TITLEBAR_H is added HERE. The compositor stores the raw window rect because this constant lives
    # in this file, which is included after compositor.cyr. So is the border ring, for the same reason.
    # ⚠ Cleared UNCONDITIONALLY, including when there is no damage tracker at all: a retired rect that
    # survived its frame would keep re-damaging those rows for the rest of the run.
    # ⭐ THE CURSOR'S OWN DAMAGE — current AND previous position. The cursor is not in the window vector,
    # so no loop above can see it; without this it leaves a trail of itself across the desktop. Same
    # `union(cur, prev)` requirement as a moving window, third instance of the same trap.
    rend_cursor_damage(ae_frame_dmg);
    if (comp_retire_valid() == 1) {
        if (ae_frame_dmg != 0) {
            rend_dmg_add_win(ae_frame_dmg, comp_retire_x(), comp_retire_y(),
              comp_retire_w(), comp_retire_h() + TITLEBAR_H);
        }
        comp_retire_clear();
    }

    # ⭐ AND NOW IT DRIVES SOMETHING. Fold cur and prev into the full-width band the clear and the
    # `#39` chrome blit both consume. Computed last, so it sees every rect added above.
    rend_band_compute(fh, bg);
    return 0;
}

# The shell status-panel renderer (render_shell_panel + panel_* helpers) lives in
# src/shell_render.cyr — it couples to shell.cyr's SystemStatus + SH_NetStatus,
# so it is kept out of this file to keep render.cyr reusable on its own.

# --- bitmap text (kashi IBM VGA 8x16 console font — see [deps.kashi]) ---------
enum FontK {
    FONT_W   = 8;
    FONT_H   = 16;
    FONT_ADV = 9;   # 8px glyph + 1px spacing
}

# ============================================================================================
# ⭐⭐ `AE-9` — THE CHROME FILLS OFF THE CPU. The rect queue.
# ============================================================================================
# Same shape as the text queue below, for the same reason: render runs before present, so a `#88` issued
# during render would be overwritten by whatever lands in the back buffer afterwards. Render enqueues;
# `ae_gpu_emit_chrome()` drains, FIRST, as the bottom layer of the frame.
#
# ⭐ THIS IS THE RUNG THAT DELETES THE `#39` BLIT. With the clear, the chrome rects, the text and the
# client surfaces all issued to the GPU, nothing is left in the userland framebuffer for `#39` to copy —
# and `gpu.cyr`'s own `#85`-removal note predicted exactly this order: clear the back buffer, fill the
# window and panel rects, glyph the titles, and nothing overwrites the clear because there is no CPU layer
# left to copy over it.
#
# ⛔ THE MIGRATION IS ALL-OR-NOTHING PER FRAME, AND THAT IS NOT CAUTION. The `#39` blit is the BOTTOM layer:
# a frame that draws half its chrome into the userland framebuffer and half through `#88` has the two
# overwriting each other in whichever order the frame happens to run. So the decision is taken ONCE per
# frame, before anything is drawn, and every fill in that frame follows it.
enum AeRect {
    AE_RECT_MAX = 768;   # ~10 rects a window (4 of them the border) x AE_MARK_MAX (64) windows + the panel, the clear band, the launcher
}
var ae_rect_n = 0;
var ae_rect_x[768];
var ae_rect_y[768];
var ae_rect_w[768];
var ae_rect_h[768];
var ae_rect_col[768];
# ⭐ PER-RECT ALPHA, 255 = opaque. An opaque rect goes to `#88 gpu_fill_rect`; a translucent one to
# `#92` op 0x02 with a constant-coverage mask (gpu.cyr). ⛔ Before this lane existed `fill_rect_a` had
# NO GPU route at all, and the two shapes that fell out of that cost two consecutive burns — see
# `ae_gpu_cov_ok`'s banner. The queue is the right place for it: the routing decision belongs to the
# emitter, which is the only code that knows whether this frame's chrome is on the GPU.
var ae_rect_a[768];
# ⛔ 1 = the GPU chrome path is still trusted. Cleared by gpu.cyr on a refusal, exactly like the text
# latch, because a queued rect that never gets emitted is a HOLE in the frame — and with `#39` gone there
# is no userland copy to fall back on after the fact. One bad frame, then the CPU path for the rest.
var ae_chrome_gpu_ok = 1;
# ⚠ Overflow is a frame with missing chrome — the rect falls to a CPU store a GPU frame never presents —
# so it is COUNTED (it does not retire the path). AE_RECT_MAX is sized past AE_MARK_MAX windows so it
# cannot happen for any window count the marks support; the counter is there because "cannot" is a claim
# about today's chrome. ⚠ 0.17.4's borders took a window from ~6 rects to ~10: re-size this with the chrome.
var ae_rect_dropped = 0;

# ============================================================================================
# ⭐⭐ Z-ORDER MARKS — which queued rects and text runs belong to which window
# ============================================================================================
# ⛔⛔ WHY THIS EXISTS. Both queues are FLAT and append-only, and `ae_gpu_present_frame` used to drain
# them in LAYER order: every window's chrome, then every window's client surface, then every window's
# text. With two overlapping windows that is wrong — the LOWER window's surface is blitted after the
# UPPER window's titlebar and covers it, while the upper title GLYPHS are repainted on top afterwards.
# The signature on screen is floating title text over a neighbour's surface with no titlebar behind it.
# ⚠ It is not an opacity bug; it is why the GPU frame cannot be trusted with overlapping windows at
# all, and therefore why per-window opacity could not be allowed onto that path.
#
# ⭐ THE FIX NEEDS NO NEW QUEUE. `render_desktop` already paints windows bottom-to-top, so both queues
# are ALREADY in z-order — the only thing missing was where one window ends and the next begins.
# A mark after each window recovers that, and `present_frame` can then emit
# [chrome_i][surface_i][text_i] per window instead of [all chrome][all surfaces][all text].
#
# ⚠ MARK EVERY WINDOW, INCLUDING ONES THAT DREW NOTHING. A minimized window enqueues no rects, so its
# range is empty — but its mark must still exist or every later index refers to the wrong window.
var AE_MARK_MAX = 64;
var ae_rect_mark[64];
var ae_text_mark[64];
var ae_mark_n = 0;
var ae_rect_prelude = 0;      # rects queued BEFORE the first window: the clear / wallpaper band
var ae_text_prelude = 0;

fn ae_marks_reset(): i64 { ae_mark_n = 0; ae_rect_prelude = 0; ae_text_prelude = 0; return 0; }
# Called once after the background and before the first window.
fn ae_mark_prelude(): i64 { ae_rect_prelude = ae_rect_n; ae_text_prelude = ae_text_n; return 0; }
# Called after EACH window, drawn or not.
fn ae_mark_window(): i64 {
    if (ae_mark_n >= AE_MARK_MAX) { return 0; }
    store64(&ae_rect_mark + ae_mark_n * 8, ae_rect_n);
    store64(&ae_text_mark + ae_mark_n * 8, ae_text_n);
    ae_mark_n = ae_mark_n + 1;
    return 1;
}
fn ae_mark_count(): i64 { return ae_mark_n; }
fn ae_rect_mark_at(i): i64 { if (i < 0) { return ae_rect_prelude; } return load64(&ae_rect_mark + i * 8); }
fn ae_text_mark_at(i): i64 { if (i < 0) { return ae_text_prelude; } return load64(&ae_text_mark + i * 8); }
fn ae_rect_prelude_n(): i64 { return ae_rect_prelude; }
fn ae_text_prelude_n(): i64 { return ae_text_prelude; }

fn ae_rect_reset(): i64 { ae_rect_n = 0; return 0; }
fn ae_rect_count(): i64 { return ae_rect_n; }
fn ae_rect_get_x(i): i64 { return load64(&ae_rect_x + i * 8); }
fn ae_rect_get_y(i): i64 { return load64(&ae_rect_y + i * 8); }
fn ae_rect_get_w(i): i64 { return load64(&ae_rect_w + i * 8); }
fn ae_rect_get_h(i): i64 { return load64(&ae_rect_h + i * 8); }
fn ae_rect_get_col(i): i64 { return load64(&ae_rect_col + i * 8); }
fn ae_rect_get_a(i): i64 { return load64(&ae_rect_a + i * 8); }
fn ae_rect_dropped_get(): i64 { return ae_rect_dropped; }
fn ae_chrome_gpu_ok_get(): i64 { return ae_chrome_gpu_ok; }
fn ae_chrome_gpu_disable(): i64 { ae_chrome_gpu_ok = 0; return 0; }

# 1 when this frame's chrome goes to the GPU. Read by every fill so one frame cannot be half-migrated.
fn ae_chrome_on_gpu(): i64 {
    if (ae_gpu_frame_ok != 1) { return 0; }
    # ⛔⛔ TEXT AND CHROME RETIRE TOGETHER, AND THEY DID NOT. `AE-8`'s fallback comment promised "every
    # LATER frame goes back to the per-pixel path and the desktop keeps its titles" — true when it was
    # written, FALSE once `AE-9` deleted the `#39` blit. With chrome still on the GPU, `chrome_rc > 0`
    # zeroes the damage band and the blit is skipped, so CPU-drawn glyphs land in a userland framebuffer
    # that nothing copies to screen. The 1.56.42 burn showed it: one refused glyph run and every glyph on
    # the desktop was gone for the rest of the session, with a log line that said the opposite.
    # ⇒ If text cannot go on the GPU, chrome does not either — that restores the `#39` blit and makes the
    # CPU text visible again. ⚠ It costs the `AE-9` win for the rest of that session, which is the correct
    # trade: a slower desktop beats an invisible one.
    if (ae_text_gpu_ok != 1) { return 0; }
    # ⛔⛔ AND THE CURSOR RETIRES CHROME TOO — the same trap, found by audit before it reached iron. The
    # cursor's own retirement latch sends `render_cursor` to `render_cursor_cpu`, but if chrome stayed on
    # the GPU the `#39` blit stays skipped and those CPU pixels land in a framebuffer nothing copies to
    # screen. ⇒ The "fix" for an invisible cursor would have produced an invisible cursor. Any layer that
    # falls back to per-pixel drawing must drag chrome back with it, because the blit is the only thing
    # that carries per-pixel output to the panel.
    if (ae_cursor_gpu_ok != 1) { return 0; }
    # ⛔⛔ AND A TRANSLUCENT WINDOW RETIRES CHROME FOR THE FRAME — the same trap as the three above, and
    # the ONLY one of them that reached iron. `fill_rect_a` (:64) is a per-pixel read-modify-write with no
    # `#88` route, so a window at opacity < 255 draws its body, titlebar and accent strip into the
    # USERLAND framebuffer no matter what this returns. Answering 1 then skips the `#39` blit (gpu.cyr
    # :1119 zeroes the band the moment any rect is queued, and the deco buttons always are) and those
    # pixels never reach the panel. 1.56.44 burn: at `--opacity 128` every window lost its titlebar
    # background and kept its buttons and title glyphs — the exact shape this file's banner predicted for
    # text and for the cursor, from a fourth layer nobody had added to the list.
    # ⚠ The CLIENT SURFACES stay on the GPU — `render_window` still skips its CPU composite on
    # `ae_gpu_frame_ok`, which is unchanged — so `#92` op 0x06 keeps doing the per-pixel blend. Only the
    # flat chrome comes back to the CPU, and the band blit carries it.
    if (ae_gpu_alpha_chrome == 1) { return 0; }
    return ae_chrome_gpu_ok;
}

# Queue one chrome rect, CLIPPED to the framebuffer exactly as fill_rect clips. Returns 1 if queued.
#
# ⛔ THE CLIP MUST HAPPEN HERE, NOT IN THE KERNEL. `#88 gpu_fill_rect` bounds-checks against the back
# buffer and REFUSES an out-of-range rect rather than clipping it — while `fill_rect` has always clipped
# silently. Passing an unclipped rect would turn a window dragged one pixel past the edge from a clipped
# fill into a refused op, and the refusal would retire the whole chrome path for the session.
# ⚠ The opaque form is the SAME function with alpha 255, not a copy. Two enqueues that clip
# independently is how the two would drift, and the clip is the load-bearing half.
fn ae_rect_enqueue(fb, x, y, w, h, color): i64 {
    return ae_rect_enqueue_a(fb, x, y, w, h, color, 255);
}

fn ae_rect_enqueue_a(fb, x, y, w, h, color, a): i64 {
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (x1 > fw) { x1 = fw; }
    if (y1 > fh) { y1 = fh; }
    if (x1 <= x0) { return 1; }                  # fully clipped: nothing to draw, nothing to fall back to
    if (y1 <= y0) { return 1; }
    if (ae_rect_n >= AE_RECT_MAX) { ae_rect_dropped = ae_rect_dropped + 1; return 0; }
    store64(&ae_rect_x + ae_rect_n * 8, x0);
    store64(&ae_rect_y + ae_rect_n * 8, y0);
    store64(&ae_rect_w + ae_rect_n * 8, x1 - x0);
    store64(&ae_rect_h + ae_rect_n * 8, y1 - y0);
    store64(&ae_rect_col + ae_rect_n * 8, color);
    store64(&ae_rect_a + ae_rect_n * 8, a);
    ae_rect_n = ae_rect_n + 1;
    return 1;
}

# ============================================================================================
# ⭐⭐ `AE-8` — GLYPHS OFF THE CPU. The text-run queue and the 1bpp packer.
# ============================================================================================
# `draw_char` sets ONE PIXEL PER CALL through `bhumi_fb_set`, which is the same per-pixel overhead that
# made `fill_rect` cost 12.72 ns/px before it was rewritten to walk rows — four bounds compares and seven
# `load64`s of the framebuffer header to store four bytes. Text is the last chrome layer still paying it,
# and a terminal made glyphs the desktop's hot content.
#
# agnos `#92` op 0x03 GLYPH_1BPP does exactly this in one dispatch: a 1bpp mask, colour where a bit is
# set, destination untouched elsewhere. ⭐ kashi's VGA 8x16 font is ALREADY that format — one byte per
# row, `bit (7 - col)` leftmost — and the kernel's shader reads **MSB-first** (its own comment names
# LSB-first as the mistake it was written to avoid). So the packer below is a bit-copy, not a conversion.
#
# ⛔ WHY A QUEUE AND NOT A DIRECT CALL. Chrome is drawn into the USERLAND framebuffer and reaches the back
# buffer via the `#39` DEFER blit inside `ae_gpu_present_frame` — which runs AFTER render. A glyph op
# issued during render would be overwritten by that blit. So render ENQUEUES and present DRAINS, after the
# chrome lands. ⚠ The queue lives here rather than in gpu.cyr for the same reason `ae_frame_dmg` does: a
# cyrius VARIABLE forward-reference does not resolve, and `tests/render.tcyr` compiles this module without
# gpu.cyr. The syscall stays on the far side of that line.
enum AeText {
    AE_TEXT_MAX      = 48;       # runs per frame
    AE_TEXT_CHARS    = 64;       # CELLS per run — every window caption is capped to it; other chrome text is not
    # Bytes in a caption buffer: AE_TEXT_CHARS cells of up to 4 UTF-8 bytes, the 3-byte '…' and the NUL, rounded
    # up to 8. ⚠ `rend_title_caption` keeps four bytes free while it copies, so 4 * AE_TEXT_CHARS + 4 is the floor.
    AE_TEXT_CAP_B    = 264;
    AE_TEXT_ELLIPSIS = 0x2026;   # U+2026 HORIZONTAL ELLIPSIS — a cut caption's last cell
}
var ae_text_n = 0;
var ae_text_x[48];
var ae_text_y[48];
var ae_text_col[48];
var ae_text_off[48];       # where each run starts in the pool, in CELLS
var ae_text_len[48];       # each run's length, in CELLS
# ⛔ MODULE-SCOPE `var X[N]` IS N x u64. The pool holds CELLS of TWO bytes: since kashi 1.1.0 a cell reaches
# 0x101 ('…' and U+FFFD are extension cells past 0xFF, its ADR 0011), and a one-byte pool would wrap them to
# 0x00 / 0x01 — blank. AE_TEXT_MAX * AE_TEXT_CHARS = 3072 cells = 6144 bytes, so [768]. Sizing it by the
# function-local byte rule would overrun into the next global.
# ⭐ DECODED ONCE, AT ENQUEUE. The pool holds what will be DRAWN, so the packer gpu.cyr runs every frame has no
# decoder in it, a run's length is one number — cells, which is what its width, the cap and the fit all count
# — and a cell costs 2 bytes where its UTF-8 can cost 4. A CPU draw maps through the same `ae_text_cell`.
var ae_text_pool[768];
var ae_text_used = 0;      # pool CELLS in use
# ⚠ COUNTED, NOT SILENT. A queue that quietly drops a run renders a window with no title and nothing says
# why. The caller falls back to the CPU path on a refusal — ⛔ but a GPU frame never presents that CPU layer
# (`AE-9` skips the `#39` band), so there a drop IS a missing caption. Window captions are made to fit
# HORIZONTALLY before they get here (`render_title`); a run `ae_text_fits` refuses — a caption row past the
# top or bottom edge among them — is not counted at all.
var ae_text_dropped = 0;
# ⛔ 1 = the GPU glyph path is still trusted. THIS IS THE ONE-FRAME KILL SWITCH, and it exists because the
# enqueue happens BEFORE anyone knows the op will succeed: `draw_text` hands a run to the queue and does not
# draw it, so if the emit then fails the text is simply ABSENT — silent missing titles, on every frame,
# forever. Cleared by gpu.cyr the first time an op is refused, which sends every later frame back to the
# per-pixel path. A shader that cannot glyph therefore costs ONE frame of captions, not the whole session.
var ae_text_gpu_ok = 1;
fn ae_text_gpu_ok_get(): i64 { return ae_text_gpu_ok; }
fn ae_text_gpu_disable(): i64 { ae_text_gpu_ok = 0; return 0; }

fn ae_text_reset(): i64 { ae_text_n = 0; ae_text_used = 0; return 0; }
fn ae_text_count(): i64 { return ae_text_n; }
fn ae_text_run_x(i): i64 { return load64(&ae_text_x + i * 8); }
fn ae_text_run_y(i): i64 { return load64(&ae_text_y + i * 8); }
fn ae_text_run_col(i): i64 { return load64(&ae_text_col + i * 8); }
fn ae_text_run_len(i): i64 { return load64(&ae_text_len + i * 8); }
# ⚠ -> the run's CELLS, two bytes each (`load16` at + 2 * j) — what `ae_text_pack_1bpp` reads, not the string.
fn ae_text_run_ptr(i): i64 { return &ae_text_pool + load64(&ae_text_off + i * 8) * 2; }
fn ae_text_dropped_get(): i64 { return ae_text_dropped; }

# Queue one text run. Returns 1 if queued (the caller must NOT also draw it), 0 if refused.
# ⛔⛔ WOULD THIS RUN LEAVE THE FRAMEBUFFER? `#92` op 0x03 REFUSES an out-of-range rect rather than
# clipping it — the same contract `#88` has, which `ae_rect_enqueue` already guards. The text path did
# not, and it cost the 1.56.42 iron burn: `AE-7`'s cursor is a glyph at the cursor position, the position
# was clamped to `bound_w - 1`, and an 8 px glyph at x=2559 on a 2560-wide buffer reaches 2567. One move
# to the right edge refused, the path retired for the session, and **every glyph on the desktop
# disappeared** — titles included, because `AE-9` no longer blits the framebuffer the CPU draws into.
# ⇒ Refuse HERE so the run falls through to the CPU path: one glyph missing for one frame, instead of a
# retired path for the boot. ⚠ Checked against the FRAMEBUFFER, which this file already has — the GPU back
# buffer's dimensions live in gpu.cyr, which is included AFTER this file, and Cyrius does not resolve
# forward references to variables.
fn ae_text_fits(fb, s, x, y): i64 {
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    var n = utf8_count(s);                          # CELLS: a run is as wide as its scalars, not its bytes
    if (n == 0) { return 1; }
    if (x + ae_text_width(n) > bhumi_fb_width(fb)) { return 0; }
    if (y + FONT_H > bhumi_fb_height(fb)) { return 0; }
    return 1;
}

fn ae_text_enqueue(s, x, y, color): i64 {
    if (ae_text_n >= AE_TEXT_MAX) { ae_text_dropped = ae_text_dropped + 1; return 0; }
    var n = utf8_count(s);                          # CELLS — the cap and the pool both count cells
    if (n == 0) { return 1; }                       # nothing to draw, and nothing to fall back to
    # ⛔⛔ REFUSE A RUN THAT WOULD LEAVE THE BACK BUFFER, LOCALLY, BEFORE THE KERNEL SEES IT.
    #
    # `#92` op 0x03 REFUSES an out-of-range rect rather than clipping it — the same contract `#88` has,
    # and `ae_rect_enqueue` already guards against for exactly this reason. The text path did not, and it
    # cost the 1.56.42 iron burn: the new `AE-7` cursor is a glyph drawn at the cursor position, the
    # position was clamped to `bound_w - 1`, and an 8 px glyph at x=2559 on a 2560-wide buffer extends to
    # 2567. One move to the right edge refused, `ae_text_gpu_disable()` retired the path for the session,
    # and **every glyph on the desktop vanished** — titles included, because the CPU fallback draws into a
    # framebuffer that `AE-9` no longer blits.
    # ⇒ A run that does not fit is DROPPED here and falls through to the CPU path, which is a missing
    # glyph for one frame instead of a retired path for the boot.
    # ⚠ Dropped, not clipped: a partial 1bpp mask would need per-run stride surgery, and the case is a
    # cursor at the very edge — one frame of absence is the cheaper correct answer.
    if (x < 0) { ae_text_dropped = ae_text_dropped + 1; return 0; }
    if (y < 0) { ae_text_dropped = ae_text_dropped + 1; return 0; }
    if (n > AE_TEXT_CHARS) { ae_text_dropped = ae_text_dropped + 1; return 0; }
    if (ae_text_used + n > AE_TEXT_MAX * AE_TEXT_CHARS) { ae_text_dropped = ae_text_dropped + 1; return 0; }
    ae_text_cells(&ae_text_pool + ae_text_used * 2, s, n);
    store64(&ae_text_x + ae_text_n * 8, x);
    store64(&ae_text_y + ae_text_n * 8, y);
    store64(&ae_text_col + ae_text_n * 8, color);
    store64(&ae_text_off + ae_text_n * 8, ae_text_used);
    store64(&ae_text_len + ae_text_n * 8, n);
    ae_text_used = ae_text_used + n;
    ae_text_n = ae_text_n + 1;
    return 1;
}

# Row stride in bytes of the 1bpp bitmap a run of `len` CELLS packs into. `#92` op 0x03 requires
# byte-aligned rows: `(w + 7) / 8`.
fn ae_text_stride(len): i64 { return ((len * FONT_ADV) + 7) / 8; }
fn ae_text_width(len): i64 { return len * FONT_ADV; }
fn ae_text_bytes(len): i64 { return ae_text_stride(len) * FONT_H; }

# Pack the `len` CELLS at `cells` — two bytes each, a queued run (`ae_text_run_ptr`) — into a 1bpp MSB-first
# bitmap at `dst`. -> the bitmap width in pixels.
#
# ⛔ MSB-FIRST, AND THIS IS THE ONE DETAIL THAT CANNOT BE GUESSED. The kernel's glyph shader reads bit 7 of
# a byte as the LEFTMOST pixel, and its own source comment says the mistake it was written to avoid is
# reading LSB-first — which mirrors every glyph horizontally. kashi hands out rows in the same convention
# (`bit (7 - col)`), so this is a bit-for-bit copy at a horizontal offset, not a format conversion.
# ⚠ Pure — no syscalls, no framebuffer — so `tests/render.tcyr` can verify the bit layout on any machine
# instead of on the operator's only box.
fn ae_text_pack_1bpp(dst, cells, len): i64 {
    var stride = ae_text_stride(len);
    var total = stride * FONT_H;
    var z = 0;
    while (z < total) { store8(dst + z, 0); z = z + 1; }
    var i = 0;
    while (i < len) {
        var ch = load16(cells + i * 2);
        var row = 0;
        while (row < FONT_H) {
            var bits = kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, row);
            var c = 0;
            while (c < FONT_W) {
                if ((bits & (1 << (7 - c))) != 0) {
                    var px = i * FONT_ADV + c;
                    var byi = row * stride + px / 8;
                    var bit = px - (px / 8) * 8;
                    store8(dst + byi, load8(dst + byi) | (1 << (7 - bit)));
                }
                c = c + 1;
            }
            row = row + 1;
        }
        i = i + 1;
    }
    return ae_text_width(len);
}

# draw_char(fb, ch, x, y, color): blit one kashi VGA 8x16 glyph CELL. Each row is a
# byte; bit (7 - col) = leftmost-first pixel. Requires kashi_font_init() first.
# ⚠ `ch` IS A CELL — not a byte of text, not a codepoint: 0x20..0xFF is the CP437 page and 0x100.. kashi's
# extension block, and anything else draws blank. Text reaches it through `ae_text_cell`.
# ⭐ ONE-SHOT FONT GUARD (0.16.4). See `draw_text` for why this exists rather than a bare call.
var ae_font_ready = 0;
fn ae_font_ensure(): i64 {
    if (ae_font_ready == 1) { return 0; }
    kashi_font_init();
    ae_font_ready = 1;
    return 1;
}

# The glyph CELL that draws scalar `cp` (kashi ADR 0011): printable ASCII is itself, the CP437 high half its
# code-page cell (U+00E9 'é' is 0x82), U+2026 and U+FFFD the extension cells — and 0 for a scalar no built-in
# glyph draws, which every glyph accessor answers with blank rows.
# ⭐ A BLANK CELL STILL ADVANCES — Rust parity: renderer.rs draw_text moves on 6 px for a char it has no glyph for.
# ⚠ Ill-formed UTF-8 reaches this as U+FFFD (src/utf8.cyr), so it draws U+FFFD's glyph. Port-only: a Rust
# `&str` cannot hold an ill-formed byte.
# ⛔ The map's high half reads tables `kashi_font_init` fills, so `ae_font_ensure` must have run first — before
# it, U+00E9 answers 0 and draws blank.
fn ae_text_cell(cp): i64 { return kashi_cp437_from_unicode(cp); }

# Decode the UTF-8 string `s` into glyph CELLS at `dst`, two bytes each, at most `max` of them. -> how many.
# ⭐ The ONE decode-and-map the glyph queue uses, through the same `ae_text_cell` `draw_text`'s CPU loop draws
# with — so a queued run and a CPU draw of one string are the same cells by construction.
fn ae_text_cells(dst, s, max): i64 {
    ae_font_ensure();
    var n = 0;
    var i = 0;
    while (n < max) {
        var r = utf8_next(s + i);
        if (utf8_next_len(r) == 0) { break; }
        store16(dst + n * 2, ae_text_cell(utf8_next_cp(r)));
        i = i + utf8_next_len(r);
        n = n + 1;
    }
    return n;
}

fn draw_char(fb, ch, x, y, color): i64 {
    var row = 0;
    while (row < FONT_H) {
        var bits = kashi_glyph_row(KASHI_FONT_VGA_8X16, ch, row);
        var col = 0;
        while (col < FONT_W) {
            if ((bits & (1 << (7 - col))) != 0) {
                bhumi_fb_set(fb, x + col, y + row, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 1;
}

# draw_text(fb, s, x, y, color): render a NUL-terminated UTF-8 cstring, one cell per scalar. -> width in px.
fn draw_text(fb, s, x, y, color): i64 {
    # ⛔⛔ THE FONT MUST BE UP BEFORE ANY GLYPH IS READ, AND THE COST OF FORGETTING IS NOT BLANK TEXT.
    # `kashi_font_init` was called once from `main.cyr` at boot, so every production path was fine and
    # the requirement was invisible. It surfaced when 0.16.4 taught `render_shell_panel` to draw
    # labels: `tests/shell_render.tcyr` had never pulled in the font data, because until then nothing
    # it called REACHED a glyph — the link succeeded with `kashi_glyph_row` undefined-but-unreachable,
    # and the moment it became reachable the suite died on SIGILL rather than drawing nothing.
    # ⚠ GUARDED, NOT UNCONDITIONAL: `kashi_font_init` rewrites the whole 8x16 table, and this is a
    # per-frame path. One branch per string is the price of never losing text to an init order again.
    ae_font_ensure();
    # ⭐ `AE-8`: on a GPU frame the glyphs go to `#92` op 0x03 instead of through `bhumi_fb_set` per pixel.
    # ⛔ Only when `ae_gpu_frame_ok == 1` — that flag means `ae_gpu_present_frame` WILL run and drain the
    # queue. Enqueuing on a CPU frame would silently drop the text, because nothing would ever emit it.
    # ⚠ A refused enqueue (queue or pool full) falls through to the CPU path below, so text is never lost.
    if (ae_gpu_frame_ok == 1) {
        if (ae_text_gpu_ok == 1) {
            if (ae_text_fits(fb, s, x, y) == 1) {
                if (ae_text_enqueue(s, x, y, color) == 1) { return ae_text_width(utf8_count(s)); }
            }
        }
    }
    # ⭐ ONE SCALAR, ONE CELL OF ADVANCE — Rust's `for ch in text.chars()`, a blank cell included. A byte per cell
    # was the mojibake: "é" (C3 A9) drew `├⌐` in two cells.
    var cx = x;
    var i = 0;
    while (1) {
        var r = utf8_next(s + i);
        if (utf8_next_len(r) == 0) { break; }
        draw_char(fb, ae_text_cell(utf8_next_cp(r)), cx, y, color);
        cx = cx + FONT_ADV;
        i = i + utf8_next_len(r);
    }
    return cx - x;
}

# draw_text_lines(fb, s, x, y, color): like draw_text, but honors '\n' (U+000A) as a
# line break — a foreign guest's captured stdout is multi-line. NUL ends. Returns
# the total pixel height drawn (from y to the last line's baseline).
# ⚠ Decoded like draw_text. A '\n' is always a unit of its own — 0x0A continues no sequence — so a sequence cut
# short by a newline is one U+FFFD and the line still breaks.
fn draw_text_lines(fb, s, x, y, color): i64 {
    ae_font_ensure();                               # the cell map reads the tables too — see `ae_text_cell`
    var cx = x;
    var cy = y;
    var i = 0;
    while (1) {
        var r = utf8_next(s + i);
        if (utf8_next_len(r) == 0) { break; }
        if (utf8_next_cp(r) == 10) {
            cx = x;
            cy = cy + FONT_H + 2;
        } else {
            draw_char(fb, ae_text_cell(utf8_next_cp(r)), cx, cy, color);
            cx = cx + FONT_ADV;
        }
        i = i + utf8_next_len(r);
    }
    return cy - y;
}

# text_width(s): pixel width of a UTF-8 cstring in this font: cells * FONT_ADV - 1, 0 if empty.
# Parity: renderer.rs text_width is `chars().count() * 6 - 1` — every scalar is a cell, glyph or not.
fn text_width(s): i64 {
    var n = utf8_count(s);
    if (n == 0) { return 0; }
    return n * FONT_ADV - 1;
}
