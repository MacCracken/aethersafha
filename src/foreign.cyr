# aethersafha — foreign-app hosting via mehman (the "swallow" backend)
# Parity: rust-old/src/xwayland.rs — the foreign-app compat path.
#
# mehman is the foreign-app swallow backend: it hosts foreign-ABI apps as kavach-sandboxed
# guests and hands their surfaces to the compositor as native windows. This is
# aethersafha's seam onto mehman — build a guest spec (swallow caps: non-native,
# mediated I/O) + an XRGB8888 foreign-surface descriptor, and register a
# compositor window backed by it. Actually running the guest is
# `mehman_sandbox_run_guest` (kavach-sandboxed); the descriptor path is here.

# A hosted foreign app: its mehman guest spec + surface descriptor + window.
enum ForeignOff {
    FGN_GUEST  = 0;    # *MehmanGuestSpec
    FGN_SURF   = 8;    # *MehmanSurface
    FGN_WIN    = 16;   # id of its window, or 0. ⛔ Not a pointer: a closed window's object goes back to the pool
    FGN_RESULT = 24;   # last foreign_run MehmanError, or -1 (never run)
    FGN_EXIT   = 32;   # last kavach exec status
    FGN_SZ     = 40;
}

# foreign_new(command, w, h): build the mehman guest + XRGB8888 surface descriptor
# for a foreign command. -> *Foreign (0 if the guest/surface are invalid or OOM).
fn foreign_new(command, w, h): i64 {
    var guest = guest_spec_new(command, caps_swallow_default());
    if (guest_spec_is_valid(guest) == 0) { return 0; }
    var stride = w * mehman_format_bpp(MehmanPixelFormat.XRGB8888);
    # the foreign app's XRGB8888 pixel buffer (mehman captures the guest into it)
    var buffer = alloc(stride * h);
    if (buffer == 0) { return 0; }
    var surf = surface_new(w, h, MehmanPixelFormat.XRGB8888, stride, buffer);
    if (surface_is_valid(surf) == 0) { return 0; }
    var f = alloc(FGN_SZ);
    if (f == 0) { return 0; }
    store64(f + FGN_GUEST, guest);
    store64(f + FGN_SURF, surf);
    store64(f + FGN_WIN, 0);
    store64(f + FGN_RESULT, 0 - 1);   # never run
    store64(f + FGN_EXIT, 0);
    return f;
}

fn foreign_guest(f)       { return load64(f + FGN_GUEST); }
fn foreign_surface(f)     { return load64(f + FGN_SURF); }
fn foreign_window_id(f)   { return load64(f + FGN_WIN); }
fn foreign_result(f)      { return load64(f + FGN_RESULT); }
fn foreign_exit_status(f) { return load64(f + FGN_EXIT); }
fn foreign_has_run(f): i64 {
    if (load64(f + FGN_RESULT) >= 0) { return 1; }
    return 0;
}
# The hosted app's window while it is on `desk`, or 0 once it closed.
fn foreign_window(desk, f): i64 {
    var i = comp_find_by_id(desk_comp(desk), foreign_window_id(f));
    if (i < 0) { return 0; }
    return comp_get(desk_comp(desk), i);
}

# foreign_run(f): run the foreign guest in a kavach PROCESS sandbox (real
# fork+exec+reap) AND capture its rendered surface into the hosted window's pixel
# buffer — the mehman M2 handoff. Records the MehmanError result + kavach exec
# status. -> the MehmanError code (MehmanError.OK on a clean run+capture+reap). A guest
# killed at its deadline returns GUEST_TIMED_OUT: it ran, so foreign_has_run stays 1 and
# what it wrote before the kill is presented like any other capture.
# This is the actual "swallow" path: the compositor launching a foreign app and
# taking its surface. (mehman 0.3.0: mehman_sandbox_capture_guest.)
fn foreign_run(f): i64 {
    var exit = 0;
    var r = mehman_sandbox_capture_guest(foreign_guest(f), foreign_surface(f), &exit);
    store64(f + FGN_RESULT, r);
    store64(f + FGN_EXIT, exit);
    return r;
}

# desktop_host_foreign(desk, command, x, y, w, h, title): host a foreign app —
# create its mehman guest + surface and register a compositor window (flagged
# non-agent / foreign) whose geometry matches the surface. -> *Foreign (0 fail).
fn desktop_host_foreign(desk, command, x, y, w, h, title): i64 {
    var f = foreign_new(command, w, h);
    if (f == 0) { return 0; }
    var win = comp_create_window(desk_comp(desk), x, y, w, h, title);
    win_set_agent(win, 0);
    store64(f + FGN_WIN, win_id(win));
    vec_push(desk_foreign(desk), f);
    ae_foreign_desk = desk;
    ae_win_guest_draw = &render_foreign_window;
    return f;
}

# render_foreign_content(fb, desk, f): present a hosted foreign app's captured surface as
# its window's content — the mehman "swallow" made visible. The guest's captured stdout lives in the surface
# buffer and is drawn as text in the window body, below the titlebar. This is the stdout-as-framebuffer MVP
# (mehman ADR 0004); real XRGB pixel fidelity is the next step. A no-op until the guest has actually run, once
# its window has closed, and while it is minimized. -> pixel height drawn.
# ⛔ THE BUFFER IS THE GUEST'S, so its bytes are bounded by the surface, not by a NUL: `surface_blit_bytes`
# zero-fills only what a guest left over, and one that fills the surface leaves none. And they are clipped to the
# window body, which a line or a row of guest output runs past as easily as anything else.
fn render_foreign_content(fb, desk, f): i64 {
    if (foreign_has_run(f) == 0) { return 0; }
    var win = foreign_window(desk, f);
    if (win == 0) { return 0; }
    if (win_state(win) == WinState.WS_MINIMIZED) { return 0; }
    var surf = foreign_surface(f);
    var buf = MehmanSurface_buffer(surf);
    if (buf == 0) { return 0; }
    var bx = win_x(win);
    var by = win_body_y(win);
    return draw_text_lines_in(fb, buf, surface_size_bytes(surf), bx + 6, by + 4, bhumi_xrgb(190, 230, 190),
      bx, by, win_w(win), win_h(win));
}

# ⭐ IN THE WINDOW'S OWN Z SLOT. `render_window` calls this, through `ae_win_guest_draw`, after the window's body,
# so a window above covers the text, as do the panel and the pointer, which are drawn later. It finds the hosted
# app by the window it was handed. -> pixel height drawn.
var ae_foreign_desk = 0;
fn render_foreign_window(fb, win): i64 {
    var v = desk_foreign(ae_foreign_desk);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var f = vec_get(v, i);
        if (foreign_window_id(f) == win_id(win)) { return render_foreign_content(fb, ae_foreign_desk, f); }
        i = i + 1;
    }
    return 0;
}
