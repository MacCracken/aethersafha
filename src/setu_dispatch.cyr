# aethersafha — setu display-protocol DISPATCH (message → compositor state).
#
# Native display protocol (agnosticos native-display-protocol.md §2.2): turns
# decoded setu messages into real compositor `Window`s, received pixel buffers,
# and framebuffer blits. Depends on the transport (setu_server.cyr) AND the
# compositor (compositor.cyr / window.cyr) + the bhumi framebuffer — kept
# separate from setu_server.cyr so the pure transport carries no compositor refs.
# All fns `setu_srv_*` (the dispatch half).
#
# ⛔ TRANSPORT NOTE (2026-08-03): the agnos arm of the underlying transport — TCP on loopback —
# is RETIRED on architectural grounds and moves to the agnos socket `anu` (agnos
# docs/development/planning/ipc.md §9; revert inventory §10). setu's LINUX arm is NOT retired.
# ⭐ This file is deliberately transport-agnostic: everything below operates on an
# already-accepted `cfd` through `setu_srv_read_*` / `setu_srv_write_frame`, so the anu
# migration should not touch the dispatch logic at all. Where a comment below names TCP
# specifically (e.g. the TCP_RX_RING deadlock note), read it as a property of the OLD wire.

# Close the client + listening fds and remove the socket file.
fn setu_srv_dispatch_close(cfd, sfd, path): i64 {
    syscall(SYS_CLOSE, cfd);
    syscall(SYS_CLOSE, sfd);
    syscall(SYS_UNLINK, path);
    return 0;
}

# Receive a CREATE_SURFACE → ATTACH(+inline payload) → COMMIT session on an
# already-accepted `cfd`, minting a Window on `comp`. Fills `out4` (a 32-byte
# scratch = 4 i64 slots): [+0]=*Window, [+8]=*pixels, [+16]=w, [+24]=h. Returns
# nbytes (> 0) or a negative code (-6 read · -7 reply · -8 not CREATE · -9 window
# alloc · -11 not ATTACH · -12 bad payload size · -13 not COMMIT). Byte-exact
# framing throughout (setu_srv_read_msg for frames, setu_srv_read_exact for the
# raw payload).
fn setu_srv_recv_committed(cfd, comp, out4): i64 {
    var m = setu_msg_new();
    if (setu_srv_read_msg(cfd, m) < 0) { return 0 - 6; }
    return setu_srv_commit_from_create(m, cfd, comp, out4);
}

# The handshake from CREATE_SURFACE onward, with that first message already in hand.
#
# ⛔ SPLIT OUT FOR THE CHANNEL BAND (1.56.40 bite 7), AND THE REASON IS A REAL STALL. Under the retired
# TCP transport, `accept()` only returned once a client had actually connected, so the blocking reads
# below were always called on a socket with something coming. A MINTED CHANNEL EXISTS THE INSTANT THE
# COMPOSITOR CREATES IT — before the client has run a single instruction — so calling this per frame
# would hit `setu_read_blk`'s 5000 x 2 ms retry budget and stall the frame loop for up to TEN SECONDS
# per client that has not spoken yet.
#
# ⭐ The fix is to POLL for the first message and only then commit: once CREATE_SURFACE has arrived the
# client is demonstrably running and sends ATTACH + COMMIT back to back, so the remaining blocking
# reads are satisfied promptly. That is why only the FIRST read moved — the other two are correct as
# they are, and making all three non-blocking would mean carrying a per-client handshake state machine
# for no gain.
fn setu_srv_commit_from_create(m, cfd, comp, out4): i64 {
    if (setu_msg_kind(m) != SETU_CREATE_SURFACE) { return 0 - 8; }
    var win = comp_create_window(comp, 0, 0, setu_msg_arg(m, 0), setu_msg_arg(m, 1), "setu-surface");
    if (win == 0) { return 0 - 9; }
    win_set_keymode(win, setu_msg_arg(m, 2) & SETU_SURF_FULL_KEYS);   # CREATE_SURFACE flags: full-key opt-in
    # SETU_SURF_PREMULTIPLIED: the client declares premultiplied BGRA (c <= a), so this surface may be
    # BLENDED per-pixel on the GPU (gpu_shader_op#92 op 0x01) instead of copied opaquely (#87).
    # ⚠ Normalised to 0/1 rather than stored as the raw bit — win_premul() is read as a boolean.
    var pmul = 0;
    if ((setu_msg_arg(m, 2) & SETU_SURF_PREMULTIPLIED) != 0) { pmul = 1; }
    win_set_premul(win, pmul);
    if (setu_srv_write_frame(cfd, setu_surface_created(win_id(win))) < 0) { return 0 - 7; }

    var am = setu_msg_new();
    if (setu_srv_read_msg(cfd, am) < 0) { return 0 - 6; }
    if (setu_msg_kind(am) != SETU_ATTACH) { return 0 - 11; }
    var w  = setu_msg_arg(am, 1);
    var ah = setu_msg_arg(am, 2);
    var stride = setu_msg_arg(am, 3);
    var buf_id = setu_msg_arg(am, 5);           # arg5: 0 = inline pixels, >0 = shared buffer
    var nbytes = ah * stride;
    if (nbytes <= 0) { return 0 - 12; }
    if (nbytes > 16777216) { return 0 - 12; }   # 16 MB cap
    var pix = alloc(nbytes);
    if (pix == 0) { return 0 - 14; }
    if (buf_id > 0) {
        # Sovereign shared-buffer present: copy the pixels OUT of the client's buffer
        # by id — no inline stream (which deadlocks on agnos when the payload exceeds
        # TCP_RX_RING). Kernel/OS-owned buffer, so no cross-proc page lifetime hazard.
        if (setu_buf_read(buf_id, pix, nbytes) < 0) { return 0 - 14; }
        # LIVE: record the buffer id so render_window RE-READS it every frame — a client
        # that keeps writing its buffer (without re-presenting) produces a live window.
        win_set_bufid(win, buf_id);
    }
    if (buf_id <= 0) {
        if (setu_srv_read_exact(cfd, pix, nbytes) < 0) { return 0 - 6; }
    }

    var cm = setu_msg_new();
    if (setu_srv_read_msg(cfd, cm) < 0) { return 0 - 6; }
    if (setu_msg_kind(cm) != SETU_COMMIT) { return 0 - 13; }

    store64(out4 + 0,  win);
    store64(out4 + 8,  pix);
    store64(out4 + 16, w);
    store64(out4 + 24, ah);
    return nbytes;
}

# Bite 4: accept ONE client, read a CREATE_SURFACE, create a real Window on
# `comp`, and reply SURFACE_CREATED(id). Returns the new surface id (> 0) or a
# negative code (listen/-5 accept/-6 read/-8 not CREATE/-9 alloc/-7 reply).
fn setu_srv_create_surface(path, comp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfd = setu_srv_listen(path);
    if (sfd < 0) { return sfd; }
    var cfd = syscall(SYS_ACCEPT, sfd, 0, 0);
    if (cfd < 0) { syscall(SYS_CLOSE, sfd); syscall(SYS_UNLINK, path); return 0 - 5; }

    var msg = setu_msg_new();
    var rc = setu_srv_read_msg(cfd, msg);
    if (rc < 0) { setu_srv_dispatch_close(cfd, sfd, path); return rc; }
    if (setu_msg_kind(msg) != SETU_CREATE_SURFACE) { setu_srv_dispatch_close(cfd, sfd, path); return 0 - 8; }
    var win = comp_create_window(comp, 0, 0, setu_msg_arg(msg, 0), setu_msg_arg(msg, 1), "setu-surface");
    if (win == 0) { setu_srv_dispatch_close(cfd, sfd, path); return 0 - 9; }
    var id = win_id(win);
    var wr = setu_srv_write_frame(cfd, setu_surface_created(id));
    setu_srv_dispatch_close(cfd, sfd, path);
    if (wr < 0) { return wr; }
    return id;
    #endif
}

# Bite 6: serve a CREATE→ATTACH(+payload)→COMMIT session and return a byte
# checksum (sum of committed pixel bytes) — proof the payload crossed the wire
# intact. Does not blit.
fn setu_srv_serve_buffer(path, comp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfd = setu_srv_listen(path);
    if (sfd < 0) { return sfd; }
    var cfd = syscall(SYS_ACCEPT, sfd, 0, 0);
    if (cfd < 0) { syscall(SYS_CLOSE, sfd); syscall(SYS_UNLINK, path); return 0 - 5; }
    var out4 = alloc(32);
    var nbytes = setu_srv_recv_committed(cfd, comp, out4);
    setu_srv_dispatch_close(cfd, sfd, path);
    if (nbytes < 0) { return nbytes; }
    var pix = load64(out4 + 8);
    var sum = 0;
    var i = 0;
    while (i < nbytes) { sum = sum + load8(pix + i); i = i + 1; }
    return sum;
    #endif
}

# Bite 7: serve a full session AND blit the committed buffer into the bhumi
# framebuffer `fb` at the window's (x,y), then read the framebuffer region back
# and verify it equals the source pixels. Returns the framebuffer-region pixel
# checksum (> 0) when the blit landed correctly, -30 on a source/framebuffer
# mismatch, or a negative recv code. This proves the whole path
# client→wire→compositor→framebuffer; the final kernel-scanout hop
# (bhumi_backend_present) is agnos-only.
fn setu_srv_serve_present(path, comp, fb): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfd = setu_srv_listen(path);
    if (sfd < 0) { return sfd; }
    var cfd = syscall(SYS_ACCEPT, sfd, 0, 0);
    if (cfd < 0) { syscall(SYS_CLOSE, sfd); syscall(SYS_UNLINK, path); return 0 - 5; }
    var out4 = alloc(32);
    var nbytes = setu_srv_recv_committed(cfd, comp, out4);
    setu_srv_dispatch_close(cfd, sfd, path);
    if (nbytes < 0) { return nbytes; }

    var win = load64(out4 + 0);
    var pix = load64(out4 + 8);
    var w   = load64(out4 + 16);
    var h   = load64(out4 + 24);
    var wx = win_x(win);
    var wy = win_y(win);

    # Blit the w×h BGRA buffer into the framebuffer, summing source pixels.
    var src_sum = 0;
    var py = 0;
    while (py < h) {
        var px = 0;
        while (px < w) {
            var pixel = load32(pix + (py * w + px) * 4);
            bhumi_fb_set(fb, wx + px, wy + py, pixel);
            src_sum = src_sum + pixel;
            px = px + 1;
        }
        py = py + 1;
    }

    # Read the framebuffer region back and sum it — must equal the source.
    var fb_sum = 0;
    py = 0;
    while (py < h) {
        var px = 0;
        while (px < w) {
            fb_sum = fb_sum + bhumi_fb_get(fb, wx + px, wy + py);
            px = px + 1;
        }
        py = py + 1;
    }

    if (src_sum != fb_sum) { return 0 - 30; }
    return fb_sum;
    #endif
}

# Bite 11: serve a full PERSISTENT session for one client on one connection —
# receive a present (CREATE→ATTACH+payload→COMMIT), blit + verify it into `fb`,
# THEN push input events back down the same connection (the realistic duplex the
# one-shot probes didn't exercise). Returns the framebuffer-region checksum
# (> 0) on a verified blit, -30 on mismatch, or a negative recv code. On the real
# compositor the input originates from bhumi_backend_poll; scripted here.
fn setu_srv_serve_session(path, comp, fb): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfd = setu_srv_listen(path);
    if (sfd < 0) { return sfd; }
    var cfd = syscall(SYS_ACCEPT, sfd, 0, 0);
    if (cfd < 0) { syscall(SYS_CLOSE, sfd); syscall(SYS_UNLINK, path); return 0 - 5; }

    var out4 = alloc(32);
    var nbytes = setu_srv_recv_committed(cfd, comp, out4);
    if (nbytes < 0) { setu_srv_dispatch_close(cfd, sfd, path); return nbytes; }

    var win = load64(out4 + 0);
    var pix = load64(out4 + 8);
    var w   = load64(out4 + 16);
    var h   = load64(out4 + 24);
    var wx = win_x(win);
    var wy = win_y(win);
    var id = win_id(win);

    # Blit + verify (source == framebuffer region).
    var src_sum = 0;
    var fb_sum = 0;
    var py = 0;
    while (py < h) {
        var px = 0;
        while (px < w) {
            var pixel = load32(pix + (py * w + px) * 4);
            bhumi_fb_set(fb, wx + px, wy + py, pixel);
            src_sum = src_sum + pixel;
            fb_sum = fb_sum + bhumi_fb_get(fb, wx + px, wy + py);
            px = px + 1;
        }
        py = py + 1;
    }
    if (src_sum != fb_sum) { setu_srv_dispatch_close(cfd, sfd, path); return 0 - 30; }

    # Push scripted input back to the client on the SAME connection.
    setu_srv_write_frame(cfd, setu_input_key(id, 65, 0));        # 'A'
    setu_srv_write_frame(cfd, setu_input_ptr_move(id, 100, 50));
    setu_srv_write_frame(cfd, setu_input_ptr_btn(id, 272, 1));   # press

    setu_srv_dispatch_close(cfd, sfd, path);
    return fb_sum;
    #endif
}

# Bite 12: serve a present on an ALREADY-ACCEPTED connection `cfd` — the seam
# main's frame loop calls per accepted client. Receive CREATE→ATTACH+payload→
# COMMIT, mint the Window on `comp`, and blit the buffer into `fb` (composited on
# top of whatever the desktop drew this frame; proper z-order via the Window
# model is later polish). The CALLER owns cfd (accepts + closes it) and the
# listen socket, so this does no listen/accept/close and needs no agnos guard.
# Returns the surface id (> 0) or a negative recv code.
fn setu_srv_serve_accepted(cfd, comp, fb): i64 {
    var out4 = alloc(32);
    var nbytes = setu_srv_recv_committed(cfd, comp, out4);
    if (nbytes < 0) { return nbytes; }
    var win = load64(out4 + 0);
    var pix = load64(out4 + 8);
    # CACHE the presented pixels on the Window — render_window composites them into `fb` EVERY
    # frame, so the surface persists on screen. (Was a one-shot blit here, overwritten by the
    # next desktop redraw → the window vanished after one frame.) `fb` is now composited by the
    # per-frame render path, not here. Surface dims live on the Window (comp_create_window w/h).
    win_set_pix(win, pix);
    return win_id(win);
}

# Like setu_srv_serve_accepted, but PLACE this surface's window at (dstx,dsty)
# instead of the default (0,0) origin — so a compositor (or harness) can host
# MULTIPLE setu clients as distinct, non-overlapping windows (the multi-window
# desktop). Moves the minted Window and blits the committed buffer there. The
# CALLER owns cfd + the listen socket. Returns the surface id (>0) or a negative
# recv code.
# Non-blocking peer of setu_srv_serve_accepted_at, for a channel the compositor MINTED rather than
# accepted. Returns the new window id (> 0), 0 when the client has not spoken yet (poll again next
# frame — the common case for the first few frames after spawn), or a negative handshake error.
# ⛔ 0 IS NOT AN ERROR AND MUST NOT BE TREATED AS ONE. A client that has not been scheduled yet is
# indistinguishable from one that never will be, and the difference is time, not state.
# ⭐⭐ THE HANDSHAKE AS A PER-CLIENT STATE MACHINE, ONE STEP PER FRAME.
#
# ⛔ WHY IT CANNOT BLOCK, WHICH IS THE WHOLE REASON THIS EXISTS. The three messages are INTERACTIVE:
# the client sends CREATE_SURFACE, then waits for SURFACE_CREATED before sending ATTACH. So the
# compositor genuinely has to wait for its peer — and on agnos it MUST NOT, because every blocking
# wait available to ring 3 starves the peer. `setu_read_blk` retries via `sys_sleep_ms`, which holds
# preempt disabled; the client cannot run to send ATTACH while the compositor sleeps for it.
# ipc.md §9.4 names this exactly: "the preempt_disable; sti; hlt spin is the poison that made TCP
# toxic — it starves the peer it is waiting on."
#
# ⚠ Under the retired TCP transport this was invisible: `accept()` only returned once a client had
# connected, and the kernel's socket buffers absorbed the interleaving. A minted channel exists before
# the client does, so the compositor now meets its peer's scheduling directly.
#
# State: 0 = await CREATE_SURFACE · 1 = await ATTACH · 2 = attached, await COMMIT · 3 = done.
# Returns the window id (> 0) on COMPLETION, 0 while still in progress, negative on a protocol error.
# `st` is a 6-word scratch owned by the caller, one per client: [0]=state [1]=win [2]=pix [3]=w [4]=h.

enum SetuHsAct {
    HS_SKIP   = 0;    # a stale orphan record — consume it and stay in this state
    HS_CREATE = 1;
    HS_ATTACH = 2;
    HS_COMMIT = 3;
    HS_BAD    = 4;    # genuinely wrong kind for this state — the caller maps it to -8/-11/-13
}

# ⭐⭐ WHY THIS IS A PURE FUNCTION AND NOT AN `if` CHAIN INSIDE THE STEP: the record transport can
# DELETE records under us, so "which kind is legal in which state" is the part that has to be
# provably right, and it was not. It is separated so a test can drive it over every stream a lossy
# ring can produce. [[feedback_compiled_is_not_reachable]] — logic a test cannot reach is logic
# nobody checked, and this shipped to iron wrong.
#
# ⛔⛔ THE AGNOS CHANNEL RING DROPS THE **OLDEST** RECORD WHEN IT IS FULL (`chan_queue`,
# agnos kernel/core/syscall.cyr:4586 — 64 slots, `store64(&chan_r ..., rv + 1)` on overflow). A client
# that presents every frame emits ATTACH+COMMIT per frame; the compositor's frame is far slower
# (full-screen composite), so the client wraps the ring between two compositor reads and the read
# cursor is YANKED FORWARD to an arbitrary point in the …A,C,A,C,A,C… stream. A machine that demanded
# the exact next kind then failed FOREVER on a parity it did not choose.
# ⚠ MEASURED, 2026-08-08 iron burn: puka presents continuously and never got past this — no window
# with a client fd, so `setu_srv_forward_key` dropped every key at its `cfd == 0` guard and the
# terminal "didn't register key commands". crab survived only because it presents ONCE.
# ⭐ The resync: a COMMIT before any ATTACH is an orphan whose ATTACH was dropped (SKIP it); a repeat
# ATTACH after one landed means OUR commit was dropped (re-apply, idempotent). Either way the machine
# is back in phase within one record instead of stuck for the rest of the boot.
fn setu_hs_action(state, kind): i64 {
    if (state == 0) {
        if (kind == SETU_CREATE_SURFACE) { return SetuHsAct.HS_CREATE; }
        return SetuHsAct.HS_BAD;
    }
    if (state == 1) {
        if (kind == SETU_ATTACH) { return SetuHsAct.HS_ATTACH; }
        if (kind == SETU_COMMIT) { return SetuHsAct.HS_SKIP; }
        return SetuHsAct.HS_BAD;
    }
    if (state == 2) {
        if (kind == SETU_COMMIT) { return SetuHsAct.HS_COMMIT; }
        if (kind == SETU_ATTACH) { return SetuHsAct.HS_ATTACH; }
        return SetuHsAct.HS_BAD;
    }
    return SetuHsAct.HS_BAD;
}

var setu_hs_consumed = 0;      # 1 = the last step took a record off the channel (drives the drain)
var setu_hs_stale = 0;         # one-shot: a resync happened, i.e. the ring really did drop a pair

fn setu_srv_handshake_step(st, cfd, comp, dstx, dsty, title): i64 {
    var m = setu_msg_new();
    setu_hs_consumed = 0;
    var p = setu_poll_input(cfd, m);
    if (p == 0) { return 0; }                      # nothing this frame — NOT an error
    # ⛔ DO NOT ADD A DIAGNOSTIC `sys_chan_recv` HERE. A debug probe that reads the channel to
    # find out *why* the poll failed CONSUMES A RECORD, so the very handshake frame being chased
    # disappears into the diagnostic. A read is not a peek on a record transport.
    if (p < 0) { return 0 - 6; }
    setu_hs_consumed = 1;
    var state = load64(st);
    var act = setu_hs_action(state, setu_msg_kind(m));

    if (act == SetuHsAct.HS_SKIP) {
        if (setu_hs_stale == 0) {
            setu_hs_stale = 1;
            println("aethersafha: placed client: resynced past a stale record -- the channel ring dropped its pair");
        }
        return 0;
    }
    if (act == SetuHsAct.HS_BAD) {
        if (state == 0) { return 0 - 8; }
        if (state == 1) { return 0 - 11; }
        return 0 - 13;
    }

    if (act == SetuHsAct.HS_CREATE) {
        # ⭐ THE APPLICATION'S NAME, NOT "setu-surface". Every window on the desktop used to be captioned
        # with the protocol's name for a surface, which tells the user nothing and made two windows
        # indistinguishable in a photograph. setu carries no title in CREATE_SURFACE, but the compositor
        # SPAWNED these clients and therefore already knows what each one is — the name rides down from the
        # spawn site instead of needing a protocol change. ⚠ A client that arrives some other way (the
        # accept paths below) still gets "setu-surface"; that is honest, because nothing there knows better.
        var win = comp_create_window(comp, 0, 0, setu_msg_arg(m, 0), setu_msg_arg(m, 1), title);
        if (win == 0) { return 0 - 9; }
        win_set_keymode(win, setu_msg_arg(m, 2) & SETU_SURF_FULL_KEYS);
        var pmul = 0;
        if ((setu_msg_arg(m, 2) & SETU_SURF_PREMULTIPLIED) != 0) { pmul = 1; }
        win_set_premul(win, pmul);
        if (setu_srv_write_frame(cfd, setu_surface_created(win_id(win))) < 0) { return 0 - 7; }
        store64(st + 8, win);
        store64(st, 1);
        return 0;
    }

    if (act == SetuHsAct.HS_ATTACH) {
        var w2 = setu_msg_arg(m, 1);
        var ah = setu_msg_arg(m, 2);
        var stride = setu_msg_arg(m, 3);
        var buf_id = setu_msg_arg(m, 5);
        var nbytes = ah * stride;
        if (nbytes <= 0) { return 0 - 12; }
        if (nbytes > 16777216) { return 0 - 12; }
        # ⛔ SHM ONLY on this path. The inline-pixel branch streamed the surface down the control
        # connection, which a record channel cannot carry — and `setu_read_exact` correctly refuses on
        # agnos rather than emulating a stream. A client that presents inline here is a protocol error,
        # not something to work around.
        if (buf_id <= 0) { return 0 - 12; }
        # ⭐ IDEMPOTENT RE-ATTACH. This arm is reachable from state 2 (a repeat ATTACH whose predecessor's
        # COMMIT the ring ate), so it must not allocate a second surface every time — a continuously
        # presenting client would leak one FULL SURFACE per dropped commit. Reuse the buffer whenever the
        # geometry is unchanged, which for a client re-presenting the same window is always.
        # ⚠ A real resize (w/h differ) does abandon the old block; there is no free() on this allocator,
        # and one leak per resize is the same cost the single-shot version already paid per attach.
        var pix = load64(st + 16);
        if (pix != 0) { if (load64(st + 24) != w2) { pix = 0; } }
        if (pix != 0) { if (load64(st + 32) != ah) { pix = 0; } }
        if (pix == 0) {
            pix = alloc(nbytes);
            if (pix == 0) { return 0 - 14; }
        }
        if (setu_buf_read(buf_id, pix, nbytes) < 0) { return 0 - 14; }
        win_set_bufid(load64(st + 8), buf_id);
        store64(st + 16, pix);
        store64(st + 24, w2);
        store64(st + 32, ah);
        store64(st, 2);
        return 0;
    }

    var win3 = load64(st + 8);                     # HS_COMMIT — the only action left
    win_move(win3, dstx, dsty);
    win_set_pix(win3, load64(st + 16));
    win_set_cfd(win3, cfd);                        # ⭐ THE KEY PATH: forward_key refuses on cfd == 0
    store64(st, 3);
    return win_id(win3);
}

# ⭐⭐ DRAIN, DO NOT SIP. One record per frame is not a rate the compositor gets to choose: a client
# presenting every frame emits two records per ITS frame, and the compositor's frame is an order of
# magnitude slower, so sipping one record per frame falls permanently behind a 64-slot ring that drops
# the oldest to make room. The consumer must empty what is there, every frame.
# ⛔ BOUNDED BY THE RING, so a client that writes faster than this loop reads cannot hold the frame
# loop hostage: at most one ring's worth of records is processed per frame per client, then the
# compositor renders regardless.
# Returns exactly what the step returns: window id (> 0), 0 = still in progress, negative = error.
enum SetuHsK { DRAIN_MAX = 64; }   # = CHAN_SLOTS, the agnos channel ring depth

# ⚠ How many records the LAST drain call consumed. The caller needs this to tell "the client said
# nothing this frame" from "the client spoke and behaved" — which is what makes its retry counter
# genuinely CONSECUTIVE rather than cumulative. Not derivable from the return value: a productive
# drain and an idle one both return 0.
var setu_hs_drained = 0;

fn setu_srv_handshake_drain(st, cfd, comp, dstx, dsty, title): i64 {
    var n = 0;
    setu_hs_drained = 0;
    while (n < SetuHsK.DRAIN_MAX) {
        var r = setu_srv_handshake_step(st, cfd, comp, dstx, dsty, title);
        if (r != 0) { return r; }                   # completed or failed — the caller decides
        if (setu_hs_consumed == 0) { return 0; }    # channel empty: nothing more to do this frame
        n = n + 1;
        setu_hs_drained = n;
    }
    return 0;
}

fn setu_srv_serve_polled_at(cfd, comp, fb, dstx, dsty): i64 {
    var m = setu_msg_new();
    var p = setu_poll_input(cfd, m);
    if (p == 0) { return 0; }                        # nothing yet
    if (p < 0) { return 0 - 6; }                     # peer gone / error
    var out4 = alloc(32);
    var nbytes = setu_srv_commit_from_create(m, cfd, comp, out4);
    if (nbytes < 0) { return nbytes; }
    var win = load64(out4 + 0);
    var pix = load64(out4 + 8);
    win_move(win, dstx, dsty);
    win_set_pix(win, pix);
    win_set_cfd(win, cfd);
    return win_id(win);
}

fn setu_srv_serve_accepted_at(cfd, comp, fb, dstx, dsty): i64 {
    var out4 = alloc(32);
    var nbytes = setu_srv_recv_committed(cfd, comp, out4);
    if (nbytes < 0) { return nbytes; }
    var win = load64(out4 + 0);
    var pix = load64(out4 + 8);
    win_move(win, dstx, dsty);
    win_set_pix(win, pix);          # persist: render_window re-composites every frame (see above)
    win_set_cfd(win, cfd);          # KEEP the connection: the compositor forwards input on it
    return win_id(win);
}

# Forward a bhumi key event to the FOCUSED setu client over its persistent
# connection. The mods arg carries the make/break for a FULL_KEYS surface (1 = press,
# 0 = release); a press-only surface (the default) gets presses only with mods = 0 —
# byte-identical to the pre-0.5.0 behaviour. No-op if the focused window is a
# compositor-seeded window (win_cfd == 0) or nothing is focused. keysym = the bhumi HID
# usage. Returns 1 if a key was forwarded, else 0. This is the S->C leg of setu input.
fn setu_srv_forward_key(comp, ev): i64 {
    var win = comp_focused_window(comp);
    if (win == 0) { return 0; }
    var cfd = win_cfd(win);
    if (cfd == 0) { return 0; }                          # focused window has no setu client
    var pressed = bhumi_key_pressed(ev);
    # press-only clients (SETU_SURF_FULL_KEYS unset) still get key-DOWN only — drop key-UP.
    if (pressed == 0) { if (win_keymode(win) == 0) { return 0; } }
    var usage = bhumi_key_usage(ev);
    var val = 0;                                         # press-only surface: mods stays 0
    if (win_keymode(win) == 1) { val = pressed; }        # FULL_KEYS: mods = make/break (1/0)
    setu_send(cfd, setu_input_key(win_id(win), usage, val));
    return 1;
}

# Notify setu clients that focus MOVED from window index `old_idx` to `new_idx`:
# send SETU_INPUT_FOCUS(id, 0) to the window losing focus and (id, 1) to the one
# gaining it. No-op for a non-client window (win_cfd == 0) or an out-of-range index
# (old_idx == -1 on the first-ever focus). This is the client-visible focus indicator
# — clients render bright/dim from it, so focus is legible without a keypress.
fn setu_srv_notify_focus(comp, old_idx, new_idx): i64 {
    if (old_idx >= 0) {
        if (old_idx < comp_count(comp)) {
            var ow = comp_get(comp, old_idx);
            if (ow != 0) {
                var ocfd = win_cfd(ow);
                if (ocfd != 0) { setu_send(ocfd, setu_input_focus(win_id(ow), 0)); }
            }
        }
    }
    if (new_idx >= 0) {
        if (new_idx < comp_count(comp)) {
            var nw = comp_get(comp, new_idx);
            if (nw != 0) {
                var ncfd = win_cfd(nw);
                if (ncfd != 0) { setu_send(ncfd, setu_input_focus(win_id(nw), 1)); }
            }
        }
    }
    return 0;
}
