# gpu.cyr — hardware compositing on agnos: the first consumer of the ring-3 GPU display band.
#
# WHY THIS EXISTS. agnos ships an iron-proven ring-3 GPU band — `#84 present`, `#85 gpu_fill`,
# `#86 shm_create_gpu`, `#87 gpu_blit_shm`, `#88 gpu_fill_rect`, `#89 gpu_caps` — and until this file it had
# **zero callers anywhere in the ecosystem**. ~15 iron burns of proven capability that nothing used.
#
# ⚠ THE BLOCKER WAS NOT ALPHA, and the published diagnosis said it was. It was memory. `setu_buf_create`
# allocated client surfaces with `shm_create` #71 = SYSTEM RAM, and the agnos GPU cannot reach system RAM at
# all — bus-master is off by design and the engines see only the framebuffer aperture. The kernel therefore
# rejected every client slot at both GPU entry points (`#87`: `src_mc == 0 ⇒ the GPU cannot read it`;
# `#92`: `GPO_E_BADSLOT`). setu 0.6.0 fixed that in one line by asking for `shm_create_gpu` #86 first. The
# alpha facts (sadish forcing 0xFF, bhumi packing X=0) are real but gate `#92`'s PREMULTIPLIED blend only —
# they never blocked `#87`, which is an opaque blit. See [[reference_gpu_band_blocked_by_shm71_not_alpha]].
#
# WHAT THIS REPLACES. The CPU path did, per window, per frame:
#   1. `setu_buf_read` (#73) — a full surface copy, kernel → userland
#   2. a `bhumi_fb_set` loop — one `load32`+bounds-checked store PER PIXEL into the software framebuffer
#   3. and then the whole framebuffer went to the kernel anyway via `blit` #39
# `#87` does all of it in-kernel: the pixels never leave GPU-visible memory and never touch the CPU.
#
# ⚠ THE ORDERING IS THE WHOLE DESIGN, and it is why this is not a drop-in substitution. `#87` composites
# into the KERNEL's blit back buffer, while chrome (titlebars, borders, text) is drawn into bhumi's
# USERLAND software framebuffer. Getting a correct frame means both must land in the same buffer, in the
# right order:
#
#   1. chrome → back buffer, via `blit` #39 with **DEFER_PRESENT (a4 bit 40)** so it does NOT flip
#   2. each client surface → back buffer, via `#87`, landing ON TOP of the chrome
#   3. ONE `#84 present` to flip the finished frame
#
# Without the defer bit, step 1 auto-presents and every window would flash a chrome-only frame before its
# content arrived. Without step 3, nothing is ever shown.
#
# ⚠ FALLBACK IS NOT OPTIONAL. `#89` reports no GPU on QEMU (and on any non-AMD box), where the entire
# desktop must still work. Every failure path here returns 0 and the caller runs the untouched CPU path.

# --- Probe state. Probed ONCE: gpu_caps is cheap but not free, and the answer cannot change mid-run. ---
var ae_gpu_mode   = 0;    # 1 = hardware compositing available and armed
var ae_gpu_probed = 0;
var ae_gpu_blend  = 0;    # 1 = gpu_shader_op#92 is usable (caps bit3) — selects the PREMULTIPLIED route
# First-occurrence latches, so the log states WHICH kernel op composited client surfaces without
# printing per frame. ⛔ Both are printed, because "no line" must not be the signal for either case.
var ae_gpu_blend_seen = 0;
var ae_gpu_fallback_seen = 0;
var ae_gpu_wp_demote = 0;
var ae_gpu_op_demote = 0;

# ⭐⭐ THE WALLPAPER ON THE GPU — `#86` slot + `#87 gpu_blit_shm`, the SAME path a client surface takes
# (`AE-2`, iron-proven for an opaque surface). No new kernel op, no shader, no driver stack.
# ⛔ mabda is NOT involved: its GPU surface rides Linux's driver stack while this band is the agnos
# kernel's own ring-3 `#82`-`#94` (roadmap, corrected 2026-08-01). Decode is chitra's, on CPU.
# ⛔⛔ THE 2 MB CAP IS ON UPLOADS, NOT ON THE DESKTOP — do not read the table below as a resolution
# limit. `gpu_blit_arm` sizes the back buffer from boot_info as `pitch * height` (14.7 MB at 2560x1440),
# so the clear, the chrome `#88` fills, the `#92` glyphs and blend, and the `#84` flip all run at full
# native resolution; `AE-9` burned there. What the cap bites is what userland UPLOADS through `#86`:
# a full-screen wallpaper, and any single client surface over 2 MB (a window larger than ~724x724,
# which falls back to the CPU per-window exactly as `AE-6`'s routing intends). Client windows fit today
# because a window is smaller than the screen.
#
# ⛔ A `#86` slot is
# capped at **2 MB** (`SHM_MAX_SIZE = 2097152`, 16 slots system-wide). A full-screen XRGB wallpaper is
# `w*h*4`, so: 800x600 = 1,920,000 -> **FITS**, and that is archaemenid's actual scanout geometry.
# 1280x800 = 4,096,000 and 2560x1440 = 14,745,600 -> do NOT. Tiling across slots was considered and
# rejected: 8 slots for a 1440p wallpaper is half the system's supply held permanently, and re-uploading
# strips per frame moves more bytes through the CPU than the CPU blit it replaces.
# ⇒ Gated on the caps-reported `shm_slot_max` at RUNTIME, never on an assumed number, and a wallpaper
# that does not fit demotes the frame with its size named.
var ae_gpu_wp_slot = 0;
var ae_gpu_wp_buf  = 0;
var ae_gpu_wp_ser  = 0 - 1;   # wallpaper serial the slot was filled from
var ae_gpu_wp_w    = 0;       # geometry the slot was scaled to
var ae_gpu_wp_h    = 0;
var ae_gpu_wp_fail = 0;       # latched: too big, no slot, or a failed write
var ae_gpu_wp_ready = 0;      # 1 = this frame's wallpaper is staged and will be blitted by #87

fn ae_gpu_wp_on(): i64 { return ae_gpu_wp_ready; }

# PURE: does a `fw` x `fh` XRGB wallpaper fit one `#86` slot of `slot_max` bytes? -> 1 / 0.
# ⭐ Split out for the same reason `_bhumi_fbinfo_rc` and `ae_gpu_op_supported` are: this is the whole
# decision, it is arithmetic, and it is the only part of the `#87` wallpaper path a machine without an
# AMD GPU can execute at all. QEMU exposes no AMD PCI device, so `gpu_find` never matches and every
# branch below this is dead there — a burn is the only thing that runs them.
# ⚠ `slot_max <= 0` is "the kernel told us nothing", which must NOT read as "fits".
fn ae_gpu_wp_fits(fw, fh, slot_max): i64 {
    if (fw <= 0) { return 0; }
    if (fh <= 0) { return 0; }
    if (slot_max <= 0) { return 0; }
    if ((fw * fh * 4) > slot_max) { return 0; }
    return 1;
}

# Stage the wallpaper into its `#86` slot at the current geometry. -> 1 ready, 0 not.
fn ae_gpu_wp_ensure(fw, fh): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (ae_gpu_wp_fail == 1) { return 0; }
    if (wp_kind() != 2) { return 0; }            # AE_WP_IMAGE only — solid is #88, gradient is neither
    var need = fw * fh * 4;
    # ⚠ Ask the kernel's number, do not hardcode 2 MB: `shm_slot_max` is caps +24 and a later kernel
    # raising the cap should light this up with no edit here.
    if (ae_gpu_wp_fits(fw, fh, ae_gpu_shm_slot_max) == 0) {
        ae_gpu_wp_fail = 1;
        println("aethersafha: wallpaper too large for one #86 slot (bytes needed, then slot max):");
        println_int(need);
        println_int(ae_gpu_shm_slot_max);
        return 0;
    }
    if (ae_gpu_wp_slot == 0) {
        var sl = sys_shm_create_gpu(need);
        if (sl < 1) {
            ae_gpu_wp_fail = 1;
            println("aethersafha: no graphics-visible slot for the wallpaper -- CPU path");
            return 0;
        }
        ae_gpu_wp_slot = sl;
        ae_gpu_wp_buf = alloc(need);
        if (ae_gpu_wp_buf == 0) { ae_gpu_wp_fail = 1; return 0; }
    }
    # ⭐ RE-UPLOAD ONLY WHEN IT CHANGED. The scale is a full-screen per-pixel loop and the `#86` write
    # copies the whole buffer — doing that every frame would cost far more than the CPU blit this
    # replaces. Serial covers a new wallpaper; the geometry pair covers a mode change.
    if (ae_gpu_wp_ser == wp_serial()) {
        if (ae_gpu_wp_w == fw) { if (ae_gpu_wp_h == fh) { return 1; } }
    }
    var y = 0;
    while (y < fh) {
        var x = 0;
        while (x < fw) {
            store32(ae_gpu_wp_buf + (y * fw + x) * 4, wp_pixel(x, y, fw, fh));
            x = x + 1;
        }
        y = y + 1;
    }
    if (sys_shm_write(ae_gpu_wp_slot, ae_gpu_wp_buf, need) != 0) {
        ae_gpu_wp_fail = 1;
        println("aethersafha: #86 write refused for the wallpaper -- CPU path");
        return 0;
    }
    ae_gpu_wp_ser = wp_serial();
    ae_gpu_wp_w = fw;
    ae_gpu_wp_h = fh;
    println("aethersafha: wallpaper staged in a #86 slot for #87, bytes:");
    println_int(need);
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}   # latch: named the translucent-window demotion once (M6-C3)   # latch: named the non-solid-wallpaper demotion once (M6-C1a)

# gpu_caps#89 flag bits (kernel: syscall.cyr gpu_caps_sys).
var AE_GPU_CAP_PRESENT  = 1;    # bit0 — a GPU is bound
var AE_GPU_CAP_ARMED    = 2;    # bit1 — the double-buffer is armed (a back buffer exists to composite into)
var AE_GPU_CAP_CARVEOUT = 4;    # bit2 — a GPU carveout exists, so #86 slots can be served
# ⭐⭐ bit4 — BATCHED SUBMISSION, and it is a SEMANTIC bit, not a performance hint. One `#92` call is ONE GPU
# submission, so a failure cannot name which op died: the kernel answers `GPO_E_BATCH` and an INDETERMINATE
# PREFIX has already landed in the back buffer. ⇒ The caller owes a DIFFERENT recovery than for a per-op
# `GPO_E_DISPATCH`: re-clear with `#85` and **do not present**. A compositor that ignores this bit cannot know
# which recovery it owes — the kernel's own caps comment says so — and until now this one ignored it.
var AE_GPU_CAP_BATCHED  = 16;
# ⭐⭐ `#89` BYTE +28 — THE `#92` OP-SUPPORT MASK, bit N = op code N (kernel `syscall.cyr:4294`,
# `GPU_OP_SUPPORTED = 0x1FF1F`). Until now this compositor read bytes +0..+24 and STOPPED, then
# discovered which `#92` ops existed **by issuing one and reading the error** — the exact shape `#86`
# already proved wrong, and the reason the kernel publishes a bitmask at all is so a caller need not
# probe by trial. ⚠ Caps bit3 (SHADER) answers a DIFFERENT question: "will `#92` run at all". A kernel
# can have the dispatch envelope proven and still not implement the op you want; both gates are needed.
var AE_GPU_OPBIT_BLEND = 2;     # 1 << 0x01 — GPU_OP_BLEND_RECT, the premultiplied route (AE-6)
var AE_GPU_OPBIT_GLYPH = 8;     # 1 << 0x03 — GPU_OP_GLYPH_1BPP, chrome text on the shader cores (AE-8)
var ae_gpu_op_mask = 0;
var ae_gpu_glyph_op = 0;        # 1 = op 0x03 is advertised by the kernel

# PURE, host-testable: is op `op` advertised in `mask`? Split out for the same reason
# `_bhumi_fbinfo_rc` is — a caps-decoding mistake should never need hardware to find.
fn ae_gpu_op_supported(mask, op): i64 {
    if ((mask & (1 << op)) != 0) { return 1; }
    return 0;
}

var AE_GPU_CAP_SHADER   = 8;    # bit3 — SHADER COMPOSITING available, i.e. gpu_shader_op#92 will actually
# run. Mirrors the kernel's own gate: #92 refuses with E_UNPROVEN unless
# the dispatch envelope was proven on THIS boot.

# blit#39 a4 bit 40 — composite into the back buffer WITHOUT flipping. The explicit half of the
# blit/present split: a compositor accumulates a frame, then calls #84 once.
var AE_BLIT_DEFER = 0x10000000000;

# ae_gpu_probe — ask the kernel once whether hardware compositing is really available.
#
# ⚠ Requires ALL THREE of present + armed + carveout, not just "a GPU is here". A GPU with no armed back
# buffer has nothing to composite into, and one with no carveout cannot serve the `#86` slots the clients'
# surfaces live in — either way `#87` would fail per-window and we would produce a frame with chrome and no
# content. Cheaper to answer honestly once.
# ⭐ THE WHOLE `#89` RECORD IS READ NOW, NOT JUST `flags`. Bytes +4..+31 carry the real back-buffer geometry
# and the `#86` slot budget, and both answer questions this compositor was previously guessing at:
#   +4  bb_pitch (BYTES)   +8  bb_w (px)   +12 bb_h (px)
#   +16 shm_max slots      +20 shm_free    +24 shm_slot_max bytes
# ⛔ `bb_w` IS NOT A LAYOUT WIDTH. It is `pitch / 4`, and on archaemenid the pitch in pixels (832) EXCEEDS the
# visible width (800) — laying out to it would push chrome into the invisible gutter, which is a mistake this
# repo already made once with `#38 fbinfo`. It is the right bound for asking "will `#87`/`#88` ACCEPT this
# rect", because those bounds-check against the BACK BUFFER and REJECT rather than clip. Two different
# questions, two different numbers.
var ae_gpu_bb_pitch = 0;
var ae_gpu_bb_w = 0;
var ae_gpu_bb_h = 0;
var ae_gpu_shm_max = 0;
var ae_gpu_shm_free = 0;
var ae_gpu_shm_slot_max = 0;
var ae_gpu_batched = 0;         # 1 = one #92 call is one submission ⇒ GPO_E_BATCH recovery applies

fn ae_gpu_bb_w_get(): i64 { return ae_gpu_bb_w; }
fn ae_gpu_bb_h_get(): i64 { return ae_gpu_bb_h; }
fn ae_gpu_batched_get(): i64 { return ae_gpu_batched; }

fn ae_gpu_probe(): i64 {
    if (ae_gpu_probed == 1) { return ae_gpu_mode; }
    ae_gpu_probed = 1;
    ae_gpu_mode = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    var caps[32];                       # function-local => 32 BYTES, the #89 record size
    # ⛔⛔ EVERY REFUSAL BELOW USED TO RETURN IN SILENCE, and that cost a diagnosis. On a SECOND launch in
    # one boot (close the clients, Esc out, run it again) the probe fails and the compositor falls to the
    # CPU for every frame — and because `AE-9` deleted the `#39` blit, a CPU frame draws into a buffer
    # nothing copies to screen. The operator sees the console text and no desktop, and the log contains
    # NOTHING about why: the four returns here print not one word between them, so the failure presents as
    # an ABSENCE of the GPU lines rather than a reason. [[feedback_instrument_discipline]] rule 9 — a
    # readout that suppresses a value makes ABSENT and THAT VALUE indistinguishable.
    if (sys_gpu_caps(&caps, 32) != 0) {
        println("aethersafha: #89 gpu_caps REFUSED -- no hardware compositing this run");
        return 0;
    }
    var flags = load32(&caps + 0) & 0xFFFFFFFF;
    ae_gpu_bb_pitch     = load32(&caps + 4) & 0xFFFFFFFF;
    ae_gpu_bb_w         = load32(&caps + 8) & 0xFFFFFFFF;
    ae_gpu_bb_h         = load32(&caps + 12) & 0xFFFFFFFF;
    ae_gpu_shm_max      = load32(&caps + 16) & 0xFFFFFFFF;
    ae_gpu_shm_free     = load32(&caps + 20) & 0xFFFFFFFF;
    ae_gpu_shm_slot_max = load32(&caps + 24) & 0xFFFFFFFF;
    ae_gpu_op_mask      = load32(&caps + 28) & 0xFFFFFFFF;
    if ((flags & AE_GPU_CAP_BATCHED) != 0) { ae_gpu_batched = 1; }
    # ⚠ NAME THE MISSING BIT, and print the whole flags word — which bit is absent is the difference
    # between "this box has no GPU" and "the previous compositor left the band disarmed".
    if ((flags & AE_GPU_CAP_PRESENT) == 0) {
        println("aethersafha: gpu caps lack PRESENT -- no hardware compositing this run, flags:");
        println_int(flags);
        return 0;
    }
    if ((flags & AE_GPU_CAP_ARMED) == 0) {
        println("aethersafha: gpu caps lack ARMED -- the band is not armed for this process, flags:");
        println_int(flags);
        return 0;
    }
    if ((flags & AE_GPU_CAP_CARVEOUT) == 0) {
        println("aethersafha: gpu caps lack CARVEOUT -- no back buffer to composite into, flags:");
        println_int(flags);
        return 0;
    }
    ae_gpu_mode = 1;
    # bit3 is a SEPARATE capability from bit0-2: a GPU can serve opaque #87 blits while the shader
    # compositing envelope is unproven. Opaque windows still go hardware; only the premultiplied ones
    # need this.
    # ⛔ BOTH GATES, NOT EITHER. caps bit3 says `#92` dispatch is proven on this boot; the op mask says
    # THIS OP exists. A kernel with the envelope proven and op 0x01 absent would previously have been
    # discovered by a failed blend mid-frame, per window, forever.
    if ((flags & AE_GPU_CAP_SHADER) != 0) {
        if (ae_gpu_op_supported(ae_gpu_op_mask, 1) == 1) { ae_gpu_blend = 1; }
        if (ae_gpu_op_supported(ae_gpu_op_mask, 3) == 1) { ae_gpu_glyph_op = 1; }
    }
    # ⚠ Say what was advertised. A blank desktop with no explanation is the failure mode this band has
    # produced most often, and "which ops did the kernel offer" is unanswerable after the fact.
    println("aethersafha: #92 op-support mask, then blend/glyph usable:");
    println_int(ae_gpu_op_mask);
    println_int(ae_gpu_blend);
    println_int(ae_gpu_glyph_op);
    # ⚠ STATE THE BUDGET RATHER THAN DISCOVERING IT BY FAILING. The glyph path needs one `#86` slot and each
    # client surface needs one; there are only `shm_max` in the whole system and `shm_create` rounds every
    # request up to a 2 MB page. Printing the free count at probe time means a later "no slot for glyphs"
    # has a cause in the same log instead of being a mystery.
    println("aethersafha: gpu back buffer and slot budget");
    println_int(ae_gpu_bb_w);
    println_int(ae_gpu_bb_h);
    println_int(ae_gpu_shm_free);
    if (ae_gpu_batched == 1) { println("aethersafha: #92 is BATCHED -- a failure means an indeterminate prefix landed"); }
    #endif
    return ae_gpu_mode;
}

# ae_gpu_active — has the probe run AND said yes? render.cyr asks this to decide whether to skip its
# per-pixel client composite. Never probes: the frame loop probes once at startup, and a render path must
# not be the thing that triggers a syscall.
fn ae_gpu_active(): i64 {
    return ae_gpu_mode;
}

# ============================================================================================
# ⛔ THE `#85 gpu_fill` CLEAR ARM WAS REMOVED HERE. DO NOT RE-ADD IT WITHOUT DELETING THE
#    `#39` CHROME BLIT IN THE SAME CHANGE. It was wrong by CONSTRUCTION, not by tuning.
# ============================================================================================
# 0.9.8 shipped `ae_gpu_clear` / `ae_gpu_clear_band`, which issued `#85` against the armed back
# buffer. Two facts make that unconditionally pointless in this frame shape:
#
#   1. `#85` clears `gpu_bb_a`/`gpu_bb_b` — the KERNEL's back buffer.
#   2. Step 1 of ae_gpu_present_frame below then blits the whole chrome layer into THE SAME ROWS
#      OF THE SAME BUFFER via `#39` DEFER (`gpu_blit_target`, agnos kernel/core/gpu.cyr — the
#      `#39` target and the `#85` target are selected by the same `gpu_bb_back` predicate).
#
# So every pixel `#85` wrote was overwritten, in the same frame, before anything was presented.
# The clear cost a CP-DMA fill and bought nothing.
#
# ⚠ AND IT CLEARED THE WRONG BUFFER FOR THE CPU HALF. `bhumi_fb_clear` targets the USERLAND
# framebuffer — different memory entirely. On the GPU arm the userland buffer was therefore never
# cleared at all, so chrome accumulated in it frame over frame. Wiring rung 0a up as written
# would have shipped that bug, and the symptom (smearing chrome) reads as a renderer fault.
#
# ⭐ WHEN IT COMES BACK. `#85` becomes correct AND load-bearing the moment the chrome layer moves
# wholly onto the GPU and the `#39` blit is deleted — clear the back buffer, then `#88 gpu_fill_rect`
# the window and panel rects, then `#92` op 0x03 the title text. At that point nothing overwrites
# the clear because there is no CPU layer left to copy over it. That is a separate, atomic bite:
# the `#39` blit is the BOTTOM layer of the frame, so a half-migration has GPU-drawn chrome and
# CPU-drawn chrome overwriting each other in whichever order the frame happens to run.
#
# ⚠ The runtime bisect gates (`/.ae-no-gpu-clear`, `/.ae-no-damage`) went with it. They were never
# reachable — both sat behind the dead `render_frame`, so the one debugging affordance 0.9.8
# claimed to ship did not exist at runtime. The idiom itself was sound and should return with the
# GPU chrome layer; a gate that is never stat'd is worse than no gate, because it is believed.

# ⛔ ae_frame_dmg / ae_gpu_frame_ok / ae_gpu_plan_n ARE DECLARED IN render.cyr, NOT HERE, and that
# placement is load-bearing. render.cyr is included BEFORE this file (main.cyr:16 vs :17) and a
# VARIABLE forward-reference does not resolve in cyrius — only a FUNCTION one does. Declaring them
# here compiled fine for `cyrius build src/main.cyr` and broke three tests with "undefined
# variable", because the test harness compiles render.cyr in a unit that does not reach this file.
# ⚠ The lesson is not "move the variable" — it is that a green `cyrius build` on the umbrella does
# NOT prove the modules compile independently. Run `cyrius test`.

# ae_gpu_demote — give up on hardware compositing for the rest of this run.
#
# ⭐ WHY A COMPOSITOR MUST BE ABLE TO GIVE UP. `ae_gpu_mode` was previously write-once: set by the
# startup probe and never cleared. A GPU that started refusing therefore left the compositor
# permanently believing it was being composited by hardware — and because render_window skips its
# CPU composite on that belief, the result was a desktop that showed chrome and no window content
# FOREVER, with no way back. Degrading to a working software desktop is strictly better than a
# fast empty one.
fn ae_gpu_demote(): i64 {
    # ⚠ wallpaper-staged must clear too, or a demote leaves wp_fill_band believing the GPU will paint
    # a backdrop that is no longer coming. Same defect as the frame_plan reset above, permanently.
    ae_gpu_wp_ready = 0;
    ae_gpu_mode = 0;
    ae_gpu_blend = 0;
    ae_gpu_glyph_op = 0;
    ae_gpu_frame_ok = 0;
    return 0;
}

# --- Pre-flip capture: the only way a compositor can be graded on iron ------------------------
#
# ⭐ WHY THE HOOK LIVES IN THE SHIPPING FUNCTION INSTEAD OF A TEST COPY OF IT. The obvious way to
# prove GPU compositing on hardware is a separate probe binary that mimics ae_gpu_present_frame.
# That proves the MIMIC works. This repo has already paid for that mistake twice: `render_frame`
# carried the whole 0.9.8 damage model while the live loop ran `render_desktop`, and the GPU
# decision lived in ae_gpu_present_frame while its consumer read a different flag in render_window.
# A verification path that is not the production path is a shared-premise oracle wearing a lab coat.
# So the capture is a branch INSIDE the real frame — armed by the selftest, dead weight otherwise.
#
# ⛔ IT MUST FIRE BEFORE `#84`, AND THAT IS NOT A PREFERENCE. `present` FLIPS the render target
# (agnos kernel/core/gpu.cyr toggles `gpu_bb_back` on every present), so a readback issued after the
# flip samples the buffer this frame did NOT draw into — returning the PREVIOUS frame's pixels, in
# full, with no error. On a static desktop those look almost right, which is the worst possible
# failure for an instrument: it would report a working GPU path from a frame the GPU never touched.
#
# ⚠ `#90` fails SILENTLY by design — a wrong or stale read returns plausible pixels, never an error
# code (agnos gpu.md C2g-1: a reused slot once returned a stale ghost). So a 0 return here means
# "the syscall was accepted", nothing more. The verdict has to come from comparing VALUES that the
# compositor could not have produced; see selftest.cyr.
#
# ⚠ The capture slot must NEVER be a slot a window is sourcing from. `#90` writes into it, so
# capturing into a live client surface would overwrite the very pixels under test between the blit
# and the comparison, and the test would then read its own capture back as if it were the source.
var ae_gpu_cap_slot = 0;         # 0 = disarmed. Production runs with this 0 and skips the branch.
var ae_gpu_cap_wh   = 0;         # (h << 16) | w
var ae_gpu_cap_xy   = 0;         # (sy << 16) | sx
# -99 = the hook never executed, which is a DISTINCT and important answer from "#90 returned an
# error": it means the frame never reached step 3 at all (the plan refused, a blit failed, the
# window count changed), and reporting that as a readback failure would send the next session
# hunting the GPU when the fault was upstream of it.
var ae_gpu_cap_rc   = 0 - 99;

fn ae_gpu_capture_arm(slot, sx, sy, w, h): i64 {
    ae_gpu_cap_slot = slot;
    ae_gpu_cap_wh = (h << 16) | w;
    ae_gpu_cap_xy = (sy << 16) | sx;
    ae_gpu_cap_rc = 0 - 99;
    return 0;
}

fn ae_gpu_capture_disarm(): i64 {
    ae_gpu_cap_slot = 0;
    return 0;
}

# The #90 return from the most recent armed frame, or -99 if the hook did not run.
fn ae_gpu_capture_result(): i64 { return ae_gpu_cap_rc; }

# ae_gpu_frame_plan(comp, fb) — decide, BEFORE the frame is rendered and WITHOUT issuing a single
# syscall, whether the GPU will take this whole frame. Returns 1 = GPU frame, 0 = CPU frame.
#
# ⭐ THIS EXISTS TO FIX AN ORDERING BUG, NOT TO ADD A CAPABILITY. The decision and its consumer
# used to live in different places and read different data: render_window skipped its per-pixel
# client composite whenever `ae_gpu_active()` was 1, but ae_gpu_present_frame independently
# refused the frame for per-window reasons the renderer never saw (a window past an edge, a
# premultiplied surface with no shader path). On refusal the caller presented the framebuffer it
# had — chrome, and no window content.
#
# ⛔ IT WAS REACHABLE BY ORDINARY USE, not by an edge case. main.cyr cascades each new setu client
# down and right; the third client lands past the bottom edge of an 800-tall surface, and `#87`
# REJECTS rather than clips. One more client than expected and the whole desktop went blank.
#
# ⚠ ALL-OR-NOTHING, AND THAT IS FORCED BY Z-ORDER, not chosen for simplicity. It is tempting to
# take the windows the GPU accepts and CPU-composite the rest. But the CPU-composited pixels reach
# the back buffer inside the `#39` chrome blit, which lands FIRST — so any GPU-blitted window would
# then paint over a CPU-composited window that is supposed to be ABOVE it. A mixed frame is only
# correct if the accepted set happens to be the top of the stack, which nothing enforces.
#
# ⚠ COMPUTE ONCE, READ TWICE. render_window and ae_gpu_present_frame must never re-derive this
# independently — if they ever disagree a window is composited twice or not at all. The plan
# writes `ae_gpu_frame_ok` and both read it.
# ae_gpu_window_admissible(win, fw, fh) — can `#87`/`#92` take THIS window? 1 = yes.
#
# ⭐ Factored out and deliberately FREE OF `#ifdef`, so the admissibility rule is testable on a
# host with no GPU. The rule is the expensive half to get right and the half that silently blanked
# the desktop; a rule that can only be exercised on the operator's single iron box is a rule that
# gets tested by burning a boot.
#
# ⛔ THE KERNEL REJECTS RATHER THAN CLIPS (`#87` bounds-checks against the back buffer), so a
# partly-off-screen window must never be handed over. Dragging a window past an edge is ordinary.
fn ae_gpu_window_admissible(win, fw, fh): i64 {
    if (win_bufid(win) == 0) { return 1; }   # no client buffer: nothing for the GPU to blit
    var w = win_w(win);
    var h = win_h(win);
    var dx = win_x(win);
    var dy = win_body_y(win);                # the content sits below the titlebar — one definition, in window.cyr
    if (dx < 0) { return 0; }
    if (dy < 0) { return 0; }
    if (w < 1) { return 0; }
    if (h < 1) { return 0; }
    if (dx + w > fw) { return 0; }
    if (dy + h > fh) { return 0; }
    # ⭐ A PREMULTIPLIED SURFACE IS ALWAYS ADMISSIBLE. Whether this boot can run `#92` is a per-window
    # ROUTING question, answered in ae_gpu_present_frame — not a reason to throw the WHOLE FRAME at the
    # CPU. Refusing here cost every window its hardware compositing because one client asked for a blend,
    # which is a far worse outcome than compositing that one window opaquely.
    # ⚠ The old refusal reasoned that `#87` "would paint a half-transparent window at full strength". True
    # only for a surface with real translucency; for the alpha-255 surfaces clients actually produce today
    # `#87` and `#92` are byte-identical, so the fallback is exact rather than approximate.
    return 1;
}

fn ae_gpu_frame_plan(comp, fb): i64 {
    ae_gpu_frame_ok = 0;
    ae_gpu_plan_n = 0;
    # ⛔⛔ RESET HERE, WITH THE OTHER TWO — NOT 40 LINES DOWN. `ae_gpu_wp_ready` used to be cleared
    # only at :495, BELOW the translucency `return 0`. So a frame that demoted for a translucent
    # window kept LAST frame's 1; `wp_fill_band` reads it (`wallpaper.cyr:172`) and skips painting the
    # CPU backdrop; the GPU path then never runs to blit one. ⇒ **an image-wallpaper session that
    # gains a translucent window loses its wallpaper — a black desktop.** Every early return between
    # here and :495 had the same hole, which is exactly why the reset belongs with the frame's other
    # per-frame state and not beside the code that happens to set it.
    ae_gpu_wp_ready = 0;
    # ⚠ OFF AGNOS THERE IS NO GPU FRAME, EVER — and saying so HERE is what fixes the bug. The old
    # code let the renderer believe hardware compositing was live on any build, then discovered at
    # present time that it was not. The plan is the single place that belief is formed.
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    if (ae_gpu_mode != 1) { return 0; }
    if (fb == 0) { return 0; }
    # ⛔⛔ A NON-SOLID WALLPAPER DEMOTES THE WHOLE FRAME (M6-C1a). `AE-9` routes the clear through
    # `#88 gpu_fill_rect`, which fills ONE colour — a gradient is not expressible as one op, and
    # `AE-9` is all-or-nothing by construction (the `#39` blit is gone, so there is no CPU layer left
    # to mix in). Compositing the windows on the GPU over a backdrop the GPU cannot draw would show
    # chrome on a stale or black void.
    # ⚠ LATCHED AND LOUD. Silence here is indistinguishable from a wallpaper that simply failed to
    # paint, and this arc has already paid for that shape twice. The gradient-as-N-`#88`-bands route is
    # the C1b follow-on that removes the demotion.
    # ⛔ A TRANSLUCENT WINDOW DEMOTES THE FRAME, same reason as a non-solid wallpaper (M6-C3):
    # `#88 gpu_fill_rect` writes a flat colour with no read-modify-write, and `#92` op 0x01 blends the
    # per-pixel alpha the CLIENT authored — its op record has nowhere to put a compositor-applied
    # uniform α (`op / src_id / wh / dstxy`, and the kernel REJECTS a non-zero reserved dword). So a
    # window opacity is not expressible on this band at all today; that is a kernel ask, not a
    # renderer change. See roadmap M6-C3.
    var wv = comp_windows(comp);
    var wi = 0;
    var wn = vec_len(wv);
    while (wi < wn) {
        var ww = vec_get(wv, wi);
        if (ww != 0) {
            # ⚠ THE MESSAGE BELOW IS NOW HALF FALSE AND THE DEMOTE IS STILL RIGHT. `#92` DOES have an
            # opacity field as of agnos 1.56.44 — op 0x06 BLEND_ALPHA, dword 9 — and
            # `ae_gpu_blend_rect_alpha` is written and tested. Two things still block using it, and
            # they are different in kind:
            #   1. NO KERNEL ADVERTISES IT. `blend_alpha` has never been burned, so agnos keeps bit 6
            #      in GPU_OP_NOTIMPL_MASK and `#89 +28` reports it absent. `ae_gpu_alpha_ok()` is 0
            #      everywhere today. This one clears itself on a green burn, with no edit here.
            #   2. ⛔ THE GPU FRAME CANNOT ORDER TWO OVERLAPPING WINDOWS, AND THAT IS INDEPENDENT OF
            #      OPACITY. `ae_gpu_present_frame` drains the ENTIRE chrome layer in step 1, then blits
            #      ALL client surfaces in step 2 — so a LOWER window's content covers an UPPER window's
            #      titlebar BACKGROUND, while step 2c repaints the upper title GLYPHS on top (":1100 —
            #      so a title cannot be hidden under a window"). The result is floating title text over
            #      a neighbour's surface. Opacity exists to see a lower window THROUGH an upper one; a
            #      path that cannot stack two OPAQUE windows correctly must not be the one it lands on.
            # ⇒ Narrowing this to `if (win_translucent(ww) == 1) { if (ae_gpu_alpha_ok() == 0) { ... } }`
            # is a two-line change, and it must NOT be made until (2) is fixed — otherwise the first
            # burned kernel turns a slow-but-correct frame into a fast wrong one.
            if (win_translucent(ww) == 1) {
                if (ae_gpu_op_demote == 0) {
                    ae_gpu_op_demote = 1;
                    println("aethersafha: GPU frame DEMOTED — a translucent window; op 0x06 exists but is unadvertised (unburned) and the GPU frame cannot yet z-order overlapping windows");
                }
                return 0;
            }
        }
        wi = wi + 1;
    }
    # ⭐ An IMAGE wallpaper is expressible via `#87` when it fits a slot — try to stage it, and only
    # fall through to the demotion when it cannot be. `ae_gpu_wp_ready` is read by `wp_fill_band` so
    # the CPU never paints a backdrop the GPU is about to blit over.
    ae_gpu_wp_ready = 0;
    if (wp_kind() == 2) {
        # ⚠ Read the geometry here rather than using `fw`/`fh` — this gate runs BEFORE they are
        # declared below, and hoisting them would reorder the cheap early-outs above it.
        if (ae_gpu_wp_ensure(bhumi_fb_width(fb), bhumi_fb_height(fb)) == 1) { ae_gpu_wp_ready = 1; }
    }
    if (ae_gpu_wp_ready == 0) {
    if (wp_gpu_expressible() == 0) {
        if (ae_gpu_wp_demote == 0) {
            ae_gpu_wp_demote = 1;
            println("aethersafha: GPU frame DEMOTED — this wallpaper is not one #88 fill; CPU path for the run");
        }
        return 0;
    }
    }
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (fw < 1) { return 0; }
    if (fh < 1) { return 0; }
    # ⛔⛔ A RETIRED CURSOR TAKES THE WHOLE FRAME OFF THE GPU, and it has to — ORDERING, not visibility.
    # The `#39` chrome blit is the BOTTOM layer: client surfaces composite ON TOP of it (step 2 of
    # `ae_gpu_present_frame`, above the text and cursor emits). So a CPU-drawn cursor lives in the blit
    # layer and every hosted window paints over it — the pointer would vanish the moment it crossed puka
    # or crab, which is most of the screen. Making `ae_chrome_on_gpu()` follow the cursor latch restores
    # the blit but cannot reorder it.
    # ⇒ If the cursor cannot go on the shader cores, nothing does: a CPU frame composites clients
    # per-pixel and `render_desktop` draws the cursor LAST, which is the only arrangement that puts it on
    # top. Same trade the text path already takes, one layer further — a slower desktop beats a pointer
    # you lose over every window.
    if (ae_cursor_gpu_ok != 1) { return 0; }
    var v = comp_windows(comp);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        # ⚠ A MINIMIZED WINDOW IS NOT COMPOSITED, so its geometry must not veto the frame. Judging one
        # would let an off-screen or oversized minimized window take the WHOLE desktop off the GPU for a
        # surface that is never drawn.
        if (win_state(vec_get(v, i)) != WinState.WS_MINIMIZED) {
            if (ae_gpu_window_admissible(vec_get(v, i), fw, fh) == 0) { return 0; }
        }
        i = i + 1;
    }
    ae_gpu_frame_ok = 1;
    ae_gpu_plan_n = n;
    return 1;
}

# ae_gpu_blend_rect — gpu_shader_op #92 op 0x01 (BLEND_RECT): PREMULTIPLIED src-over on the shader cores.
# Returns 0 on success, non-zero on refusal.
#
# This is the one operation CP-DMA structurally cannot do. `#87` is a byte mover with no ALU, so it can only
# COPY a surface; `#92` runs a real per-pixel blend — `out = src + dst * (1 - a/255)` — on the compute units.
# Translucent window content is exactly the case that needs it.
#
# ⚠ THE SOURCE MUST BE PREMULTIPLIED (c <= a). Straight alpha does not error anywhere in the stack — it just
# renders washed out, silently. Only surfaces that set SETU_SURF_PREMULTIPLIED reach here; sadish's
# sd_premul() is the sanctioned producer.
#
# ⚠ THERE IS NO CYRIUS WRAPPER FOR #92. The band's wrappers stop at `sys_gpu_caps` (#89) — 6.4.71 has no
# `sys_gpu_shader_op`, and cyrius is hands-off here. A raw `syscall(92, ...)` behind the existing
# CYRIUS_TARGET_AGNOS gate is the sanctioned in-house idiom; agnos's own /bin/gpublend does exactly this.
# ⚠ LINUX COLLISION: #92 is `chown(path, uid, gid)` there, and arg1 is a real user VA the kernel would read
# as a path — a METADATA WRITE if it ever resolved. The `#ifdef` around this file's call sites is the only
# barrier, which is why the raw syscall lives here and not in a shared helper.
#
# The descriptor is ONE 64-byte op record. Every dword the op does not define MUST be zero — the kernel
# REJECTS a non-zero reserved field rather than ignoring it, which is what keeps today's unused dwords safe
# to define in a later kernel without an ABI break.
fn ae_gpu_blend_rect(bid, wh, dstxy): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var d[64];                                  # function-local => 64 BYTES = exactly one op record
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d + 0, 1);                         # op = GPU_OP_BLEND_RECT (0x01)
    store32(&d + 8, bid);                       # src_id — the GPU-visible shm slot (#86)
    store32(&d + 16, wh);                       # (h << 16) | w
    store32(&d + 20, dstxy);                    # (dy << 16) | dx
    return syscall(92, &d, 64);                 # 0 = ok; -((idx<<8)|reason) names the failing op
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
}

# ⭐ M6-C3 — the same composite with a UNIFORM per-surface alpha, `#92` op 0x06 GPU_OP_BLEND_ALPHA.
# The record is BLEND_RECT's field-for-field plus dword 9, so a reader who knows one reads the other.
#
# ⛔⛔ INERT TODAY, AND DELIBERATELY SO. agnos ships op 0x06 behind `GPU_OP_NOTIMPL_MASK` bit 6 because
# `blend_alpha` HAS NEVER BEEN BURNED, so `#89 gpu_caps` byte +28 does not advertise it and
# `ae_gpu_alpha_ok()` below is 0 on every kernel in existence. Nothing calls this yet. It lands now so
# that clearing one kernel constant after a successful burn is the whole of the consumer change.
#
# ⚠ ALPHA IS A 0..255 SCALAR IN DWORD 9, which is `color0` — a full 32-bit ARGB — for ops 0x02/0x03/
# 0x04. The kernel refuses anything above 255 with GPO_E_ARANGE, op-guarded so it cannot touch those
# other ops. The shader reads the value with `v_cvt_f32_ubyte0` (BYTE 0), so an unrefused 0x100 would
# render FULLY TRANSPARENT rather than opaque. Masking here as well costs nothing and means a caller
# that bypasses validation still cannot produce that picture.
fn ae_gpu_blend_rect_alpha(bid, wh, dstxy, alpha): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var d[64];                                  # function-local => 64 BYTES = exactly one op record
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d + 0, 6);                         # op = GPU_OP_BLEND_ALPHA (0x06)
    store32(&d + 8, bid);                       # src_id — same dword as BLEND_RECT
    store32(&d + 16, wh);                       # (h << 16) | w
    store32(&d + 20, dstxy);                    # (dy << 16) | dx
    store32(&d + 36, alpha & 0xFF);             # dword 9 — alpha, 0..255
    return syscall(92, &d, 64);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
}

# ⭐ Is the uniform-alpha composite available on THIS kernel? Pure; the whole capability test.
# ⚠ A new op advertises itself for free — this reads the same `#89 +28` mask every other op gate uses,
# so no probe-by-calling is involved. It answers 0 on every kernel today (NOTIMPL bit 6) and will
# answer 1 the moment a burned kernel clears it, with no change here.
fn ae_gpu_alpha_ok(): i64 {
    if (ae_gpu_blend == 0) { return 0; }        # no shader envelope at all
    return ae_gpu_op_supported(ae_gpu_op_mask, 6);
}

# ============================================================================================
# ⭐⭐ `AE-9` — THE CHROME FILLS ON THE GPU, AND THE `#39` BLIT GOES AWAY.
# ============================================================================================
# `#88 gpu_fill_rect(color, wh, dstxy)` fills a rect in the back buffer with CP-DMA. With the clear, the
# chrome rects, the glyphs and the client surfaces all issued to the GPU, **nothing remains in the userland
# framebuffer for `#39` to copy** — so the blit is skipped rather than emitted, which is what this rung was
# for. That is the order `gpu.cyr`'s own `#85`-removal note wrote down in advance: clear the back buffer,
# fill the window and panel rects, glyph the title text, and nothing overwrites the clear because there is
# no CPU layer left to copy over it.
#
# ⭐ THE CLEAR IS THE BIG ONE. `AE-0a` measured it at 3.83 ms of a 6.40 ms frame and cut it to 2.46 ms by
# shrinking it to a damage band. Here it stops being a CPU store loop at all — the band is simply the first
# rect in the queue, filled by the same engine as the chrome.
#
# ⚠ `sys_gpu_fill_rect` is the existing stdlib wrapper, so this needs no raw syscall and no cyrius change.
# (`sys_gpu_fill` exists but drops the kernel's y0/h band arguments, so a full-width rect is both simpler
# and more precise than reaching for the raw form.)
var ae_gpu_chrome_seen = 0;

# Drain the frame's chrome rects. -> count filled, or -1 if a fill was refused and the path is now retired.
# ⭐ RANGE FORM. `ae_gpu_present_frame` replays this queue per WINDOW so overlapping windows stack
# correctly; the whole-queue wrapper below keeps every other caller unchanged.
fn ae_gpu_emit_chrome_range(ae_rect_lo, ae_rect_hi): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ ANNOUNCE THE PATH, NOT THE EMISSION, AND SAY IT BEFORE THE EARLY RETURN.
    # This logged only after a rect was successfully filled, so "no line" had TWO causes: the chrome never
    # went to the GPU, or it did and the queue happened to be empty (an idle frame whose damage band is
    # zero-height enqueues nothing, which is correct). One of those is a finding and the other is normal,
    # and a reader cannot tell them apart from an absence. Stating it at the point the DECISION is live
    # makes the line mean exactly "chrome is on the GPU this run".
    if (ae_gpu_chrome_seen == 0) {
        ae_gpu_chrome_seen = 1;
        println("aethersafha: chrome fills are on the GPU (#88 gpu_fill_rect) -- the #39 blit is gone");
    }
    var n = ae_rect_hi;
    if (n <= ae_rect_lo) { return 0; }
    var i = ae_rect_lo;
    while (i < n) {
        var wh = (ae_rect_get_h(i) << 16) | ae_rect_get_w(i);
        var dstxy = (ae_rect_get_y(i) << 16) | ae_rect_get_x(i);
        if (sys_gpu_fill_rect(ae_rect_get_col(i), wh, dstxy) != 0) {
            # ⛔ ONE REFUSAL RETIRES THE PATH, AND THIS FRAME MUST STILL BLIT. The rects were queued instead
            # of drawn, so the userland framebuffer holds no chrome — a frame that neither fills nor blits
            # shows nothing at all. The caller reads -1 and falls back to `#39` for this frame; every later
            # frame draws chrome on the CPU again, which is why this is a latch and not a per-frame retry.
            ae_chrome_gpu_disable();
            println("aethersafha: #88 gpu_fill_rect refused -- chrome returns to the CPU + #39");
            return 0 - 1;
        }
        i = i + 1;
    }
    return n - ae_rect_lo;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

fn ae_gpu_emit_chrome(): i64 { return ae_gpu_emit_chrome_range(0, ae_rect_count()); }

# ============================================================================================
# ⭐⭐ `AE-8` — GLYPHS ON THE SHADER CORES. `#92` op 0x03 GLYPH_1BPP.
# ============================================================================================
# The last chrome layer still drawn a pixel at a time. `draw_char` calls `bhumi_fb_set` per lit pixel —
# a function call, four bounds compares and seven header `load64`s to store four bytes — and `AE-T` made
# glyphs the desktop's hot content by putting a terminal on it.
#
# ⭐ THE FORMAT ALREADY MATCHES, WHICH IS WHY THIS IS SMALL. `#92` op 0x03 takes a 1bpp mask and paints
# `color` where a bit is set, leaving the destination untouched elsewhere — text, exactly. kashi's VGA 8x16
# font is one byte per row with `bit (7 - col)` leftmost, and the kernel's shader reads **MSB-first** (its
# source names LSB-first as the mistake it was written to avoid). So `ae_text_pack_1bpp` copies bits at an
# x-offset rather than converting a format.
#
# ⛔ ONE SLOT, ALLOCATED ONCE, REUSED EVERY FRAME. `#86 shm_create_gpu` slots are scarce (16 in the whole
# system, and `shm_create` rounds every request up to a 2 MB page), so allocating per run — or per frame —
# would exhaust the table in seconds. The slot is sized for the widest run the queue allows.
var ae_gpu_glyph_slot = 0;      # GPU-visible 1bpp staging slot (0 = not yet allocated)
var ae_gpu_glyph_buf = 0;       # userland packing buffer, allocated with it
var ae_gpu_text_seen = 0;       # first-occurrence log latch
var ae_gpu_text_fail = 0;       # 1 = the slot could not be had; stop retrying every frame

# Issue one GLYPH_1BPP record. Returns 0 on success.
#
# ⚠ FIELD LAYOUT IS `gpo_field_mask(0x03) = 0x023B` — dwords 0,1,3,4,5,9: op(+0) flags(+4) mask_id(+12)
# wh(+16) dstxy(+20) color0(+36). ⛔ EVERY OTHER DWORD MUST BE ZERO — the kernel REJECTS a non-zero
# reserved field rather than ignoring it, which is what keeps today's unused dwords safe to define later.
fn ae_gpu_glyph_rect(mask_id, wh, dstxy, color): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var d[64];                                  # function-local => 64 BYTES = exactly one op record
    var z = 0;
    while (z < 16) { store32(&d + z * 4, 0); z = z + 1; }
    store32(&d + 0, 3);                         # op = GPU_OP_GLYPH_1BPP (0x03)
    store32(&d + 12, mask_id);                  # mask_id — the GPU-visible 1bpp slot (#86)
    store32(&d + 16, wh);                       # (h << 16) | w
    store32(&d + 20, dstxy);                    # (dy << 16) | dx
    store32(&d + 36, color);                    # color0 — painted where a mask bit is set
    return syscall(92, &d, 64);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
}

# ⛔⛔ THE RECOVERY THE `BATCHED` BIT OBLIGES, AND THIS COMPOSITOR WAS NOT DOING IT.
#
# `GPO_E_BATCH` (15) means one `#92` call was one submission and an **INDETERMINATE PREFIX** of its ops has
# already landed in the back buffer. The kernel's contract for that case is explicit: ring 3 recovers by
# **re-clearing with `#85` and NOT calling `#84`**. Anything else presents a half-composited frame — and
# because the prefix is indeterminate there is no way to repair it op by op.
#
# A per-op `GPO_E_DISPATCH` is the other case, and it is NOT the same: there the failing index is named,
# ops `[0, idx)` composited cleanly, and demoting the frame to the CPU path is a sufficient answer.
#
# ⚠ The error encoding is `-((idx << 8) | reason)`, so the reason is the low byte of the negated return —
# `idx` is meaningless for a batch error and must not be read as one.
fn ae_gpu_err_reason(rc): i64 {
    if (rc >= 0) { return 0; }
    return (0 - rc) & 0xFF;
}

# 1 when a `#92` return demands the batch recovery (re-clear, do not present) rather than a plain demote.
fn ae_gpu_err_is_batch(rc): i64 {
    if (ae_gpu_err_reason(rc) == 15) { return 1; }        # GPO_E_BATCH
    return 0;
}

# Re-clear the back buffer after an indeterminate batch failure. Returns 0 on success.
# ⚠ `#85 gpu_fill` whole-buffer is exactly right here: the prefix could have touched anywhere, so a damage
# band is not a sound bound for the repair. This is the one place the full-screen clear is still correct.
fn ae_gpu_batch_recover(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    println("aethersafha: #92 batch failed -- indeterminate prefix landed, re-clearing and NOT presenting");
    return sys_gpu_fill(0);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

# Drain the frame's text runs onto the GPU. Returns the number emitted.
#
# ⛔ MUST RUN AFTER THE `#39` CHROME BLIT AND BEFORE `#84 present`. The blit copies the whole userland
# framebuffer over the back buffer, so a glyph issued before it is erased; the flip ends the frame, so one
# issued after it lands on the buffer nobody is showing.
#
# ⚠ A FAILURE HERE IS NOT WORTH DEMOTING THE FRAME. The chrome, the window bodies and the client surfaces
# are already correct in the back buffer at this point — losing the frame over a titlebar caption would
# trade a whole desktop for a string. On refusal the text is simply absent for that frame and the run is
# counted, which is visible without being fatal.
# Make sure the 1bpp staging slot exists. Returns 1 if usable, 0 if it could not be had.
#
# ⛔⛔ THIS IS SHARED, AND FACTORING IT OUT IS A BUG FIX, NOT TIDYING. It used to live inside
# `ae_gpu_emit_text`, BELOW that function's `if (n == 0) { return 0; }` early exit — so a frame with no
# text to draw never created the slot. The cursor emit then saw `ae_gpu_glyph_slot == 0` and permanently
# retired the pointer, on a desktop whose only fault was having nothing to caption. ⇒ The cursor needs the
# slot on its OWN terms; it must not depend on some other layer having run first.
# ⚠ Sized for the widest glyph run so the slot never has to grow; the cursor's mask is far smaller and is
# checked against this capacity at its call site.
fn ae_gpu_glyph_ensure_slot(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (ae_gpu_text_fail == 1) { return 0; }
    # ⚠ The kernel does not advertise op 0x03 — do not issue it. Chrome text falls back to the CPU
    # glyph path, which `AE-8` kept precisely so a glyph refusal never costs the frame.
    if (ae_gpu_glyph_op == 0) { return 0; }
    if (ae_gpu_glyph_slot != 0) { return 1; }
    var cap = ae_text_bytes(AE_TEXT_CHARS);
    var sl = sys_shm_create_gpu(cap);
    if (sl < 1) {
        ae_gpu_text_fail = 1;
        println("aethersafha: no graphics-visible slot for glyphs -- titles stay on the CPU");
        return 0;
    }
    ae_gpu_glyph_slot = sl;
    ae_gpu_glyph_buf = alloc(cap);
    if (ae_gpu_glyph_buf == 0) { ae_gpu_text_fail = 1; return 0; }
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

# ⭐ RANGE FORM, same reason as the chrome emitter: a window's title must land on ITS OWN surface,
# after it and before the next window's chrome.
fn ae_gpu_emit_text_range(ae_text_lo, ae_text_hi): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⚠ Guard on the RANGE, not the whole queue — an empty slice (a window with no title, or a
    # minimized one) must be a cheap no-op, not a walk that emits nothing but still arms the slot.
    if (ae_text_hi <= ae_text_lo) { return 0; }
    if (ae_gpu_text_fail == 1) { return 0; }
    # ⚠ The kernel does not advertise op 0x03 — do not issue it. Chrome text falls back to the CPU
    # glyph path, which `AE-8` kept precisely so a glyph refusal never costs the frame.
    if (ae_gpu_glyph_op == 0) { return 0; }
    if (ae_gpu_glyph_ensure_slot() == 0) { return 0; }
    var emitted = 0;
    var i = ae_text_lo;
    while (i < ae_text_hi) {
        var len = ae_text_run_len(i);
        var w = ae_text_pack_1bpp(ae_gpu_glyph_buf, ae_text_run_ptr(i), len);
        if (sys_shm_write(ae_gpu_glyph_slot, ae_gpu_glyph_buf, ae_text_bytes(len)) == 0) {
            var wh = (FONT_H << 16) | w;
            var dstxy = (ae_text_run_y(i) << 16) | ae_text_run_x(i);
            var grc = ae_gpu_glyph_rect(ae_gpu_glyph_slot, wh, dstxy, ae_text_run_col(i));
            if (grc == 0) {
                emitted = emitted + 1;
            }
            else {
                # ⛔ ONE REFUSAL RETIRES THE PATH FOR THE REST OF THE RUN. The run was enqueued instead of
                # drawn, so this frame's caption is already lost — but `draw_text` consults this flag, so
                # every LATER frame goes back to the per-pixel path and the desktop keeps its titles.
                # Silently retrying a refusing op every frame would mean permanently missing text with no
                # line in the log to explain it.
                ae_text_gpu_disable();
                println("aethersafha: #92 op 0x03 refused a glyph run -- chrome text returns to the CPU");
                # ⛔⛔ AND IF THE KERNEL BATCHES, THIS FRAME MUST NOT BE PRESENTED. An indeterminate prefix
                # of the submission is already in the back buffer; presenting it shows a half-composited
                # frame. -2 tells the caller to re-clear and skip the flip. Reading only "nonzero = bad"
                # here is what made this compositor owe a recovery it never performed.
                if (ae_gpu_err_is_batch(grc) == 1) { return 0 - 2; }
                return emitted;
            }
        }
        i = i + 1;
    }
    if (emitted > 0) {
        if (ae_gpu_text_seen == 0) {
            ae_gpu_text_seen = 1;
            println("aethersafha: chrome text is on the shader cores (#92 op 0x03 GLYPH_1BPP)");
        }
    }
    return emitted;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

fn ae_gpu_emit_text(): i64 { return ae_gpu_emit_text_range(0, ae_text_count()); }

var ae_gpu_cursor_seen = 0;     # first-occurrence log latch
# Visible-rect scratch for the cursor emit. MODULE scope => 4 x u64 = 32 bytes, reused every frame.
var ae_cur_vr[4];

# ⭐⭐ THE POINTER, AS TWO 1bpp MASKS THROUGH THE SAME op 0x03 — outline in black, then fill in white.
#
# Called AFTER `ae_gpu_emit_text`, which is what makes the cursor top-most: op order is paint order, so the
# last thing enqueued is the last thing composited. A cursor that goes under a titlebar caption is a cursor
# you lose exactly when you are trying to click the titlebar.
#
# ⭐ OUTLINE FIRST, THEN FILL. The two masks are disjoint by construction (`tests/cursor.tcyr` asserts it),
# so the order does not matter for correctness — but it does for a partial failure: if the second op is
# refused, an outline with no fill still reads as a cursor, whereas a fill with no outline is an
# unidentifiable white blob.
#
# ⛔ IT SHARES THE GLYPH SLOT, and that is safe only because it runs after the text drain has finished with
# it. `#86` slots are scarce (16 system-wide, each rounded up to 2 MB) so a second slot for 40 bytes would
# be indefensible — but this ordering dependency is real: moving this call above the text drain would have
# the cursor's mask overwritten by the first caption.
#
# ⚠ A REFUSAL HERE MUST NOT RETIRE THE TEXT PATH. `cursor_visible_rect` already guarantees the rect is
# on-surface, so a refusal is not the out-of-range case that `ae_text_fits` guards — retiring captions
# because the pointer was refused would be the 1.56.42 failure in reverse. It costs one frame of cursor.
# Returns the number of masks emitted (0..2), or -2 if the kernel batched and the frame must not present.
fn ae_gpu_emit_cursor(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (ae_cursor_q_pending() == 0) { return 0; }
    # ⛔⛔ THESE TWO USED TO `return 0` AND THAT LOST THE POINTER FOREVER. `render_cursor` gates on
    # `ae_text_gpu_ok` + `ae_cursor_gpu_ok`, NOT on these — so when the staging slot cannot be had
    # (`ae_gpu_text_fail`, or `#86`'s 16 system-wide slots exhausted by the clients) the cursor is already
    # QUEUED and not drawn, and a bare return leaves it undrawn this frame and every frame after.
    # ⇒ Retire, so the next frame draws it per-pixel. The flags must not be allowed to disagree silently.
    # ⛔ ENSURE, DO NOT RETIRE. An earlier cut retired the pointer here whenever the slot did not already
    # exist — but the slot was only ever created by the TEXT path, below its no-text early exit, so a frame
    # with nothing to caption killed the cursor for the rest of the boot. The cursor asks for the slot
    # itself now; only a slot that genuinely cannot be had is a retirement.
    if (ae_gpu_glyph_ensure_slot() == 0) {
        ae_cursor_gpu_disable();
        rend_cursor_unmark();
        println("aethersafha: no graphics-visible slot for the cursor mask -- the pointer moves to the CPU");
        return 0;
    }
    # ⛔ CONSUME THE QUEUE HERE, NOT NOWHERE. It is set by `render_cursor` once per frame and was never
    # cleared, so the flag latched at 1 for the rest of the run. That happens to be harmless in today's
    # call graph — every `ae_gpu_present_frame` is preceded by a `render_desktop` that re-queues — but it
    # means correctness rested on a call-ordering coincidence rather than on the queue's own contract. A
    # present that ever runs without a render would composite the cursor at a STALE position.
    ae_cursor_q_clear();
    # ⛔⛔ THE SLOT IS BORROWED FROM THE TEXT PATH, AND ITS CAPACITY IS NOT THIS FILE'S TO ASSUME. It is
    # sized for the widest glyph run (`ae_text_bytes(AE_TEXT_CHARS)`); a cursor mask is `cursor_max_bytes()`.
    # ⚠ 40 vs 1152 today — I asserted that in a COMMENT and checked it nowhere, which is exactly how a
    # later resize of the text slot turns into an shm overrun with no failing test.
    # [[feedback_audit_re_derive_dont_validate_comments]]
    if (cursor_max_bytes() > ae_text_bytes(AE_TEXT_CHARS)) {
        ae_cursor_gpu_disable();
        rend_cursor_unmark();
        println("aethersafha: the cursor mask does not fit the glyph staging slot -- pointer moves to the CPU");
        return 0;
    }
    var cx = ae_cursor_q_x();
    var cy = ae_cursor_q_y();
    # ⛔ A MODULE-SCOPE SCRATCH, NOT `alloc(32)` PER FRAME. agnos's allocator is a bump over 2 MB mmap
    # chunks and NEVER FREES, so a 32-byte allocation in a once-per-frame path burns a fresh chunk about
    # every 65536 frames and grows without bound for the life of the desktop. ⚠ MODULE-scope `var X[4]` is
    # 4 x u64 = 32 BYTES, which is what `cursor_visible_rect` writes; the function-local form would be 4.
    if (cursor_visible_rect(cx, cy, ae_gpu_bb_w, ae_gpu_bb_h, &ae_cur_vr) == 0) { return 0; }
    var vr = &ae_cur_vr;
    var vx = load64(vr + 0);
    var vy = load64(vr + 8);
    var vw = load64(vr + 16);
    var vh = load64(vr + 24);
    var wh = (vh << 16) | vw;
    var dstxy = (vy << 16) | vx;
    var emitted = 0;
    var layer = CursorK.CUR_OUTLINE;
    var pass = 0;
    while (pass < 2) {
        if (pass == 1) { layer = CursorK.CUR_FILL; }
        var col = ae_cursor_line_colour();
        if (pass == 1) { col = ae_cursor_fill_colour(); }
        var nb = cursor_pack(ae_gpu_glyph_buf, layer, cx, cy, vr);
        var wrc = sys_shm_write(ae_gpu_glyph_slot, ae_gpu_glyph_buf, nb);
        # ⛔ A FAILED WRITE USED TO SKIP THE PASS IN SILENCE — no log, no retirement, no change to
        # `emitted`. The slot can be refused for a recycled id or a bad range, and the pointer would then
        # be absent every frame with nothing in the log to say why. Same disease as the refused op below.
        if (wrc != 0) {
            ae_cursor_gpu_disable();
            rend_cursor_unmark();
            println("aethersafha: could not stage the cursor mask into its slot -- the pointer moves to the CPU");
            return emitted;
        }
        if (wrc == 0) {
            var rc = ae_gpu_glyph_rect(ae_gpu_glyph_slot, wh, dstxy, col);
            if (rc == 0) { emitted = emitted + 1; }
            else {
                # An indeterminate prefix is already in the back buffer — the frame cannot be presented.
                if (ae_gpu_err_is_batch(rc) == 1) { return 0 - 2; }
                # ⛔ RETIRE THE GPU CURSOR, DO NOT JUST GIVE UP ON THIS FRAME. `render_cursor` queued
                # instead of drawing, so without this the pointer is absent this frame AND every frame
                # after it — the queue re-fills and the op refuses again. Retiring sends the next frame to
                # `render_cursor_cpu`, which draws per-pixel and cannot be refused.
                ae_cursor_gpu_disable();
                # ⛔ AND UN-MARK THE POSITION. `render_cursor` already called `rend_cursor_mark_drawn` for
                # this frame, but the cursor was NOT drawn — the op refused. With the position recorded as
                # drawn, `rend_cursor_damage` sees no movement next frame and damages nothing, so a
                # STATIONARY pointer stays invisible until the user happens to move it. Clearing the mark
                # makes the next frame treat it as moved and repaint it.
                rend_cursor_unmark();
                println("aethersafha: #92 op 0x03 refused a cursor mask -- the pointer returns to the CPU");
                return emitted;
            }
        }
        pass = pass + 1;
    }
    if (emitted > 0) {
        if (ae_gpu_cursor_seen == 0) {
            ae_gpu_cursor_seen = 1;
            println("aethersafha: the pointer is a real arrow on the shader cores (two #92 op 0x03 masks)");
        }
    }
    return emitted;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}

# ae_gpu_present_frame — composite and flip one frame on the GPU.
# Returns 1 if the frame was presented on the GPU, 0 if the caller must fall back to the CPU present.
#
# ⚠ Returns 0 (not a partial frame) on ANY per-window failure, and the caller then presents the CPU way.
# A half-composited frame is worse than a slower one: the chrome is already in the back buffer at that
# point, so bailing without presenting leaves it unshown rather than showing content-less windows.
fn ae_gpu_present_frame(comp, fb): i64 {
    # ⛔ THE PLAN DECIDES, NOT THIS FUNCTION. ae_gpu_frame_plan already ran every window through
    # ae_gpu_window_admissible BEFORE the frame was rendered, and render_window composited on the
    # CPU iff the plan said no. Re-deriving the answer here would let the two disagree — the exact
    # split-brain this reorder exists to remove.
    if (ae_gpu_frame_ok != 1) { return 0; }
    if (fb == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    var px = bhumi_fb_pixels(fb);
    var fw = bhumi_fb_width(fb);
    var fh = bhumi_fb_height(fb);
    if (px == 0) { return 0; }
    if (fw < 1) { return 0; }
    if (fh < 1) { return 0; }
    # ⚠ CONSISTENCY GUARD, not a second derivation. The setu accept block runs BETWEEN the plan and
    # this call and can push a new window, which the plan never saw and render_window never drew.
    # Compositing it here would blit a surface with no chrome under it. A changed count means the
    # plan is stale: present on the CPU this frame and re-plan next.
    if (vec_len(comp_windows(comp)) != ae_gpu_plan_n) { return 0; }

    # 0. ⭐ THE WALLPAPER, FIRST — it is the bottom layer, so it goes down before the chrome rects.
    # ⚠ Ordering is the whole correctness here: `AE-9` makes the CLEAR the first `#88` rect in the
    # queue, so a wallpaper blitted after the chrome flush would be painted over by that clear.
    # `wp_fill_band` suppresses the clear enqueue whenever `ae_gpu_wp_on()` is 1, and this blit
    # replaces it.
    if (ae_gpu_wp_ready == 1) {
        if (sys_gpu_blit_shm(ae_gpu_wp_slot, (fh << 16) | fw, 0) != 0) { ae_gpu_demote(); return 0; }
    }

    # 1. Chrome layer -> back buffer, DEFERRED — ⭐⭐ NOW DAMAGE-LIMITED (`AE-0a`).
    #
    # ⛔ THE BAND IS `union(cur, prev)`, AND THAT IS FORCED BY THE FLIP, NOT A CHOICE.
    # `#84 present` FLIPS THE RENDER TARGET on every present (agnos kernel/core/gpu.cyr —
    # `if (gpu_bb_back == 0) { gpu_bb_back = 1; } else { gpu_bb_back = 0; }`), and `#39` renders into
    # whichever buffer that same predicate selects. So a band-limited blit updates buffer A this frame
    # and buffer B the next: A's rows outside this frame's band hold what was there TWO frames ago.
    # Writing `union(cur, prev)` covers everything that changed in either of the last two frames, which
    # is exactly the set A can be missing. `rend_band_compute` (render.cyr) owns that fold; the reason
    # it must not be re-derived here is the same reason the frame plan is computed once and read twice.
    # ⚠ Getting it wrong shows as a trailing ghost at a two-frame lag in the rows a window vacated —
    # which reads as "the framebuffer is stale", not "the damage model is wrong". That misreading is why
    # this sat unshipped through two cuts.
    #
    # ⛔ FULL-WIDTH ROWS ONLY, AND THE PACKING IS ASSERTED RATHER THAN ASSUMED. `#39` takes its source
    # tightly packed at w*4 bytes per row with **no stride parameter**, so the band's source pointer is
    # only valid if the userland fb has `pitch == fw * 4` and `bpp == 4`. bhumi guarantees it today
    # (`bhumi_fb_clear` walks `size` in 4s on exactly that basis) — but a future backend with a padded
    # pitch would silently blit skewed rows, so this checks and falls back to the full frame instead.
    # A skewed image is a much worse failure than a slower one.
    # ⭐⭐ `AE-9`: WHEN THE CHROME IS ON THE GPU THERE IS NOTHING TO BLIT. The rects went to `#88` instead
    # of into the userland framebuffer, so copying that framebuffer would paint a stale or blank layer over
    # them. Setting the band height to 0 skips the blit — the deletion this rung existed for.
    # ⚠ `-1` means a fill was refused mid-frame: the queue held the chrome, the framebuffer is empty, and the
    # path has just been retired — so the blit MUST still run or this frame shows nothing.
    # ⛔⛔ STEP 1 NOW EMITS ONLY THE PRELUDE — the clear / wallpaper band — NOT every window's chrome.
    # It used to drain the WHOLE rect queue here, which put every titlebar down before any client
    # surface. With two overlapping windows the lower window's surface then covered the upper window's
    # titlebar background, while step 2c repainted the upper title GLYPHS on top afterwards: floating
    # title text over a neighbour's surface. Per-window chrome now goes down inside the loop below,
    # interleaved with that window's own surface and text, so windows stack in z-order.
    # ⚠ `chrome_rc` still decides whether the `#39` band blit runs, and it must count EVERY rect this
    # frame puts on the GPU — not just the prelude — or a frame whose chrome is entirely per-window
    # would blit an empty userland framebuffer over the chrome the GPU just filled. It is accumulated
    # across the loop and tested after it.
    if (ae_chrome_on_gpu() == 1) {
        if (ae_gpu_emit_chrome_range(0, ae_rect_prelude_n()) == 0 - 1) { ae_gpu_demote(); return 0; }
    }
    var band_y = 0;
    var band_h = fh;
    if (rend_band_valid() == 1) {
        if (bhumi_fb_bpp(fb) == 4) {
            if (bhumi_fb_pitch(fb) == fw * 4) {
                band_y = rend_band_y();
                band_h = rend_band_h();
            }
        }
    }
    # ⛔⛔ THE ZEROING MUST COME AFTER THE DAMAGE BAND, AND THE FIRST VERSION OF THIS PUT IT BEFORE.
    # The band block assigns `band_h` unconditionally, so zeroing above it was silently overwritten — the
    # blit would then have run and copied an EMPTY userland framebuffer straight over the chrome the GPU had
    # just filled. Order is the whole correctness of this block, not a style choice.
    # ⛔⛔ THE BLIT MUST STAY *BEFORE* THE CLIENT SURFACES, and my first attempt at this reorder moved it
    # after them. When chrome is on the CPU the band carries that chrome, so blitting it after the
    # surfaces paints titlebars OVER the windows — the mirror image of the z-order bug being fixed here.
    # ⚠ The decision therefore cannot wait for `chrome_rc` to finish accumulating. It does not need to:
    # "is the chrome on the GPU this frame" is knowable NOW, from the path flag and whether anything was
    # queued at all. A rect refusal later in the frame is handled by demoting and letting the caller do a
    # full CPU present — strictly safer than the old latch-and-blit, which repainted from a framebuffer
    # that was already partly stale.
    if (ae_chrome_on_gpu() == 1) { if (ae_rect_count() > 0) { band_h = 0; } }
    # ⚠ A ZERO-HEIGHT BAND IS A RESULT, NOT AN ERROR: nothing changed in two frames, so the buffer about
    # to be flipped to already holds the right pixels and there is nothing to copy. Skip the blit and
    # still present — the flip is what puts the finished frame on screen.
    if (band_h > 0) {
        var bsrc = px + band_y * fw * 4;
        # a4 carries BOTH the destination origin — (dst_y<<16)|dst_x, per `#39`'s ABI — and the
        # DEFER_PRESENT flag at bit 40, so the accumulate-then-flip-once shape is unchanged.
        var bxy = (band_y << 16) | 0;
        if (sys_blit(bsrc, fw, band_h, bxy | AE_BLIT_DEFER) != 0) { ae_gpu_demote(); return 0; }
    }

    # 2. Each client surface -> back buffer, in the SAME bottom-to-top order render_frame paints, so
    #    overlapping windows stack identically to the CPU path.
    var v = comp_windows(comp);
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var win = vec_get(v, i);
        var bid = win_bufid(win);
        # ⭐⭐ THIS WINDOW'S CHROME, IMMEDIATELY BEFORE ITS OWN SURFACE — the whole z-order fix.
        # `render_desktop` enqueued the rects in paint order and marked each window's end, so the slice
        # [prev_mark, this_mark) is exactly this window's chrome and nobody else's.
        # ⚠ A minimized window's slice is EMPTY and the range emitter no-ops on it, which is why the
        # marks are recorded for every window rather than only the drawn ones.
        if (ae_chrome_on_gpu() == 1) {
            if (i < ae_mark_count()) {
                # ⚠ A refusal here retires the chrome path mid-frame. The band blit has already been
                # decided and possibly skipped, so this frame cannot be rescued by blitting — demote and
                # let the caller repaint the whole thing on the CPU.
                if (ae_gpu_emit_chrome_range(ae_rect_mark_at(i - 1), ae_rect_mark_at(i)) == 0 - 1) {
                    ae_gpu_demote(); return 0;
                }
            }
        }
        # ⛔⛔ A MINIMIZED WINDOW IS NOT COMPOSITED EITHER, AND MISSING THIS SHIPPED TO IRON. A window is
        # drawn in TWO places — `render_window` paints the chrome on the CPU, and this loop blits the
        # CLIENT SURFACE on the GPU. The minimize fix skipped only the first, so F6 removed the titlebar
        # and left the client's pixels on screen: operator, 2026-08-09, *"minimize fails - only appears to
        # lose the topbar"*. ⇒ Skipping a window means skipping EVERY path that draws it; one guard per
        # drawing site, and there are two.
        if (win_state(win) == WinState.WS_MINIMIZED) { bid = 0; }
        if (bid != 0) {
            # ⚠ NO BOUNDS RE-CHECK HERE. ae_gpu_window_admissible already cleared every window in
            # this frame, and render_window skipped its CPU composite on the strength of that. A
            # second, independently-written copy of the same rule is how the two drift apart.
            var w = win_w(win);
            var h = win_h(win);
            var dx = win_x(win);
            var dy = win_body_y(win);              # the content sits below the titlebar — see window.cyr
            var wh = (h << 16) | w;
            var dstxy = (dy << 16) | dx;
            # ⛔ A FAILURE HERE IS A GPU REFUSAL, NOT A GEOMETRY PROBLEM — geometry was settled by the
            # plan. So demote: the next frame runs entirely on the CPU and the desktop keeps working.
            # Without this the compositor retries a refusing GPU every frame forever while
            # render_window keeps skipping its composite, and the screen stays blank.
            # ⭐ THE ROUTING DECISION, PER WINDOW. A premultiplied surface goes to the shader
            # (`#92` op 0x01, a real `out = src + dst*(1 - src_a)`); everything else takes the opaque
            # copy (`#87`). ⚠ And a premultiplied surface on a boot with NO shader envelope falls back to
            # `#87` here rather than costing the frame — see ae_gpu_window_admissible. That fallback is
            # exact for the alpha-255 surfaces clients produce today, and it means the desktop keeps
            # hardware compositing on hardware that cannot blend instead of losing it entirely.
            var use_blend = 0;
            if (win_premul(win) == 1) { if (ae_gpu_blend == 1) { use_blend = 1; } }
            if (use_blend == 1) {
                var brc = ae_gpu_blend_rect(bid, wh, dstxy);
                if (brc != 0) {
                    # ⛔ SAME TWO RECOVERIES AS THE GLYPH PATH. A batch failure left an indeterminate prefix
                    # in the back buffer, so re-clear and refuse the flip; a per-op failure is repairable by
                    # demoting the frame to the CPU. Treating both as "demote" would present a partial frame.
                    if (ae_gpu_err_is_batch(brc) == 1) { ae_gpu_batch_recover(); ae_gpu_demote(); return 0; }
                    ae_gpu_demote();
                    return 0;
                }
                if (ae_gpu_blend_seen == 0) {
                    ae_gpu_blend_seen = 1;
                    println("aethersafha: compositing a client surface with #92 op 0x01 (shader blend)");
                }
            }
            if (use_blend == 0) {
                if (sys_gpu_blit_shm(bid, wh, dstxy) != 0) { ae_gpu_demote(); return 0; }
                if (win_premul(win) == 1) {
                    if (ae_gpu_fallback_seen == 0) {
                        ae_gpu_fallback_seen = 1;
                        println("aethersafha: premultiplied surface but no shader envelope -- using #87");
                    }
                }
            }
        }
        # ⭐ AND THIS WINDOW'S TITLE, AFTER ITS OWN SURFACE. Previously every title was emitted after
        # every surface, which is why a title could survive on top of a NEIGHBOUR's window — the code
        # that did it even said so ("so a title cannot be hidden under a window"). Correct is: after
        # its own surface, before the next window's chrome.
        if (i < ae_mark_count()) {
            if (ae_gpu_emit_text_range(ae_text_mark_at(i - 1), ae_text_mark_at(i)) == 0 - 2) {
                ae_gpu_batch_recover();
                return 0;
            }
        }
        i = i + 1;
    }

    # 2c. THE POSTLUDE — whatever was queued AFTER the last window: the shell panel and anything else
    #     that must sit above every window. Each window's own chrome and title already went down inside
    #     the loop, in z-order, which is the fix.
    # ⛔ -2 MEANS DO NOT PRESENT. A batched `#92` failure left an indeterminate prefix in the back buffer;
    # the kernel's stated recovery is re-clear and no `#84`. Returning 0 here sends the caller to the CPU
    # present, which repaints the whole frame from the userland framebuffer — the correct outcome, and the
    # one thing that must NOT happen is flipping the half-composited buffer to the panel.
    var post_lo = ae_rect_prelude_n();
    var tpost_lo = ae_text_prelude_n();
    if (ae_mark_count() > 0) {
        post_lo = ae_rect_mark_at(ae_mark_count() - 1);
        tpost_lo = ae_text_mark_at(ae_mark_count() - 1);
    }
    if (ae_chrome_on_gpu() == 1) {
        if (ae_gpu_emit_chrome_range(post_lo, ae_rect_count()) == 0 - 1) {
            ae_gpu_demote(); return 0;
        }
    }
    if (ae_gpu_emit_text_range(tpost_lo, ae_text_count()) == 0 - 2) {
        ae_gpu_batch_recover();
        ae_gpu_demote();
        return 0;
    }


    # 2d. THE POINTER, LAST. Op order is paint order, so this is what makes the arrow top-most — over
    #     chrome, over captions, over client surfaces. ⛔ It must stay AFTER the text drain for a second
    #     reason too: both share the one `#86` glyph staging slot, so emitting the cursor first would have
    #     its mask overwritten by the first caption packed after it.
    if (ae_gpu_emit_cursor() == 0 - 2) {
        ae_gpu_batch_recover();
        ae_gpu_demote();
        return 0;
    }

    # 2b. Pre-flip capture, if the selftest armed one. See the ae_gpu_cap_* block above for why this
    #     is here and not in a probe of its own, and why it cannot be moved below the present.
    if (ae_gpu_cap_slot != 0) {
        ae_gpu_cap_rc = sys_gpu_readback_shm(ae_gpu_cap_slot, ae_gpu_cap_wh, ae_gpu_cap_xy);
    }

    # 3. ONE flip for the whole frame.
    # ⚠ #84 returns 1 = PRESENTED / 0 = nothing to present — the one syscall in this band that does not use
    # the 0-ok convention. Checking `!= 0` here would read success as failure; that exact mistake cost an
    # iron burn on /bin/gpublend.
    if (sys_gpu_present() != 1) { ae_gpu_demote(); return 0; }
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
}
