[package]
name = "aethersafha"
version = "${file:VERSION}"
description = "aethersafha — AI-augmented AGNOS compositor (Cyrius port, from 27207 lines of Rust)"
license = "AGPL-3.0-only"
language = "cyrius"
cyrius = "6.6.11"

[build]
entry = "src/main.cyr"
output = "aethersafha"

# Stdlib is opt-in: list every module that src/ or any [deps.*] bundle calls. A dep's `.deps`
# sidecar is a starting point; grep its bundle for the symbols it actually references.
[deps]
stdlib = [
    "syscalls", "string", "alloc", "atomic", "fmt", "vec", "str", "slice",
    "hashmap", "fnptr", "io", "fs", "process", "args", "tagged", "result",
    "chrono", "math", "assert", "bench", "ct",
    # mehman → kavach → sandhi → the native TLS stack:
    "net", "sandhi", "thread_local", "random", "freelist", "sync",
    "async", "fdlopen", "dynlib", "mmap",
    "tls", "tls_native", "tls_native_conn", "tls_native_ctx", "tls_native_lowlevel",
    "tls_native_hs12", "tls_native_hs13", "tls_native_keysched",
    "sha1", "keccak", "sigil", "sakshi",
    # chitra → sankoch (PNG inflate); sankoch's lock calls mutex_lock, hence "thread":
    "sankoch", "thread",
]
# "sys" is not listed: src/sysprobe.cyr includes lib/sys.cyr by path.

# Every `path` line below stays commented out (dormant) in a commit. A live `path` wins over `tag`:
# `cyrius deps`, which every build and test runs first, re-vendors lib/ from the sibling checkout and
# cyrius.lock pins no commit for it. Uncomment one only while working against an unpushed sibling.
# scripts/check-dep-tags.sh reads the dormant line as the sibling's location and fails on a live one.

# Platform backend: framebuffer scanout, keyboard and pointer input, seat.
[deps.bhumi]
git = "https://github.com/MacCracken/bhumi.git"
# path = "../bhumi"
tag = "1.4.5"
modules = ["dist/bhumi.cyr"]

# Desktop theme tokens (the MUDRA / SHANTA palettes); src/theme.cyr packs them for the framebuffer.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# path = "../rupa"
tag = "0.1.8"
modules = ["dist/rupa.cyr"]

# Bitmap console fonts. Only the freestanding glyph-data core (kashi_font_init, kashi_glyph_row):
# the library face (dist/kashi.cyr) adds font import and a runtime font registry that nothing here
# calls (+183,360 B, measured on dhancha). Switch modules only when runtime font loading is needed.
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# path = "../kashi"
tag = "1.0.10"
modules = ["src/font_data.cyr"]

# Foreign-app "swallow" backend: hosts foreign-ABI app surfaces in a kavach sandbox.
[deps.mehman]
git = "https://github.com/MacCracken/mehman.git"
# path = "../mehman"
tag = "1.0.4"
modules = ["src/types.cyr", "src/surface.cyr", "src/sandbox.cyr"]

# mehman's sandbox backend. Declared so its bundle is prepended: mehman's src/sandbox.cyr names
# kavach's types and sandbox_* functions directly.
[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
# path = "../kavach"
tag = "3.13.1"
modules = ["dist/kavach.cyr"]

# Image decode (PNG and JPEG to RGBA8) for the wallpaper. Use it; do not hand-roll a decoder here.
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
# path = "../chitra"
tag = "1.0.3"
modules = ["dist/chitra.cyr"]

# Display-plane contract with clients: message types and the wire codec. The transport (Unix socket,
# shared buffers, the agnos channel band) lives in this repo, not in setu.
[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# path = "../setu"
tag = "0.8.11"
modules = ["dist/setu.cyr"]
