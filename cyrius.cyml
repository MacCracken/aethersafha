[package]
name = "aethersafha"
# ⚠ INTERPOLATED, NOT DUPLICATED. This was a hardcoded literal and drifted from `VERSION` at every cut —
# the same shape as agnoshi printing "1.8.6" from a hardcoded string while its VERSION said 1.8.8, which
# cost a false staleness finding on 2026-08-07. puka already uses this form; one source of truth.
version = "${file:VERSION}"
description = "aethersafha — AI-augmented AGNOS compositor (Cyrius port, from 27207 lines of Rust)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.33"

[build]
entry = "src/main.cyr"
output = "aethersafha"

# Stdlib is OPT-IN: declare exactly what the project + every active [deps.*]
# needs, reviewed from each dep's `dist/<name>.deps` sidecar + referenced symbols.
# UNION covers: compositor + M2 leaf; agnostik (trait); agnodrm (ct); kashi
# (freestanding, none); mehman → [deps.kavach] → sandhi → the tls_native TLS
# stack + crypto (net/sandhi/thread_local/random/freelist + tls_native* + sha/keccak/sigil).
[deps]
stdlib = [
    "syscalls", "string", "alloc", "atomic", "fmt", "vec", "str", "slice",
    "hashmap", "fnptr", "io", "fs", "process", "args", "tagged", "result",
    "chrono", "math", "assert", "bench", "trait", "ct",
    # mehman → kavach → sandhi → TLS cascade:
    "net", "sandhi", "thread_local", "random", "freelist", "sync",
    "async", "fdlopen", "dynlib", "mmap",
    "tls", "tls_native", "tls_native_conn", "tls_native_ctx", "tls_native_lowlevel",
    "tls_native_hs12", "tls_native_hs13", "tls_native_keysched",
    "sha1", "keccak", "sigil", "sakshi",
    # chitra (image decode) → sankoch's zlib_decompress for PNG IDAT inflate; sankoch's
    # _sankoch_lock/_unlock wrap mutex_lock/mutex_unlock, hence "thread".
    "sankoch", "thread",
]

# --- Platform backend: DRM/KMS + libinput + logind → output/input/seat.
[deps.bhumi]
git = "https://github.com/MacCracken/bhumi.git"
path = "../bhumi"
tag = "1.4.2"
modules = ["dist/bhumi.cyr"]

# --- Desktop theme-token core: rupa (रूप — form / appearance). The ONE source of
# the MUDRA / SHANTA palette; the compositor chrome packs its logical 0xRRGGBB
# tokens to the bhumi framebuffer via ae_bhumi (src/theme.cyr). Extracted from the
# compositor's own theme.cyr when dhancha became the second consumer.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
path = "../rupa"
tag = "0.1.4"
modules = ["dist/rupa.cyr"]

# --- Shared AGNOS domain primitives (was Rust `agnostik` 0.90.0). Error family
# namespaced STIK_ERR_*/stik_err_*/stik_syserr_* at 1.3.3 to end the ERR_*
# collision with agnodrm.
[deps.agnostik]
git = "https://github.com/MacCracken/agnostik.git"
path = "../agnostik"
tag = "1.3.5"
modules = ["dist/agnostik.cyr"]

# --- udev + DRM/KMS device model (was Rust `agnosys` 0.50.0; agnosys decomposed
# 2026-06-19 → agnodrm). Error family namespaced DRM_ERR_*/drm_err_*/drm_syserr_*
# at 1.4.5. bhumi also sits on agnodrm internally.
[deps.agnodrm]
git = "https://github.com/MacCracken/agnodrm.git"
path = "../agnodrm"
tag = "1.5.1"
modules = ["dist/agnodrm.cyr"]

# --- Bitmap console fonts (the AGNOS font subsystem). We consume only the
# freestanding font-data core (pure store8/load8, no stdlib): the IBM VGA 8x16 +
# CGA 8x8 glyph tables + a row-query API. Replaces the hand-rolled 5x7 font.
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
path = "../kashi"
tag = "1.0.6"
# ⛔⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT (recorded 2026-08-17, kashi 1.0.6).
# kashi's ADR 0001 says stdlib-linked consumers should take the LIBRARY FACE, and this project links
# the full stdlib — so `src/font_data.cyr` looks like the wrong surface. Two reasons it is not:
#   1. Until kashi 1.0.6 the library face was UNCONSUMABLE. `src/lib.cyr` opens with
#      `include "src/font_data.cyr"`, a kashi-root-relative path that cannot resolve once vendored
#      into this repo's `lib/` — `error: cannot open include file: src/font_data.cyr`. kashi 1.0.6
#      adds `dist/kashi.cyr`, which fixes that, so the choice is now real.
#   2. It is still the core. MEASURED on dhancha: core 364,640 B vs full face 548,000 B —
#      **+183,360 (+50%)** for PSF/BDF/PCF import and a runtime font registry nothing here calls, and
#      `CYRIUS_DCE=1` reclaims NONE of it. This project uses `kashi_font_init` + `kashi_glyph_row`.
# ⇒ Switch to `modules = ["dist/kashi.cyr"]` only when this project needs runtime font LOADING.
modules = ["src/font_data.cyr"]

# --- Compat / "swallow" backend: does XWayland's job the sovereign way — hosts foreign-ABI app
# surfaces in a kavach sandbox. We consume its library modules (error/caps/guest
# vocabulary, the foreign-surface descriptor, and the kavach-sandboxed guest
# runner + the M2 surface-capture handoff, mehman_sandbox_capture_guest).
# Transitively pulls [deps.kavach] → sandhi → the tls_native TLS stack, declared
# in [deps].stdlib above.
[deps.mehman]
git = "https://github.com/MacCracken/mehman.git"
path = "../mehman"
tag = "1.0.2"
modules = ["src/types.cyr", "src/surface.cyr", "src/sandbox.cyr"]

# --- Sandbox execution surface (mehman's guest backend). Declared explicitly so
# kavach's dist is prepended — mehman_sandbox.cyr names kavach's Backend / config
# / sandbox_* surface directly.
[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
path = "../kavach"
# ⚠ 3.11.7 → 3.11.10 (2026-08-12). The tag had been WRONG IN COMMITTED STATE for two cuts: HEAD vendored
# 3.11.8 and any local build re-materialised 3.11.10 from `../kavach`, because the `path` override wins.
# So the manifest declared a graph nothing here had built since 3.11.7. Verified before bumping: 3.11.10 is
# a real tag on a clean kavach tree, so the declared graph is now fetchable and matches the vendored copy.
# ⛔ 3.11.10 → 3.11.12 (2026-08-13) — AND IT HAPPENED AGAIN, EXACTLY AS THE NOTE ABOVE PREDICTS. The
# sibling moved to 3.11.12; the first local build of this session silently re-materialised `lib/kavach.cyr`
# (+61/-12 lines) and moved its `cyrius.lock` digest, while this line still said 3.11.10. Nothing warns:
# `path` wins, so the build is green either way and the DECLARED graph is the only thing that is wrong.
# ⚠ The comment above did not prevent the recurrence, and a third instance should not be met with a third
# comment — this wants a gate that diffs every declared tag against its sibling VERSION at check time.
# Verified before bumping: 3.11.12 is a real tag locally AND on the remote, on a clean tree.
# ⛔ 3.11.14 → 3.12.2 (2026-08-21) — FOURTH recurrence, and the gate above is now BUILT rather than
# re-described: `scripts/check-dep-tags.sh`. No fifth comment. Verified before bumping, all four ways
# the earlier notes only claimed: 3.12.2 is a real tag locally AND on the remote (37f55c2), the sibling
# tree is clean, and `lib/kavach.cyr` is **byte-identical to `dist/kavach.cyr` at that tag**
# (sha `ee243978`, matching `cyrius.lock`). ⚠ kavach HEAD is 1 commit past the tag, but that commit does
# not touch the one module consumed here — checked, not assumed.
tag = "3.12.2"
modules = ["dist/kavach.cyr"]

# --- Image decode: chitra (चित्र — image / picture). Pure-Cyrius CPU raster decoder — PNG (all bit
# depths + Adam7) and JPEG (baseline, YCbCr, 4:4:4/4:2:2/4:2:0) → canonical RGBA8. This is what makes a
# WALLPAPER A FILE.
# ⛔ Do NOT hand-roll a decoder here. One was written for the C1a follow-on before this dep was found,
# covering a strict subset (8-bit, RGB/RGBA, no Adam7) — a maintained sibling already did all of it and
# more. Deleted rather than kept as a "lighter" path.
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
path = "../chitra"
tag = "0.3.1"
modules = ["dist/chitra.cyr"]

# --- DISPLAY plane contract: setu (सेतु — bridge). The dhancha client ↔ this
# compositor wire — pure message TYPES + wire CODEC (pixel/input/surface
# lifecycle). AGENT-FREE; shares no wire with any MCP endpoint. Transport (Unix
# socket + memfd/SCM_RIGHTS) lives here in the compositor, NOT in setu. All fns
# are `setu_*` (no collision); its stdlib needs {string,fmt,alloc,vec,str,io,
# syscalls,assert} are already a subset of [deps].stdlib above.
[deps.setu]
# 0.8.0 — ⭐⭐ THE CHANNEL-BAND CUTOVER. On agnos setu no longer DIALS: `setu_connect` checks the kernel
#         floor via `CH_CAPS`, reads `AGNOS_CHAN` out of its environment, and returns that fd. The TCP
#         arm is DELETED on agnos (Linux keeps its own — a different target, not a fallback).
#         ⛔ Hard floor: agnos >= 1.56.40 (`#97 chan_op`). A client built from it REFUSES on an older
#         kernel rather than appearing to work — enforced by CH_CAPS, not documented.
# ⚠ `args` must stay in [deps] stdlib above: the agnos arm calls `getenv`, which resolves to
#   `_agnos_getenv` (agnos has no /proc). `dist/setu.deps` does NOT list it — that sidecar names 8
#   leaves while setu itself needs 12 (`net`/`chrono`/`result` are missing too). Verified against a
#   throwaway consumer built with exactly those 8: it fails on `_agnos_getenv`. Sidecar = starting
#   point, not contract. (It is already present here for other reasons; do not remove it.)
# ⚠ COMMENT CORRECTED 2026-08-01 — it said "Pinned to 0.5.0" over a `tag = "0.7.1"` line, and had
# said so through two bumps. A stale pin comment is worse than none: it is what a reader checks
# INSTEAD of the field below it. (puka and dhancha carry the same rotted comment, saying 0.3.0.)
# 0.6.0 — client buffers are GPU-VISIBLE on agnos (`shm_create_gpu` #86 before `shm_create` #71).
#         This is what makes a client surface blittable at all: #71 is system RAM, which the agnos
#         GPU cannot reach, and the kernel rejects such a slot at both #87 and #92.
# 0.7.0 — SETU_SURF_PREMULTIPLIED (flag bit 1), the opt-in this compositor routes to #92 op 0x01.
# 0.5.0 — full key events (press + release); SETU_SURF_FULL_KEYS + the per-surface make/break
#         forwarding this compositor honours.
git = "https://github.com/MacCracken/setu.git"
# ⚠ `path` added 2026-08-12 — setu was the ONE dep declaring a tag with no path override, which meant
# a local setu change could not be built against at all. Every sibling dep here carries both. The
# path-wins hazard applies as it does to the rest: re-verify tag vs sibling VERSION at each cut.
path = "../setu"
tag = "0.8.7"
modules = ["dist/setu.cyr"]
