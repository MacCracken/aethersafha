# aethersafha — mehman foreign-app hosting test (the "swallow" seam).
# mehman/kavach/TLS surface is auto-prepended via cyrius.cyml [deps.*].
include "src/geom.cyr"
include "src/window.cyr"
include "src/render.cyr"   # render_foreign_content presents captured surfaces
include "src/compositor.cyr"
include "src/gestures.cyr"
include "src/accessibility.cyr"
include "src/ai_features.cyr"
include "src/shell.cyr"
include "src/security_ui.cyr"
include "src/plugin_host.cyr"
include "src/desktop.cyr"
include "src/foreign.cyr"

fn t_ok(x): i64 {
    if (x != 0) { return 1; }
    return 0;
}

# ⛔ THE SUITE'S GUESTS ARE THIS BINARY, RE-EXECUTED, SO A RUN TESTS THIS CODE AND NOT THE RUNNER'S IMAGE.
# `/proc/self/exe` pins this very file, so a guest takes the real path (the sandbox, the pinned exec, the
# capture, the reap) and is the same program on every host. It answers only to its own argv shape, so the
# suite under `cyrius test` (argc 1) never takes it.
#
# ⛔ ONE GUEST IS THE HOST'S `/bin/echo`, ON PURPOSE: it is the production path, the boot greeter's. Ubuntu's
# coreutils are uutils since 25.10: one multicall binary that takes the utility's name from the path it was
# executed by. Below 3.14.0 kavach execs a pinned program as `/dev/fd/N`, and uutils refuses to start: exit
# 1, no stdout. 3.14.0 execs `/proc/self/fd/N`, which uutils accepts. `foreign_run` returns OK for a guest
# that never started, so the exit code is what tells them apart. On a GNU host this group passes either way;
# on a uutils host it fails with kavach below 3.14.0.
#
#   guest-echo WORD   prints WORD and a newline, exits 0
#   guest-exit N      exits N (one digit)
#   guest-hang WORD   prints WORD and a newline, then outlasts any deadline this suite sets
var T_GUEST_ECHO_HI = "/proc/self/exe guest-echo hi";

# The guest's entry: its exit code, or -1 when this run is the suite.
fn t_guest(): i64 {
    if (args_init() <= 0) { return 0 - 1; }
    if (argc() != 3) { return 0 - 1; }
    var verb = argv(1);
    var arg = argv(2);
    if (streq(verb, "guest-echo") == 1) {
        println(arg);
        return 0;
    }
    if (streq(verb, "guest-exit") == 1) { return load8(arg) - 48; }
    if (streq(verb, "guest-hang") == 1) {
        println(arg);
        sleep_ms(60000);
        return 0;
    }
    return 0 - 1;
}

fn main() {
    alloc_init();
    var guest_code = t_guest();
    if (guest_code >= 0) { return guest_code; }

    test_group("mehman — foreign guest spec + surface descriptor");
    var f = foreign_new("xterm", 800, 600);
    assert(t_ok(f), "foreign_new builds a hosted foreign app");
    assert_eq(guest_spec_is_valid(foreign_guest(f)), 1, "guest spec valid (swallow caps)");
    assert_eq(surface_is_valid(foreign_surface(f)), 1, "XRGB8888 surface descriptor valid");

    test_group("mehman — host a foreign app as a compositor window");
    var d = desktop_new();
    var before = comp_count(desk_comp(d));
    var fw = desktop_host_foreign(d, "gimp", 40, 40, 640, 480, "GIMP (foreign)");
    assert(t_ok(fw), "desktop_host_foreign succeeds");
    assert(t_ok(foreign_window(fw)), "a compositor window backs the foreign surface");
    assert_eq(comp_count(desk_comp(d)), before + 1, "compositor gained the foreign window");
    assert_eq(win_is_agent(foreign_window(fw)), 0, "foreign window is not agent-owned");

    test_group("mehman — run a sandboxed guest (kavach PROCESS backend)");
    var rf = foreign_new("/proc/self/exe guest-exit 3", 100, 100);
    assert(t_ok(rf), "foreign_new for a guest that exits 3");
    assert_eq(foreign_has_run(rf), 0, "not run yet");
    assert_eq(foreign_run(rf), 0, "run returns MehmanError.OK (clean fork+exec+reap)");
    assert_eq(foreign_has_run(rf), 1, "marked as run after foreign_run");
    # The exact code, not "non-zero" and not foreign_run's OK: a refused exec exits 1 and still returns OK.
    assert_eq(foreign_exit_status(rf), 3, "the guest really started: its own exit code comes back");

    test_group("mehman — capture the guest surface into its buffer (M2 handoff)");
    var cf = foreign_new(T_GUEST_ECHO_HI, 64, 8);
    assert(t_ok(cf), "foreign_new for the echoing guest");
    assert_eq(foreign_run(cf), 0, "capture run returns MehmanError.OK");
    assert_eq(foreign_exit_status(cf), 0, "the echoing guest exited 0");
    # the guest's stdout ("hi\n") is captured into the foreign surface's pixel buffer
    var sbuf = MehmanSurface_buffer(foreign_surface(cf));
    assert_eq(load8(sbuf + 0), 104, "surface byte 0 = 'h' (captured guest output)");
    assert_eq(load8(sbuf + 1), 105, "surface byte 1 = 'i'");
    assert_eq(load8(sbuf + 2), 10, "surface byte 2 = newline");

    test_group("mehman — the host's own /bin/echo runs as a guest, whichever coreutils it has");
    var hf = foreign_new("/bin/echo hi", 64, 8);
    assert(t_ok(hf), "foreign_new for the host's /bin/echo");
    assert_eq(foreign_run(hf), 0, "the host's /bin/echo returns MehmanError.OK");
    assert_eq(foreign_exit_status(hf), 0, "  ...and exits 0: it really started");
    var hbuf = MehmanSurface_buffer(foreign_surface(hf));
    assert_eq(load8(hbuf + 0), 104, "  ...and its output is captured: 'h'");
    assert_eq(load8(hbuf + 1), 105, "  ...'i'");

    test_group("mehman — a guest killed at its deadline ran, and what it wrote stays in the surface");
    # Through mehman 1.1.0 a kill returned OK. `_mehman_deadline_ms` is mehman's private test hook: without
    # it a one-shot guest gets kavach's 30 s, which would keep this path out of the suite.
    _mehman_deadline_ms = 300;
    var kf = foreign_new("/proc/self/exe guest-hang hi", 64, 8);
    assert(t_ok(kf), "foreign_new for a guest that never exits");
    assert_eq(foreign_run(kf), MehmanError.GUEST_TIMED_OUT, "foreign_run reports the kill, not OK");
    _mehman_deadline_ms = 0;
    assert_eq(foreign_has_run(kf), 1, "  ...and the guest counts as run, so its window presents");
    assert_eq(foreign_exit_status(kf), 137, "  ...killed: 128 + SIGKILL");
    var kbuf = MehmanSurface_buffer(foreign_surface(kf));
    assert_eq(load8(kbuf + 0), 104, "  ...and what it wrote first is still in the surface: 'h'");
    assert_eq(load8(kbuf + 1), 105, "  ...'i'");

    test_group("mehman — present the captured surface as window content");
    kashi_font_init();   # the glyph tables must be live before draw_text_lines
    var pd = desktop_new();
    assert_eq(desk_foreign_count(pd), 0, "no foreign apps hosted yet");
    var pf = desktop_host_foreign(pd, T_GUEST_ECHO_HI, 0, 0, 200, 100, "echo");
    assert(t_ok(pf), "hosted the echo guest");
    assert_eq(desk_foreign_count(pd), 1, "desktop tracks the hosted foreign app");
    var pfb = bhumi_fb_new(200, 100);
    bhumi_fb_clear(pfb, 0);
    # before the guest runs there is nothing to present (no-op).
    assert_eq(render_foreign_content(pfb, pf), 0, "no content before the guest runs");
    assert_eq(foreign_run(pf), 0, "guest ran (capture OK)");
    # present every hosted foreign app; the captured "hi" paints the window body.
    assert_eq(render_desktop_foreign(pd, pfb), 1, "render_desktop_foreign drew 1 app");
    var green = bhumi_xrgb(190, 230, 190);
    var lit = 0;
    var yy = 30;
    while (yy < 60) {
        var xx = 0;
        while (xx < 120) {
            if (bhumi_fb_get(pfb, xx, yy) == green) { lit = lit + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    assert(t_ok(lit), "captured guest text painted pixels in the window body");

    return assert_summary();
}

var ec = main();
syscall(60, ec);
