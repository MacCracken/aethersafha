# aethersafha desktop shell — behavioral parity test.
# Mirrors rust-old/src/shell.rs #[cfg(test)] behaviors against the
# Cyrius port in src/shell.cyr. Stdlib (vec/str/hashmap/assert/string)
# is auto-prepended via cyrius.cyml [deps.stdlib]; shell.cyr has no
# src cross-references so it is the only include needed.
include "src/shell.cyr"

# Non-null pointer check helper (assert() is strict cond==1).
fn t_ok(x) { if (x != 0) { return 1; } return 0; }

# t_find_item: the live launcher item whose id Str equals lid, or 0.
fn t_find_item(sh, lid) {
    var items = shell_items(sh);
    var n = vec_len(items);
    var i = 0;
    while (i < n) {
        var it = vec_get(items, i);
        if (str_eq(shell_item_id(it), lid) == 1) { return it; }
        i = i + 1;
    }
    return 0;
}

# t_app_matches: 1 iff the registry entry for `id` AND the launcher item derived from it carry
# exactly rust's fields (shell.rs initialize_app_registry + populate_launcher_items).
fn t_app_matches(sh, id, name, icon, cat, is_ai) {
    var app = shell_registry_get(sh, id);
    if (app == 0) { return 0; }
    if (streq(shell_app_id(app), id) != 1) { return 0; }
    if (streq(shell_app_name(app), name) != 1) { return 0; }
    if (streq(shell_app_icon(app), icon) != 1) { return 0; }
    if (shell_app_category(app) != cat) { return 0; }
    if (shell_app_is_ai(app) != is_ai) { return 0; }
    # launcher item: id "app-<id>", desc "Launch <name>", app Some, OpenApp(id), 1.0 -> 1000
    var it = t_find_item(sh, str_cat(str_from("app-"), str_from(id)));
    if (it == 0) { return 0; }
    if (str_eq(shell_item_name(it), str_from(name)) != 1) { return 0; }
    if (str_eq(shell_item_desc(it), str_cat(str_from("Launch "), str_from(name))) != 1) { return 0; }
    if (str_eq(shell_item_icon(it), str_from(icon)) != 1) { return 0; }
    if (shell_item_app(it) != app) { return 0; }
    var act = shell_item_action(it);
    if (act == 0) { return 0; }
    if (shell_action_kind(act) != SH_LauncherActionKind.SH_ACT_OPEN_APP) { return 0; }
    if (streq(shell_action_arg(act), id) != 1) { return 0; }
    if (shell_item_suggested(it) != 0) { return 0; }
    if (shell_item_relevance(it) != 1000) { return 0; }
    return 1;
}

# t_any_name_contains: 1 iff some result's lowercased name contains needle (a lowercase cstr).
fn t_any_name_contains(results, needle) {
    var n = vec_len(results);
    var i = 0;
    while (i < n) {
        var lc = shell_str_lower_str(shell_item_name(vec_get(results, i)));
        if (str_contains(lc, str_from(needle)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Is the notification with id `id` still held? -> 1 / 0.
fn t_has_notif(sh, id) {
    if (shell_notif_find_index(sh, id) >= 0) { return 1; }
    return 0;
}

# --- test_notification_default, test_notification_custom ---
fn t_notification_records() {
    test_group("shell — Notification::default and a custom notification");
    var nd = shell_notif_default(7, 100);
    assert_eq(shell_notif_priority(nd), SH_NotifPriority.SH_PRIO_NORMAL, "default priority Normal");
    assert_eq(shell_notif_requires_action(nd), 0, "default not requires_action");
    assert_eq(shell_notif_is_agent(nd), 0, "default not is_agent_related");
    assert_eq(strlen(shell_notif_app_name(nd)) + strlen(shell_notif_title(nd)) + strlen(shell_notif_body(nd)), 0,
      "default app_name, title and body empty");
    var nc = shell_notif_new(8, "test", "Test Title", "Test Body", SH_NotifPriority.SH_PRIO_HIGH, 100, 1, 1);
    assert_eq(streq(shell_notif_title(nc), "Test Title"), 1, "custom title Test Title");
    assert_eq(shell_notif_requires_action(nc), 1, "custom requires_action");
    assert_eq(shell_notif_priority(nc), SH_NotifPriority.SH_PRIO_HIGH, "  ...priority High");
    assert_eq(shell_notif_is_agent(nc), 1, "  ...is_agent_related");
    return 0;
}

# --- test_launcher_item, test_launcher_action ---
fn t_launcher_records() {
    test_group("shell — LauncherItem and LauncherAction");
    # LauncherItem { app: None, action: None, is_suggested: false, relevance_score: 0.9 }
    var li = shell_item_new(str_from("test"), str_from("Test App"), str_from("A test application"),
      str_from("app"), 0, 0, 0, 900);
    assert_eq(str_eq(shell_item_name(li), str_from("Test App")), 1, "item name Test App");
    assert_eq(shell_item_relevance(li), 900, "relevance 0.9 -> 900 permille");
    assert_eq(shell_item_has_app(li) + shell_item_has_action(li), 0, "  ...app and action None");
    var a1 = shell_action_new(SH_LauncherActionKind.SH_ACT_OPEN_APP, "terminal");
    var a2 = shell_action_new(SH_LauncherActionKind.SH_ACT_RUN_COMMAND, "ls");
    var a3 = shell_action_new(SH_LauncherActionKind.SH_ACT_SEARCH_FILES, "query");
    var a4 = shell_action_new(SH_LauncherActionKind.SH_ACT_WEB_SEARCH, "search");
    assert_eq(shell_action_kind(a1), SH_LauncherActionKind.SH_ACT_OPEN_APP, "OpenApp(_)");
    assert_eq(streq(shell_action_arg(a1), "terminal"), 1, "  ...carrying terminal");
    assert_eq(shell_action_kind(a2), SH_LauncherActionKind.SH_ACT_RUN_COMMAND, "RunCommand(_)");
    assert_eq(streq(shell_action_arg(a2), "ls"), 1, "  ...carrying ls");
    assert_eq(shell_action_kind(a3), SH_LauncherActionKind.SH_ACT_SEARCH_FILES, "SearchFiles(_)");
    assert_eq(streq(shell_action_arg(a3), "query"), 1, "  ...carrying query");
    assert_eq(shell_action_kind(a4), SH_LauncherActionKind.SH_ACT_WEB_SEARCH, "WebSearch(_)");
    assert_eq(streq(shell_action_arg(a4), "search"), 1, "  ...carrying search");
    return 0;
}

# --- test_desktop_shell_multiple_notifications, test_desktop_shell_dismiss_multiple_notifications,
#     test_notification_with_all_priorities ---
fn t_many_notifications() {
    test_group("shell — ten notifications are all held");
    var s10 = shell_new();
    var i = 0;
    while (i < 10) {
        shell_show_notification(s10, shell_notif_new(shell_next_notif_id(s10), "app", "Notif", "",
            SH_NotifPriority.SH_PRIO_NORMAL, i, 0, 0));
        i = i + 1;
    }
    assert_eq(shell_notification_count(s10), 10, "10 shown, 10 held");

    test_group("shell — dismissing three of five leaves the other two");
    var s5 = shell_new();
    var ids = vec_new();
    var k = 0;
    while (k < 5) {
        var nid = shell_next_notif_id(s5);
        vec_push(ids, nid);
        shell_show_notification(s5, shell_notif_default(nid, 100));
        k = k + 1;
    }
    assert_eq(shell_notification_count(s5), 5, "five held");
    var d = 0;
    var dis_ok = 0;
    while (d < 3) {
        if (shell_dismiss_notification(s5, vec_get(ids, d)) == SH_Err.SH_OK) { dis_ok = dis_ok + 1; }
        d = d + 1;
    }
    assert_eq(dis_ok, 3, "the first three dismiss Ok (unwrap)");
    assert_eq(shell_notification_count(s5), 2, "two left");
    assert_eq(t_has_notif(s5, vec_get(ids, 3)) + t_has_notif(s5, vec_get(ids, 4)), 2, "  ...the fourth and fifth");
    # Dismissal is by id, not position: three dismissals from the front cannot tell the two apart.
    shell_dismiss_notification(s5, vec_get(ids, 4));
    assert_eq(t_has_notif(s5, vec_get(ids, 3)) * 10 + t_has_notif(s5, vec_get(ids, 4)), 10,
      "  ...dismissing the fifth keeps the fourth");

    test_group("shell — one notification of each priority");
    var sp = shell_new();
    var p = SH_NotifPriority.SH_PRIO_LOW;
    while (p <= SH_NotifPriority.SH_PRIO_CRITICAL) {
        shell_show_notification(sp, shell_notif_new(shell_next_notif_id(sp), "test", "P", "", p, 100, 0, 0));
        p = p + 1;
    }
    assert_eq(shell_notification_count(sp), 4, "Low, Normal, High and Critical all held");
    var pv = shell_get_notifications(sp);
    var seen = 0;
    var q = 0;
    while (q < vec_len(pv)) {
        seen = seen | (1 << shell_notif_priority(vec_get(pv, q)));
        q = q + 1;
    }
    assert_eq(seen, 15, "  ...each priority once");
    return 0;
}

# --- test_desktop_shell_notification_eviction_prefers_non_action ---
fn t_eviction_prefers_non_action() {
    test_group("shell — eviction takes only a notification that needs no action");
    var se = shell_new();
    var cap = SH_Limits.SH_MAX_NOTIFICATIONS;
    var first = 0;
    var i = 0;
    while (i < cap) {
        var aid = shell_next_notif_id(se);
        if (i == 0) { first = aid; }
        shell_show_notification(se, shell_notif_new(aid, "test", "Action", "", SH_NotifPriority.SH_PRIO_HIGH,
            i, 1, 0));
        i = i + 1;
    }
    # A non-action one at capacity: nothing is evictable (the new one is not in the map yet).
    var oid = shell_next_notif_id(se);
    shell_show_notification(se, shell_notif_new(oid, "overflow", "Overflow", "", SH_NotifPriority.SH_PRIO_LOW,
        cap, 0, 0));
    assert_eq(shell_notification_count(se) <= cap + 1, 1, "count <= MAX_NOTIFICATIONS + 1");
    assert_eq(shell_notification_count(se), cap + 1, "  ...exactly MAX + 1: no action notification evicted");
    assert_eq(t_has_notif(se, first), 1, "  ...the oldest action notification is kept");
    # The next one evicts the only non-action notification, the overflow, not the older action ones.
    var nid = shell_next_notif_id(se);
    shell_show_notification(se, shell_notif_new(nid, "next", "Next", "", SH_NotifPriority.SH_PRIO_LOW,
        cap + 1, 0, 0));
    assert_eq(shell_notification_count(se), cap + 1, "one more: still MAX + 1");
    assert_eq(t_has_notif(se, oid), 0, "  ...the overflow was evicted");
    assert_eq(t_has_notif(se, first), 1, "  ...the oldest action notification still kept");
    assert_eq(t_has_notif(se, nid), 1, "  ...the new one held");
    return 0;
}

# The eviction picks the OLDEST non-action notification (shell.rs:401-410: min_by_key(timestamp)),
# not merely some non-action one: with two evictable, the newer must survive.
fn t_eviction_takes_oldest_non_action() {
    test_group("shell — eviction takes the OLDEST notification that needs no action");
    var so = shell_new();
    var cap = SH_Limits.SH_MAX_NOTIFICATIONS;
    var old_id = 0;
    var new_id = 0;
    var i = 0;
    while (i < cap) {
        var nid = shell_next_notif_id(so);
        var needs = 1;
        if (i == 5) { needs = 0; old_id = nid; }       # timestamp 5: the older non-action
        if (i == 50) { needs = 0; new_id = nid; }      # timestamp 50: the newer non-action
        shell_show_notification(so, shell_notif_new(nid, "test", "N", "", SH_NotifPriority.SH_PRIO_NORMAL,
            i, needs, 0));
        i = i + 1;
    }
    var extra = shell_next_notif_id(so);
    shell_show_notification(so, shell_notif_new(extra, "extra", "Extra", "", SH_NotifPriority.SH_PRIO_LOW,
        cap, 1, 0));
    assert_eq(t_has_notif(so, old_id), 0, "the older non-action notification (timestamp 5) was evicted");
    assert_eq(t_has_notif(so, new_id), 1, "  ...the newer one (timestamp 50) kept");
    assert_eq(t_has_notif(so, extra), 1, "  ...and the new one held");
    return 0;
}

# --- test_desktop_shell_lock_unlock_round_trip ---
fn t_lock_round_trip() {
    test_group("shell — lock / unlock round trip, with a double lock");
    var sl = shell_new();
    assert_eq(shell_is_locked(sl), 0, "unlocked at start");
    shell_lock_screen(sl);
    assert_eq(shell_is_locked(sl), 1, "locked");
    shell_unlock_screen(sl);
    assert_eq(shell_is_locked(sl), 0, "unlocked");
    shell_lock_screen(sl);
    shell_lock_screen(sl);
    assert_eq(shell_is_locked(sl), 1, "a double lock is locked");
    shell_unlock_screen(sl);
    assert_eq(shell_is_locked(sl), 0, "  ...and one unlock unlocks it");
    return 0;
}

fn main() {
    alloc_init();

    # ============================================================
    # DesktopShell::new + initial state
    # (rust: test_desktop_shell_new, test_desktop_shell_initial_system_status — re-expressed as
    #  ADR 0003's UNKNOWN seed: the gauges and the net are UNKNOWN, not Rust's 0.0 and Connected)
    # ============================================================
    test_group("shell — construction + initial state");
    var sh = shell_new();
    assert(t_ok(sh), "shell_new returns non-null");
    assert_eq(shell_notification_count(sh), 0, "no notifications at start");
    assert_eq(shell_is_locked(sh), 0, "not locked at start");
    assert_eq(shell_panel_visible(sh), 1, "panel visible at start");
    assert_eq(shell_registry_count(sh), 14, "14 app registry entries");

    var st0 = shell_get_system_status(sh);
    assert(t_ok(st0), "initial status non-null");
    # ⛔⛔ THIS SUITE ASSERTED THE DEFECT (corrected 0.16.20). It required cpu/mem/disk to be 0 on a
    # fresh shell — and since NOTHING ever fed them, that made "the panel shows a confident 0% for
    # everything, forever" the tested, defended behaviour. Third instance of this shape in the arc,
    # after `render.tcyr` asserted the one-frame repaint and `setu_handshake.tcyr` asserted state 3
    # as terminal. A seeded gauge is UNKNOWN until a producer answers.
    assert_eq(shell_status_cpu(st0), 0 - 1, "initial cpu UNKNOWN — no producer has answered yet");
    assert_eq(shell_status_mem(st0), 0 - 1, "initial mem UNKNOWN");
    assert_eq(shell_status_disk(st0), 0 - 1, "initial disk UNKNOWN");
    assert_eq(shell_status_battery_is_none(st0), 1, "initial battery None");
    # ⛔ AND NET IS UNKNOWN, not Rust's Connected (shell.rs:183): nothing measures it, so a seeded
    # Connected was the dot claiming a link on every boot (0.17.2).
    assert_eq(shell_status_net(st0), SH_NetStatus.SH_NET_UNKNOWN, "initial net UNKNOWN, not a claimed Connected");
    assert_eq(shell_status_agents(st0), 0, "initial agents 0");

    # ============================================================
    # App launch + registry
    # (rust: test_desktop_shell_launch_app, test_desktop_shell_launch_all_registered_apps,
    #  test_desktop_shell_launch_each_registered_app — the two loops are identical in rust)
    # ============================================================
    test_group("shell — launch app");
    assert_eq(shell_launch_app(sh, "terminal"), SH_Err.SH_OK, "launch terminal OK");
    assert_eq(shell_launch_app(sh, "nonexistent"), SH_Err.SH_ERR_APP_NOT_FOUND, "launch nonexistent errors");
    assert_eq(shell_launch_app(sh, "nonexistent-app-xyz"), SH_Err.SH_ERR_APP_NOT_FOUND, "launch unknown app errors");
    assert_eq(shell_launch_app(sh, "filemanager"), SH_Err.SH_OK, "launch filemanager OK");
    assert_eq(shell_launch_app(sh, "settings"), SH_Err.SH_OK, "launch settings OK");
    assert_eq(shell_launch_app(sh, "agent-manager"), SH_Err.SH_OK, "launch agent-manager OK");
    assert_eq(shell_launch_app(sh, "audit-viewer"), SH_Err.SH_OK, "launch audit-viewer OK");
    assert_eq(shell_launch_app(sh, "model-manager"), SH_Err.SH_OK, "launch model-manager OK");
    assert_eq(shell_launch_app(sh, "firefox"), SH_Err.SH_OK, "launch firefox OK");
    assert_eq(shell_launch_app(sh, "chromium"), SH_Err.SH_OK, "launch chromium OK");
    assert_eq(shell_launch_app(sh, "zen-browser"), SH_Err.SH_OK, "launch zen-browser OK");
    assert_eq(shell_launch_app(sh, "brave"), SH_Err.SH_OK, "launch brave OK");
    assert_eq(shell_launch_app(sh, "librewolf"), SH_Err.SH_OK, "launch librewolf OK");
    assert_eq(shell_launch_app(sh, "vivaldi"), SH_Err.SH_OK, "launch vivaldi OK");
    assert_eq(shell_launch_app(sh, "falkon"), SH_Err.SH_OK, "launch falkon OK");
    assert_eq(shell_launch_app(sh, "midori"), SH_Err.SH_OK, "launch midori OK");
    assert_eq(shell_launch_app(sh, "cmdpalette"), SH_Err.SH_ERR_APP_NOT_FOUND, "no cmdpalette entry — rust never registered one");

    # ============================================================
    # Registry + derived launcher items, field by field
    # (rust: initialize_app_registry, populate_launcher_items, test_desktop_shell_app_registry_count)
    # 14 matches + a count of 14 pins the exact set; 15 items == 14 app items + "search-files".
    # ============================================================
    test_group("shell — registry + launcher items vs rust");
    var C_SYS = SH_AppCategory.SH_CAT_SYSTEM;
    var C_AI = SH_AppCategory.SH_CAT_AI;
    var C_NET = SH_AppCategory.SH_CAT_INTERNET;
    assert_eq(t_app_matches(sh, "terminal", "Terminal", "terminal", C_SYS, 1), 1, "terminal entry + item match rust");
    assert_eq(t_app_matches(sh, "filemanager", "File Manager", "folder", C_SYS, 0), 1, "filemanager entry + item match rust");
    assert_eq(t_app_matches(sh, "settings", "Settings", "settings", C_SYS, 0), 1, "settings entry + item match rust");
    assert_eq(t_app_matches(sh, "agent-manager", "Agent Manager", "bot", C_AI, 1), 1, "agent-manager entry + item match rust");
    assert_eq(t_app_matches(sh, "audit-viewer", "Audit Viewer", "shield", C_SYS, 1), 1, "audit-viewer entry + item match rust");
    assert_eq(t_app_matches(sh, "model-manager", "Model Manager", "cpu", C_AI, 1), 1, "model-manager entry + item match rust");
    assert_eq(t_app_matches(sh, "firefox", "Firefox", "firefox", C_NET, 0), 1, "firefox entry + item match rust");
    assert_eq(t_app_matches(sh, "chromium", "Chromium", "chromium", C_NET, 0), 1, "chromium entry + item match rust");
    assert_eq(t_app_matches(sh, "zen-browser", "Zen Browser", "zen-browser", C_NET, 0), 1, "zen-browser entry + item match rust");
    assert_eq(t_app_matches(sh, "brave", "Brave", "brave", C_NET, 0), 1, "brave entry + item match rust");
    assert_eq(t_app_matches(sh, "librewolf", "LibreWolf", "librewolf", C_NET, 0), 1, "librewolf entry + item match rust");
    assert_eq(t_app_matches(sh, "vivaldi", "Vivaldi", "vivaldi", C_NET, 0), 1, "vivaldi entry + item match rust");
    assert_eq(t_app_matches(sh, "falkon", "Falkon", "falkon", C_NET, 0), 1, "falkon entry + item match rust");
    assert_eq(t_app_matches(sh, "midori", "Midori", "midori", C_NET, 0), 1, "midori entry + item match rust");
    assert_eq(vec_len(shell_items(sh)), 15, "15 launcher items (14 apps + search-files)");
    var sf_item = t_find_item(sh, str_from("search-files"));
    assert(t_ok(sf_item), "search-files item present");
    assert_eq(str_eq(shell_item_name(sf_item), str_from("Search Files")), 1, "search-files name");
    assert_eq(str_eq(shell_item_desc(sf_item), str_from("Search for files on the system")), 1, "search-files desc");
    assert_eq(str_eq(shell_item_icon(sf_item), str_from("search")), 1, "search-files icon");
    assert_eq(shell_item_has_app(sf_item), 0, "search-files app None");
    assert_eq(shell_action_kind(shell_item_action(sf_item)), SH_LauncherActionKind.SH_ACT_SEARCH_FILES, "search-files action SearchFiles");
    assert_eq(strlen(shell_action_arg(shell_item_action(sf_item))), 0, "search-files action arg empty (String::new())");
    assert_eq(shell_item_suggested(sf_item), 0, "search-files not suggested");
    assert_eq(shell_item_relevance(sf_item), 800, "search-files relevance 0.8 -> 800");

    # ============================================================
    # Notification lifecycle
    # (rust: test_desktop_shell_notification_lifecycle,
    #  test_desktop_shell_dismiss_nonexistent, dismiss_twice)
    # ============================================================
    test_group("shell — notification lifecycle");
    var nid = shell_next_notif_id(sh);
    var n1 = shell_notif_new(nid, "test", "Test", "Body", SH_NotifPriority.SH_PRIO_NORMAL, 100, 0, 0);
    assert(t_ok(n1), "notification allocated");
    shell_show_notification(sh, n1);
    assert_eq(shell_notification_count(sh), 1, "one notification after show");
    assert_eq(shell_dismiss_notification(sh, nid), SH_Err.SH_OK, "dismiss existing OK");
    assert_eq(shell_notification_count(sh), 0, "zero after dismiss");
    assert_eq(shell_dismiss_notification(sh, nid), SH_Err.SH_ERR_NOTIF_NOT_FOUND, "dismiss again errors");
    assert_eq(shell_dismiss_notification(sh, 99999), SH_Err.SH_ERR_NOTIF_NOT_FOUND, "dismiss unknown id errors");

    # ============================================================
    # Agent notification: requires_action -> High + agent-related
    # (rust: test_desktop_shell_agent_notification[_requires_action])
    # ============================================================
    test_group("shell — agent notification");
    var an = shell_show_agent_notification(sh, "Title", "Body", 0, 200);
    assert(t_ok(an), "agent notif (no action) allocated");
    assert_eq(shell_notif_is_agent(an), 1, "agent notif is_agent_related");
    assert_eq(shell_notif_requires_action(an), 0, "agent notif not requires_action");
    assert_eq(shell_notif_priority(an), SH_NotifPriority.SH_PRIO_NORMAL, "no-action agent notif is Normal");

    var an2 = shell_show_agent_notification(sh, "Alert", "Body", 1, 201);
    assert(t_ok(an2), "agent notif (action) allocated");
    assert_eq(shell_notif_requires_action(an2), 1, "action agent notif requires_action");
    assert_eq(shell_notif_priority(an2), SH_NotifPriority.SH_PRIO_HIGH, "action agent notif is High");
    assert_eq(shell_notification_count(sh), 2, "two agent notifs stored");

    # ============================================================
    # Human override: Critical, requires_action, agent, body content
    # (rust: test_desktop_shell_human_override_request/_fields/_is_critical)
    # ============================================================
    test_group("shell — human override");
    var ov = shell_request_human_override(sh, "agent-a", "write /etc/passwd", "needs access", 300);
    assert(t_ok(ov), "override notif allocated");
    assert_eq(shell_notif_priority(ov), SH_NotifPriority.SH_PRIO_CRITICAL, "override is Critical");
    assert_eq(shell_notif_requires_action(ov), 1, "override requires_action");
    assert_eq(shell_notif_is_agent(ov), 1, "override is_agent_related");
    # title == "Human Override Requested"
    var ov_title = shell_notif_title(ov);
    var title_needle = str_from("Human Override Requested");
    var title_hay = str_from(ov_title);
    assert_eq(str_eq(title_hay, title_needle), 1, "override title matches");
    # body (a Str fat pointer) contains agent name + action + reason
    var ov_body = shell_notif_body(ov);
    assert_eq(str_contains(ov_body, str_from("agent-a")), 1, "override body has agent name");
    assert_eq(str_contains(ov_body, str_from("write /etc/passwd")), 1, "override body has action");
    assert_eq(str_contains(ov_body, str_from("needs access")), 1, "override body has reason");

    # ============================================================
    # Launcher search: match / empty / no-result / case-insensitive / boost
    # (rust: test_desktop_shell_search_launcher[_empty_query/_no_results/
    #  _case_insensitive/_partial_match/_by_description], boost logic in search_launcher)
    # ============================================================
    test_group("shell — launcher search");
    var r_term = shell_search_launcher(sh, "terminal");
    var n_term = vec_len(r_term);
    var term_found = (n_term > 0);
    assert_eq(term_found, 1, "search 'terminal' yields results");
    assert_eq(t_any_name_contains(r_term, "terminal"), 1, "a 'terminal' result's name contains 'terminal'");

    var r_part = shell_search_launcher(sh, "term");
    assert_eq(t_any_name_contains(r_part, "terminal"), 1, "partial 'term' finds Terminal");

    # every app item's description is "Launch <name>"; search-files' is not
    var r_desc = shell_search_launcher(sh, "Launch");
    assert_eq(vec_len(r_desc), 14, "search 'Launch' matches the 14 app descriptions");

    var r_empty = shell_search_launcher(sh, "");
    var n_empty = vec_len(r_empty);
    # empty query matches every launcher item (14 apps + search-files == 15)
    assert_eq(n_empty, 15, "empty query matches all 15 items");

    var r_none = shell_search_launcher(sh, "zzz_nonexistent_12345");
    assert_eq(vec_len(r_none), 0, "gibberish query yields no results");

    var r_lower = shell_search_launcher(sh, "terminal");
    var r_upper = shell_search_launcher(sh, "TERMINAL");
    assert_eq(vec_len(r_lower), vec_len(r_upper), "search is case-insensitive (equal counts)");

    # prefix boost: top result for "terminal" has boosted relevance 1000*3/2 == 1500,
    # and results are relevance-sorted descending so index 0 is the boosted match.
    # ⚠ vec_get dies on an empty vec, which would end the suite here unreported — the "yields
    # results" assert above already records that failure, so only index a non-empty result.
    var top = 0;
    if (n_term > 0) { top = vec_get(r_term, 0); }
    assert(t_ok(top), "top search result non-null");
    if (top != 0) {
        assert_eq(shell_item_relevance(top), 1500, "prefix match boosted to 1500 permille");
    }

    # boost applied to a CLONE — the live launcher item keeps base 1000.
    var live_items = shell_items(sh);
    var live0 = vec_get(live_items, 0);
    assert_eq(shell_item_relevance(live0), 1000, "live launcher item relevance unchanged (1000)");

    # ============================================================
    # Lock / unlock + panel toggle round trips
    # (rust: test_desktop_shell_lock_screen, test_desktop_shell_toggle_panel_round_trip)
    # ============================================================
    test_group("shell — lock + panel");
    shell_lock_screen(sh);
    assert_eq(shell_is_locked(sh), 1, "locked after lock_screen");
    shell_unlock_screen(sh);
    assert_eq(shell_is_locked(sh), 0, "unlocked after unlock_screen");

    var p1 = shell_toggle_panel(sh);
    assert_eq(p1, 0, "panel hidden after first toggle");
    var p2 = shell_toggle_panel(sh);
    assert_eq(p2, 1, "panel visible after second toggle");
    assert_eq(shell_panel_visible(sh), 1, "panel_visible reflects round trip");

    # ============================================================
    # System status update + agent count
    # (rust: test_desktop_shell_update_system_status_all_fields,
    #  test_desktop_shell_set_agent_count[_multiple_times],
    #  test_desktop_shell_system_status_battery_some)
    # ============================================================
    test_group("shell — system status");
    var newst = shell_status_new(999, 875, 552, 15, SH_NetStatus.SH_NET_ERROR, 42);
    assert(t_ok(newst), "new status allocated");
    shell_update_system_status(sh, newst);
    var cur = shell_get_system_status(sh);
    assert_eq(shell_status_cpu(cur), 999, "cpu updated");
    assert_eq(shell_status_mem(cur), 875, "memory 87.5 -> 875");
    assert_eq(shell_status_disk(cur), 552, "disk 55.2 -> 552");
    assert_eq(shell_status_battery(cur), 15, "battery updated to 15");
    assert_eq(shell_status_battery_is_none(cur), 0, "battery Some(15) not None");
    assert_eq(shell_status_net(cur), SH_NetStatus.SH_NET_ERROR, "net updated to Error");
    assert_eq(shell_status_agents(cur), 42, "agent_count updated to 42");

    shell_status_set_net(cur, SH_NetStatus.SH_NET_CONNECTING);
    assert_eq(shell_status_net(cur), SH_NetStatus.SH_NET_CONNECTING, "set_net writes the net field");
    shell_status_set_battery(cur, shell_battery_none());
    assert_eq(shell_status_battery_is_none(cur), 1, "set_battery(None) reads back as None");
    assert_eq(shell_status_agents(cur), 42, "  ...and neither setter touched agent_count");

    shell_set_agent_count(sh, 100);
    assert_eq(shell_status_agents(shell_get_system_status(sh)), 100, "set_agent_count 100");
    shell_set_agent_count(sh, 0);
    assert_eq(shell_status_agents(shell_get_system_status(sh)), 0, "set_agent_count back to 0");

    # ============================================================
    # Notification eviction at capacity
    # (rust: test_desktop_shell_notification_eviction)
    # A fresh shell; push MAX+1 (201) non-action notifs. Eviction of the
    # oldest non-action keeps the count capped at MAX (200).
    # ============================================================
    test_group("shell — notification eviction");
    var sh2 = shell_new();
    assert(t_ok(sh2), "second shell non-null");
    var i = 0;
    var cap = SH_Limits.SH_MAX_NOTIFICATIONS;
    var upper = cap + 1;
    while (i < upper) {
        var eid = shell_next_notif_id(sh2);
        # ascending timestamps so the oldest (smallest ts) is the eviction target
        var en = shell_notif_new(eid, "app", "Title", "", SH_NotifPriority.SH_PRIO_NORMAL, i, 0, 0);
        shell_show_notification(sh2, en);
        i = i + 1;
    }
    assert_eq(shell_notification_count(sh2), cap, "count capped at MAX_NOTIFICATIONS (200)");

    t_notification_records();
    t_launcher_records();
    t_many_notifications();
    t_eviction_prefers_non_action();
    t_eviction_takes_oldest_non_action();
    t_lock_round_trip();

    return assert_summary();
}

var ec = main();
syscall(60, ec);
