# aethersafha renderer test — alpha blend + damage tracking (pure logic).
# render.cyr is shell-free: this suite includes it WITHOUT shell.cyr (the shell
# status-panel renderer + its test live in tests/shell_render.tcyr).
# Stdlib + [deps.*] auto-included via cyrius.cyml.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme.cyr"        # ae_bhumi — render_window packs its colours through it
include "src/cursor.cyr"      # render_cursor draws this bitmap; cursor.tcyr owns the shape itself
include "src/render.cyr"
include "src/wallpaper.cyr"   # rend_band_compute reads wp_serial(); gpu frame plan reads wp_gpu_expressible()
# ⚠ The cursor lives in input.cyr (`input_ptr_x/y`) and render.cyr calls it — a forward function
# reference, legal in Cyrius and exactly what the real include chain does. The test must carry the
# same set or it fails to link on functions the production build resolves fine.
include "src/input.cyr"

# One frame for the ghost test, in render_desktop's exact order: damage, banded clear, draw, stamp.
fn t_gt_r(a, b): i64 {
    if (a > b) { return 1; }
    return 0;
}

# ⚠ Same shape and same reason as t_gt_r: the comparison is spelled as a statement so the suite does
# not depend on a comparison being usable as a VALUE. "differs from the sentinel" is the whole of what
# the chrome-route assertions need — the exact blended word is bhumi's business, not this test's.
fn t_ne_r(a, b): i64 {
    if (a == b) { return 0; }
    return 1;
}

fn t_layer_count_r(layer): i64 {
    var n = 0;
    var y = 0;
    while (y < cursor_h()) {
        var x = 0;
        while (x < cursor_w()) {
            if (cursor_layer_at(layer, x, y) == 1) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

# Render `win` focused on a GPU frame into fresh queues -> how many text runs it queued. The caption is the
# only text `render_window` draws, so run 0 IS the caption — and a caption that is not queued falls back to a
# CPU draw that a GPU frame never presents.
fn t_title_q_r(fb, win): i64 {
    ae_rect_reset();
    ae_text_reset();
    # ⚠ POISON SLOT 0 FIRST. A reset zeroes only the COUNT, so a caption that is NOT queued would read back
    # as whatever the previous call left in slot 0 — and two assertions passed against the unfixed renderer
    # on exactly that coincidence. A missing caption now reads as "~" at x = 0.
    ae_text_enqueue("~", 0, 0, 0);
    ae_text_reset();
    render_window(fb, win, 1);
    return ae_text_count();
}

# Cell `j` of queued run `i`. ⚠ A run is CELLS, two bytes each, decoded at enqueue — not the string's bytes.
fn t_run_cell_r(i, j): i64 { return load16(ae_text_run_ptr(i) + j * 2); }

# 1 when the first `n` cells of queued run `i` are the bytes of the ASCII string `s` — a printable ASCII
# byte IS its own cell (kashi ADR 0011), so for ASCII the cell and the byte are the same number.
fn t_run_prefix_r(i, s, n): i64 {
    var j = 0;
    while (j < n) {
        if (t_run_cell_r(i, j) != load8(s + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# The cells kashi draws U+2026 and U+FFFD with — named by codepoint, as kashi's ADR 0011 asks, never by number.
fn t_ell_cell_r(): i64 { return kashi_cp437_from_unicode(0x2026); }
fn t_repl_cell_r(): i64 { return kashi_cp437_from_unicode(0xFFFD); }

# 1 when queued run `i` ends in the ellipsis: its LAST cell is U+2026's — one cell, where the port used to
# spend three on ASCII dots.
fn t_run_ell_r(i): i64 {
    var n = ae_text_run_len(i);
    if (n < 1) { return 0; }
    if (t_run_cell_r(i, n - 1) != t_ell_cell_r()) { return 0; }
    return 1;
}

# The cells of an ASCII string (each byte its own cell) into `out`, two bytes each. -> how many.
fn t_ascii_cells_r(out, s): i64 {
    var j = 0;
    while (load8(s + j) != 0) {
        store16(out + j * 2, load8(s + j));
        j = j + 1;
    }
    return j;
}

# A title of `n` scalars into `tb`, NUL-terminated, cycling through eight kinds — one to four bytes, with a
# glyph and without, and an ill-formed byte — and its expected CELLS into `tc`. The cells come from the CP437
# chart and kashi's two named cells, not from the decoder under test. -> the title's length in bytes.
fn t_mb_title_r(tb, tc, n): i64 {
    var bi = 0;
    var u = 0;
    while (u < n) {
        var kind = u % 8;
        var us = "é";                               # U+00E9 -> CP437 0x82
        var cell = 0x82;
        if (kind == 1) { us = "A"; cell = 0x41; }
        if (kind == 2) { us = "─"; cell = 0xC4; }   # U+2500, three bytes
        if (kind == 3) { us = "中"; cell = 0; }     # U+4E2D: no built-in glyph, a BLANK cell that still advances
        if (kind == 4) { us = "😀"; cell = 0; }     # U+1F600, four bytes: likewise blank
        if (kind == 5) { us = "\xFF"; cell = t_repl_cell_r(); }   # ill-formed: U+FFFD's glyph
        if (kind == 6) { us = "ß"; cell = 0xE1; }   # U+00DF
        if (kind == 7) { us = "π"; cell = 0xE3; }   # U+03C0
        var ul = strlen(us);
        var uj = 0;
        while (uj < ul) {
            store8(tb + bi, load8(us + uj));
            bi = bi + 1;
            uj = uj + 1;
        }
        store16(tc + u * 2, cell);
        u = u + 1;
    }
    store8(tb + bi, 0);
    return bi;
}

# 1 when the 9 px cell at (x, y) is EXACTLY kashi's VGA 8x16 glyph for `cell` in colour `c`: `c` on every set
# bit, anything else on every clear one, and no `c` in the 1 px gap that ends the cell. Cell 0 = a blank cell.
fn t_cell_is_r(fb, x, y, cell, c): i64 {
    var row = 0;
    while (row < FONT_H) {
        var bits = kashi_glyph_row(KASHI_FONT_VGA_8X16, cell, row);
        var col = 0;
        while (col < FONT_ADV) {
            var want = 0;
            if (col < FONT_W) { if ((bits & (1 << (7 - col))) != 0) { want = 1; } }
            var got = 0;
            if (bhumi_fb_get(fb, x + col, y + row) == c) { got = 1; }
            if (got != want) { return 0; }
            col = col + 1;
        }
        row = row + 1;
    }
    return 1;
}

# 1 when cell `i` of a packed 1bpp run of `len` cells at `mask` is EXACTLY kashi_glyph_row's bits for `cell`,
# bit for bit, with its gap column clear.
fn t_mask_cell_is_r(mask, len, i, cell): i64 {
    var stride = ae_text_stride(len);
    var row = 0;
    while (row < FONT_H) {
        var bits = kashi_glyph_row(KASHI_FONT_VGA_8X16, cell, row);
        var col = 0;
        while (col < FONT_ADV) {
            var px = i * FONT_ADV + col;
            var got = 0;
            if ((load8(mask + row * stride + px / 8) & (1 << (7 - (px % 8)))) != 0) { got = 1; }
            var want = 0;
            if (col < FONT_W) { if ((bits & (1 << (7 - col))) != 0) { want = 1; } }
            if (got != want) { return 0; }
            col = col + 1;
        }
        row = row + 1;
    }
    return 1;
}

# Expand queued run `i` onto `fb` the way the kernel's op 0x03 does — `c` where a mask bit is set, the rest
# untouched. -> the run's width in pixels.
fn t_expand_run_r(fb, i, c): i64 {
    var len = ae_text_run_len(i);
    var mask = alloc(ae_text_bytes(len));
    var w = ae_text_pack_1bpp(mask, ae_text_run_ptr(i), len);
    var stride = ae_text_stride(len);
    var gy = 0;
    while (gy < FONT_H) {
        var gx = 0;
        while (gx < w) {
            if ((load8(mask + gy * stride + gx / 8) & (1 << (7 - (gx % 8)))) != 0) {
                bhumi_fb_set(fb, ae_text_run_x(i) + gx, ae_text_run_y(i) + gy, c);
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    return w;
}

# ⭐ THE TWO FRAME KINDS, ONE CAPTION. A CPU frame draws `win`'s caption; a GPU frame queues it, and the queue is
# expanded here exactly as the kernel would. Both start from the same blank framebuffer, so any pixel that
# differs is a cell the two paths disagree on. -> the differing pixels; *lit gets the CPU frame's ink count.
fn t_cap_cpu_gpu_diff_r(fbc, fbg, win, lit): i64 {
    var CAPC = 0x00F0E0D0;
    bhumi_fb_clear(fbc, 0);
    bhumi_fb_clear(fbg, 0);
    ae_gpu_frame_ok = 0;
    render_title(fbc, win, CAPC);
    ae_gpu_frame_ok = 1;
    ae_text_gpu_ok = 1;
    ae_text_reset();
    render_title(fbg, win, CAPC);
    var q = 0;
    while (q < ae_text_count()) {
        t_expand_run_r(fbg, q, CAPC);
        q = q + 1;
    }
    var diff = 0;
    var ink = 0;
    var yy = 0;
    while (yy < bhumi_fb_height(fbc)) {
        var xx = 0;
        while (xx < bhumi_fb_width(fbc)) {
            if (bhumi_fb_get(fbc, xx, yy) != bhumi_fb_get(fbg, xx, yy)) { diff = diff + 1; }
            if (bhumi_fb_get(fbc, xx, yy) == CAPC) { ink = ink + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    store64(lit, ink);
    return diff;
}

# Pixels of colour `c` in columns [x0, x1) of rows [y0, y1).
fn t_count_px_r(fb, x0, x1, y0, y1, c): i64 {
    var n = 0;
    var yy = y0;
    while (yy < y1) {
        var xx = x0;
        while (xx < x1) {
            if (bhumi_fb_get(fb, xx, yy) == c) { n = n + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return n;
}

# ⭐ THE ORACLE: the caption Rust's rule (renderer.rs:543-562) makes from an `n`-character title whose cells are
# at `tc`, on a window `w` px wide — written as cells to `out`, the count returned. Rust's own literal `w - 80`
# box and a FONT_ADV cell, then the port's one addition, ADR 0003's run limit, which cuts the same way.
# Written from Rust, not from `rend_title_caption`, so the sweep checks one against the other.
fn t_rust_cap_r(out, tc, n, w): i64 {
    var bw = w - 80;
    if (bw < 0) { bw = 0; }                         # saturating_sub
    var take = n;
    var ell = 0;
    if (n * FONT_ADV - 1 > bw) {                    # text_width(title) > max_title_width
        var mc = bw / FONT_ADV;                     # max_chars
        # title.chars().take(max_chars - 1), then '…'; at max_chars <= 2 Rust draws it whole
        if (mc > 2) { take = mc - 1; ell = 1; }
    }
    if (take + ell > AE_TEXT_CHARS) { take = AE_TEXT_CHARS - 1; ell = 1; }
    var j = 0;
    while (j < take) {
        store16(out + j * 2, load16(tc + j * 2));
        j = j + 1;
    }
    if (ell == 1) { store16(out + take * 2, t_ell_cell_r()); }
    return take + ell;
}

# 1 when the `len` cells of queued run `i` are cells [k, k + len) of the oracle's caption at `cap`.
fn t_run_is_cap_r(i, len, cap, k): i64 {
    var j = 0;
    while (j < len) {
        if (t_run_cell_r(i, j) != load16(cap + (k + j) * 2)) { return 0; }
        j = j + 1;
    }
    return 1;
}

fn ghost_frame(comp, fb, win, bg): i64 {
    rend_frame_damage(comp, fb, bg);
    if (rend_band_valid() == 1) {
        if (rend_band_h() > 0) { rend_clear_band(fb, rend_band_y(), rend_band_h(), bg); }
    }
    if (rend_band_valid() == 0) { bhumi_fb_clear(fb, bg); }
    render_window(fb, win, 1);
    win_stamp_prev(win);
    return 0;
}

# ================================================================================================================
# ⭐⭐ 0.17.4 — THE CPU BLEND AGAINST THE KERNEL'S, AND THE WINDOW BORDER
# ================================================================================================================
# THE ORACLES, none of them a call into the code under test:
#   · op 0x01 — `t_ref_px_r`, the kernel's own integer reference, copied verbatim (below).
#   · op 0x06 / op 0x02 — words and digests computed OUTSIDE this tree by an IEEE-f32 model of agnos's
#     blend_alpha.s and blend_cov.s: every v_mul_f32 a numpy float32 multiply, every v_fma_f32 the exact a·b + c
#     rounded once to f32 (that rounding checked against numpy's float32 multiply on all 65,792 products the
#     shaders form), v_cvt_pk_u8_f32 saturate-then-round-half-even. Constants: INV = 0x3B808081 (f32 1/255),
#     -INV = 0xBB808081. Recompute with those steps; the digest is Σ word·(i·K1 + K2) mod 2^64 over the words in
#     the order listed, K1 = 0x9E3779B97F4A7C15, K2 = 0x632BE59BD9B4E019. The same model of blend_rect.s equals
#     `t_ref_px_r` on all 2^24 of its inputs, and its blend_alpha.s at α = 255 equals blend_rect.s everywhere.

# ⭐ THE KERNEL'S INTEGER REFERENCE FOR `#92` op 0x01, VERBATIM from agnos kernel/core/gpu.cyr `blend_ref_px` — what
# the burned blend_rect.s is gated against (agnos tests/gpu/shaderexec.cyr gate 1). The kernel's code, not the port's.
fn t_ref_px_r(src, dst): i64 {
    var sa = (src >> 24) & 0xFF;
    var ia = 255 - sa;
    var out = 0;
    var b = 0;
    while (b < 4) {
        var sc = (src >> (b * 8)) & 0xFF;
        var dc = (dst >> (b * 8)) & 0xFF;
        var r = sc + ((dc * ia) * 2 + 255) / 510;
        if (r > 255) { r = 255; }
        out = out | (r << (b * 8));
        b = b + 1;
    }
    return out;
}

# One step of the fixture digest: h + word · (i·K1 + K2), wrapping mod 2^64 as the generator does.
fn t_dig_step_r(h, word, i): i64 { return h + word * (i * 0x9E3779B97F4A7C15 + 0x632BE59BD9B4E019); }

# The sweep surface: 256 x 256, row y has source alpha y, so every alpha meets every lane value. Pixel (0,0) is 0.
fn t_sweep_src_r(x, y): i64 {
    return (((y << 24) | (((x * 3 + y) & 0xFF) << 16)) | ((((x * 7) + (y * 2)) & 0xFF) << 8)) | (x & 0xFF);
}
# Three destination patterns over the same 256 x 256, every lane varying, the alpha byte included.
fn t_sweep_dst_r(x, y, p): i64 {
    var a = (x * 3 + y * 5 + p * 85) & 0xFF;
    var r = (x * 11 + p * 50) & 0xFF;
    var g = (y * 7 + x + p) & 0xFF;
    var b = (x * y + p * 99) & 0xFF;
    return (((a << 24) | (r << 16)) | (g << 8)) | b;
}
fn t_sweep_fill_r(fb, p): i64 {
    var y = 0;
    while (y < 256) {
        var x = 0;
        while (x < 256) { bhumi_fb_set(fb, x, y, t_sweep_dst_r(x, y, p)); x = x + 1; }
        y = y + 1;
    }
    return 0;
}

# The op 0x06 digest grid the generator walks: sa = 0..255, k = 0..255, i = sa·256 + k.
fn t_dig06_r(alpha): i64 {
    var h = 0;
    var i = 0;
    var sa = 0;
    while (sa < 256) {
        var k = 0;
        while (k < 256) {
            var sc0 = (k * 4 + sa) & 0xFF;
            var sc1 = (k * 7 + 3) & 0xFF;
            var sc2 = (k * 13 + sa * 3) & 0xFF;
            var d0 = (k * 5 + sa * 11) & 0xFF;
            var d1 = (k * 9 + 17) & 0xFF;
            var d2 = (255 - k * 3) & 0xFF;
            var d3 = (k * 29 + sa) & 0xFF;
            var src = (((sa << 24) | (sc2 << 16)) | (sc1 << 8)) | sc0;
            var dst = (((d3 << 24) | (d2 << 16)) | (d1 << 8)) | d0;
            h = t_dig_step_r(h, rend_blend_alpha_px(src, dst, alpha), i);
            i = i + 1;
            k = k + 1;
        }
        sa = sa + 1;
    }
    return h;
}

# The op 0x02 digest: a 64 x 64 framebuffer of varied words, filled whole by `fill_rect_a` on a CPU frame.
fn t_dig02_dst_r(x, y): i64 {
    var hi = (((x * 37 + y * 11) & 0xFF) << 24) | (((x * 4 + y) & 0xFF) << 16);
    return hi | ((((y * 4 + x) & 0xFF) << 8) | ((x * y + 7) & 0xFF));
}
fn t_dig02_r(color, a): i64 {
    var fb = bhumi_fb_new(64, 64);
    var y = 0;
    while (y < 64) {
        var x = 0;
        while (x < 64) { bhumi_fb_set(fb, x, y, t_dig02_dst_r(x, y)); x = x + 1; }
        y = y + 1;
    }
    fill_rect_a(fb, 0, 0, 64, 64, color, a);
    var h = 0;
    var yy = 0;
    while (yy < 64) {
        var xx = 0;
        while (xx < 64) { h = t_dig_step_r(h, bhumi_fb_get(fb, xx, yy), yy * 64 + xx); xx = xx + 1; }
        yy = yy + 1;
    }
    return h;
}

# Pixels of `fb` in [x0,x1) x [y0,y1) that are NOT `c`.
fn t_count_not_r(fb, x0, x1, y0, y1, c): i64 {
    var n = 0;
    var yy = y0;
    while (yy < y1) {
        var xx = x0;
        while (xx < x1) {
            if (bhumi_fb_get(fb, xx, yy) != c) { n = n + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return n;
}

# ---- op 0x01 -----------------------------------------------------------------------------------------------------
fn t_grp_op01_r(): i64 {
    test_group("render — #92 op 0x01 on the CPU: renderer.rs blend tests, re-expressed premultiplied");
    # Rust's test_blend_semi_transparent fed blend() a STRAIGHT red (a 128, r 255). The rule is premultiplied
    # (c <= a), so the same half-transparent red is (128, 128, 0, 0), and the kernel's arithmetic makes it exact:
    # r = 128 + round(0), b = 0 + round(255·127/255) = 127, a = 128 + round(255·127/255) = 255.
    var sm = rend_px_premul(0x80800000, 0xFF0000FF);
    assert_eq(sm, 0xFF80007F, "50% premultiplied red over opaque blue is 0xFF80007F");
    assert_eq(sm >> 24, 255, "  a == 255 (Rust's assertion)");
    assert_eq(t_gt_r(sm & 0xFF, 0), 1, "  b > 0 — the blue shows through (Rust's)");
    assert_eq(t_gt_r(255, sm & 0xFF), 1, "  b < 255 (Rust's)");
    assert_eq((sm >> 16) & 0xFF, 128, "  r is the source's own premultiplied 128 (Rust's `r > 128` held for straight red)");
    # Rust's own straight input through the kernel's rule: the channel saturates, as Rust's `.min(255)` did.
    assert_eq(rend_px_premul(0x80FF0000, 0xFF0000FF), 0xFFFF007F, "Rust's straight-red input: r saturates at 255, b 127, a 255");
    assert_eq(rend_px_premul(0xFFFFFFFF, 0xFF000000), 0xFFFFFFFF, "test_blend_opaque_over: opaque white over black is white");
    assert_eq(rend_px_premul(0, 0xFF000000), 0xFF000000, "test_blend_transparent_over: transparent over black is black");
    # ⚠ WHERE THE KERNEL AND RUST PART (ADR 0003): Rust truncated d·(255 − sa)/255 and returned dst for any
    # zero-alpha source; the kernel rounds to nearest and ADDS a zero-alpha source's colour.
    assert_eq(rend_px_premul(0x01010101, 0x01010101), 0x02020202, "1 + round(1·254/255) = 2 — Rust truncated it to 1");
    assert_eq(rend_px_premul(0x00102030, 0x00405060), 0x00507090, "a zero-alpha source with colour ADDS — Rust returned dst");

    # ⭐ THE SWEEP, THROUGH THE REAL CPU PATH: a premultiplied surface at full opacity, every source alpha against
    # every lane value, over three destinations — each pixel against the kernel's reference.
    ae_gpu_frame_ok = 0;
    var src = alloc(256 * 256 * 4);
    var y = 0;
    while (y < 256) {
        var x = 0;
        while (x < 256) { store32(src + (y * 256 + x) * 4, t_sweep_src_r(x, y)); x = x + 1; }
        y = y + 1;
    }
    var fb = bhumi_fb_new(256, 256);
    var bad = 0;
    var blended = 0;
    var p = 0;
    while (p < 3) {
        t_sweep_fill_r(fb, p);
        rend_composite_surface(fb, 0, 0, src, 256, 256, 1, 255);
        var yy = 0;
        while (yy < 256) {
            var xx = 0;
            while (xx < 256) {
                var want = t_ref_px_r(t_sweep_src_r(xx, yy), t_sweep_dst_r(xx, yy, p));
                if (bhumi_fb_get(fb, xx, yy) != want) { bad = bad + 1; }
                if (want != t_sweep_src_r(xx, yy)) { blended = blended + 1; }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        p = p + 1;
    }
    assert_eq(bad, 0, "op 0x01 over 196,608 pixels: every word is the kernel's blend_ref_px");
    assert_eq(t_gt_r(blended, 150000), 1, "  (and most of them really blended — not a copy compared with a copy)");
    # The copy shortcut is EXACT: an alpha-255 pixel is the op's result, row 255 untouched by the destination.
    t_sweep_fill_r(fb, 1);
    rend_composite_surface(fb, 0, 0, src, 256, 256, 1, 255);
    assert_eq(bhumi_fb_get(fb, 77, 255), t_sweep_src_r(77, 255), "an alpha-255 source pixel lands as its own word");
    assert_eq(bhumi_fb_get(fb, 0, 0), t_sweep_dst_r(0, 0, 1), "  and a zero source pixel leaves the destination word");
    return 0;
}

# ---- op 0x06 -----------------------------------------------------------------------------------------------------
fn t_grp_op06_r(): i64 {
    test_group("render — #92 op 0x06 on the CPU: window opacity scales the premultiplied source (blend_alpha.s)");
    # Words from the IEEE-f32 model (see the banner above), one per shape that matters.
    assert_eq(rend_blend_alpha_px(0xFF336699, 0x00101018, 128), 0x80223B59, "an opaque pixel at α 128 over a dark backdrop");
    assert_eq(rend_blend_alpha_px(0x80402010, 0x00808080, 128), 0x40807068, "a half-transparent pixel at α 128: they MULTIPLY");
    assert_eq(rend_blend_alpha_px(0xFFFFFFFF, 0x00000000, 1), 0x01010101, "α 1: white over black is 1 in every byte");
    assert_eq(rend_blend_alpha_px(0xFF000000, 0xFFFFFFFF, 254), 0xFF010101, "α 254: black over white keeps 1/255 of it");
    assert_eq(rend_blend_alpha_px(0x00405060, 0x00101010, 200), 0x00424F5B,
      "a zero-alpha source with colour ADDS under op 0x06 too — the ghost of a client that writes alpha 0");
    assert_eq(rend_blend_alpha_px(0x7F7F7F7F, 0x12345678, 37), 0x23436282, "α 37 over a mixed word");
    assert_eq(rend_blend_alpha_px(0xFFE7E9EF, 0x0014161B, 64), 0x40494B50, "ink over a panel at α 64");
    # ⛔⛔ THE ROUNDING TIE — the one input class the kernel's own interpreter pins (agnos tests/gpu/shaderexec.cyr
    # gate 4): α 4, sa = sc = 64, d = 128 makes R(d·ia + sc') exactly 128.5. Round-half-even gives 128, half-away
    # 129. The shader declares round-to-nearest-EVEN and no burn has discriminated it; this asserts that choice.
    var tie = rend_blend_alpha_px(0x40000040, 0x00000080, 4);
    assert_eq(tie & 0xFF, 128, "the tie at 128.5 rounds to EVEN (128), the kernel's declared mode — half-away is 129");
    assert_eq(tie, 0x01000080, "  the whole word, alpha lane R(64·4/255) = 1 included");
    # ⛔ THE f32 ROUNDINGS INSIDE THE SHADER TIE TO EVEN TOO — IEEE's default and the shaders' round mode 0, a rule
    # apart from the conversion's. These are among the few lane inputs where it shows (one in all 2^24 at α 1): a
    # v_mul_f32 or v_fma_f32 result exactly halfway between two f32s. Rounded away, each comes out one step off,
    # and the model's half-away variant says so too.
    assert_eq(rend_blend_alpha_px(0xFE0000FF, 0x00000080, 1), 0x01000080, "an FMA tie at α 1 rounds to even: 128, not 129");
    assert_eq(rend_blend_alpha_px(0xFE0000FF, 0x00000001, 128), 0x7F000080, "  at α 128: 128, not 129");
    assert_eq(rend_blend_alpha_px(0x10000050, 0x000000D9, 121), 0x080000F8, "  a multiply tie at α 121: 248, not 249");
    assert_eq(rend_blend_alpha_px(0x7A0000C0, 0x00000089, 122), 0x3A0000C5, "  at α 122: 197, not 198");
    assert_eq(rend_blend_alpha_px(0x340000A2, 0x00000083, 131), 0x1B0000C9, "  at α 131: 201, where half-away gives 200");
    # The kernel's two settled identities: α 0 leaves dst; α 255 IS op 0x01 (blend_alpha.s's header, measured).
    # ⚠ One alpha per pass: the per-alpha tables are rebuilt whenever the alpha changes.
    var i0 = 0;
    var i255 = 0;
    var pass = 0;
    while (pass < 2) {
        var y = 0;
        while (y < 256) {
            var x = 0;
            while (x < 256) {
                var s = t_sweep_src_r(x, y);
                var d = t_sweep_dst_r(x, y, 2);
                if (pass == 0) { if (rend_blend_alpha_px(s, d, 0) != d) { i0 = i0 + 1; } }
                if (pass == 1) { if (rend_blend_alpha_px(s, d, 255) != t_ref_px_r(s, d)) { i255 = i255 + 1; } }
                x = x + 1;
            }
            y = y + 1;
        }
        pass = pass + 1;
    }
    assert_eq(i0, 0, "α 0 leaves every destination word as it was (65,536 pixels)");
    assert_eq(i255, 0, "α 255 equals op 0x01 — the kernel's blend_ref_px — on every one of them");
    # ⭐ DIGESTS: 65,536 words per alpha, against the model. One wrong byte anywhere moves the sum.
    assert_eq(t_dig06_r(1), 0 - 6314396923382171578, "α 1: the digest of 65,536 words is the model's");
    assert_eq(t_dig06_r(2), 0 - 7394524270973916816, "α 2");
    assert_eq(t_dig06_r(4), 2569789153945065882, "α 4 (the tie's alpha)");
    assert_eq(t_dig06_r(37), 7965779066389050477, "α 37");
    assert_eq(t_dig06_r(64), 0 - 6794005979040855471, "α 64");
    assert_eq(t_dig06_r(127), 1129992058937937491, "α 127");
    assert_eq(t_dig06_r(128), 0 - 8811415284055575061, "α 128 (--opacity 128)");
    assert_eq(t_dig06_r(129), 0 - 6667560609821055543, "α 129");
    assert_eq(t_dig06_r(200), 0 - 5054729323977126896, "α 200");
    assert_eq(t_dig06_r(253), 0 - 5220541295822012559, "α 253");
    assert_eq(t_dig06_r(254), 0 - 5968361366421700941, "α 254");
    # The real CPU path at α 128: alpha-255 pixels go through the opaque-source table, the rest per pixel; both
    # must be the per-pixel op.
    ae_gpu_frame_ok = 0;
    var src = alloc(256 * 256 * 4);
    var sy = 0;
    while (sy < 256) {
        var sx = 0;
        while (sx < 256) { store32(src + (sy * 256 + sx) * 4, t_sweep_src_r(sx, sy)); sx = sx + 1; }
        sy = sy + 1;
    }
    var fb = bhumi_fb_new(256, 256);
    t_sweep_fill_r(fb, 0);
    rend_composite_surface(fb, 0, 0, src, 256, 256, 1, 128);
    var bad = 0;
    var cy = 0;
    while (cy < 256) {
        var cx = 0;
        while (cx < 256) {
            if (bhumi_fb_get(fb, cx, cy) != rend_blend_alpha_px(t_sweep_src_r(cx, cy), t_sweep_dst_r(cx, cy, 0), 128)) {
                bad = bad + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    assert_eq(bad, 0, "a premultiplied surface at α 128 through the CPU path is op 0x06, every pixel (the table rows too)");
    return 0;
}

# ---- op 0x02 -----------------------------------------------------------------------------------------------------
fn t_grp_op02_r(): i64 {
    test_group("render — #92 op 0x02 on the CPU: alpha chrome is the kernel's coverage blend (blend_cov.s)");
    ae_gpu_frame_ok = 0;
    # A translucent window's body and its border over a dark backdrop, words from the model.
    assert_eq(rend_blend(0x00101018, 0x1B1E24, 128), 0x8016171E, "the widget colour at α 128 over a dark backdrop");
    assert_eq(rend_blend(0x00101018, 0x262A32, 128), 0x801B1D25, "the border's line colour at α 128 over it");
    # ⭐ DIGESTS of `fill_rect_a` itself on a CPU frame — 4,096 varied words per case, against the model.
    assert_eq(t_dig02_r(0x1B1E24, 128), 7008102241270972494, "fill_rect_a: widget at α 128, the digest of 4,096 words is the model's");
    assert_eq(t_dig02_r(0xFF4D4D, 37), 0 - 2527459864991937397, "  alert at α 37");
    assert_eq(t_dig02_r(0x00E5FF, 200), 7851221452573619598, "  accent at α 200");
    assert_eq(t_dig02_r(0x262A32, 1), 0 - 7528157692685003378, "  line at α 1");
    assert_eq(t_dig02_r(0xFBF8F0, 254), 0 - 7251279300320264126, "  a light widget at α 254");
    # The rect walk reads the colour's rows of a table; the per-pixel op computes. Every destination byte, every lane.
    var fb = bhumi_fb_new(256, 4);
    var bad = 0;
    var ai = 0;
    while (ai < 4) {
        var a = 1;
        if (ai == 1) { a = 77; }
        if (ai == 2) { a = 128; }
        if (ai == 3) { a = 254; }
        var ci = 0;
        while (ci < 3) {
            var c = 0x1B1E24;
            if (ci == 1) { c = 0xFFFFFF; }
            if (ci == 2) { c = 0x000000; }
            var y = 0;
            while (y < 4) {
                var x = 0;
                while (x < 256) {
                    bhumi_fb_set(fb, x, y, ((((x + 3 * y) & 0xFF) << 24) | (((x * 5 + y) & 0xFF) << 16)) | ((255 - x) << 8) | x);
                    x = x + 1;
                }
                y = y + 1;
            }
            fill_rect_a(fb, 0, 0, 256, 4, c, a);
            var yy = 0;
            while (yy < 4) {
                var xx = 0;
                while (xx < 256) {
                    var d = ((((xx + 3 * yy) & 0xFF) << 24) | (((xx * 5 + yy) & 0xFF) << 16)) | ((255 - xx) << 8) | xx;
                    if (bhumi_fb_get(fb, xx, yy) != rend_blend(d, c, a)) { bad = bad + 1; }
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            ci = ci + 1;
        }
        ai = ai + 1;
    }
    assert_eq(bad, 0, "fill_rect_a's table walk equals the per-pixel op for every byte of every lane (12,288 words)");
    return 0;
}

# A w x h surface whose word at (x, y) is (y·9) & 0xFF in the alpha byte — so rows run from transparent to opaque —
# over varied colour bytes. `opaque` forces the alpha byte to 255.
fn t_op_surface_r(w, h, opaque): i64 {
    var px = alloc(w * h * 4);
    var y = 0;
    while (y < h) {
        var x = 0;
        while (x < w) {
            var a = (y * 9) & 0xFF;
            if (opaque == 1) { a = 255; }
            store32(px + (y * w + x) * 4, (((a << 24) | (((x * 3) & 0xFF) << 16)) | (((x + y) & 0xFF) << 8)) | ((x * y) & 0x7F));
            x = x + 1;
        }
        y = y + 1;
    }
    return px;
}

# Body pixels of `win` (its content rect) whose word on `fb` is not `want(src, under)` for the routing `mode`:
#   0 = a copy of the client's word · 1 = op 0x01 over `under` · 2 = op 0x06 at `a` over `under` · 3 = `under` itself
fn t_body_bad_r(fb, win, px, under, mode, a): i64 {
    var bad = 0;
    var y = 0;
    while (y < win_h(win)) {
        var x = 0;
        while (x < win_w(win)) {
            var s = load32(px + (y * win_w(win) + x) * 4);
            var want = s;
            if (mode == 1) { want = t_ref_px_r(s, under); }
            if (mode == 2) { want = rend_blend_alpha_px(s, under, a); }
            if (mode == 3) { want = under; }
            if (bhumi_fb_get(fb, win_x(win) + x, win_body_y(win) + y) != want) { bad = bad + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return bad;
}

# ---- what a CPU frame composites ---------------------------------------------------------------------------------
fn t_grp_opacity_r(): i64 {
    test_group("render — a CPU frame routes surfaces as gpu.cyr does: premultiplied blend, others copy");
    ae_gpu_frame_ok = 0;
    var OBG = 0x00101018;
    var widget = ae_bhumi(rupa_theme_widget(rupa_theme_active()));
    var fb = bhumi_fb_new(200, 200);
    var win = win_new(41, 20, 20, 64, 48, "op");
    var px = t_op_surface_r(64, 48, 0);
    win_set_pix(win, px);
    # 1. premultiplied at full opacity: op 0x01 over the opaque body — the kernel's reference, every pixel.
    win_set_premul(win, 1);
    win_set_opacity(win, 255);
    bhumi_fb_clear(fb, OBG);
    render_window(fb, win, 0);
    assert_eq(t_body_bad_r(fb, win, px, widget, 1, 255), 0, "premultiplied, opacity 255: op 0x01 over the body (3,072 px)");
    # 2. premultiplied at α 128: the body is the widget at 128 over the backdrop, and op 0x06 at 128 goes over THAT.
    win_set_opacity(win, 128);
    bhumi_fb_clear(fb, OBG);
    render_window(fb, win, 0);
    assert_eq(t_body_bad_r(fb, win, px, rend_blend(OBG, widget, 128), 2, 128), 0,
      "premultiplied, opacity 128: op 0x06 at 128 over the translucent body — window and client alpha multiply");
    assert_eq(t_gt_r(t_body_bad_r(fb, win, px, widget, 1, 255), 1000), 1, "  (and that is NOT what opacity 255 drew)");
    # ⛔ THE FRAME AFTER COSTS NO HEAP. The per-alpha tables are module scope and the 64 KB opaque-source table is
    # allocated once; the allocator never frees, so anything per frame would grow for the life of the desktop.
    var heap0 = alloc_used();
    render_window(fb, win, 0);
    render_window(fb, win, 1);
    assert_eq(alloc_used() - heap0, 0, "  and translucent frames after the first allocate 0 B");
    # 3. NOT premultiplied: copied as `#87` copies, whatever the opacity — the word, alpha byte and all.
    win_set_premul(win, 0);
    bhumi_fb_clear(fb, OBG);
    render_window(fb, win, 0);
    assert_eq(t_body_bad_r(fb, win, px, 0, 0, 128), 0, "not premultiplied, opacity 128: the client's words, copied");
    # 4. opacity 0: a premultiplied window leaves the backdrop — its chrome at 0 draws nothing, op 0x06 at 0 neither.
    win_set_premul(win, 1);
    win_set_opacity(win, 0);
    bhumi_fb_clear(fb, OBG);
    render_window(fb, win, 0);
    assert_eq(t_body_bad_r(fb, win, px, OBG, 3, 0), 0, "premultiplied, opacity 0: the body is the backdrop");
    # ...while a non-premultiplied one still shows its words — `#87` has no alpha to apply.
    win_set_premul(win, 0);
    bhumi_fb_clear(fb, OBG);
    render_window(fb, win, 0);
    assert_eq(t_body_bad_r(fb, win, px, 0, 0, 0), 0, "not premultiplied, opacity 0: still the client's words, as on iron");
    win_set_opacity(win, 255);
    return 0;
}

# ---- the framebuffer ---------------------------------------------------------------------------------------------
fn t_grp_fb_r(): i64 {
    test_group("render — the framebuffer: renderer.rs test_framebuffer_new / _out_of_bounds, on bhumi's");
    var BLK = 0x00000000;
    var WHT = 0x00FFFFFF;
    var fb = bhumi_fb_new(100, 50);
    assert_eq(t_ne_r(fb, 0), 1, "new(100, 50) makes a framebuffer");
    assert_eq(bhumi_fb_width(fb), 100, "  width 100");
    assert_eq(bhumi_fb_height(fb), 50, "  height 50");
    assert_eq(bhumi_fb_size(fb), 5000 * 4, "  5000 pixels of 4 bytes (Rust: pixels.len() == 5000)");
    bhumi_fb_clear(fb, 0x00123456);
    assert_eq(bhumi_fb_get(fb, 0, 0), 0x00123456, "  filled, (0,0) reads the fill (Rust: new's fill colour)");
    # Rust returned None where width·height overflowed; bhumi refuses an impossible size outright.
    assert_eq(bhumi_fb_new(0, 50), 0, "a zero width is refused");
    assert_eq(bhumi_fb_new(100, 0 - 1), 0, "a negative height is refused");
    var ob = bhumi_fb_new(10, 10);
    bhumi_fb_clear(ob, BLK);
    assert_eq(bhumi_fb_get(ob, 10, 10), 0 - 1, "get(10, 10) on 10x10 is out of bounds: -1 (Rust: None)");
    assert_eq(bhumi_fb_get(ob, 0 - 1, 0), 0 - 1, "  and so is a negative x");
    assert_eq(bhumi_fb_set(ob, 10, 10, WHT), 0 - 1, "set(10, 10) is refused, not wrapped (Rust: no panic, no write)");
    assert_eq(t_count_not_r(ob, 0, 10, 0, 10, BLK), 0, "  ...and wrote nothing anywhere");
    return 0;
}

# ---- draw_rect_outline -------------------------------------------------------------------------------------------
fn t_grp_outline_r(): i64 {
    test_group("render — draw_rect_outline (renderer.rs test_framebuffer_draw_rect_outline)");
    ae_gpu_frame_ok = 0;
    var BLK = 0x00000000;
    var WHT = 0x00FFFFFF;
    var fb = bhumi_fb_new(100, 100);
    bhumi_fb_clear(fb, BLK);
    draw_rect_outline(fb, 10, 10, 20, 20, WHT);
    assert_eq(bhumi_fb_get(fb, 10, 10), WHT, "top-left corner (Rust's)");
    assert_eq(bhumi_fb_get(fb, 15, 10), WHT, "top edge (Rust's)");
    assert_eq(bhumi_fb_get(fb, 15, 15), BLK, "interior (Rust's)");
    assert_eq(bhumi_fb_get(fb, 29, 29), WHT, "bottom-right corner, the last pixel of the rect");
    assert_eq(bhumi_fb_get(fb, 10, 22), WHT, "left edge");
    assert_eq(bhumi_fb_get(fb, 29, 12), WHT, "right edge");
    assert_eq(bhumi_fb_get(fb, 21, 29), WHT, "bottom edge");
    assert_eq(bhumi_fb_get(fb, 28, 28), BLK, "the interior's last pixel");
    assert_eq(bhumi_fb_get(fb, 30, 30), BLK, "one past the rect");
    assert_eq(bhumi_fb_get(fb, 9, 9), BLK, "one before it");
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, WHT), 76, "exactly the 76 perimeter pixels of a 20x20 rect");
    # ⚠ THE PORT'S EDGE RULE (ADR 0003): an off-screen side is DROPPED. Rust clamped it onto the edge — `x0 =
    # rect.x.max(0)`, then the left side drawn at x0 — so this rect would have a line at x = 0.
    bhumi_fb_clear(fb, BLK);
    draw_rect_outline(fb, 0 - 5, 10, 20, 20, WHT);
    assert_eq(bhumi_fb_get(fb, 0, 15), BLK, "a side left of x = 0 is dropped, not drawn at x = 0 (Rust drew it there)");
    assert_eq(bhumi_fb_get(fb, 0, 10), WHT, "  the top row survives from x = 0");
    assert_eq(bhumi_fb_get(fb, 14, 15), WHT, "  and the right side is where it was");
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, WHT), 48, "  48 pixels: 15 top, 15 bottom, 18 right");
    # A translucent ring is four DISJOINT rects: a corner is blended once, exactly like an edge pixel.
    bhumi_fb_clear(fb, 0x00204060);
    rend_outline(fb, 10, 10, 20, 20, 1, WHT, 128);
    var once = rend_blend(0x00204060, WHT, 128);
    assert_eq(bhumi_fb_get(fb, 15, 10), once, "a translucent edge pixel is blended once");
    assert_eq(bhumi_fb_get(fb, 10, 10), once, "  and so is a corner — two overlapping sides would blend it twice");
    assert_eq(bhumi_fb_get(fb, 29, 29), once, "  every corner");
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, once), 76, "  all 76, and nothing else");
    # Degenerate rects, as Rust's x0 == x1 / y0 == y1 cases: all ring.
    bhumi_fb_clear(fb, BLK);
    draw_rect_outline(fb, 50, 50, 2, 5, WHT);
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, WHT), 10, "a 2-wide rect is all outline (10 px)");
    bhumi_fb_clear(fb, BLK);
    draw_rect_outline(fb, 50, 50, 1, 1, WHT);
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, WHT), 1, "a 1x1 rect is one pixel");
    draw_rect_outline(fb, 60, 60, 0, 5, WHT);
    assert_eq(t_count_px_r(fb, 0, 100, 0, 100, WHT), 1, "a zero-width rect draws nothing");
    return 0;
}

# ---- the window border -------------------------------------------------------------------------------------------
fn t_grp_border_r(): i64 {
    test_group("render — the window border: Rust's one colour, outside the rect, at the window's opacity");
    ae_gpu_frame_ok = 0;
    var th = rupa_theme_active();
    var LINE = ae_bhumi(rupa_theme_line(th));
    var BBG = 0x00090A0B;
    var SENT = 0x00C0FFEE;
    var fb = bhumi_fb_new(300, 300);
    var win = win_new(42, 50, 60, 120, 80, "border");
    var px = alloc(120 * 80 * 4);
    var i = 0;
    while (i < 120 * 80) { store32(px + i * 4, SENT); i = i + 1; }
    win_set_pix(win, px);
    bhumi_fb_clear(fb, BBG);
    render_window(fb, win, 1);
    # The ring is one pixel OUTSIDE the rect: x 49 and 170, y 59 and 60 + 30 + 80 = 170.
    assert_eq(bhumi_fb_get(fb, 49, 59), LINE, "the ring's top-left corner is at (x - 1, y - 1)");
    assert_eq(bhumi_fb_get(fb, 110, 59), LINE, "  its top runs above the titlebar");
    assert_eq(bhumi_fb_get(fb, 49, 120), LINE, "  its left side beside the content");
    assert_eq(bhumi_fb_get(fb, 170, 75), LINE, "  its right side at x + w, beside the titlebar");
    assert_eq(bhumi_fb_get(fb, 110, 170), LINE, "  its bottom at the window's exclusive bottom edge");
    assert_eq(bhumi_fb_get(fb, 170, 170), LINE, "  bottom-right corner");
    assert_eq(t_count_px_r(fb, 0, 300, 0, 300, LINE), 2 * 122 + 2 * 112 - 4, "exactly the 464 ring pixels, nothing else");
    assert_eq(bhumi_fb_get(fb, 48, 120), BBG, "  one further out is the backdrop");
    # ⭐ NOTHING INSIDE MOVED: the titlebar still starts at the window origin, and the client's own edge pixels
    # are the client's — `scripts/qemu-linux-input.sh` reads focus_client's 6 px border from exactly those.
    assert_eq(bhumi_fb_get(fb, 50, 60), ae_bhumi(rupa_theme_widget(th)), "the titlebar's first pixel is still at (x, y)");
    assert_eq(bhumi_fb_get(fb, 50, 90), SENT, "the client's top-left word is untouched");
    assert_eq(bhumi_fb_get(fb, 169, 90), SENT, "  its top-right");
    assert_eq(bhumi_fb_get(fb, 50, 169), SENT, "  its bottom-left");
    assert_eq(bhumi_fb_get(fb, 169, 169), SENT, "  its bottom-right");
    assert_eq(t_count_not_r(fb, 50, 170, 90, 170, SENT), 0, "  and every one of its 9,600 words");
    # Rust: one colour, focused or not (COLOR_BORDER; only the titlebar follows focus).
    bhumi_fb_clear(fb, BBG);
    render_window(fb, win, 0);
    assert_eq(t_count_px_r(fb, 0, 300, 0, 300, LINE), 464, "an unfocused window has the same ring, in the same colour");
    # At the window's opacity, like the rest of its chrome.
    win_set_opacity(win, 128);
    bhumi_fb_clear(fb, BBG);
    render_window(fb, win, 0);
    assert_eq(bhumi_fb_get(fb, 49, 59), rend_blend(BBG, LINE, 128), "at opacity 128 the ring is the line colour blended once");
    assert_eq(bhumi_fb_get(fb, 110, 170), rend_blend(BBG, LINE, 128), "  every side of it");
    win_set_opacity(win, 255);
    # Past the left edge the off-screen side is dropped, not drawn over the content at x = 0 (ADR 0003).
    win_move(win, 0 - 10, 60);
    bhumi_fb_clear(fb, BBG);
    render_window(fb, win, 0);
    assert_eq(bhumi_fb_get(fb, 0, 120), SENT, "a window past the left edge keeps its content at x = 0 — no ring there");
    assert_eq(bhumi_fb_get(fb, 0, 59), LINE, "  while the top side runs on from x = 0");
    # A maximized window's ring is wholly off screen: the work area is the window.
    win_move(win, 0, 0);
    win_resize(win, 300, 300 - TITLEBAR_H);
    win_set_pix(win, 0);
    bhumi_fb_clear(fb, BBG);
    render_window(fb, win, 0);
    assert_eq(t_count_px_r(fb, 0, 300, 0, 300, LINE), 0, "a window filling the screen shows no ring");
    # On a GPU frame the ring is four queued rects in the line colour, at the window's alpha.
    win_move(win, 50, 60);
    win_resize(win, 120, 80);
    win_set_opacity(win, 200);
    ae_gpu_frame_ok = 1; ae_text_gpu_ok = 1; ae_cursor_gpu_ok = 1; ae_chrome_gpu_ok = 1; ae_gpu_alpha_chrome = 0;
    ae_rect_reset();
    ae_text_reset();
    render_window(fb, win, 0);
    var nr = 0;
    var area = 0;
    var q = 0;
    while (q < ae_rect_count()) {
        if (ae_rect_get_col(q) == LINE) {
            nr = nr + 1;
            area = area + ae_rect_get_w(q) * ae_rect_get_h(q);
            if (ae_rect_get_a(q) != 200) { area = area - 100000; }
        }
        q = q + 1;
    }
    assert_eq(nr, 4, "a GPU frame queues the ring as 4 rects");
    assert_eq(area, 464, "  covering the 464 ring pixels once each, at the window's alpha");
    ae_gpu_frame_ok = 0;
    ae_rect_reset();
    ae_text_reset();
    win_set_opacity(win, 255);
    return 0;
}

# ---- overlap and z-order -----------------------------------------------------------------------------------------
fn t_grp_overlap_r(): i64 {
    test_group("render — overlapping_surfaces and z_order (renderer.rs SceneGraph tests, on the window vector)");
    # ADR 0003: the scene's order is the window vector's, bottom to top, raised on focus — Rust's Layer sort is gone.
    ae_gpu_frame_ok = 0;
    var LINE = ae_bhumi(rupa_theme_line(rupa_theme_active()));
    var SA = 0x00AA1111;
    var SB = 0x0022BB22;
    var c = comp_new();
    var wa = comp_create_window(c, 0, 0, 100, 100, "Back");
    var wb = comp_create_window(c, 50, 50, 100, 100, "Front");
    var pa = alloc(100 * 100 * 4);
    var pb = alloc(100 * 100 * 4);
    var i = 0;
    while (i < 10000) { store32(pa + i * 4, SA); store32(pb + i * 4, SB); i = i + 1; }
    win_set_pix(wa, pa);
    win_set_pix(wb, pb);
    # Rust's test_scene_graph_overlapping_surfaces: the overlap hits the topmost, the rest the one below.
    assert_eq(comp_window_at(c, 75, 100), wb, "the overlap hits the topmost window (Rust: surface_at(75, 75) == id2)");
    assert_eq(comp_window_at(c, 10, 40), wa, "outside the overlap, the window below (Rust: surface_at(10, 10) == id1)");
    var fb = bhumi_fb_new(200, 200);
    var k = 0;
    while (k < 2) {
        bhumi_fb_clear(fb, 0x00050505);
        var v = comp_windows(c);
        var j = 0;
        while (j < vec_len(v)) {
            var f = 0;
            if (j == comp_focused(c)) { f = 1; }
            render_window(fb, vec_get(v, j), f);
            j = j + 1;
        }
        if (k == 0) {
            assert_eq(bhumi_fb_get(fb, 75, 100), SB, "painted bottom to top, the overlap shows the upper window's content");
            assert_eq(bhumi_fb_get(fb, 10, 40), SA, "  and the lower window shows where it is alone");
            assert_eq(bhumi_fb_get(fb, 49, 100), LINE, "  the upper window's BORDER is drawn over the lower one's content");
            # Rust's test_scene_graph_z_order: a later layer is drawn later. Here focus raises: focus the lower one.
            comp_focus(c, comp_find_by_id(c, win_id(wa)));
        }
        if (k == 1) {
            assert_eq(bhumi_fb_get(fb, 75, 100), SA, "after focusing it, the lower window is on top in the overlap");
            assert_eq(comp_window_at(c, 75, 100), wa, "  and hit-testing agrees with what is drawn");
            assert_eq(bhumi_fb_get(fb, 100, 100), LINE, "  its border now crosses the other window's content");
        }
        k = k + 1;
    }
    return 0;
}

# ---- a minimized window ------------------------------------------------------------------------------------------
fn t_grp_minimized_r(): i64 {
    test_group("render — a minimized window is not drawn (renderer.rs test_scene_graph_hidden_surface)");
    var MBG = 0x00070809;
    var fb = bhumi_fb_new(200, 200);
    var c = comp_new();
    var w = comp_create_window(c, 30, 30, 80, 60, "min");
    var px = alloc(80 * 60 * 4);
    var i = 0;
    while (i < 80 * 60) { store32(px + i * 4, 0x00C0FFEE); i = i + 1; }
    win_set_pix(w, px);
    win_minimize(w);
    ae_gpu_frame_ok = 0;
    bhumi_fb_clear(fb, MBG);
    render_window(fb, w, 1);
    assert_eq(t_count_not_r(fb, 0, 200, 0, 200, MBG), 0, "a CPU frame draws nothing of it: no chrome, no ring, no content");
    assert_eq(comp_window_at(c, 60, 70), 0, "  and nothing hits it (Rust: surface_at -> None)");
    ae_gpu_frame_ok = 1; ae_text_gpu_ok = 1; ae_cursor_gpu_ok = 1; ae_chrome_gpu_ok = 1; ae_gpu_alpha_chrome = 0;
    ae_rect_reset();
    ae_text_reset();
    render_window(fb, w, 1);
    assert_eq(ae_rect_count(), 0, "a GPU frame queues no rect for it");
    assert_eq(ae_text_count(), 0, "  and no caption");
    # Non-vacuity: restored, the same calls draw it.
    win_unminimize(w);
    render_window(fb, w, 1);
    assert_eq(t_gt_r(ae_rect_count(), 5), 1, "restored, it queues its chrome again");
    # ⚠ SIZING: AE_MARK_MAX windows of this chrome, plus headroom for the clear, the panel and the launcher,
    # must fit the queue — an overflow is chrome a GPU frame never presents. Borders took ~6 to ~10 (0.17.4).
    var rq_per_win = ae_rect_count();
    assert_eq(t_gt_r(AE_RECT_MAX + 1, rq_per_win * AE_MARK_MAX + 64), 1, "the rect queue holds AE_MARK_MAX windows of chrome and the prelude");
    ae_gpu_frame_ok = 0;
    ae_rect_reset();
    ae_text_reset();
    bhumi_fb_clear(fb, MBG);
    render_window(fb, w, 1);
    assert_eq(bhumi_fb_get(fb, 60, 70), 0x00C0FFEE, "  and a CPU frame draws its content");
    return 0;
}

# ---- a setu client's cache (0.17.6): the CPU composite never reads past it, and its live re-read cannot wait ----
# ⭐ A client's cache is a `fl_alloc` block its window owns (`win_pix_adopt`); over 4 KB it is its own mapping, so
# reading past it can fault where the bump heap read a neighbour. And the live re-read goes through
# `win_client_buf_read` (window.cyr), which refuses what is not a regular file, because setu's reader opens the
# buffer's /dev/shm name in a way a FIFO holds forever.
fn t_grp_cache_r(): i64 {
    test_group("render — a client's cache bounds the CPU composite, and its live re-read cannot wait (0.17.6)");
    ae_gpu_frame_ok = 0;
    var CBG = 0x00050607;
    var fb = bhumi_fb_new(200, 200);
    var widget = ae_bhumi(rupa_theme_widget(rupa_theme_active()));
    # A shared buffer of 10 x 150 words, every one 0x00ABCDEF.
    var nb = 10 * 150 * 4;
    var src = alloc(nb);
    var i = 0;
    while (i < 10 * 150) { store32(src + i * 4, 0x00ABCDEF); i = i + 1; }
    var bid = setu_buf_create(nb);
    setu_buf_write(bid, src, nb);
    # A 10 x 150 window whose cache holds 125 rows (5000 B). ⚠ The client buffer's recorded size says nothing
    # (0 x 0) — the state a minimize leaves it in, since W_PREMIN shares W_BUF_W's offset — so the clamp on it
    # is a no-op and only the cache's own size can bound the copy.
    var win = win_new(77, 20, 10, 10, 150, "cache");
    win_pix_adopt(win, fl_alloc(5000), 5000);
    win_set_client_buf(win, bid, 0, 0);
    bhumi_fb_clear(fb, CBG);
    render_window(fb, win, 0);
    var by = win_body_y(win);
    assert_eq(bhumi_fb_get(fb, 25, by), 0x00ABCDEF, "row 0 of the body: the client's pixels, re-read live");
    assert_eq(bhumi_fb_get(fb, 25, by + 124), 0x00ABCDEF, "row 124, the last the cache holds: the client's");
    assert_eq(bhumi_fb_get(fb, 25, by + 125), widget, "row 125, past the cache: not read, not composited — the body shows");
    assert_eq(bhumi_fb_get(fb, 25, by + 149), widget, "row 149 likewise");
    # The live re-read of a FIFO at the buffer's name. ⛔ Through setu's reader this render never returns (its
    # `open` waits for a writer), so it runs in a child the suite can give up on after 2 s.
    var fid = sys_getpid() * 100000 + 99101;
    var fpath = alloc(48);
    setu_buf_path(fid, fpath);
    sys_unlink(fpath);
    assert_eq(sys_mknodat(0 - 100, fpath, 4096 | 384, 0), 0, "a FIFO at a buffer's name");
    win_set_client_buf(win, fid, 10, 125);
    var pid = sys_fork();
    if (pid == 0) {
        render_window(fb, win, 0);
        sys_exit(0);
    }
    var wst = alloc(8);
    store64(wst, 0);
    var done = 0;
    var waited = 0;
    while (waited < 2000) {
        if (sys_waitpid(pid, wst, 1) == pid) {      # WNOHANG
            done = 1;
            break;
        }
        sleep_ms(10);
        waited = waited + 10;
    }
    if (done == 0) {
        sys_kill(pid, 9);
        sys_waitpid(pid, wst, 0);
    }
    assert_eq(done, 1, "a frame that re-reads it returns: nothing waited on the FIFO");
    assert_eq(load32(wst) & 0xFFFF, 0, "  and the frame ended normally (exit 0, no signal)");
    sys_unlink(fpath);
    setu_buf_close(bid);
    win_pix_release(win);
    return 0;
}

# ---- rust-old/tests/renderer_integration.rs ----------------------------------------------------------------------
# All twelve, re-expressed under ADR 0003: the framebuffer is bhumi's XRGB8888 (a fill is a clear, absent is -1),
# the blend is the kernel's `#92` op 0x01, the font is kashi's 8x16 with a 9 px advance, and the damage region
# list is the damage band. Rust's COLOR_BLACK / COLOR_WHITE are the XRGB words 0x00000000 / 0x00FFFFFF here.
fn t_grp_integ_r(): i64 {
    test_group("render — renderer_integration.rs: the framebuffer, the blend, blit, fill, damage, text");
    var BLK = 0x00000000;
    var WHT = 0x00FFFFFF;

    # framebuffer_roundtrip
    var fill = bhumi_xrgb(100, 150, 200);
    var rfb = bhumi_fb_new(64, 64);
    bhumi_fb_clear(rfb, fill);
    assert_eq(bhumi_fb_width(rfb), 64, "framebuffer_roundtrip: width 64");
    assert_eq(bhumi_fb_height(rfb), 64, "  height 64");
    assert_eq(bhumi_fb_get(rfb, 0, 0), fill, "  (0,0) reads the fill");
    assert_eq(bhumi_fb_get(rfb, 63, 63), fill, "  (63,63), the last pixel, reads the fill");
    assert_eq(bhumi_fb_get(rfb, 64, 0), 0 - 1, "  (64,0) is out of bounds: -1 (Rust: None)");

    # framebuffer_zero_dimension_is_empty — Rust made an empty framebuffer whose get was None; bhumi refuses
    # the size, so there is no framebuffer and no pixel to read either way.
    assert_eq(bhumi_fb_new(0, 100), 0, "framebuffer_zero_dimension_is_empty: 0x100 is refused (no pixels)");

    # blend_opaque_over_anything
    assert_eq(rend_px_premul(0xFF646464, 0xFFC8C8C8), 0xFF646464, "blend_opaque_over_anything: the source wins");
    # blend_transparent_is_identity — ⚠ ADR 0003 (the CPU blend is #92's): a zero-alpha source ADDS its colour, so
    # Rust's straight (0, 100, 100, 100) saturates every lane; transparent BLACK is the identity in both.
    assert_eq(rend_px_premul(0x00000000, 0xFFC8C8C8), 0xFFC8C8C8, "blend_transparent_is_identity: transparent black leaves dst");
    assert_eq(rend_px_premul(0x00646464, 0xFFC8C8C8), 0xFFFFFFFF, "  Rust's coloured zero-alpha source adds: 100 + 200 saturates");

    # decompose_roundtrip — a word keeps all four lanes through the framebuffer (the CPU frame's X byte carries
    # alpha, ADR 0003); bhumi_xrgb packs r, g, b with the X byte 0.
    bhumi_fb_set(rfb, 5, 5, 0x0A141E28);
    var dw = bhumi_fb_get(rfb, 5, 5);
    assert_eq((dw >> 24) & 0xFF, 10, "decompose_roundtrip: a 10");
    assert_eq((dw >> 16) & 0xFF, 20, "  r 20");
    assert_eq((dw >> 8) & 0xFF, 30, "  g 30");
    assert_eq(dw & 0xFF, 40, "  b 40");
    assert_eq(bhumi_xrgb(20, 30, 40), 0x00141E28, "  bhumi_xrgb packs (20, 30, 40) with the X byte 0");

    # blit_opaque_overwrites
    var wsrc = alloc(5 * 5 * 4);
    var wi = 0;
    while (wi < 25) { store32(wsrc + wi * 4, WHT); wi = wi + 1; }
    var bdst = bhumi_fb_new(10, 10);
    bhumi_fb_clear(bdst, BLK);
    blit_rect(bdst, 0, 0, wsrc, 5, 5);
    assert_eq(bhumi_fb_get(bdst, 0, 0), WHT, "blit_opaque_overwrites: (0,0) white");
    assert_eq(bhumi_fb_get(bdst, 4, 4), WHT, "  (4,4) white");
    assert_eq(bhumi_fb_get(bdst, 5, 5), BLK, "  (5,5), outside the blit, black");

    # blit_with_negative_offset_clips
    bhumi_fb_clear(bdst, BLK);
    blit_rect(bdst, 0 - 2, 0 - 2, wsrc, 5, 5);
    assert_eq(bhumi_fb_get(bdst, 0, 0), WHT, "blit_with_negative_offset_clips: (0,0) white");
    assert_eq(bhumi_fb_get(bdst, 2, 2), WHT, "  (2,2) white");
    assert_eq(bhumi_fb_get(bdst, 3, 3), BLK, "  (3,3) black");

    # fill_rect_clips_to_framebuffer
    bhumi_fb_clear(bdst, BLK);
    fill_rect(bdst, 0 - 5, 0 - 5, 20, 20, WHT);
    assert_eq(bhumi_fb_get(bdst, 0, 0), WHT, "fill_rect_clips_to_framebuffer: (0,0) white");
    assert_eq(bhumi_fb_get(bdst, 9, 9), WHT, "  (9,9) white");
    assert_eq(t_count_not_r(bdst, 0, 10, 0, 10, WHT), 0, "  every pixel white");

    # damage_tracker_lifecycle — on the damage band (ADR 0003). A fresh frame path has seen no background, so its
    # first frame has no band (the whole screen, Rust's flush of 1920x1080); `#84` flips, so the second frame is
    # whole-screen too where Rust's tracker was already clean. Rust's region_count closes with the region list.
    ae_frame_dmg = rend_dmg_new();
    ae_prev_dmg = rend_dmg_new();
    ae_last_bg = 0 - 1;
    ae_last_wp = 0 - 1;
    ae_inval_owed = 0;
    rend_band_carry_reset();
    rend_band_compute(1080, 0x121218);
    assert_eq(rend_band_valid(), 0, "damage_tracker_lifecycle: the first frame has no band — the whole screen");
    rend_band_compute(1080, 0x121218);
    assert_eq(rend_band_valid(), 0, "  and so does the second, for the other buffer (#84 flips)");
    rend_band_compute(1080, 0x121218);
    assert_eq(rend_band_valid(), 1, "  then nothing is damaged: a band...");
    assert_eq(rend_band_h(), 0, "  ...of height 0 (Rust: !has_damage)");
    rend_dmg_add(ae_frame_dmg, 10, 10, 100, 100);
    assert_eq(rend_dmg_valid(ae_frame_dmg), 1, "  add_damage: the tracker has damage");
    assert_eq(rend_dmg_x(ae_frame_dmg), 10, "  its bounds x 10");
    assert_eq(rend_dmg_y(ae_frame_dmg), 10, "  its bounds y 10");
    rend_band_compute(1080, 0x121218);
    assert_eq(rend_band_y(), 10, "  the band starts at row 10");
    assert_eq(rend_band_h(), 100, "  and is the damage's 100 rows");

    # text_width_calculation — kashi's 8 px glyph and 1 px gap (ADR 0003), where Rust's was 5 + 1.
    assert_eq(text_width(""), 0, "text_width_calculation: empty is 0");
    assert_eq(text_width("A"), 8, "  one glyph, no trailing gap: 8 (Rust: 5)");
    assert_eq(text_width("AB"), 17, "  8 + 1 + 8 (Rust: 5 + 1 + 5)");

    # desktop_renderer_creates — the port has no renderer object: the screen is a bhumi framebuffer, the kernel's
    # `#84` flip owns front and back (ADR 0003), and the damage tracker is allocated beside it (main.cyr).
    var dfb = bhumi_fb_new(1920, 1080);
    assert_eq(t_ne_r(dfb, 0), 1, "desktop_renderer_creates: a 1920x1080 framebuffer");
    assert_eq(bhumi_fb_width(dfb), 1920, "  width 1920");
    assert_eq(bhumi_fb_height(dfb), 1080, "  height 1080");
    assert_eq(t_ne_r(rend_dmg_new(), 0), 1, "  and its damage tracker");

    # as_bytes_length
    assert_eq(bhumi_fb_size(bdst), 10 * 10 * 4, "as_bytes_length: 10x10 is 400 bytes");
    return 0;
}

# ⚠ `src/gpu.cyr` cannot be included here (duplicate variable against this suite's own fixtures), and
# `wp_fill_band`'s IMAGE arm references `ae_gpu_wp_on`. Under `wp_set_solid` that arm is never taken at
# runtime — but it must LINK. A local stub keeps the suite honest: it exercises the SOLID path, which
# is the one the no-band clear regression is about.
fn ae_gpu_wp_on(): i64 { return 0; }

fn main() {
    alloc_init();
    # ⚠ SETTLE THE CURSOR before any band assertion. `rend_cursor_damage` reports the cursor as moved
    # until something records where it was last DRAWN, and these tests call the damage pass without
    # `render_cursor` (they predate the cursor entirely). Left unsettled, every "an idle desktop writes
    # NOTHING" assert reads 18 rows — which is a real property of an UNPAIRED damage/draw, not noise.
    input_ptr_set(0, 0);
    rend_cursor_mark_drawn(0, 0);

    # ⭐ 0.17.4: `rend_blend` IS the kernel's `#92` op 0x02 for one pixel — the opaque colour at a constant
    # coverage, ALL FOUR BYTES, so its alpha byte is the kernel's too. Expected words: the IEEE-f32 model of
    # blend_cov.s (the 0.17.4 banner above `t_ref_px_r`). The old straight-colour blend left byte 3 at 0 and truncated.
    test_group("render — alpha blend (#92 op 0x02, one pixel)");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 255), 0xFFFFFFFF, "full coverage = the opaque colour, alpha byte 255");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 0), 0x000000, "zero coverage = dst, every byte");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 128), 0x80808080, "half coverage = mid grey, alpha byte 128");
    assert_eq(rend_blend(0x203040, 0x203040, 200) & 0xFFFFFF, 0x203040, "same src/dst colour is stable");
    assert_eq(rend_blend(0x203040, 0x203040, 200) >> 24, 200, "  ...and the alpha byte is the coverage over a 0");

    test_group("render — damage tracker");
    var d = rend_dmg_new();
    assert_eq(rend_dmg_valid(d), 0, "empty damage invalid");
    rend_dmg_add(d, 10, 10, 20, 20);
    assert_eq(rend_dmg_valid(d), 1, "first add makes it valid");
    assert_eq(rend_dmg_x(d), 10, "damage x");
    assert_eq(rend_dmg_w(d), 20, "damage w");
    rend_dmg_add(d, 5, 5, 10, 10);
    assert_eq(rend_dmg_x(d), 5, "damage grows left");
    assert_eq(rend_dmg_y(d), 5, "damage grows up");
    assert_eq(rend_dmg_w(d), 25, "damage right edge held (30-5)");
    assert_eq(rend_dmg_h(d), 25, "damage bottom edge held");
    rend_dmg_clear(d);
    assert_eq(rend_dmg_valid(d), 0, "clear resets validity");

    # ⭐⭐ AE-0a — THE DAMAGE BAND. Drives the clear AND the `#39` chrome blit, so a wrong band is
    # either a stale desktop or a 60%-of-frame cost that never went away. `rend_band_compute` reads the
    # two module trackers, so these set them directly.
    test_group("render — AE-0a damage band: union(cur, prev)");
    ae_frame_dmg = rend_dmg_new();
    ae_prev_dmg = rend_dmg_new();
    ae_last_bg = 0x121218;                       # pretend a frame already cleared to this
    # ⚠ AND the wallpaper serial, for the same reason (M6-C1a): `rend_band_compute` refuses to band
    # when EITHER the bg or the wallpaper changed since the last frame, so faking "a frame already
    # rendered" means priming both halves of that state. Priming only `ae_last_bg` made the very first
    # compute look like a wallpaper change and cost a frame.
    ae_last_wp = wp_serial();

    # A band with neither tracker valid: nothing changed in two frames. VALID with height 0 — a real
    # result, not a failure. ⛔ Conflating it with "no band" would clear the whole screen every idle frame.
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_valid(), 1, "idle: a band IS computed");
    assert_eq(rend_band_h(), 0, "idle: height 0 — both buffers already correct, nothing to write");

    # cur alone.
    rend_dmg_add(ae_frame_dmg, 0, 100, 800, 200);            # rows 100..300
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_valid(), 1, "cur only: valid");
    assert_eq(rend_band_y(), 100, "cur only: band starts at cur's top");
    assert_eq(rend_band_h(), 200, "cur only: band is cur's height");

    # ⭐ THE NEGATIVE CONTROL FOR THE WHOLE BITE. prev is DISJOINT from cur and BELOW it. `#84 present`
    # flips the render target, so the buffer being written this frame is missing prev's rows too — a
    # band of cur alone would leave them holding two-frames-ago pixels, which is the trailing ghost this
    # union exists to prevent. If someone "simplifies" the fold to cur, THIS assert fails and says why.
    rend_dmg_add(ae_prev_dmg, 0, 900, 800, 100);             # rows 900..1000
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 100, "union: top comes from cur");
    assert_eq(rend_band_h(), 900, "union: bottom comes from PREV (1000-100) — not cur's 200");

    # Order does not matter: prev above cur folds the same way.
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 500, 800, 100);            # cur rows 500..600
    rend_dmg_add(ae_prev_dmg, 0, 50, 800, 100);              # prev rows  50..150
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 50, "union: top comes from prev when prev is higher");
    assert_eq(rend_band_h(), 550, "union: bottom from cur (600-50)");

    # Clamped to the screen, both edges. An off-screen window rect must not produce a source pointer
    # or a destination row outside the framebuffer — `#39` clips, but the band's own src offset does not.
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 0 - 200, 800, 300);        # rows -200..100
    rend_dmg_add(ae_prev_dmg, 0, 1400, 800, 500);            # rows 1400..1900
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 0, "clamped: negative top pinned to 0");
    assert_eq(rend_band_h(), 1440, "clamped: bottom pinned to the screen height");

    # ⛔ A BACKGROUND CHANGE DAMAGES EVERY PIXEL WITHOUT MOVING A WINDOW. The band must refuse, so the
    # caller does a full clear — otherwise the old colour survives everywhere outside the band and reads
    # as a stale desktop that no window rect can explain.
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 100, 800, 50);
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 0, "theme switch: NO band — the whole screen must be cleared");
    assert_eq(rend_inval_owed(), 1, "theme switch: one more full-screen frame is still owed");
    # ⛔⛔ TWO FRAMES, ONE PER BUFFER — AND THIS ASSERTION USED TO SAY THE OPPOSITE.
    # It read `assert_eq(rend_band_valid(), 1, "the frame AFTER a theme switch bands normally
    # again")`, with a comment saying the repaint lasts "only for that one frame". That is the
    # defect, asserted as the contract: `#84 present` FLIPS, so one frame of full repaint reaches
    # ONE buffer and the other keeps the old background — forever, because it never gets another
    # full frame. `#84` alternates them, so the desktop blinks at half the frame rate. Reported from
    # iron 2026-08-19 ("themes bg flicker ... more often than not, more with lighter themes"); a
    # dark stale buffer is simply more visible under a light theme.
    # ⚠ QEMU CANNOT CATCH THIS — no GPU, no flip, one buffer — which is why the suite and the QEMU
    # runs both called the CPU path correct while iron flickered. Same reasoning as `comp_retire`
    # (compositor.cyr:196), which buys a closed window exactly these two frames.
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 0, "the frame AFTER a theme switch STILL has no band — buffer 2");
    assert_eq(rend_inval_owed(), 0, "the debt is paid after two frames");
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 1, "the THIRD frame bands normally again — both buffers correct");

    # -----------------------------------------------------------------------
    test_group("render — the band itself covers TWO frames (#84 flips)");
    # ⛔⛔ WHY THIS EXISTS. Since AE-9 the `#39` chrome blit is gone on iron and the GPU's
    # back-buffer clear IS the band's first rect — so a row outside the band is not just
    # "not re-copied", it is never painted this frame in THIS buffer. `union(cur, prev)` buys two
    # frames for anything routed through the damage trackers, but a row that is inside the band on
    # frame N and outside on N+1 lands in ONE buffer and `#84` alternates them forever.
    # Iron 2026-08-19: the band moved 458..552 (launcher panel) -> 0..0 -> 0..414 -> 0..464 ->
    # 50..464, and the background flickered outside the window's rows. `--fullclear` removed it
    # entirely — the controlled proof that the cause is staleness OUTSIDE the band.
    rend_band_carry_reset();
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 100, 800, 100);            # frame 1: rows 100..200
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_y(), 100, "carry frame 1: band starts at the damage");
    assert_eq(rend_band_h(), 100, "carry frame 1: band is the damage");

    # Frame 2 damages a DISJOINT region far below. Without the carry the band would be 800..900 and
    # rows 100..200 would never be repainted in the other buffer — the flicker.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 800, 800, 100);            # frame 2: rows 800..900
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_y(), 100, "carry frame 2: still covers frame 1's rows — the other buffer");
    assert_eq(rend_band_h(), 800, "carry frame 2: union of 100..200 and 800..900");

    # ⛔ AND IT MUST SHRINK BACK. Unioning against the EMITTED band instead of the RAW one would
    # ratchet outward and never recover — a permanent full-screen clear wearing a band's name.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 800, 800, 100);            # frame 3: the same rows again
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_y(), 800, "carry frame 3: shrinks back — no ratchet");
    assert_eq(rend_band_h(), 100, "carry frame 3: band is just the steady damage");


    # ⛔ A MISSING TRACKER MEANS FULL SCREEN, NOT AN EMPTY BAND. Every unit suite runs with these unset,
    # and an empty band there would silently stop clearing anything at all.
    var save_cur = ae_frame_dmg;
    ae_frame_dmg = 0;
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 0, "no tracker: no band, so the caller clears everything");
    ae_frame_dmg = save_cur;

    # The roll: rend_dmg_copy is what makes THIS frame's cur become next frame's prev.
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 700, 800, 40);
    rend_dmg_copy(ae_prev_dmg, ae_frame_dmg);
    assert_eq(rend_dmg_valid(ae_prev_dmg), 1, "roll: prev takes cur's validity");
    assert_eq(rend_dmg_y(ae_prev_dmg), 700, "roll: prev takes cur's top");
    assert_eq(rend_dmg_h(ae_prev_dmg), 40, "roll: prev takes cur's height");

    # ⭐⭐ THE FAILURE MODE THE BAND CAN INTRODUCE, ASSERTED ON PIXELS: a window that MOVES must not
    # leave its old self behind. Nothing else tests this — the QEMU desktop's windows are static and its
    # present is full-frame (no GPU there), so a wrong band looks perfect on every substrate short of
    # iron, where the symptom reads as "the framebuffer is stale" rather than "the damage model is wrong".
    #
    # ⛔⛔ THE MOVE MUST HAPPEN ON FRAME 4, NOT FRAME 2, AND THIS COST A VACUOUS TEST.
    # The first version moved the window on frame 2 and PASSED against a mutant that dropped the old rect
    # from the fold entirely. Reason: frame 1 primes damage to the FULL SCREEN, so frame 2's band is
    # `union(cur, prev=full)` = full — it covers the vacated rows no matter what the fold does. Two
    # settling frames are needed to drain `prev` back to empty before a move can prove anything.
    # ⚠ Mutation-tested in both directions now: dropping the old rect FAILS the ghost assert, and
    # dropping prev from the union FAILS the union asserts above.
    #
    # ⚠ MIRRORS `render_desktop`'s ORDER (src/desktop.cyr) — damage, banded clear, draw, stamp — via
    # `ghost_frame` below, calling the real `rend_frame_damage` / `rend_clear_band` / `render_window`.
    test_group("render — AE-0a: a moved window leaves NO ghost");
    # ⚠ 400 TALL SO THE MOVED WINDOW FITS. At 300 the window at y=200 (+100 body +30 titlebar = 330)
    # runs off the bottom, the band clamps to 300, and the "reaches its new bottom" assert fails on the
    # TEST's geometry rather than on the code — which is how it failed first time round.
    var gfb = bhumi_fb_new(400, 400);
    var gcomp = comp_new();
    var gwin = comp_create_window(gcomp, 40, 40, 120, 100, "G");
    var GBG = 0x00101018;
    ae_dmg_primed = 0;                        # frame 1 must prime full, as it does at startup
    ae_last_bg = 0 - 1;
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);

    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 1 — primed full
    assert(bhumi_fb_get(gfb, 80, 100) != GBG, "frame 1: the window is actually on screen");
    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 2 — band still full (prev = frame 1)
    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 3 — settled: nothing changed in two frames
    assert_eq(rend_band_h(), 0, "settled: an idle desktop writes NOTHING — the band is empty");
    var gring = ae_bhumi(rupa_theme_line(rupa_theme_active()));
    assert_eq(bhumi_fb_get(gfb, 80, 40 - BORDER_W), gring, "frame 3: the border's top row is drawn ABOVE the window, at y = 39");

    # ---- frame 4: move it far down. Its old rows must come back to the background. ----
    win_move(gwin, 40, 200);
    rend_frame_damage(gcomp, gfb, GBG);
    assert_eq(rend_band_valid(), 1, "after the move: a band was computed");
    assert(rend_band_y() <= 40, "after the move: the band reaches the window's OLD top");
    assert(rend_band_y() + rend_band_h() >= 200 + 100 + 30,
      "after the move: ...and its NEW bottom + titlebar");
    # ⭐ 0.17.4: AND THE RING, ONE ROW FURTHER EACH WAY. The border lies outside the window rect, so a band of the
    # rect alone leaves the old top ring row on screen — a one-pixel ghost line where the window was.
    assert_eq(t_gt_r(rend_band_y(), 40 - BORDER_W), 0, "after the move: the band reaches the OLD ring row, y = 39");
    assert_eq(t_gt_r(200 + 30 + 100 + BORDER_W, rend_band_y() + rend_band_h()), 0,
      "after the move: ...and the NEW ring row below the window, y = 330");
    if (rend_band_valid() == 1) {
        if (rend_band_h() > 0) { rend_clear_band(gfb, rend_band_y(), rend_band_h(), GBG); }
    }
    if (rend_band_valid() == 0) { bhumi_fb_clear(gfb, GBG); }
    render_window(gfb, gwin, 1);
    win_stamp_prev(gwin);
    # ⛔ THE GHOST ASSERT. (80,100) was inside the window on frames 1-3 and is outside it now, so it must
    # read the background. If the band ever narrows to the new rect alone, this pixel still holds chrome.
    assert_eq(bhumi_fb_get(gfb, 80, 100), GBG, "after the move: the VACATED region is background, not a ghost");
    assert(bhumi_fb_get(gfb, 80, 260) != GBG, "after the move: and the window is drawn at its new position");
    assert_eq(bhumi_fb_get(gfb, 80, 40 - BORDER_W), GBG, "after the move: the OLD border row is background — no ghost line");
    assert_eq(bhumi_fb_get(gfb, 80, 200 - BORDER_W), gring, "after the move: the border is drawn at its new top");

    # ================================================================================================
    # A STATIONARY TRANSLUCENT WINDOW MUST NOT CONVERGE TO OPAQUE
    # ================================================================================================
    # ⛔⛔ THE BUG THIS PINS SHIPPED, AND A PUBLISHED VERIFICATION MISSED IT. `fill_rect_a` is
    # read-modify-write (`render.cyr:81`). `render_desktop` calls `render_window` every frame while the
    # clear is band-limited, and `rend_frame_damage` used to damage a window only on a rect change or a
    # live `bufid` — so a STATIONARY translucent window was re-blended over its OWN previous output,
    # frame after frame. The iteration's fixed point is (near) the source colour: the window fades in
    # and then goes effectively OPAQUE in about four frames.
    #
    # ⚠ 0.15.0's null-test reported inside-pixels `1A1D24` at a=150 and `171A24` at a=60 over one
    # gradient wallpaper and read that as blending. It is arithmetically NOT a single blend: solving
    # `rend_blend` from the widget colour `1B1E24` admits backdrop red {25,26} at a=150 and {22,23} at
    # a=60, green {28,29} and {25,26} — **both intersections EMPTY**. Iterating the blend from the
    # backdrop that run itself published (`151727`) reproduces BOTH values exactly, in 4 frames.
    # ⇒ The measurement was real; the interpretation was convergence, not opacity.
    #
    # This test settles the frame, then runs many more and requires the pixel to STOP MOVING at a value
    # that is still visibly blended. A pixel that keeps drifting toward the source is the bug.
    test_group("render — a stationary translucent window stays translucent");
    var trfb = bhumi_fb_new(400, 400);
    var trcomp = comp_new();
    var trwin = comp_create_window(trcomp, 40, 40, 120, 100, "T");
    var TRBG = 0x00101018;
    win_set_opacity(trwin, 128);
    assert_eq(win_translucent(trwin), 1, "the fixture window is translucent");

    ae_last_bg = 0 - 1;
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    ghost_frame(trcomp, trfb, trwin, TRBG);
    ghost_frame(trcomp, trfb, trwin, TRBG);
    var px_settled = bhumi_fb_get(trfb, 80, 100);
    var ring_settled = bhumi_fb_get(trfb, 80, 40 - BORDER_W);

    # ⛔ THE DAMAGE ASSERTION IS THE ROOT CAUSE, AND IT IS CHECKED DIRECTLY. Without it the band goes
    # empty for a stationary translucent window and every pixel assertion below becomes vacuous —
    # nothing would be redrawn, so nothing could drift, and a broken build would pass.
    rend_frame_damage(trcomp, trfb, TRBG);
    assert(rend_band_h() > 0, "a stationary translucent window is STILL damaged (no bufid, no move)");
    # ⭐ 0.17.4: its BORDER is chrome at the window's opacity too, one row outside it each way.
    assert_eq(t_gt_r(rend_band_y(), 40 - BORDER_W), 0, "  ...and its band reaches the border row above it");
    assert_eq(t_gt_r(40 + TITLEBAR_H + 100 + BORDER_W, rend_band_y() + rend_band_h()), 0,
      "  ...and the border row below it");

    var trf = 0;
    while (trf < 12) { ghost_frame(trcomp, trfb, trwin, TRBG); trf = trf + 1; }
    var px_late = bhumi_fb_get(trfb, 80, 100);
    assert_eq(px_late, px_settled, "12 further frames change NOTHING — no accumulation");
    assert(px_late != TRBG, "the window is still drawn");
    assert_eq(bhumi_fb_get(trfb, 80, 40 - BORDER_W), ring_settled, "  nor does its translucent border accumulate");
    assert_eq(ring_settled, rend_blend(TRBG, ae_bhumi(rupa_theme_line(rupa_theme_active())), 128),
      "  ...which is the line colour at a=128 over the backdrop, blended ONCE");

    # And it must genuinely be a blend of the two, not either one alone. The opaque chrome colour is
    # whatever a=255 produces; assert the translucent result differs from it.
    win_set_opacity(trwin, 255);
    rend_dmg_clear(ae_frame_dmg); rend_dmg_clear(ae_prev_dmg); ae_last_bg = 0 - 1;
    ghost_frame(trcomp, trfb, trwin, TRBG);
    ghost_frame(trcomp, trfb, trwin, TRBG);
    var px_opaque = bhumi_fb_get(trfb, 80, 100);
    assert(px_late != px_opaque, "and it is NOT the opaque colour -- a=128 differs from a=255");

    # ================================================================================================
    # Z-ORDER MARKS — the partition the GPU frame replays windows in
    # ================================================================================================
    # ⛔ WHAT THIS PINS, AND WHAT IT CANNOT. `ae_gpu_present_frame` used to emit ALL chrome, then ALL
    # client surfaces, then ALL text — so a LOWER window's surface covered an UPPER window's titlebar
    # while the upper title glyphs were repainted on top. It now replays per window, sliced by these
    # marks. ⚠ That emission path is `#ifdef CYRIUS_TARGET_AGNOS` and cannot run here at all, so this
    # suite gates the PARTITION (which is pure and portable) and NOT the emission. The reorder itself
    # is unverified until it runs on agnos — a QEMU Linux screendump is byte-identical before and after,
    # precisely because the code never executes there.
    test_group("render — the per-window z-order partition");
    var zfb = bhumi_fb_new(400, 400);
    var zcomp = comp_new();
    var zw0 = comp_create_window(zcomp, 10, 10, 100, 80, "A");
    var zw1 = comp_create_window(zcomp, 200, 200, 100, 80, "B");
    # Drive the exact sequence render_desktop performs — reset, mark the prelude, then render+mark each
    # window. Calling render_desktop itself is not possible here (desktop.cyr is not in this suite's
    # include graph), and this is the more faithful test anyway: it pins the call ORDER the fix depends
    # on rather than trusting one caller to have it right.
    # ⚠ Rects are only queued when chrome is on the GPU; force that on for the duration.
    # ⛔ `ae_chrome_on_gpu()` is a CONJUNCTION — it needs the frame plan to have said yes AND the chrome
    # path to be live AND the glyph op available. Setting only one left it 0, no rects were queued, every
    # slice was empty, and the content checks below passed VACUOUSLY: two deliberate mutations (dropping
    # the mark, and marking before the render instead of after) both stayed green. Instrumented rather
    # than assumed — the counters read prelude=0 m0=0 m1=0 total=0.
    # ⚠ FOUR conjuncts, all required: ae_gpu_frame_ok, ae_text_gpu_ok, ae_cursor_gpu_ok, ae_chrome_gpu_ok.
    var zsaved = ae_chrome_gpu_ok;
    var zsaved_ok = ae_gpu_frame_ok;
    var zsaved_t = ae_text_gpu_ok;
    var zsaved_c = ae_cursor_gpu_ok;
    ae_chrome_gpu_ok = 1; ae_gpu_frame_ok = 1; ae_text_gpu_ok = 1; ae_cursor_gpu_ok = 1;
    ae_rect_reset(); ae_text_reset(); ae_marks_reset();
    # ⚠ QUEUE A BACKGROUND FIRST, as wp_fill_band does in a real frame. Without it the prelude is empty
    # and "forget the prelude mark" is an equivalent mutation — the test could not tell the two apart,
    # and a mutation that cannot fail is not coverage.
    fill_rect(zfb, 0, 0, 400, 400, 0x00101018);
    ae_mark_prelude();
    render_window(zfb, zw0, 1); ae_mark_window();
    render_window(zfb, zw1, 0); ae_mark_window();

    assert_eq(ae_mark_count(), 2, "one mark per window, drawn or not");
    # ⛔ NON-VACUITY GUARD, and it is not decoration: without it this whole group passed with ZERO rects
    # queued, and two deliberate mutations went undetected. Every range check below is trivially true on
    # an empty queue.
    assert(ae_rect_count() > 0, "rects were actually queued -- the checks below are not vacuous");
    assert(ae_rect_mark_at(0 - 1) > 0, "the PRELUDE is non-empty -- the background was queued");
    assert(ae_rect_mark_at(0) > ae_rect_mark_at(0 - 1), "window 0's slice is NON-EMPTY");
    assert(ae_rect_mark_at(1) > ae_rect_mark_at(0), "window 1's slice is NON-EMPTY");
    # The slices must TILE the queue: prelude, then each window, in order, ending at the count.
    assert(ae_rect_mark_at(0 - 1) <= ae_rect_mark_at(0), "prelude ends at or before window 0's slice");
    assert(ae_rect_mark_at(0) <= ae_rect_mark_at(1), "window 0's slice ends at or before window 1's");
    assert(ae_rect_mark_at(1) <= ae_rect_count(), "window 1's slice ends at or before the queue end");
    assert(ae_text_mark_at(0) <= ae_text_mark_at(1), "the text queue is partitioned the same way");

    # ⭐ THE CONTENT CHECK, WHICH IS THE ONE THAT MATTERS. Every rect in window 0's slice must lie
    # inside window 0's bounds. If the marks were off by one window, this fails — an ordering test that
    # only checked the arithmetic would not.
    var zi = ae_rect_mark_at(0 - 1);
    var zbad = 0;
    while (zi < ae_rect_mark_at(0)) {
        if (ae_rect_get_x(zi) + ae_rect_get_w(zi) > 200) { zbad = zbad + 1; }
        zi = zi + 1;
    }
    assert_eq(zbad, 0, "window 0's slice contains only rects inside window 0 (x < 200)");
    var zj = ae_rect_mark_at(0);
    var zbad2 = 0;
    while (zj < ae_rect_mark_at(1)) {
        # ⚠ 0.17.4: the border ring is window 1's chrome and lies BORDER_W outside its rect, so x >= 199.
        if (ae_rect_get_x(zj) < 200 - BORDER_W) { zbad2 = zbad2 + 1; }
        zj = zj + 1;
    }
    assert_eq(zbad2, 0, "window 1's slice contains only rects of window 1 (x >= 199, its border included)");
    ae_chrome_gpu_ok = zsaved; ae_gpu_frame_ok = zsaved_ok; ae_text_gpu_ok = zsaved_t; ae_cursor_gpu_ok = zsaved_c;

    # ⛔⛔ `AE-0a`: A **CLOSED** WINDOW IS NOT A MOVED WINDOW, and the difference cost an iron burn.
    # The 2026-08-08 flash proved the move leaves no ghost (the group above). Closing a window instead
    # left it **standing on the panel, flashing** — because every damage producer walks the LIVE window
    # list, so a removed window is in neither `cur` nor `prev` and its rows are never repainted.
    # ⭐ THE LOAD-BEARING PROPERTY IS **TWO** FRAMES OF COVERAGE, NOT ONE. `#84 present` flips the render
    # target, so erasing a region takes one frame per buffer. A single frame erases the window from the
    # buffer being drawn and leaves it in the other, and the flip then alternates them — that IS the
    # flashing. Anything folded into `cur` gets two frames for free, because next frame's `prev` is this
    # frame's `cur`. These asserts are on the BAND rather than on pixels for exactly that reason: one
    # framebuffer cannot show a flip, but band coverage on two consecutive frames is what the flip needs.
    test_group("render — AE-0a: a CLOSED window's rows are covered for TWO frames");
    var kfb = bhumi_fb_new(400, 400);
    var kcomp = comp_new();
    var kwin = comp_create_window(kcomp, 40, 40, 120, 100, "K");
    var KBG = 0x00101018;
    ae_dmg_primed = 0;
    ae_last_bg = 0 - 1;
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    comp_retire_clear();
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 1 — primed full
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 2
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 3 — settled
    assert_eq(rend_band_h(), 0, "settled before the close: an idle desktop writes nothing");
    assert(bhumi_fb_get(kfb, 80, 100) != KBG, "the window really is on screen before the close");

    comp_close_window(kcomp, win_id(kwin));
    assert_eq(comp_count(kcomp), 0, "the close removed the window");
    assert_eq(comp_retire_valid(), 1, "the close RECORDED the vacated rect before unlinking");
    assert_eq(comp_retire_y(), 40, "the retired rect keeps the window's y");
    assert_eq(comp_retire_h(), 100, "the retired rect keeps the window's h (titlebar added by render)");

    # ---- frame 4: the close frame. The vacated rows must be in the band. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_valid(), 1, "close frame: a band was computed");
    assert(rend_band_y() <= 40, "close frame: the band reaches the closed window's top");
    assert(rend_band_y() + rend_band_h() >= 40 + 100 + 30,
      "close frame: ...and its bottom, titlebar included");
    assert_eq(comp_retire_valid(), 0, "the retired rect is CONSUMED by the frame that folded it in");
    assert_eq(t_gt_r(rend_band_y(), 40 - BORDER_W), 0, "close frame: the band reaches its border row above it");
    assert_eq(t_gt_r(40 + 100 + 30 + BORDER_W, rend_band_y() + rend_band_h()), 0, "  ...and below it");
    if (rend_band_h() > 0) { rend_clear_band(kfb, rend_band_y(), rend_band_h(), KBG); }
    assert_eq(bhumi_fb_get(kfb, 80, 100), KBG, "close frame: the vacated region is background");
    assert_eq(bhumi_fb_get(kfb, 80, 40 - BORDER_W), KBG, "close frame: and so is its old border row");

    # ---- frame 5: THE ASSERT THAT CATCHES THE FLASH. The other buffer still holds the window. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_valid(), 1, "frame after the close: a band was computed");
    assert(rend_band_y() <= 40,
      "frame after the close: the band STILL reaches the old top — this is the OTHER buffer");
    assert(rend_band_y() + rend_band_h() >= 40 + 100 + 30,
      "frame after the close: ...and the old bottom. One frame of coverage is what flashed");

    # ---- frame 6: and now it may settle. Coverage must not persist forever either. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_h(), 0, "two frames after the close: settled — a retired rect does not linger");

    # ⛔ THE STATIC, CLIENTLESS WINDOW — the worse of the two symptoms, and a DIFFERENT code path.
    # A compositor-seeded window has no client buffer, so `win_bufid` is 0 and after its first frames
    # `win_rect_changed` is 0 too: it was in NEITHER `cur` nor `prev` even on the close frame, so closing
    # it damaged NOTHING and it stayed on screen in BOTH buffers permanently. That is "not disappearing"
    # as distinct from "flashing", and the retired rect is what covers it.
    test_group("render — AE-0a: closing a STATIC clientless window still damages its rows");
    var sfb = bhumi_fb_new(400, 400);
    var scomp = comp_new();
    var swin = comp_create_window(scomp, 60, 60, 100, 80, "S");
    var SBG = 0x00101018;
    ae_dmg_primed = 0;
    ae_last_bg = 0 - 1;
    rend_band_carry_reset();          # independent scenario, not the next frame — see the carry test
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    comp_retire_clear();
    ghost_frame(scomp, sfb, swin, SBG);
    ghost_frame(scomp, sfb, swin, SBG);
    ghost_frame(scomp, sfb, swin, SBG);
    assert_eq(rend_band_h(), 0, "static window: settled, and it never moved");
    assert_eq(win_bufid(swin), 0, "static window: it genuinely has no client buffer");
    assert_eq(win_rect_changed(swin), 0, "static window: and its rect is genuinely unchanged");
    comp_close_window(scomp, win_id(swin));
    rend_frame_damage(scomp, sfb, SBG);
    assert_eq(rend_band_valid(), 1, "static close: a band was computed at all");
    assert(rend_band_h() > 0, "static close: and it is NOT empty — nothing else could have damaged it");
    assert(rend_band_y() <= 60, "static close: the band reaches the window's top");
    assert(rend_band_y() + rend_band_h() >= 60 + 80 + 30, "static close: ...and its bottom + titlebar");

    # Two windows closed in ONE frame must both be covered — the retired rect is a union.
    test_group("render — AE-0a: two closes in one frame union into one band");
    var ucomp = comp_new();
    var uw1 = comp_create_window(ucomp, 10, 10, 50, 50, "U1");
    var uw2 = comp_create_window(ucomp, 10, 300, 50, 50, "U2");
    comp_retire_clear();
    comp_close_window(ucomp, win_id(uw1));
    comp_close_window(ucomp, win_id(uw2));
    assert_eq(comp_retire_y(), 10, "union: top comes from the higher window");
    assert_eq(comp_retire_y() + comp_retire_h(), 350, "union: bottom comes from the lower window");
    assert_eq(comp_retire_valid(), 1, "union: still one valid box");
    comp_retire_clear();
    assert_eq(comp_retire_valid(), 0, "and clearing it invalidates it");

    # ⭐⭐ `AE-8` — THE PACKED 1bpp BITMAP MUST BE THE SAME GLYPHS THE CPU DRAWS.
    # This is the whole local verification of `#92` op 0x03, and it needs no GPU: expand the packed mask
    # the way the kernel's shader does (paint `color` where a bit is set, leave the rest) and compare it
    # pixel-for-pixel against `draw_text`'s own output on an identical framebuffer.
    # ⛔ IT CATCHES THE ONE MISTAKE THAT CANNOT BE EYEBALLED FROM CODE: the kernel reads the mask
    # **MSB-first**, and its own source names LSB-first as the error it was written to avoid — which
    # mirrors every glyph horizontally. A mirrored 'H' is still an 'H'-shaped blob in a pixel count, so
    # only an exact comparison against the reference renderer finds it.
    test_group("render — AE-8: the packed 1bpp mask equals what draw_text draws");
    # ⛔ THE GLYPH TABLES MUST BE LIVE. Without kashi_font_init() every `kashi_glyph_row` answers 0, so
    # BOTH the reference and the packed mask come out blank and compare EQUAL — a vacuous pass. The
    # `lit > 100` assert below exists to catch exactly that, and it did on the first run.
    kashi_font_init();
    var tw = 200;
    var th = 40;
    var fb_cpu = bhumi_fb_new(tw, th);
    var fb_gpu = bhumi_fb_new(tw, th);
    bhumi_fb_clear(fb_cpu, 0x00000000);
    bhumi_fb_clear(fb_gpu, 0x00000000);
    var msg = "Hg1|_ WM";                       # ascenders, descenders, a bar, an underscore, a space
    var mlen = strlen(msg);
    var TCOL = 0x00D7D7DF;

    # Reference: the per-pixel path, unchanged.
    # ⚠ ae_gpu_frame_ok must be 0 here or draw_text would ENQUEUE instead of drawing — the very routing
    # this test exists to validate would hollow out its own reference.
    ae_gpu_frame_ok = 0;
    draw_text(fb_cpu, msg, 5, 8, TCOL);

    # Under test: pack, then expand exactly as `gpu_glyph_surface` does.
    # ⚠ The packer takes CELLS (a queued run), so the string goes through the queue's own decode first.
    var stride = ae_text_stride(mlen);
    var mask = alloc(ae_text_bytes(mlen));
    var mcells = alloc(mlen * 2);
    assert_eq(ae_text_cells(mcells, msg, mlen), mlen, "an ASCII string is one cell per byte");
    var pw = ae_text_pack_1bpp(mask, mcells, mlen);
    assert_eq(pw, mlen * FONT_ADV, "the packed width is one advance per character");
    assert_eq(stride, (pw + 7) / 8, "the row stride is the kernel's (w + 7) / 8");
    var gy = 0;
    while (gy < FONT_H) {
        var gx = 0;
        while (gx < pw) {
            var byi = gy * stride + gx / 8;
            var bit = gx - (gx / 8) * 8;
            if ((load8(mask + byi) & (1 << (7 - bit))) != 0) {
                bhumi_fb_set(fb_gpu, 5 + gx, 8 + gy, TCOL);
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }

    var diff = 0;
    var lit = 0;
    var py = 0;
    while (py < th) {
        var px = 0;
        while (px < tw) {
            var a = bhumi_fb_get(fb_cpu, px, py);
            var b = bhumi_fb_get(fb_gpu, px, py);
            if (a != b) { diff = diff + 1; }
            if (a == TCOL) { lit = lit + 1; }
            px = px + 1;
        }
        py = py + 1;
    }
    assert(lit > 100, "the reference actually drew glyphs (not comparing two blank buffers)");
    assert_eq(diff, 0, "the packed 1bpp mask expands to the EXACT pixels draw_text produces");

    # ⛔ NEGATIVE CONTROL: read the same mask LSB-first — the mistake the kernel warns about — and the
    # comparison must FAIL. Without this, a checker that passes two blank buffers looks identical.
    bhumi_fb_clear(fb_gpu, 0x00000000);
    gy = 0;
    while (gy < FONT_H) {
        var lx = 0;
        while (lx < pw) {
            var lbyi = gy * stride + lx / 8;
            var lbit = lx - (lx / 8) * 8;
            if ((load8(mask + lbyi) & (1 << lbit)) != 0) {        # LSB-first: mirrors each byte
                bhumi_fb_set(fb_gpu, 5 + lx, 8 + gy, TCOL);
            }
            lx = lx + 1;
        }
        gy = gy + 1;
    }
    var mdiff = 0;
    py = 0;
    while (py < th) {
        var mx = 0;
        while (mx < tw) {
            if (bhumi_fb_get(fb_cpu, mx, py) != bhumi_fb_get(fb_gpu, mx, py)) { mdiff = mdiff + 1; }
            mx = mx + 1;
        }
        py = py + 1;
    }
    assert(mdiff > 0, "reading the mask LSB-first MIRRORS the glyphs and is CAUGHT");

    # ---- the queue: routing, capacity, and the CPU fallback ----------------------------------------
    test_group("render — AE-8: the text queue routes and refuses honestly");
    ae_text_reset();
    assert_eq(ae_text_count(), 0, "reset empties the queue");
    assert_eq(ae_text_enqueue("title", 10, 20, 0x00FF0000), 1, "a run is accepted");
    assert_eq(ae_text_count(), 1, "and counted");
    assert_eq(ae_text_run_x(0), 10, "x is carried");
    assert_eq(ae_text_run_y(0), 20, "y is carried");
    assert_eq(ae_text_run_col(0), 0x00FF0000, "colour is carried");
    assert_eq(ae_text_run_len(0), 5, "length is the string's cell count (ASCII: one per byte)");
    assert_eq(t_run_cell_r(0, 0), 0x74, "the string is decoded INTO the pool as cells, not aliased");
    assert_eq(t_run_cell_r(0, 4), 0x65, "  ...all of it: the last cell is 'e'");
    # An empty string is queued as a no-op rather than refused: there is nothing to fall back TO, and
    # returning 0 would make the caller draw nothing on the CPU either — same result, more work.
    assert_eq(ae_text_enqueue("", 0, 0, 0), 1, "an empty run is a no-op, not a refusal");
    assert_eq(ae_text_count(), 1, "and does not occupy a slot");
    # ⛔ OVER-LONG AND OVER-FULL MUST REFUSE, so draw_text falls back to the CPU and the text still shows.
    var d0 = ae_text_dropped_get();
    var long = alloc(AE_TEXT_CHARS + 8);
    var li = 0;
    while (li < AE_TEXT_CHARS + 2) { store8(long + li, 0x41); li = li + 1; }
    store8(long + AE_TEXT_CHARS + 2, 0);
    assert_eq(ae_text_enqueue(long, 0, 0, 0), 0, "a run longer than the packer's cap is REFUSED");
    assert_eq(ae_text_dropped_get(), d0 + 1, "...and counted, because a silent drop is a lie");
    ae_text_reset();
    var qi = 0;
    while (qi < AE_TEXT_MAX) { ae_text_enqueue("x", 0, 0, 0); qi = qi + 1; }
    assert_eq(ae_text_count(), AE_TEXT_MAX, "the queue fills to exactly AE_TEXT_MAX");
    assert_eq(ae_text_enqueue("x", 0, 0, 0), 0, "and then refuses rather than overrunning");
    ae_text_reset();

    # ⭐⭐ THE QUEUE COUNTS CELLS, AND A CELL CAN BE PAST 0xFF. A run's length, the AE_TEXT_CHARS cap and the pool
    # are all in cells since the text became UTF-8, and kashi 1.1.0's '…' and U+FFFD are cells 0x100 / 0x101 —
    # which no byte can hold. Each assertion below fails for one of the two ways to get that wrong.
    test_group("render — the glyph queue holds CELLS, and cells past 0xFF survive it");
    ae_text_reset();
    var hs = "Aé─…\xFF中😀";                   # 1 + 2 + 3 + 3 + 1 + 3 + 4 = 17 bytes, 7 scalars
    assert_eq(ae_text_enqueue(hs, 3, 4, TCOL), 1, "a UTF-8 run is accepted");
    assert_eq(ae_text_run_len(0), 7, "  its length is 7 CELLS, not 17 bytes");
    assert_eq(t_run_cell_r(0, 0), 0x41, "  'A' is cell 0x41");
    assert_eq(t_run_cell_r(0, 1), 0x82, "  'é' is CP437 0x82 — one cell, not the two of C3 A9");
    assert_eq(t_run_cell_r(0, 2), 0xC4, "  '─' (U+2500) is CP437 0xC4");
    assert_eq(t_gt_r(t_ell_cell_r(), 0xFF), 1, "  (kashi's '…' cell is past 0xFF — one byte cannot hold it)");
    assert_eq(t_run_cell_r(0, 3), t_ell_cell_r(), "  '…' survives the pool whole");
    assert_eq(t_gt_r(t_repl_cell_r(), 0xFF), 1, "  (and so is U+FFFD's)");
    assert_eq(t_run_cell_r(0, 4), t_repl_cell_r(), "  the ill-formed byte FF is U+FFFD's cell");
    assert_eq(t_run_cell_r(0, 5), 0, "  '中' has no built-in glyph: cell 0, a blank");
    assert_eq(t_run_cell_r(0, 6), 0, "  nor has '😀'");
    # ⭐ AND THE PACKER DRAWS EVERY ONE OF THEM, BIT FOR BIT, from the run gpu.cyr hands it.
    var hmask = alloc(ae_text_bytes(7));
    assert_eq(ae_text_pack_1bpp(hmask, ae_text_run_ptr(0), ae_text_run_len(0)), 7 * FONT_ADV,
      "the packed run is 7 cells wide");
    assert_eq(t_mask_cell_is_r(hmask, 7, 0, 0x41), 1, "  cell 0 is kashi_glyph_row's 'A', bit for bit");
    assert_eq(t_mask_cell_is_r(hmask, 7, 1, 0x82), 1, "  cell 1 is 0x82's rows");
    assert_eq(t_mask_cell_is_r(hmask, 7, 2, 0xC4), 1, "  cell 2 is 0xC4's");
    assert_eq(t_mask_cell_is_r(hmask, 7, 3, t_ell_cell_r()), 1, "  cell 3 is U+2026's extension glyph");
    assert_eq(t_mask_cell_is_r(hmask, 7, 4, t_repl_cell_r()), 1, "  cell 4 is U+FFFD's");
    assert_eq(t_mask_cell_is_r(hmask, 7, 5, 0), 1, "  cells 5 and 6 are blank");
    assert_eq(t_mask_cell_is_r(hmask, 7, 6, 0), 1, "  ...both");
    # ⚠ NON-VACUITY: the comparison must be able to fail. The ellipsis cell is not a blank, and the bits of an
    # 0xFF-masked cell (0x00, what a one-byte pool would store for 0x100) are not U+2026's.
    assert_eq(t_mask_cell_is_r(hmask, 7, 3, 0), 0, "  (and the ellipsis cell is NOT a blank — the check can fail)");
    assert_eq(t_mask_cell_is_r(hmask, 7, 4, t_ell_cell_r()), 0, "  (nor is U+FFFD's cell U+2026's)");
    # The cap is in cells: 64 two-byte scalars (128 bytes) fit one run, and 65 do not.
    ae_text_reset();
    var e64 = alloc(AE_TEXT_CHARS * 2 + 8);
    var ei = 0;
    while (ei < AE_TEXT_CHARS) {
        store8(e64 + ei * 2, 0xC3);
        store8(e64 + ei * 2 + 1, 0xA9);
        ei = ei + 1;
    }
    store8(e64 + AE_TEXT_CHARS * 2, 0);
    var ed0 = ae_text_dropped_get();
    assert_eq(ae_text_enqueue(e64, 0, 0, 0), 1, "64 'é' — 128 bytes — are ONE run: the cap counts cells");
    assert_eq(ae_text_run_len(0), AE_TEXT_CHARS, "  of 64 cells");
    store8(e64 + AE_TEXT_CHARS * 2, 0xC3);
    store8(e64 + AE_TEXT_CHARS * 2 + 1, 0xA9);
    store8(e64 + AE_TEXT_CHARS * 2 + 2, 0);
    assert_eq(ae_text_enqueue(e64, 0, 0, 0), 0, "  and 65 are refused");
    assert_eq(ae_text_dropped_get(), ed0 + 1, "  ...and counted");
    # ⛔ THE POOL IS SIZED FOR TWO-BYTE CELLS: fill every run to the cap and every cell must read back — a pool
    # sized one byte a cell would be half this and overrun the globals after it.
    ae_text_reset();
    store8(e64 + AE_TEXT_CHARS * 2, 0);
    var fq = 0;
    var facc = 0;
    while (fq < AE_TEXT_MAX) {
        facc = facc + ae_text_enqueue(e64, 0, 0, 0);
        fq = fq + 1;
    }
    assert_eq(facc, AE_TEXT_MAX, "AE_TEXT_MAX full-length runs of two-byte scalars all fit the pool");
    var fbad = 0;
    fq = 0;
    while (fq < AE_TEXT_MAX) {
        var fj = 0;
        while (fj < AE_TEXT_CHARS) {
            if (t_run_cell_r(fq, fj) != 0x82) { fbad = fbad + 1; }
            fj = fj + 1;
        }
        fq = fq + 1;
    }
    assert_eq(fbad, 0, "  and all 3072 of their cells read back as 'é'");
    assert_eq(ae_text_dropped_get(), ed0 + 1, "  with nothing refused");
    assert_eq(ae_text_gpu_ok_get(), 1, "  and the latch after the pool is intact");
    ae_text_reset();

    # ⛔ THE ONE-FRAME KILL SWITCH. draw_text enqueues BEFORE anyone knows the op will succeed, so a
    # refusing shader would mean captions absent on EVERY frame. gpu.cyr clears this flag on the first
    # refusal and draw_text must then take the CPU path again.
    ae_gpu_frame_ok = 1;
    assert_eq(ae_text_gpu_ok_get(), 1, "the GPU glyph path starts trusted");
    ae_text_reset();
    draw_text(fb_cpu, "queued", 0, 0, TCOL);
    assert_eq(ae_text_count(), 1, "on a GPU frame the run is QUEUED, not drawn");
    # ⚠ AND IT REPORTS THE WIDTH IT WILL DRAW — in cells, as the CPU path does — not its bytes.
    ae_text_reset();
    assert_eq(draw_text(fb_cpu, "é—中", 0, 0, TCOL), 3 * FONT_ADV, "a queued UTF-8 run reports 3 cells of width, not 8 bytes");
    assert_eq(ae_text_count(), 1, "  (it was queued)");
    ae_gpu_frame_ok = 0;
    assert_eq(draw_text(fb_cpu, "é—中", 0, 0, TCOL), 3 * FONT_ADV, "  the same as a CPU frame reports for it");
    ae_gpu_frame_ok = 1;
    ae_text_reset();
    ae_text_gpu_disable();
    ae_text_reset();
    draw_text(fb_cpu, "drawn", 0, 0, TCOL);
    assert_eq(ae_text_count(), 0, "after a refusal draw_text goes back to the CPU path");
    assert_eq(ae_text_gpu_ok_get(), 0, "...and stays disabled for the rest of the run");
    ae_text_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_text_reset();

    # ⭐⭐ `AE-9` — the chrome rect queue. A wrong rect here is a hole in the frame, because with the
    # chrome on the GPU there is no userland framebuffer copy to fall back on after the fact.
    test_group("render — AE-9: chrome rects queue, clip, and refuse honestly");
    var rfb = bhumi_fb_new(400, 300);
    ae_gpu_frame_ok = 0;
    assert_eq(ae_chrome_on_gpu(), 0, "no GPU frame ⇒ chrome stays on the CPU");
    ae_gpu_frame_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "GPU frame + trusted path ⇒ chrome goes to #88");

    ae_rect_reset();
    assert_eq(ae_rect_count(), 0, "reset empties the queue");
    fill_rect(rfb, 10, 20, 30, 40, 0x00112233);
    assert_eq(ae_rect_count(), 1, "on a GPU frame fill_rect QUEUES instead of writing pixels");
    assert_eq(ae_rect_get_x(0), 10, "x carried");
    assert_eq(ae_rect_get_y(0), 20, "y carried");
    assert_eq(ae_rect_get_w(0), 30, "w carried");
    assert_eq(ae_rect_get_h(0), 40, "h carried");
    assert_eq(ae_rect_get_col(0), 0x00112233, "colour carried");
    # ⛔ AND IT MUST NOT HAVE TOUCHED THE FRAMEBUFFER. A fill that both queues and draws would double-paint
    # on the fallback path and waste the whole point on the GPU path.
    assert_eq(bhumi_fb_get(rfb, 15, 25), 0x00000000, "the framebuffer was NOT written");

    # ⛔ CLIPPING HAPPENS IN THE QUEUE, because `#88` REFUSES an out-of-range rect where `fill_rect` always
    # clipped silently. A window dragged one pixel past the edge must not retire the chrome path.
    ae_rect_reset();
    fill_rect(rfb, 0 - 10, 0 - 5, 30, 20, 0x00445566);
    assert_eq(ae_rect_count(), 1, "a partly off-screen rect is queued");
    assert_eq(ae_rect_get_x(0), 0, "clipped to x=0");
    assert_eq(ae_rect_get_y(0), 0, "clipped to y=0");
    assert_eq(ae_rect_get_w(0), 20, "width reduced by the clip (30 - 10)");
    assert_eq(ae_rect_get_h(0), 15, "height reduced by the clip (20 - 5)");
    ae_rect_reset();
    fill_rect(rfb, 390, 290, 100, 100, 0x00778899);
    assert_eq(ae_rect_get_w(0), 10, "clipped against the right edge");
    assert_eq(ae_rect_get_h(0), 10, "clipped against the bottom edge");
    ae_rect_reset();
    fill_rect(rfb, 500, 500, 10, 10, 0x00AABBCC);
    assert_eq(ae_rect_count(), 0, "a fully off-screen rect queues NOTHING");
    assert_eq(bhumi_fb_get(rfb, 0, 0), 0x00000000, "...and draws nothing either");

    # The clear band rides the same path as a full-width rect.
    ae_rect_reset();
    rend_clear_band(rfb, 50, 60, 0x00121218);
    assert_eq(ae_rect_count(), 1, "the clear band is queued as one rect");
    assert_eq(ae_rect_get_x(0), 0, "band starts at x=0");
    assert_eq(ae_rect_get_w(0), 400, "band spans the full width");
    assert_eq(ae_rect_get_y(0), 50, "band y carried");
    assert_eq(ae_rect_get_h(0), 60, "band height carried");

    # ⛔ OVERFLOW REFUSES, IS COUNTED, AND FALLS BACK TO DRAWING — never a silently missing rect.
    ae_rect_reset();
    var ri = 0;
    while (ri < AE_RECT_MAX) { ae_rect_enqueue(rfb, 0, 0, 2, 2, 0x00010203); ri = ri + 1; }
    assert_eq(ae_rect_count(), AE_RECT_MAX, "the queue fills to exactly AE_RECT_MAX");
    var rd0 = ae_rect_dropped_get();
    assert_eq(ae_rect_enqueue(rfb, 0, 0, 2, 2, 0x00010203), 0, "and then refuses");
    assert_eq(ae_rect_dropped_get(), rd0 + 1, "...counted, because a silent drop is a lie");
    bhumi_fb_clear(rfb, 0x00000000);
    fill_rect(rfb, 100, 100, 4, 4, 0x00FF00FF);
    assert_eq(bhumi_fb_get(rfb, 101, 101), 0x00FF00FF, "a refused fill DRAWS instead — no hole in the frame");

    # ⛔ THE LATCH: once gpu.cyr retires the path, every later frame draws on the CPU.
    ae_rect_reset();
    ae_chrome_gpu_disable();
    assert_eq(ae_chrome_on_gpu(), 0, "a refusal retires the chrome path for the run");
    bhumi_fb_clear(rfb, 0x00000000);
    fill_rect(rfb, 5, 5, 4, 4, 0x0000FF00);
    assert_eq(ae_rect_count(), 0, "and fill_rect stops queueing");
    assert_eq(bhumi_fb_get(rfb, 6, 6), 0x0000FF00, "...drawing instead");
    ae_chrome_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_rect_reset();

    # ⛔⛔ THE WINDOW'S VERTICAL CONVENTION IS PINNED HERE. `win_h` is the CONTENT height and the titlebar
    # sits ABOVE it, so a window at y=100 with h=300 occupies **100..430**, not 100..400. Five consumers
    # had drifted into three conventions (see the note in src/window.cyr); these asserts are what stops
    # that happening again, and two of them below were CHANGED by the reconciliation rather than added —
    # they used to encode the wrong convention and passed.
    test_group("render — the window geometry convention (chrome is OUTSIDE win_h)");
    var win = win_new(1, 100, 100, 400, 300, "T");
    assert_eq(win_body_y(win), 130, "content begins one TITLEBAR_H below the window origin");
    assert_eq(win_total_h(win), 330, "on-screen height is TITLEBAR_H + content height");
    assert_eq(win_bottom_y(win), 430, "exclusive bottom edge is y + TITLEBAR_H + h");

    test_group("render — decoration hit-test");
    assert_eq(deco_hit(win, 50, 50), Deco.DECO_NONE, "outside window");
    assert_eq(deco_hit(win, 300, 250), Deco.DECO_BODY, "body");
    assert_eq(deco_hit(win, 200, 110), Deco.DECO_TITLEBAR, "titlebar drag strip");
    assert_eq(deco_hit(win, 485, 112), Deco.DECO_CLOSE, "close button");
    assert_eq(deco_hit(win, 463, 112), Deco.DECO_MAX, "maximize button");
    assert_eq(deco_hit(win, 440, 112), Deco.DECO_MIN, "minimize button");
    assert_eq(deco_hit(win, 497, 250), Deco.DECO_RESIZE_R, "right resize edge");
    # ⚠ 424..429 is the bottom grab strip now (430 - RESIZE_M), NOT 394..399.
    assert_eq(deco_hit(win, 300, 427), Deco.DECO_RESIZE_B, "bottom resize edge");
    assert_eq(deco_hit(win, 497, 427), Deco.DECO_RESIZE_BR, "bottom-right resize corner");
    # ⛔ THE REGRESSION GUARD. (300,397) was asserted as DECO_RESIZE_B for as long as this test existed,
    # because the window was believed to end at y+h=400. Under the real convention it is 33 px inside the
    # client surface — so a drag there would have started a RESIZE in the middle of a window's content.
    # If this line ever reads RESIZE_B again, the chrome-inside convention has come back.
    assert_eq(deco_hit(win, 300, 397), Deco.DECO_BODY, "y+h-3 is BODY, not the bottom edge (was wrong before)");
    # The exact boundaries, so an off-by-one in either direction fails.
    assert_eq(deco_hit(win, 300, 129), Deco.DECO_TITLEBAR, "last titlebar row");
    assert_eq(deco_hit(win, 300, 130), Deco.DECO_BODY, "first content row");
    assert_eq(deco_hit(win, 300, 429), Deco.DECO_RESIZE_B, "last row inside the window");
    assert_eq(deco_hit(win, 300, 430), Deco.DECO_NONE, "first row BELOW the window");

    # ⭐ comp_window_at must agree with deco_hit, and it did not: it ended the window at y+win_h too, so
    # a click in the bottom TITLEBAR_H rows of a live client surface found whatever was BEHIND the window.
    test_group("render — comp_window_at agrees with the same convention");
    var hc = comp_new();
    var hw = comp_create_window(hc, 100, 100, 400, 300, "H");
    assert_eq(comp_window_at(hc, 300, 110), hw, "titlebar row hits the window");
    assert_eq(comp_window_at(hc, 300, 250), hw, "content hits the window");
    assert_eq(comp_window_at(hc, 300, 420), hw, "the bottom TITLEBAR_H rows hit it too (they did NOT before)");
    assert_eq(comp_window_at(hc, 300, 429), hw, "last row inside");
    assert_eq(comp_window_at(hc, 300, 430), 0, "one row below is a MISS");
    assert_eq(comp_window_at(hc, 300, 99), 0, "one row above is a MISS");
    win_set_state(hw, WinState.WS_MINIMIZED);
    assert_eq(comp_window_at(hc, 300, 250), 0, "a minimized window is not hit");
    win_set_state(hw, WinState.WS_NORMAL);

    # ⛔ THE THEME BODY MUST REACH THE BOTTOM OF THE CONTENT RECT. `render_window` used to fill it with
    # height `h - TITLEBAR_H` while blitting the client surface at the same origin with height `h`, in the
    # SAME function — so the theme body stopped TITLEBAR_H short of the surface drawn over it. Invisible
    # whenever a client covered it, and 30 px short on the compositor's own clientless window.
    # ⚠ Added because a mutant restoring `h - TITLEBAR_H` PASSED the whole suite: nothing measured the
    # body's height, so that half of the reconciliation was untested until these four lines.
    test_group("render — the theme body fills the whole content rect");
    var bfb = bhumi_fb_new(240, 240);
    var BBG = 0x00090909;
    bhumi_fb_clear(bfb, BBG);
    var bwin = win_new(9, 20, 20, 160, 120, "B");     # content 20+30=50 .. 170, bottom edge 170
    render_window(bfb, bwin, 0);
    var body_col = ae_bhumi(rupa_theme_widget(rupa_theme_active()));
    assert_eq(bhumi_fb_get(bfb, 100, win_body_y(bwin) + 2), body_col, "body is painted just below the titlebar");
    assert_eq(bhumi_fb_get(bfb, 100, win_bottom_y(bwin) - 2), body_col,
      "body reaches the LAST content row — a short fill stops TITLEBAR_H above this");
    assert_eq(bhumi_fb_get(bfb, 100, win_bottom_y(bwin) + 2), BBG, "and stops at the bottom edge");
    assert(bhumi_fb_get(bfb, 100, win_y(bwin) + 2) != body_col, "the titlebar is not the body colour");

    test_group("render — bitmap text (kashi VGA 8x16)");
    kashi_font_init();
    assert_eq(kashi_font_is_ready(), 1, "kashi font initialized");
    assert_eq(kashi_font_width(KASHI_FONT_VGA_8X16), 8, "glyph width 8");
    assert_eq(kashi_font_height(KASHI_FONT_VGA_8X16), 16, "glyph height 16");
    assert_eq(text_width("Hi"), 17, "text width = 2*9 - 1");
    assert_eq(text_width(""), 0, "empty string has width 0");
    var tfb = bhumi_fb_new(16, 20);
    bhumi_fb_clear(tfb, 0);
    var white = bhumi_xrgb(255, 255, 255);
    draw_char(tfb, 'A', 0, 0, white);
    var setpx = 0;
    var yy = 0;
    while (yy < 16) {
        var xx = 0;
        while (xx < 8) {
            if (bhumi_fb_get(tfb, xx, yy) == white) { setpx = setpx + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    var some = (setpx > 0);
    assert(some, "'A' glyph drew pixels");
    var notall = (setpx < 128);
    assert(notall, "'A' glyph is not a solid block");

    # ⭐⭐ TEXT IS UTF-8: ONE SCALAR, ONE CELL. Rust's draw_text walks `text.chars()` and advances a cell for every
    # char, drawn or not, and its text_width is `chars().count() * advance - 1`. The port did both per BYTE, so
    # "é" (C3 A9) drew `├⌐` in two cells and measured 17 px.
    test_group("render — text is UTF-8: one scalar, one cell (Rust's chars())");
    ae_gpu_frame_ok = 0;
    assert_eq(text_width("é"), 8, "'é' is ONE cell wide (2 bytes: byte-wise it measured 17 px)");
    assert_eq(text_width("—"), 8, "'—' is one cell (3 bytes)");
    assert_eq(text_width("😀"), 8, "'😀' is one cell (4 bytes)");
    assert_eq(text_width("中文"), 17, "two CJK scalars are two cells — blank ones still count, as in Rust");
    assert_eq(text_width("\xFF\xFE"), 17, "two ill-formed bytes are two U+FFFD cells");
    assert_eq(text_width("a\xE2\x80"), 17, "'a' then E2 80 cut short by the NUL: two cells");
    assert_eq(text_width("Hé—中"), 35, "a mix: 4 scalars, 4 cells");
    var ufb = bhumi_fb_new(64, 40);
    var UC = 0x00E0E0E0;
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text(ufb, "é", 0, 0, UC), FONT_ADV, "draw_text 'é' advances ONE cell");
    assert_eq(t_cell_is_r(ufb, 0, 0, 0x82, UC), 1, "  and draws CP437 0x82, 'é', exactly");
    assert_eq(t_count_px_r(ufb, FONT_ADV, 64, 0, 40, UC), 0, "  with nothing in a second cell — not `├⌐`");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text(ufb, "—", 0, 0, UC), FONT_ADV, "'—' has no CP437 cell: it still advances one cell");
    assert_eq(t_count_px_r(ufb, 0, 64, 0, 40, UC), 0, "  and draws NOTHING — a blank cell, like Rust's unknown char");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text(ufb, "a中b", 0, 0, UC), 3 * FONT_ADV, "'a中b' is three cells");
    assert_eq(t_cell_is_r(ufb, 0, 0, 'a', UC), 1, "  'a' in cell 0");
    assert_eq(t_cell_is_r(ufb, FONT_ADV, 0, 0, UC), 1, "  cell 1 blank — '中' has no built-in glyph");
    assert_eq(t_cell_is_r(ufb, 2 * FONT_ADV, 0, 'b', UC), 1, "  and 'b' in cell 2: the blank cell kept its advance");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text(ufb, "\xFF", 0, 0, UC), FONT_ADV, "an ill-formed byte is one cell");
    assert_eq(t_cell_is_r(ufb, 0, 0, t_repl_cell_r(), UC), 1, "  drawn as U+FFFD's glyph, exactly");
    assert_eq(t_gt_r(t_count_px_r(ufb, 0, FONT_ADV, 0, 16, UC), 20), 1, "  (which has ink: the check is not of a blank)");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text(ufb, "…", 0, 0, UC), FONT_ADV, "'…' is one cell");
    assert_eq(t_cell_is_r(ufb, 0, 0, t_ell_cell_r(), UC), 1, "  kashi 1.1.0's own glyph for it — byte-wise, `ΓÇª`");

    test_group("render — draw_text_lines decodes too, and a newline still breaks the line");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text_lines(ufb, "é\n—x", 0, 0, UC), FONT_H + 2, "two lines: one break's height");
    assert_eq(t_cell_is_r(ufb, 0, 0, 0x82, UC), 1, "  line 1: 'é', one cell");
    assert_eq(t_count_px_r(ufb, FONT_ADV, 64, 0, FONT_H, UC), 0, "  and nothing after it");
    assert_eq(t_cell_is_r(ufb, 0, FONT_H + 2, 0, UC), 1, "  line 2: '—', a blank cell");
    assert_eq(t_cell_is_r(ufb, FONT_ADV, FONT_H + 2, 'x', UC), 1, "  then 'x' one cell along");
    bhumi_fb_clear(ufb, 0);
    assert_eq(draw_text_lines(ufb, "\xE2\x80\nA", 0, 0, UC), FONT_H + 2, "a sequence cut short by a newline still breaks");
    assert_eq(t_cell_is_r(ufb, 0, 0, t_repl_cell_r(), UC), 1, "  E2 80 is ONE U+FFFD");
    assert_eq(t_cell_is_r(ufb, FONT_ADV, 0, 0, UC), 1, "  and only one");
    assert_eq(t_cell_is_r(ufb, 0, FONT_H + 2, 'A', UC), 1, "  and 'A' starts line 2");

    # ⛔ THE CELL MAP READS kashi's TABLES, SO EVERY TEXT ENTRY POINT BRINGS THEM UP ITSELF. Before
    # `kashi_font_init` the high half of `kashi_cp437_from_unicode` answers 0 — and a queued run is decoded at
    # ENQUEUE, so a cell mapped too early would sit in the pool as a blank however soon the font came up. The
    # pre-init state is put back by hand each time: kashi's count of index entries, and render.cyr's latch.
    test_group("render — every text entry point brings the font up before it maps a cell");
    kashi_cp437_n = 0;
    ae_font_ready = 0;
    assert_eq(kashi_cp437_from_unicode(0xE9), 0, "precondition: with kashi's index empty, 'é' maps to nothing");
    ae_text_reset();
    ae_text_enqueue("é", 0, 0, 0);
    assert_eq(t_run_cell_r(0, 0), 0x82, "ae_text_enqueue maps 'é' to 0x82 all the same: it brought the font up first");
    ae_text_reset();
    kashi_cp437_n = 0;
    ae_font_ready = 0;
    bhumi_fb_clear(ufb, 0);
    draw_text_lines(ufb, "é", 0, 0, UC);
    assert_eq(t_cell_is_r(ufb, 0, 0, 0x82, UC), 1, "draw_text_lines draws 'é' all the same");
    kashi_cp437_n = 0;
    ae_font_ready = 0;
    bhumi_fb_clear(ufb, 0);
    draw_text(ufb, "é", 0, 0, UC);
    assert_eq(t_cell_is_r(ufb, 0, 0, 0x82, UC), 1, "and so does draw_text");
    assert_eq(kashi_cp437_n, 128, "  (and kashi's index is whole again)");

    # ⭐ CLIPPING — fill_rect and blit_rect clamp the rectangle ONCE and then walk rows, rather
    # than testing every pixel against the bounds. That is a 8.7x speedup and it is also where a
    # clamp-once rewrite can silently disagree with the per-pixel original, so every edge is
    # asserted here rather than inferred from "the suite still passes". The old loop's behaviour
    # is the contract: out-of-bounds pixels are DROPPED, never wrapped and never clamped onto the
    # edge, and the in-bounds remainder is unaffected.
    test_group("render — fill_rect clipping");
    var cfb = bhumi_fb_new(20, 10);
    var red = bhumi_xrgb(255, 0, 0);
    var blu = bhumi_xrgb(0, 0, 255);

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 2, 2, 4, 3, red);
    assert_eq(bhumi_fb_get(cfb, 2, 2), red, "in-bounds: first pixel");
    assert_eq(bhumi_fb_get(cfb, 5, 4), red, "in-bounds: last pixel");
    assert_eq(bhumi_fb_get(cfb, 6, 2), 0, "in-bounds: one past the right edge untouched");
    assert_eq(bhumi_fb_get(cfb, 2, 5), 0, "in-bounds: one past the bottom edge untouched");
    assert_eq(bhumi_fb_get(cfb, 1, 2), 0, "in-bounds: one before the left edge untouched");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 0 - 3, 1, 5, 2, red);
    assert_eq(bhumi_fb_get(cfb, 0, 1), red, "clipped left: column 0 filled");
    assert_eq(bhumi_fb_get(cfb, 1, 1), red, "clipped left: the surviving 2 columns filled");
    assert_eq(bhumi_fb_get(cfb, 2, 1), 0, "clipped left: nothing beyond x+w");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 1, 0 - 2, 2, 5, red);
    assert_eq(bhumi_fb_get(cfb, 1, 0), red, "clipped top: row 0 filled");
    assert_eq(bhumi_fb_get(cfb, 1, 2), red, "clipped top: the surviving rows filled");
    assert_eq(bhumi_fb_get(cfb, 1, 3), 0, "clipped top: nothing beyond y+h");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 18, 8, 10, 10, red);
    assert_eq(bhumi_fb_get(cfb, 18, 8), red, "clipped bottom-right: the in-bounds corner is filled");
    assert_eq(bhumi_fb_get(cfb, 19, 9), red, "clipped bottom-right: last framebuffer pixel filled");
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "clipped bottom-right: no wrap to the far corner");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 50, 50, 4, 4, red);
    fill_rect(cfb, 0 - 50, 0 - 50, 4, 4, red);
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "fully offscreen draws nothing (positive and negative)");
    assert_eq(bhumi_fb_get(cfb, 19, 9), 0, "fully offscreen leaves the far corner alone");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 2, 2, 0, 5, red);
    fill_rect(cfb, 2, 2, 5, 0, red);
    fill_rect(cfb, 2, 2, 0 - 4, 5, red);
    fill_rect(cfb, 2, 2, 5, 0 - 4, red);
    assert_eq(bhumi_fb_get(cfb, 2, 2), 0, "zero and negative w/h draw nothing");

    test_group("render — blit_rect clipping");
    # 4x3 source, each pixel encodes its own (x,y) so a wrong offset is visible, not just wrong.
    var src = alloc(4 * 3 * 4);
    var sy2 = 0;
    while (sy2 < 3) {
        var sx2 = 0;
        while (sx2 < 4) {
            store32(src + (sy2 * 4 + sx2) * 4, bhumi_xrgb(0, sy2 + 1, sx2 + 1));
            sx2 = sx2 + 1;
        }
        sy2 = sy2 + 1;
    }

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 5, 4, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 5, 4), bhumi_xrgb(0, 1, 1), "in-bounds: src (0,0) lands at (5,4)");
    assert_eq(bhumi_fb_get(cfb, 8, 6), bhumi_xrgb(0, 3, 4), "in-bounds: src (3,2) lands at (8,6)");
    assert_eq(bhumi_fb_get(cfb, 9, 4), 0, "in-bounds: one past the right edge untouched");

    # ⛔ THE ONE THAT MATTERS. The per-pixel original got source clipping for free — a dropped
    # write still advanced the source index. Walking rows does not: the source pointer must be
    # advanced by exactly the amount the destination was clipped by, or a partly-offscreen window
    # draws the WRONG PART of its own surface, which reads as a corrupt client, not as a clip bug.
    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 0 - 2, 0 - 1, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 0, 0), bhumi_xrgb(0, 2, 3),
      "clipped top-left: (0,0) shows src (2,1), NOT src (0,0)");
    assert_eq(bhumi_fb_get(cfb, 1, 1), bhumi_xrgb(0, 3, 4),
      "clipped top-left: (1,1) shows src (3,2)");
    assert_eq(bhumi_fb_get(cfb, 2, 0), 0, "clipped top-left: nothing past the source's right edge");

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 18, 9, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 18, 9), bhumi_xrgb(0, 1, 1), "clipped bottom-right: corner pixel");
    assert_eq(bhumi_fb_get(cfb, 19, 9), bhumi_xrgb(0, 1, 2), "clipped bottom-right: second column");
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "clipped bottom-right: no wrap onto the next row");

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 50, 50, src, 4, 3);
    blit_rect(cfb, 3, 3, 0, 4, 3);
    blit_rect(cfb, 3, 3, src, 0, 3);
    blit_rect(cfb, 3, 3, src, 4, 0);
    assert_eq(bhumi_fb_get(cfb, 3, 3), 0, "offscreen, null src, and zero dims all draw nothing");

    # ================================================================
    # AE-7: the cursor's DAMAGE rect must match the cursor's BITMAP
    # ================================================================
    # ⛔ WHEN THE CURSOR GREW FROM A GLYPH TO AN ARROW, THIS WAS THE SILENT HAZARD. The damage rect was
    # `FONT_W + 2` x `FONT_H + 2` (10x18) — which happens to be *almost* the arrow's 10x20, so a stale rect
    # would smear only the bottom two rows and only while moving. That is exactly the kind of defect that
    # survives a screenshot and shows up as "the pointer leaves a trail" three burns later.
    test_group("render — the cursor damages its own extent, and nothing when it is still");
    ae_ptr_x = 0; ae_ptr_y = 0;
    rend_cursor_mark_drawn(0, 0);
    var cd = rend_dmg_new();
    # Still -> no damage at all. This is what keeps an idle desktop free under AE-0a.
    assert_eq(rend_cursor_damage(cd), 0, "a stationary cursor returns 0");
    assert_eq(rend_dmg_valid(cd), 0, "a stationary cursor damages NOTHING");
    # Moved -> union of old and new, each the full bitmap extent.
    input_ptr_set(100, 200);
    rend_cursor_damage(cd);
    assert_eq(rend_dmg_valid(cd), 1, "a moved cursor damages");
    assert_eq(rend_dmg_x(cd), 0, "  union starts at the OLD position");
    assert_eq(rend_dmg_y(cd), 0, "  union starts at the OLD position");
    # old rect (0,0,w,h) + new rect (100,200,w,h) -> union is 100+w wide, 200+h tall.
    assert_eq(rend_dmg_w(cd), 100 + cursor_w(), "  union spans to the NEW rect's right edge");
    assert_eq(rend_dmg_h(cd), 200 + cursor_h(), "  union spans to the NEW rect's bottom edge");
    # ⭐ THE ASSERTION THAT CATCHES A FONT-SIZED RECT: the extent is the cursor's, not the glyph's.
    assert_eq(cursor_w(), 10, "  and that extent is the bitmap's width");
    assert_eq(cursor_h(), 20, "  and the bitmap's height (a FONT_H+2 rect would be 18 and smear)");
    # A single un-moved settle then re-damages nothing, proving mark_drawn pairs with the damage.
    rend_cursor_mark_drawn(100, 200);
    rend_dmg_clear(cd);
    assert_eq(rend_cursor_damage(cd), 0, "settled at the new position -> free again");
    assert_eq(rend_dmg_valid(cd), 0, "  and nothing damaged");

    # ================================================================
    # AE-7: a retired GPU cursor must FALL BACK, not vanish
    # ================================================================
    # ⛔⛔ THE BUG THIS CATCHES WAS SHIPPED AND CAUGHT BY A DEAD-CODE AUDIT, NOT BY A TEST. `render_cursor`
    # QUEUES for the GPU instead of drawing, so when the emit refused, the pointer was absent for that frame
    # — and because the next frame queues and refuses again, absent FOREVER, with one log line. That is
    # precisely what a refused glyph did to every caption on the desktop on 1.56.42, reproduced in the
    # cursor path by the fix for it.
    # ⇒ `ae_cursor_gpu_disable()` must send the next frame to `render_cursor_cpu`, which draws per-pixel and
    # cannot be refused. Verified by DRAWN PIXELS, not by a flag.
    test_group("render — a retired GPU cursor falls back to the CPU and is still drawn");
    var curfb = bhumi_fb_new(64, 64);
    ae_ptr_x = 0; ae_ptr_y = 0;
    input_ptr_set(4, 4);
    # A GPU frame with the cursor path healthy: render_cursor QUEUES and draws NOTHING itself.
    ae_gpu_frame_ok = 1;
    ae_text_gpu_ok = 1;
    ae_cursor_gpu_ok = 1;
    ae_cursor_q_clear();
    render_cursor(curfb);
    assert_eq(ae_cursor_q_pending(), 1, "a healthy GPU frame QUEUES the cursor");
    assert_eq(ae_cursor_q_x(), 4, "  at the pointer x");
    assert_eq(ae_cursor_q_y(), 4, "  at the pointer y");
    # ⭐ AND IT DREW NOTHING — which is exactly why a refusal used to lose the pointer entirely.
    assert_eq(bhumi_fb_get(curfb, 4, 4), 0, "  and drew NO pixel itself (the emit owes it)");

    # Now retire it, as gpu.cyr does on a refusal, and demand real pixels.
    ae_cursor_gpu_disable();
    assert_eq(ae_cursor_gpu_ok_get(), 0, "the cursor GPU path is retired");
    # ⛔⛔ THE ASSERTION THAT WOULD HAVE CAUGHT A SHIPPED-BUT-USELESS FIX. Falling back to the CPU is only
    # a fix if those pixels reach the panel, and they only do when the `#39` blit runs — which
    # `ae_chrome_on_gpu()` decides. It consulted `ae_text_gpu_ok` alone, so retiring the CURSOR left chrome
    # on the GPU, the blit skipped, and `render_cursor_cpu` painting into a buffer nothing copies. The
    # "fix" for an invisible cursor produced an invisible cursor. Found by audit, not by the test above —
    # which passes either way, because it only checks which BRANCH runs.
    assert_eq(ae_chrome_on_gpu(), 0, "a retired CURSOR pulls chrome off the GPU too, restoring the #39 blit");
    ae_cursor_q_clear();
    render_cursor(curfb);
    assert_eq(ae_cursor_q_pending(), 0, "a retired path does NOT queue");
    # ⛔⛔ PRE-FILL, OR THIS ENTIRE CHECK IS VACUOUS — and the first version of it was. The outline colour is
    # `bhumi_xrgb(0,0,0)` = **0**, which is byte-identical to an untouched framebuffer: a `!= 0` count sees
    # only the FILL (73 of 131 pixels), and `assert_eq(fb_get(tip), xrgb(0,0,0))` passes on a zeroed buffer
    # whether or not anything was drawn. Painting a distinctive background first makes "black" an observable
    # WRITE instead of an absence. [[feedback_instrument_discipline]] rule 2 — calibrate the null.
    # ⚠ PAINTED WITH `bhumi_fb_set` DIRECTLY, not `fill_rect`: this test needs `ae_gpu_frame_ok == 1` (that
    # is the whole point — the LATCH, not the frame kind, must cause the fallback), and on a GPU frame
    # `fill_rect` enqueues for the shader instead of touching the buffer. Measured: it painted nothing and
    # the count read 200, i.e. the full bitmap box differing from a background that was never there.
    var BG = bhumi_xrgb(9, 9, 9);
    var by = 0;
    while (by < 40) {
        var bx = 0;
        while (bx < 32) { bhumi_fb_set(curfb, bx, by, BG); bx = bx + 1; }
        by = by + 1;
    }
    assert_eq(bhumi_fb_get(curfb, 4, 4), BG, "  precondition: the tip pixel starts as background");
    assert_eq(ae_gpu_frame_ok, 1, "  precondition: this IS a GPU frame -- the latch is what redirects it");
    ae_cursor_q_clear();
    render_cursor(curfb);
    # The tip is at the hotspot and it is outline (black); the body is white. Both are now REAL writes.
    assert_eq(bhumi_fb_get(curfb, 4, 4), bhumi_xrgb(0, 0, 0), "the TIP is drawn on the CPU, in outline black");
    assert_eq(bhumi_fb_get(curfb, 5, 6), bhumi_xrgb(255, 255, 255), "the BODY is drawn on the CPU, in fill white");
    # Count what CHANGED from the background, so neither a one-pixel stub nor a fill-only draw can pass.
    var drawn = 0;
    var cy2 = 0;
    while (cy2 < cursor_h()) {
        var cx2 = 0;
        while (cx2 < cursor_w()) {
            if (bhumi_fb_get(curfb, 4 + cx2, 4 + cy2) != BG) { drawn = drawn + 1; }
            cx2 = cx2 + 1;
        }
        cy2 = cy2 + 1;
    }
    assert_eq(drawn, t_layer_count_r(CursorK.CUR_FILL) + t_layer_count_r(CursorK.CUR_OUTLINE),
      "every fill AND outline pixel of the arrow reached the framebuffer");
    assert_eq(t_gt_r(t_layer_count_r(CursorK.CUR_OUTLINE), 0), 1, "  (and the outline count is non-zero)");
    # ⚠ Restore, or every later assertion inherits a retired cursor.
    ae_cursor_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_cursor_q_clear();

    # ================================================================
    # AE-7 iron regression: the glyph run that retired the whole text path
    # ================================================================
    # ⛔ THE 1.56.42 BURN. `#92` op 0x03 REFUSES an out-of-range rect (it does not clip), and the cursor
    # was then a GLYPH at the cursor position. The position was clamped to `bound_w - 1`, so an 8 px glyph
    # at x=2559 on a 2560-wide back buffer reached 2567, the op refused, `ae_text_gpu_disable()` retired the
    # path for the session — and every glyph on the desktop disappeared, titles included.
    # ⇒ The enqueue must refuse locally, exactly as `ae_rect_enqueue` already does for `#88`.
    # ⚠ THE CURSOR NO LONGER TAKES THIS PATH — it is a real bitmap in `src/cursor.cyr` and CLIPS instead of
    # refusing, so the pointer can sit on the last pixel. This guard is still load-bearing for CAPTIONS,
    # which have no clipping of their own, and the cursor is only how it was found.
    test_group("render — a text run outside the back buffer is refused LOCALLY, not by the kernel");
    var tfb2 = bhumi_fb_new(2560, 1440);
    ae_text_reset();
    ae_text_gpu_ok = 1;
    assert_eq(ae_text_fits(tfb2, "A", 100, 100), 1, "a run well inside fits");
    # One 8x16 glyph at 2559 ends at 2567 — the exact case the burn hit.
    assert_eq(ae_text_fits(tfb2, "A", 2559, 700), 0, "a glyph past the RIGHT edge does NOT fit");
    assert_eq(ae_text_fits(tfb2, "A", 700, 1439), 0, "a glyph past the BOTTOM edge does NOT fit");
    assert_eq(ae_text_fits(tfb2, "A", 0 - 1, 100), 0, "a negative x does not fit");
    assert_eq(ae_text_fits(tfb2, "A", 100, 0 - 1), 0, "a negative y does not fit");
    # The exact boundary, so an off-by-one in either direction fails.
    # ⚠ 2551, not 2552: `ae_text_width` is `n * FONT_ADV` and FONT_ADV is 9 (an 8 px glyph plus 1 px of
    # spacing), so one character occupies 9 columns. Deriving this from the constant rather than assuming
    # the glyph width is what makes the boundary assert meaningful.
    assert_eq(ae_text_fits(tfb2, "A", 2551, 700), 1, "the LAST fully-inside x fits (2551 + 9 = 2560)");
    assert_eq(ae_text_fits(tfb2, "A", 2552, 700), 0, "one past it does NOT");
    assert_eq(ae_text_fits(tfb2, "A", 700, 1424), 1, "the LAST fully-inside y fits");
    # A multi-character run must account for its whole width, not one glyph.
    assert_eq(ae_text_fits(tfb2, "AAAA", 2524, 700), 1, "a 4-char run ending exactly at the edge fits");
    assert_eq(ae_text_fits(tfb2, "AAAA", 2530, 700), 0, "...and one that overruns it does not (whole RUN width, not one glyph)");
    # ⚠ The run's width is its CELLS: four 'é' are eight bytes and 36 px, so they fit exactly where four 'A' do.
    assert_eq(ae_text_fits(tfb2, "éééé", 2524, 700), 1, "four two-byte scalars are 4 cells wide, not 8: they fit at 2524");
    assert_eq(ae_text_fits(tfb2, "éééé", 2525, 700), 0, "  ...and one pixel further they do not");
    # ⚠ And a refusal must NOT retire the path — that is the difference between one missing frame and a
    # blank desktop for the session.
    assert_eq(ae_text_gpu_ok_get(), 1, "a locally-refused run leaves the GPU text path ENABLED");

    # ================================================================
    # Window titles: Rust's truncation, and a caption the glyph queue can always carry
    # ================================================================
    # ⭐ Parity: renderer.rs:543-562 cuts a title wider than `width - 80` to `max_chars = (width - 80) / 6`
    # cells — `max_chars - 1` chars, then '…' — and draws it whole when `max_chars <= 2`. Mapped: the box runs
    # from the title inset (x + 6) to 6 px short of the minimize button — `w - 80` again with these buttons —
    # a cell is FONT_ADV (9), and the ellipsis is Rust's own '…' in ONE cell, kashi 1.1.0's extension glyph.
    # (Until kashi had one it was three ASCII dots in the last three cells, two fewer of the title's chars.)
    # ⛔ READ OFF THE GPU QUEUE. On a GPU frame `draw_text` queues the caption instead of drawing it, so the
    # queued run is exactly what reaches the panel — and "not queued" is the invisible-title bug itself.
    test_group("render — a window title truncates like Rust's (renderer.rs:543-562)");
    var tlfb = bhumi_fb_new(1200, 120);
    ae_gpu_frame_ok = 1;
    ae_text_gpu_ok = 1;
    var tlw = win_new(70, 20, 10, 200, 60, "puka");       # box: 200 - 80 = 120 px = 13 cells
    var tlink = ae_bhumi(rupa_theme_ink(rupa_theme_active()));
    assert_eq(t_title_q_r(tlfb, tlw), 1, "a short title queues ONE run");
    assert_eq(ae_text_run_len(0), 4, "  drawn whole");
    assert_eq(t_run_prefix_r(0, "puka", 4), 1, "  ...the title's own characters, a cell each");
    assert_eq(ae_text_run_x(0), 26, "  at the title inset, x + 6");
    assert_eq(ae_text_run_y(0), 17, "  on the titlebar's glyph row, y + (TITLEBAR_H - FONT_H) / 2");
    assert_eq(ae_text_run_col(0), tlink, "  in the focused window's ink");
    win_set_title(tlw, "A window title far too long for its titlebar");
    t_title_q_r(tlfb, tlw);
    assert_eq(ae_text_run_len(0), 13, "a 44-character title is cut to 120 / 9 = 13 cells, Rust's max_chars");
    assert_eq(t_run_prefix_r(0, "A window tit", 12), 1, "  the first 12 — Rust's max_chars - 1 — are the title's");
    assert_eq(t_run_ell_r(0), 1, "  ...and the 13th is the ellipsis, ONE cell (it was three ASCII dots)");
    assert_eq(t_gt_r(ae_text_run_x(0) + ae_text_width(ae_text_run_len(0)), deco_min_x(tlw) - 6), 0,
      "  and it stops at least 6 px short of the minimize button, never under it");
    # The boundary, both sides, in a box EXACTLY 13 cells wide: 196 - 80 = 116 = 13 * 9 - 1. Rust's test is
    # `text_width > max`, strict, so 13 characters fit and 14 are cut to 116 / 9 = 12 cells.
    win_resize(tlw, 196, 60);
    win_set_title(tlw, "ABCDEFGHIJKLM");
    t_title_q_r(tlfb, tlw);
    assert_eq(ae_text_run_len(0), 13, "a title exactly as wide as its box is drawn whole");
    assert_eq(t_run_ell_r(0), 0, "  with no ellipsis");
    win_set_title(tlw, "ABCDEFGHIJKLMN");
    t_title_q_r(tlfb, tlw);
    assert_eq(ae_text_run_len(0), 12, "one character more is cut to 12 cells");
    assert_eq(t_run_prefix_r(0, "ABCDEFGHIJK", 11), 1, "  'ABCDEFGHIJK' — eleven of the title's —");
    assert_eq(t_run_ell_r(0), 1, "  then '…'");
    # ⚠ THE SAME BOUNDARY, MEASURED IN SCALARS. 'Ä' is two bytes, so this 13-character title is 14 bytes: wide
    # enough to cut if the box were compared with its byte width (125 px), and exactly as wide as the box in cells.
    win_set_title(tlw, "ÄBCDEFGHIJKLM");
    t_title_q_r(tlfb, tlw);
    assert_eq(ae_text_run_len(0), 13, "a 13-scalar, 14-byte title exactly as wide as its box is drawn whole");
    assert_eq(t_run_cell_r(0, 0), 0x8E, "  'Ä' its one cell, CP437 0x8E");
    assert_eq(t_run_ell_r(0), 0, "  with no ellipsis");
    win_resize(tlw, 200, 60);
    win_set_title(tlw, "A window title far too long for its titlebar");
    # ⭐ AND THE CPU FRAME DRAWS THE SAME CAPTION. A sentinel background makes "no ink" a real observation.
    ae_gpu_frame_ok = 0;
    var TLBG = 0x00ABCDEF;
    var tly = 10 + (TITLEBAR_H - FONT_H) / 2;             # the glyph row's top
    bhumi_fb_clear(tlfb, TLBG);
    render_window(tlfb, tlw, 1);
    # ⭐ The last cell is kashi's U+2026: three 2x2 dots packed into ONE cell (0xDB on rows 10-11), the 12 pixels
    # the ASCII "..." spread over three — and the cell before it is the title's again.
    assert_eq(t_cell_is_r(tlfb, 26 + 12 * FONT_ADV, tly, t_ell_cell_r(), tlink), 1,
      "CPU frame: the last cell is U+2026's glyph, exactly");
    assert_eq(t_count_px_r(tlfb, 26 + 12 * FONT_ADV, 26 + 13 * FONT_ADV, tly, tly + FONT_H, tlink), 12,
      "  12 pixels, in one cell");
    assert_eq(t_cell_is_r(tlfb, 26 + 11 * FONT_ADV, tly, 't', tlink), 1,
      "  and the cell before it is the title's 12th character, 't'");
    assert_eq(t_count_px_r(tlfb, 26 + 13 * FONT_ADV, deco_min_x(tlw), tly, tly + FONT_H, tlink), 0,
      "  no title ink between the caption and the minimize button");
    assert_eq(t_count_px_r(tlfb, 220, 1200, tly, tly + FONT_H, tlink), 0,
      "  and none right of the window (uncut, it ran to x = 422)");
    ae_gpu_frame_ok = 1;

    # ⭐ RUST'S NARROW-WINDOW RULE: a box of 2 cells or fewer draws the title WHOLE, not as a stub.
    test_group("render — a very narrow window draws its whole title (Rust's max_chars <= 2)");
    var tln = win_new(71, 20, 10, 106, 60, "Terminal emulator");   # box 26 px = 2 cells
    assert_eq(t_title_q_r(tlfb, tln), 1, "a 2-cell box queues the title");
    assert_eq(ae_text_run_len(0), 17, "  WHOLE: all 17 characters, past the window's own edge");
    assert_eq(t_run_ell_r(0), 0, "  and no ellipsis");
    win_resize(tln, 107, 60);                                       # box 27 px = 3 cells
    t_title_q_r(tlfb, tln);
    assert_eq(ae_text_run_len(0), 3, "one pixel wider is 3 cells: cut, two of the title's and the ellipsis");
    assert_eq(t_run_prefix_r(0, "Te", 2), 1, "  'Te'");
    assert_eq(t_run_ell_r(0), 1, "  then '…' — the ASCII dots used to fill all three cells and leave no title");
    # ⛔⛔ AND WHOLE CAN RUN OFF THE SCREEN WHILE THE WINDOW DOES NOT. Flush with the right edge of a 400 px
    # framebuffer, the 17-character title runs to x = 459: `ae_text_fits` dropped it, every GPU frame.
    var tlfbe = bhumi_fb_new(400, 120);
    win_resize(tln, 100, 60);
    win_move(tln, 300, 10);
    assert_eq(t_title_q_r(tlfbe, tln), 1, "a narrow window flush with the right edge still queues its title");
    assert_eq(ae_text_run_x(0), 306, "  at the title inset");
    assert_eq(ae_text_run_len(0), 10, "  the 10 cells that end by x = 400");
    assert_eq(t_run_prefix_r(0, "Terminal e", 10), 1, "  'Terminal e' — the screen cuts it, not an ellipsis");

    # ⛔⛔ THE RUN LIMIT. A 100-character title on a 1000 px window fits Rust's box (920 px = 102 cells), but
    # `ae_text_enqueue` refuses a run over AE_TEXT_CHARS and its CPU fallback is never presented on a GPU
    # frame — the title was invisible there, and only there.
    test_group("render — a title longer than AE_TEXT_CHARS still reaches a GPU frame");
    var tllong = alloc(AE_TEXT_CHARS + 40);
    var tli = 0;
    while (tli < 100) { store8(tllong + tli, 'A' + (tli % 26)); tli = tli + 1; }
    store8(tllong + 100, 0);
    var tlwide = win_new(72, 0, 10, 1000, 60, tllong);
    var tld0 = ae_text_dropped_get();
    assert_eq(t_title_q_r(tlfb, tlwide), 1, "a 100-character title on a wide window QUEUES");
    assert_eq(ae_text_dropped_get(), tld0, "  ...and the queue refused nothing");
    assert_eq(ae_text_run_len(0), AE_TEXT_CHARS, "  cut to the queue's run limit");
    assert_eq(t_run_prefix_r(0, tllong, AE_TEXT_CHARS - 1), 1, "  the title's first 63 characters");
    assert_eq(t_run_ell_r(0), 1, "  ...then the ellipsis, because it IS cut");
    # ⛔⛔ AND WHEN RUST'S BOX CUTS IT TOO. At 800 px the box is 720 px, narrower than the title's 899, so
    # Rust's cut applies — to 720 / 9 = 80 cells, still over the run limit. A caption of `max_chars` there
    # is refused by the queue, and the title is invisible again on every GPU frame.
    win_resize(tlwide, 800, 60);
    tld0 = ae_text_dropped_get();
    assert_eq(t_title_q_r(tlfb, tlwide), 1, "a 100-character title the box cuts to 80 cells QUEUES");
    assert_eq(ae_text_dropped_get(), tld0, "  ...and the queue refused nothing");
    assert_eq(ae_text_run_len(0), AE_TEXT_CHARS, "  capped to 64, not Rust's 80");
    assert_eq(t_run_prefix_r(0, tllong, AE_TEXT_CHARS - 1), 1, "  the title's first 63 characters");
    assert_eq(t_run_ell_r(0), 1, "  ...then the ellipsis");
    win_resize(tlwide, 1000, 60);
    # The limit's boundary: exactly AE_TEXT_CHARS is drawn whole; one more is cut back to it.
    store8(tllong + AE_TEXT_CHARS, 0);
    t_title_q_r(tlfb, tlwide);
    assert_eq(ae_text_run_len(0), AE_TEXT_CHARS, "exactly 64 characters are drawn whole");
    assert_eq(t_run_ell_r(0), 0, "  with no ellipsis");
    store8(tllong + AE_TEXT_CHARS, 'A' + (AE_TEXT_CHARS % 26));
    store8(tllong + AE_TEXT_CHARS + 1, 0);
    tld0 = ae_text_dropped_get();
    assert_eq(t_title_q_r(tlfb, tlwide), 1, "65 characters QUEUE");
    assert_eq(ae_text_run_len(0), AE_TEXT_CHARS, "  cut back to 64");
    assert_eq(t_run_ell_r(0), 1, "  ending in '…', the same cut as Rust's box");
    assert_eq(ae_text_dropped_get(), tld0, "  and nothing was refused");

    # ⛔⛔ THE SCREEN EDGE. `ae_text_fits` drops a run that leaves the framebuffer (`#92` op 0x03 refuses
    # rather than clips), so a window partly off screen lost its whole title on every GPU frame while its
    # rects, clipped by `ae_rect_enqueue`, still drew.
    test_group("render — a window past the screen edge keeps the part of its title that is on screen");
    var tlr = win_new(73, 300, 10, 300, 60, "Window past the right edge");   # runs to x = 600 of 400
    assert_eq(t_title_q_r(tlfbe, tlr), 1, "a window past the RIGHT edge still queues its title");
    assert_eq(ae_text_run_x(0), 306, "  at the title inset");
    assert_eq(ae_text_run_len(0), 10, "  the 10 cells that end by x = 400 (306 + 10 * 9 = 396)");
    assert_eq(t_run_prefix_r(0, "Window pas", 10), 1, "  'Window pas'");
    # The LEFT edge: the title starts at x = -44, so cells 0..4 are cut by x = 0 and the run starts at
    # cell 5 on the same 9 px grid, -44 + 5 * 9 = 1.
    win_move(tlr, 0 - 50, 10);
    assert_eq(t_title_q_r(tlfbe, tlr), 1, "a window past the LEFT edge still queues its title");
    assert_eq(ae_text_run_x(0), 1, "  from the first cell wholly on screen, on its own grid");
    assert_eq(ae_text_run_len(0), 19, "  the rest of the 24-cell caption");
    assert_eq(t_run_prefix_r(0, "w past the right e", 18), 1, "  'w past the right e'");
    assert_eq(t_run_ell_r(0), 1, "  then '…': Rust's cut, then the screen's");

    # ⭐⭐ THE PROPERTY, SWEPT AGAINST THE ORACLE (`t_rust_cap_r`, written from Rust). Every window must queue
    # exactly the cells of Rust's caption that are wholly on screen — at their own x, with their own cells, the
    # '…' included — and nothing when none is, and the queue must refuse none of it. Four titles, because each
    # reaches different branches across the 14 widths: 17 characters (whole, cut, and Rust's 2-cell narrow
    # rule), 65 (the run limit on a box that fits the whole title — a box can never cut it to more than 64),
    # 100 (the run limit on a box that CUTS it, to 66..99 cells at 680..971 px), and 70 scalars of one to four
    # bytes, glyph or none, with an ill-formed byte among them — so every cut, the run limit's and the screen's
    # included, has to land on a scalar boundary. 34 positions, from 500 px past the left edge to beyond the
    # right, put the screen's cut at every offset of the 9 px grid.
    test_group("render — every caption is Rust's, cut only by the screen, and the glyph queue carries it");
    var tlmiss = 0;      # cells on screen, and no run queued
    var tlextra = 0;     # no cell on screen, and a run queued anyway
    var tlwrong = 0;     # a run at the wrong x, of the wrong length, or with the wrong cells
    var tlcells = alloc(2 * 128);                          # the title's cells, from the title kind's own oracle
    var tlcapc = alloc(2 * 128);                           # Rust's caption of it, in cells
    var tlmbt = alloc(4 * 70 + 8);
    var tlmbc = alloc(2 * 70);
    assert_eq(t_mb_title_r(tlmbt, tlmbc, 70), 158, "the fourth title is 70 scalars in 158 bytes");
    assert_eq(utf8_count(tlmbt), 70, "  ...which decode as 70");
    tld0 = ae_text_dropped_get();
    var tlpass = 0;
    while (tlpass < 4) {
        var tlt = "Terminal emulator";
        if (tlpass > 0) { tlt = tllong; }                  # 65 characters, as the boundary above left it
        if (tlpass == 2) { store8(tllong + AE_TEXT_CHARS + 1, 'A' + ((AE_TEXT_CHARS + 1) % 26)); }   # 100 again
        if (tlpass == 3) { tlt = tlmbt; }                  # 70 scalars, 158 bytes
        win_set_title(tlwide, tlt);
        var tltn = 70;
        var tltc = tlmbc;
        if (tlpass < 3) {
            tltn = t_ascii_cells_r(tlcells, tlt);
            tltc = tlcells;
        }
        var tlsw = 1;
        while (tlsw < 1300) {
            var tlcap = t_rust_cap_r(tlcapc, tltc, tltn, tlsw);
            var tlsx = 0 - 500;
            while (tlsx < 1250) {
                win_resize(tlwide, tlsw, 60);
                win_move(tlwide, tlsx, 10);
                var tlq = t_title_q_r(tlfb, tlwide);
                # The caption starts at this port's title inset, x + 6; the screen keeps its cells [tlk, tle).
                var tltx = tlsx + 6;
                var tlk = 0;
                while (tltx + tlk * FONT_ADV < 0) { tlk = tlk + 1; }
                var tle = tlk;
                while (tle < tlcap) {
                    if (tltx + (tle + 1) * FONT_ADV > 1200) { break; }
                    tle = tle + 1;
                }
                if (tle > tlk) {
                    if (tlq == 0) { tlmiss = tlmiss + 1; }
                    if (tlq > 0) {
                        var tlok = 1;
                        if (tlq != 1) { tlok = 0; }
                        if (ae_text_run_x(0) != tltx + tlk * FONT_ADV) { tlok = 0; }
                        if (ae_text_run_len(0) != tle - tlk) { tlok = 0; }
                        if (tlok == 1) { tlok = t_run_is_cap_r(0, tle - tlk, tlcapc, tlk); }
                        if (tlok == 0) { tlwrong = tlwrong + 1; }
                    }
                }
                if (tle <= tlk) { if (tlq > 0) { tlextra = tlextra + 1; } }
                tlsx = tlsx + 53;
            }
            tlsw = tlsw + 97;
        }
        tlpass = tlpass + 1;
    }
    assert_eq(tlmiss, 0, "no caption with a cell wholly on screen went unqueued");
    assert_eq(tlextra, 0, "  none with no cell on screen queued anything");
    assert_eq(tlwrong, 0, "  every run is the on-screen cells of Rust's caption, at their own x");
    assert_eq(ae_text_dropped_get(), tld0, "  and the queue refused none of them");
    ae_gpu_frame_ok = 0;
    ae_text_reset();
    ae_rect_reset();

    # ⭐⭐ A MULTI-BYTE TITLE IS CUT AT A SCALAR AND ENDS IN U+2026's GLYPH. `rend_title_caption` writes the caption
    # as UTF-8, so its BYTES are pinned here as well as its cells: the title's whole units, E2 80 A6, the NUL.
    test_group("render — a multi-byte title is cut at a scalar boundary, ending in U+2026's glyph");
    var mcap = alloc(AE_TEXT_CAP_B + 16);
    var mtitle = "Ünïcödé wíndöw títlé";                  # 20 scalars, 28 bytes
    assert_eq(rend_title_caption(mcap, mtitle, 120), 13, "20 scalars in a 120 px box: 13 cells, Rust's max_chars");
    assert_eq(utf8_count(mcap), 13, "  the caption decodes to 13 scalars");
    assert_eq(memeq(mcap, mtitle, 17), 1, "  its first 17 bytes are the title's first 12 scalars, whole");
    assert_eq(load8(mcap + 17), 0xE2, "  then '…': E2");
    assert_eq(load8(mcap + 18), 0x80, "    80");
    assert_eq(load8(mcap + 19), 0xA6, "    A6");
    assert_eq(load8(mcap + 20), 0, "  and the NUL");
    var mw = win_new(74, 20, 10, 200, 60, mtitle);
    ae_gpu_frame_ok = 1;
    ae_text_gpu_ok = 1;
    assert_eq(t_title_q_r(tlfb, mw), 1, "the same title on a 200 px window queues one run");
    assert_eq(ae_text_run_len(0), 13, "  of 13 cells");
    assert_eq(t_run_cell_r(0, 0), 0x9A, "  'Ü' is CP437 0x9A");
    assert_eq(t_run_cell_r(0, 2), 0x8B, "  'ï' is 0x8B");
    assert_eq(t_run_cell_r(0, 4), 0x94, "  'ö' is 0x94");
    assert_eq(t_run_cell_r(0, 6), 0x82, "  'é' is 0x82");
    assert_eq(t_run_cell_r(0, 9), 0xA1, "  'í' is 0xA1");
    assert_eq(t_run_cell_r(0, 11), 'd', "  the 12th scalar, 'd', is the title's last");
    assert_eq(t_run_ell_r(0), 1, "  and the 13th is '…'");
    # ⚠ THE SCREEN CUTS BY CELL, THE CAPTION IS BYTES. Past the left edge the run starts at cell 5, 'd', which is
    # byte 8; the caption indexed by the cell number would start at byte 5, 'c', two scalars early. Past the right
    # edge it ends after cell 9, 'í', at byte 15; cut at byte 10, it would split 'é' and draw U+FFFD.
    win_move(mw, 0 - 50, 10);
    assert_eq(t_title_q_r(tlfbe, mw), 1, "a multi-byte title past the LEFT edge queues");
    assert_eq(ae_text_run_x(0), 1, "  from cell 5, on its own grid");
    assert_eq(ae_text_run_len(0), 8, "  the rest of the 13-cell caption");
    assert_eq(t_run_cell_r(0, 0), 'd', "  starting at 'd' — the scalar, not the byte its cell number names");
    assert_eq(t_run_cell_r(0, 1), 0x82, "  then 'é'");
    assert_eq(t_run_ell_r(0), 1, "  and the '…' last");
    win_move(mw, 300, 10);
    assert_eq(t_title_q_r(tlfbe, mw), 1, "...and past the RIGHT edge");
    assert_eq(ae_text_run_len(0), 10, "  the 10 cells that end by x = 400");
    assert_eq(t_run_cell_r(0, 9), 0xA1, "  the last is 'í', whole");
    # Four-byte scalars with no glyph: twelve blank cells and the ellipsis.
    var memo = alloc(4 * 20 + 8);
    var mj = 0;
    while (mj < 20) {
        store8(memo + mj * 4, 0xF0);
        store8(memo + mj * 4 + 1, 0x9F);
        store8(memo + mj * 4 + 2, 0x98);
        store8(memo + mj * 4 + 3, 0x80);
        mj = mj + 1;
    }
    store8(memo + 80, 0);
    assert_eq(rend_title_caption(mcap, memo, 120), 13, "twenty '😀' (four bytes each) are cut to 13 cells as well");
    assert_eq(utf8_offset(mcap, 12), 48, "  12 whole scalars, 48 bytes — never a split one");
    assert_eq(utf8_next_cp(utf8_next(mcap + 48)), 0x2026, "  then '…'");
    assert_eq(load8(mcap + 51), 0, "  and the NUL at 51");
    win_set_title(mw, memo);
    win_move(mw, 20, 10);
    ae_gpu_frame_ok = 0;
    bhumi_fb_clear(tlfb, TLBG);
    render_title(tlfb, mw, tlink);
    assert_eq(t_count_px_r(tlfb, 26, 26 + 12 * FONT_ADV, tly, tly + FONT_H, tlink), 0,
      "CPU frame: the twelve '😀' are blank cells — kashi has no glyph — that still advance");
    assert_eq(t_cell_is_r(tlfb, 26 + 12 * FONT_ADV, tly, t_ell_cell_r(), tlink), 1, "  so '…' lands in cell 12, exactly");
    # Ill-formed bytes: written back as U+FFFD, so the caption is well-formed whatever the title was.
    assert_eq(rend_title_caption(mcap, "\xFFok\xE2\x80", 500), 4, "an ill-formed title that fits is drawn whole: 4 cells");
    assert_eq((load8(mcap) << 16) | (load8(mcap + 1) << 8) | load8(mcap + 2), 0xEFBFBD, "  FF is written back as U+FFFD");
    assert_eq(load8(mcap + 3), 'o', "  then 'o'");
    assert_eq(load8(mcap + 4), 'k', "  'k'");
    assert_eq((load8(mcap + 5) << 16) | (load8(mcap + 6) << 8) | load8(mcap + 7), 0xEFBFBD, "  E2 80 cut short: U+FFFD");
    assert_eq(load8(mcap + 8), 0, "  and the NUL");

    # ⛔ THE CAPTION BUFFER HOLDS THE WORST CASE, AND NOTHING LANDS PAST IT. 64 four-byte cells are 256 bytes
    # before the NUL; cut, 63 of them and the '…' are 255. The guard bytes after the buffer must be untouched.
    test_group("render — the caption buffer holds the worst case, and nothing lands past it");
    assert_eq(t_gt_r(AE_TEXT_CAP_B, AE_TEXT_CHARS * 4 + 3), 1,
      "AE_TEXT_CAP_B >= 64 four-byte cells + the 3-byte '…' + NUL (the copy keeps those four bytes free)");
    var wt = alloc(4 * 100 + 8);
    var wti = 0;
    while (wti < 100) {
        store8(wt + wti * 4, 0xF0);
        store8(wt + wti * 4 + 1, 0x9F);
        store8(wt + wti * 4 + 2, 0x98);
        store8(wt + wti * 4 + 3, 0x80);
        wti = wti + 1;
    }
    store8(wt + 400, 0);
    var wb = alloc(AE_TEXT_CAP_B + 16);
    var wbi = 0;
    while (wbi < AE_TEXT_CAP_B + 16) { store8(wb + wbi, 0x5A); wbi = wbi + 1; }
    assert_eq(rend_title_caption(wb, wt, 5000), AE_TEXT_CHARS, "100 four-byte scalars on a wide box: capped to 64 cells");
    assert_eq(utf8_offset(wb, 63), 252, "  63 whole scalars, 252 bytes");
    assert_eq(utf8_next_cp(utf8_next(wb + 252)), 0x2026, "  then '…'");
    assert_eq(load8(wb + 255), 0, "  and the NUL at byte 255");
    var wpast = 0;
    wbi = 256;
    while (wbi < AE_TEXT_CAP_B + 16) { if (load8(wb + wbi) != 0x5A) { wpast = wpast + 1; } wbi = wbi + 1; }
    assert_eq(wpast, 0, "  not one byte written after it");
    store8(wt + AE_TEXT_CHARS * 4, 0);
    wbi = 0;
    while (wbi < AE_TEXT_CAP_B + 16) { store8(wb + wbi, 0x5A); wbi = wbi + 1; }
    assert_eq(rend_title_caption(wb, wt, 5000), AE_TEXT_CHARS, "exactly 64 four-byte scalars are drawn whole");
    assert_eq(utf8_next_cp(utf8_next(wb + 252)), 0x1F600, "  the 64th is the title's, not '…'");
    assert_eq(load8(wb + 256), 0, "  256 bytes, then the NUL — the worst case there is");
    wpast = 0;
    wbi = 257;
    while (wbi < AE_TEXT_CAP_B + 16) { if (load8(wb + wbi) != 0x5A) { wpast = wpast + 1; } wbi = wbi + 1; }
    assert_eq(wpast, 0, "  and nothing after it");

    # ⭐⭐ A CPU FRAME AND A GPU FRAME DRAW THE SAME CELLS FOR THE SAME STRING. The CPU path decodes in `draw_text`;
    # the GPU path decoded at enqueue and packs from the pool. One window, drawn both ways, compared per pixel.
    test_group("render — a CPU frame and a GPU frame draw the same caption, pixel for pixel");
    var cgc = bhumi_fb_new(400, 60);
    var cgg = bhumi_fb_new(400, 60);
    var cglit = alloc(8);
    var cgw = win_new(75, 20, 10, 200, 40, mtitle);
    assert_eq(t_cap_cpu_gpu_diff_r(cgc, cgg, cgw, cglit), 0, "a cut multi-byte caption: no pixel differs");
    assert_eq(ae_text_count(), 1, "  (the GPU frame queued it, so this is not CPU against CPU)");
    assert_eq(t_gt_r(load64(cglit), 100), 1, "  (and the CPU frame drew ink, so not two blank buffers)");
    win_set_title(cgw, tlmbt);
    assert_eq(t_cap_cpu_gpu_diff_r(cgc, cgg, cgw, cglit), 0, "every kind of scalar, the ill-formed byte included");
    assert_eq(t_gt_r(load64(cglit), 100), 1, "  (ink drawn)");
    win_move(cgw, 0 - 50, 10);
    assert_eq(t_cap_cpu_gpu_diff_r(cgc, cgg, cgw, cglit), 0, "  and cut by the left edge");
    win_resize(cgw, 2000, 40);
    win_move(cgw, 0, 10);
    assert_eq(t_cap_cpu_gpu_diff_r(cgc, cgg, cgw, cglit), 0, "  and by the right edge of a window wider than the screen");
    assert_eq(t_gt_r(load64(cglit), 100), 1, "  (ink drawn)");
    ae_gpu_frame_ok = 0;
    ae_text_reset();
    ae_rect_reset();

    # ⛔⛔ AND IF TEXT DOES RETIRE, CHROME MUST RETIRE WITH IT. `AE-8`'s fallback comment promised the
    # desktop keeps its titles; `AE-9` then deleted the `#39` blit, so CPU-drawn glyphs land in a
    # framebuffer nothing copies to screen. Coupling the two is what makes the fallback real.
    test_group("render — a retired text path takes chrome off the GPU with it");
    ae_gpu_frame_ok = 1;
    ae_chrome_gpu_ok = 1;
    ae_text_gpu_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "both enabled: chrome is on the GPU");
    ae_text_gpu_disable();
    assert_eq(ae_chrome_on_gpu(), 0,
      "text retired ⇒ chrome retires too, so the #39 blit returns and CPU text is VISIBLE");
    ae_text_gpu_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "and it comes back when text does");
    ae_gpu_frame_ok = 0;
    assert_eq(ae_chrome_on_gpu(), 0, "no GPU frame ⇒ never on the GPU");
    ae_gpu_frame_ok = 1;

    # ⛔⛔ THE `return assert_summary()` USED TO BE HERE, AND EVERY GROUP BELOW IT WAS DEAD CODE.
    # It compiled, it was listed in the suite, and `234 passed` looked like coverage — but the wallpaper
    # scaler, per-window opacity, `fill_rect_a` and the default-opacity assertions had NEVER EXECUTED,
    # because `main` returned before reaching them. ⚠ `fill_rect_a` is the function at the centre of the
    # 1.56.44 chrome regression; the four assertions that pin its blending were among the unreachable
    # ones. Same defect class as the `edgeasm`/`asmagree` gates that never compiled and the dead
    # `return 0;` in tests/gpu_fallback.tcyr: a gate that cannot fail is not a gate.
    # ⇒ The summary now returns from the BOTTOM of main, which is the only place it can be correct.

    # ----- wallpaper: image scaling (M6-C1, pure) -----------------
    # ⛔ The first cut of the wallpaper layer had NO image kind at all — it was a colour source with a
    # "row-uniform, never varies in x" doctrine, which is meaningless for a file. These pin the scaler.
    test_group("wallpaper — nearest-neighbour scaling");
    assert_eq(wp_src_index(0, 1280, 640), 0,   "dest 0 -> src 0");
    assert_eq(wp_src_index(1279, 1280, 640), 639, "last dest column -> LAST src column, not past it");
    assert_eq(wp_src_index(640, 1280, 640), 320, "midpoint halves on a 2x upscale");
    assert_eq(wp_src_index(0, 640, 1280), 0,   "downscale: dest 0 -> src 0");
    assert_eq(wp_src_index(639, 640, 1280), 1278, "downscale: last dest -> in range");
    # ⚠ Clamping is the assertion that matters: an off-by-one samples past the buffer on the final
    # row/column, which reads as a torn edge rather than as an error.
    assert_eq(wp_src_index(9999, 100, 50), 49, "past the end clamps to the last source index");
    assert_eq(wp_src_index(-5, 100, 50), 0,    "negative clamps to 0");
    assert_eq(wp_src_index(5, 0, 50), 0,       "zero dest extent is not a divide by zero");
    assert_eq(wp_src_index(5, 100, 0), 0,      "zero source extent is safe");

    # ----- window opacity (M6-C3) --------------------------------
    test_group("render — per-window opacity");
    # ⛔ THE DEFAULT MUST BE 255. An opacity field in zero-initialised memory means INVISIBLE, so a
    # window created before anyone sets one would silently vanish — the same class as the W_PREMUL slot
    # that was once missed in win_new.
    var ow = win_new(9, 0, 0, 40, 40, "op");
    assert_eq(win_opacity(ow), 255, "a new window is opaque by default");
    assert_eq(win_translucent(ow), 0, "  ...and not translucent");
    win_set_opacity(ow, 128);
    assert_eq(win_opacity(ow), 128, "opacity round-trips");
    assert_eq(win_translucent(ow), 1, "  ...and now reads translucent");
    # Clamped, because `rend_blend` computes `255 - a` and a stored 300 would wrap into garbage.
    win_set_opacity(ow, 300);
    assert_eq(win_opacity(ow), 255, "over-range clamps to 255");
    win_set_opacity(ow, -5);
    assert_eq(win_opacity(ow), 0, "under-range clamps to 0");

    test_group("render — fill_rect_a blending");
    # ⛔ THIS GROUP MEASURES THE CPU ARM, so say so instead of inheriting whatever the previous group
    # left set. It was written before `AE-9` and never ran (see the dead-`return` note above), so it
    # still assumed `fill_rect` always draws — but the retired-text group above leaves
    # `ae_gpu_frame_ok = 1`, and on a GPU frame the a=255 arm ENQUEUES and writes no pixel at all. The
    # revived group failed on exactly that. The blend arithmetic is the subject here; the routing has
    # its own group.
    ae_gpu_frame_ok = 0;
    var ofb = bhumi_fb_new(4, 4);
    bhumi_fb_clear(ofb, 0x000000);
    fill_rect_a(ofb, 0, 0, 4, 4, 0xFFFFFF, 255);
    assert_eq(bhumi_fb_get(ofb, 1, 1), 0xFFFFFF, "a=255 is an opaque fill");
    bhumi_fb_clear(ofb, 0x000000);
    fill_rect_a(ofb, 0, 0, 4, 4, 0xFFFFFF, 128);
    # 255·R(128/255) = 128.0 -> 0x80 on every channel over black, and the alpha byte is the coverage (op 0x02's
    # fourth lane: R(0·ia + sa') = 128) — the kernel writes it, so the CPU frame does too.
    assert_eq(bhumi_fb_get(ofb, 1, 1), 0x80808080, "a=128 blends white over black to mid grey, alpha byte 128");
    bhumi_fb_clear(ofb, 0x000000);
    fill_rect_a(ofb, 0, 0, 4, 4, 0xFFFFFF, 0);
    assert_eq(bhumi_fb_get(ofb, 1, 1), 0x000000, "a=0 draws nothing at all");
    # ⚠ Blending READS the destination, so it must compose with whatever is under it — that is the whole
    # point, and it is what makes a translucent window show the wallpaper rather than a flat tint.
    bhumi_fb_clear(ofb, 0x204060);
    fill_rect_a(ofb, 0, 0, 4, 4, 0x000000, 128);
    # ⛔⛔ 0x102030, NOT 0x0F1F2F — CHANGED AT 0.17.4, AND THE OLD LITERAL WAS RIGHT FOR THE OLD BLEND. Both keep
    # 127/255 of the destination; the straight-colour blend TRUNCATED it (32·127/255 = 15.94 -> 15) while the
    # kernel's op 0x02 ROUNDS (-> 16), so the CPU frame drew this titlebar one step darker per channel than iron.
    assert_eq(bhumi_fb_get(ofb, 1, 1), 0x80102030, "black at a=128 keeps 127/255 of the existing pixel, ROUNDED");

    # ----- ⛔⛔ THE 1.56.44 IRON REGRESSION -----------------------------------------------------
    # THE INVARIANT, and it is the one `ae_chrome_on_gpu()`'s banner already states: every chrome fill
    # reaches the panel by EXACTLY ONE of two routes —
    #   A. queued for `#88` (`ae_chrome_on_gpu() == 1`), or
    #   B. written into the userland framebuffer and carried by the `#39` band blit (`... == 0`).
    # A fill that takes NEITHER is lost, and `fill_rect_a` can only ever take route B: it is a per-pixel
    # read-modify-write and has no `ae_rect_enqueue` call in it at all.
    #
    # ⛔ WHAT THE BURN SHOWED. `--opacity 128` on 1.56.44 put every window's body, titlebar and accent
    # strip through `fill_rect_a` while the frame still believed chrome was on the GPU — so gpu.cyr
    # zeroed the damage band (the three deco buttons are plain `fill_rect` and are always queued) and
    # skipped the blit. Result on iron: every window lost its titlebar BACKGROUND and kept its buttons
    # and its title glyphs, at 128 and not at 255. The fix is the frame plan's third answer.
    test_group("render — a TRANSLUCENT window takes chrome off the GPU (1.56.44 iron regression)");
    var afb = bhumi_fb_new(200, 120);
    var ACS = 0x0B0C0D;          # a sentinel no chrome fill emits, so "untouched" is provable
    ae_gpu_frame_ok = 1;
    ae_chrome_gpu_ok = 1;
    ae_text_gpu_ok = 1;
    ae_cursor_gpu_ok = 1;
    var aw = win_new(21, 10, 10, 100, 60, "chrome");

    # --- route A: an OPAQUE window. `fill_rect_a(a=255)` delegates to `fill_rect`, which enqueues.
    ae_gpu_alpha_chrome = 0;
    win_set_opacity(aw, 255);
    bhumi_fb_clear(afb, ACS);
    ae_rect_reset();
    ae_text_reset();
    render_window(afb, aw, 1);
    var abody = win_body_y(aw) + 5;
    assert_eq(ae_chrome_on_gpu(), 1, "an OPAQUE window on a GPU frame keeps chrome on the GPU");
    assert_eq(t_gt_r(ae_rect_count(), 0), 1, "  its chrome is QUEUED for #88");
    assert_eq(bhumi_fb_get(afb, 12, abody), ACS, "  and NOTHING is written to the userland framebuffer");

    # --- route A STILL, for a TRANSLUCENT window: `fill_rect_a` now QUEUES (op 0x02) instead of
    #     drawing. This is the burn-2 repair — chrome stays on the GPU, so the per-window interleave in
    #     `ae_gpu_present_frame` orders it, and a lower window's surface can no longer cover an upper
    #     window's titlebar.
    ae_gpu_alpha_chrome = 0;
    win_set_opacity(aw, 128);
    bhumi_fb_clear(afb, ACS);
    ae_rect_reset();
    ae_text_reset();
    render_window(afb, aw, 1);
    assert_eq(ae_chrome_on_gpu(), 1, "a TRANSLUCENT window KEEPS chrome on the GPU (op 0x02 exists)");
    assert_eq(t_gt_r(ae_rect_count(), 0), 1, "  its alpha chrome is QUEUED, not drawn");
    assert_eq(bhumi_fb_get(afb, 12, abody), ACS,
      "  and NOTHING reached the userland framebuffer — no pixels for a skipped blit to lose");
    # ⭐ THE ALPHA MUST SURVIVE INTO THE QUEUE, which is the whole point of the new lane. A rect queued
    # at 255 would be emitted through `#88` and paint the titlebar at FULL STRENGTH on a translucent
    # window — a wrong picture that looks deliberate, and invisible to a count-only assertion.
    var seen_a = 0;
    var rq = 0;
    while (rq < ae_rect_count()) {
        if (ae_rect_get_a(rq) == 128) { seen_a = seen_a + 1; }
        rq = rq + 1;
    }
    assert_eq(t_gt_r(seen_a, 0), 1, "  at least one queued rect carries alpha 128, not 255");
    # ⚠ NON-VACUITY: the deco buttons use plain `fill_rect` and MUST still be opaque. If every rect came
    # out at 128 the assertion above would pass on a bug that made the whole queue translucent.
    var seen_op = 0;
    rq = 0;
    while (rq < ae_rect_count()) {
        if (ae_rect_get_a(rq) == 255) { seen_op = seen_op + 1; }
        rq = rq + 1;
    }
    assert_eq(t_gt_r(seen_op, 0), 1, "  ...and the opaque deco buttons still carry 255");

    # --- route B: the FALLBACK, for a kernel with no op 0x02. `ae_gpu_alpha_chrome` is what the frame
    #     plan sets there, and it must still pull the whole layer to the CPU so the `#39` blit carries
    #     it — the burn-1 repair, now reachable only when the coverage path is unavailable.
    ae_gpu_alpha_chrome = 1;
    bhumi_fb_clear(afb, ACS);
    ae_rect_reset();
    ae_text_reset();
    render_window(afb, aw, 1);
    assert_eq(ae_chrome_on_gpu(), 0, "no op 0x02 ⇒ chrome retires to the CPU, restoring the #39 blit");
    assert_eq(ae_rect_count(), 0, "  nothing is queued — the whole layer is on the CPU");
    var apix = bhumi_fb_get(afb, 12, abody);
    assert_eq(t_ne_r(apix, ACS), 1, "  the body fill IS in the framebuffer the blit will carry");
    assert_eq(t_ne_r(apix, ae_bhumi(rupa_theme_widget(rupa_theme_active()))), 1,
      "  ...and blended against the backdrop, not painted at full strength");
    ae_gpu_frame_ok = 0;
    ae_gpu_alpha_chrome = 0;
    win_set_opacity(aw, 255);

    test_group("render — the default applies to new windows");
    win_set_default_opacity(200);
    var ow2 = win_new(10, 0, 0, 10, 10, "op2");
    assert_eq(win_opacity(ow2), 200, "a new window takes the default");
    win_set_default_opacity(255);
    var ow3 = win_new(11, 0, 0, 10, 10, "op3");
    assert_eq(win_opacity(ow3), 255, "and follows it back to opaque");

    test_group("wallpaper — ⛔ THE NO-BAND CLEAR MUST TAKE THE ENQUEUEING PATH");
    # ⛔⛔ `wp_fill_all`'s SOLID arm called `bhumi_fb_clear` directly, which writes the USERLAND
    # framebuffer only. `rend_clear_band` enqueues a `#88` rect when chrome is on the GPU, and with
    # chrome on the GPU the `#39` blit is SKIPPED — so the no-band clear never reached the screen.
    # That path is the one a THEME SWITCH takes (`rend_band_compute` refuses to band across a
    # background change) and the one the FIRST FRAME takes: the 2026-08-18 burn's "theme does not
    # reach the background" and its `--selftest` residue are the same defect.
    # ⚠ Asserted on PIXELS via the CPU arm, which is what a host can reach; the GPU arm differs only
    # in that `rend_clear_band` enqueues instead of storing. The regression this guards is the
    # BYPASS — a full clear that does not go through `rend_clear_band` at all.
    var wfb = bhumi_fb_new(64, 32);
    wp_set_solid(0x00112233);
    bhumi_fb_clear(wfb, 0x00FFFFFF);
    wp_fill_all(wfb, 64, 32);
    assert_eq(bhumi_fb_get(wfb, 0, 0), 0x00112233, "the no-band clear paints the top-left");
    assert_eq(bhumi_fb_get(wfb, 63, 31), 0x00112233, "  ...and the bottom-right");
    assert_eq(bhumi_fb_get(wfb, 32, 16), 0x00112233, "  ...and the middle");
    # ⚠ And it must agree with the BANDED path over the same rows — one clear, two entry points.
    # ⛔⛔ THE DISCRIMINATING HALF. The pixel checks above pass either way — on the CPU path
    # `bhumi_fb_clear` and `rend_clear_band` write identical pixels, and a mutation restoring the
    # bypass PASSED them. What separates the two is that `rend_clear_band` ENQUEUES a `#88` rect when
    # chrome is on the GPU, and the bypass does not. `ae_gpu_frame_ok` is what gates that, so set it
    # and count the queue.
    ae_marks_reset();
    ae_gpu_frame_ok = 1;
    var rects_before = ae_rect_count();
    wp_fill_all(wfb, 64, 32);
    var rects_after = ae_rect_count();
    ae_gpu_frame_ok = 0;
    assert_eq(t_gt_r(rects_after, rects_before), 1, "the no-band clear ENQUEUES for the GPU, not just the framebuffer");

    var wfb2 = bhumi_fb_new(64, 32);
    bhumi_fb_clear(wfb2, 0x00FFFFFF);
    wp_fill_band(wfb2, 0, 32, 32);
    assert_eq(bhumi_fb_get(wfb2, 32, 16), bhumi_fb_get(wfb, 32, 16), "full and banded clears agree");

    # 0.17.4 — the kernel's blend on the CPU, window opacity, the border, and renderer.rs's tests.
    t_grp_op01_r();
    t_grp_op06_r();
    t_grp_op02_r();
    t_grp_opacity_r();
    t_grp_fb_r();
    t_grp_outline_r();
    t_grp_border_r();
    t_grp_overlap_r();
    t_grp_minimized_r();
    t_grp_cache_r();
    t_grp_integ_r();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
