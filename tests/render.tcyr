# aethersafha renderer test — alpha blend + damage tracking (pure logic).
# render.cyr is shell-free: this suite includes it WITHOUT shell.cyr (the shell
# status-panel renderer + its test live in tests/shell_render.tcyr).
# Stdlib + [deps.*] auto-included via cyrius.cyml.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme.cyr"        # ae_bhumi — render_window packs its colours through it
include "src/cursor.cyr"      # render_cursor draws this bitmap; cursor.tcyr owns the shape itself
include "src/render.cyr"
include "src/wallpaper.cyr"   # rend_band_compute reads wp_serial(); gpu frame plan reads wp_gpu_expressible()
# ⚠ The cursor lives in input.cyr (`input_ptr_x/y`) and render.cyr calls it — a forward function
# reference, legal in Cyrius and exactly what the real include chain does. The test must carry the
# same set or it fails to link on functions the production build resolves fine.
include "src/input.cyr"

# One frame for the ghost test, in render_desktop's exact order: damage, banded clear, draw, stamp.
fn t_gt_r(a, b): i64 {
    if (a > b) { return 1; }
    return 0;
}

fn t_layer_count_r(layer): i64 {
    var n = 0;
    var y = 0;
    while (y < cursor_h()) {
        var x = 0;
        while (x < cursor_w()) {
            if (cursor_layer_at(layer, x, y) == 1) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

fn ghost_frame(comp, fb, win, bg): i64 {
    rend_frame_damage(comp, fb, bg);
    if (rend_band_valid() == 1) {
        if (rend_band_h() > 0) { rend_clear_band(fb, rend_band_y(), rend_band_h(), bg); }
    }
    if (rend_band_valid() == 0) { bhumi_fb_clear(fb, bg); }
    render_window(fb, win, 1);
    win_stamp_prev(win);
    return 0;
}

fn main() {
    alloc_init();
    # ⚠ SETTLE THE CURSOR before any band assertion. `rend_cursor_damage` reports the cursor as moved
    # until something records where it was last DRAWN, and these tests call the damage pass without
    # `render_cursor` (they predate the cursor entirely). Left unsettled, every "an idle desktop writes
    # NOTHING" assert reads 18 rows — which is a real property of an UNPAIRED damage/draw, not noise.
    input_ptr_set(0, 0);
    rend_cursor_mark_drawn(0, 0);

    test_group("render — alpha blend");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 255), 0xFFFFFF, "full src alpha = src");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 0), 0x000000, "zero alpha = dst");
    assert_eq(rend_blend(0x000000, 0xFFFFFF, 128), 0x808080, "half alpha = mid grey");
    assert_eq(rend_blend(0x203040, 0x203040, 200), 0x203040, "same src/dst is stable");

    test_group("render — damage tracker");
    var d = rend_dmg_new();
    assert_eq(rend_dmg_valid(d), 0, "empty damage invalid");
    rend_dmg_add(d, 10, 10, 20, 20);
    assert_eq(rend_dmg_valid(d), 1, "first add makes it valid");
    assert_eq(rend_dmg_x(d), 10, "damage x");
    assert_eq(rend_dmg_w(d), 20, "damage w");
    rend_dmg_add(d, 5, 5, 10, 10);
    assert_eq(rend_dmg_x(d), 5, "damage grows left");
    assert_eq(rend_dmg_y(d), 5, "damage grows up");
    assert_eq(rend_dmg_w(d), 25, "damage right edge held (30-5)");
    assert_eq(rend_dmg_h(d), 25, "damage bottom edge held");
    rend_dmg_clear(d);
    assert_eq(rend_dmg_valid(d), 0, "clear resets validity");

    # ⭐⭐ AE-0a — THE DAMAGE BAND. Drives the clear AND the `#39` chrome blit, so a wrong band is
    # either a stale desktop or a 60%-of-frame cost that never went away. `rend_band_compute` reads the
    # two module trackers, so these set them directly.
    test_group("render — AE-0a damage band: union(cur, prev)");
    ae_frame_dmg = rend_dmg_new();
    ae_prev_dmg = rend_dmg_new();
    ae_last_bg = 0x121218;                       # pretend a frame already cleared to this
    # ⚠ AND the wallpaper serial, for the same reason (M6-C1a): `rend_band_compute` refuses to band
    # when EITHER the bg or the wallpaper changed since the last frame, so faking "a frame already
    # rendered" means priming both halves of that state. Priming only `ae_last_bg` made the very first
    # compute look like a wallpaper change and cost a frame.
    ae_last_wp = wp_serial();

    # A band with neither tracker valid: nothing changed in two frames. VALID with height 0 — a real
    # result, not a failure. ⛔ Conflating it with "no band" would clear the whole screen every idle frame.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_valid(), 1, "idle: a band IS computed");
    assert_eq(rend_band_h(), 0, "idle: height 0 — both buffers already correct, nothing to write");

    # cur alone.
    rend_dmg_add(ae_frame_dmg, 0, 100, 800, 200);            # rows 100..300
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_valid(), 1, "cur only: valid");
    assert_eq(rend_band_y(), 100, "cur only: band starts at cur's top");
    assert_eq(rend_band_h(), 200, "cur only: band is cur's height");

    # ⭐ THE NEGATIVE CONTROL FOR THE WHOLE BITE. prev is DISJOINT from cur and BELOW it. `#84 present`
    # flips the render target, so the buffer being written this frame is missing prev's rows too — a
    # band of cur alone would leave them holding two-frames-ago pixels, which is the trailing ghost this
    # union exists to prevent. If someone "simplifies" the fold to cur, THIS assert fails and says why.
    rend_dmg_add(ae_prev_dmg, 0, 900, 800, 100);             # rows 900..1000
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 100, "union: top comes from cur");
    assert_eq(rend_band_h(), 900, "union: bottom comes from PREV (1000-100) — not cur's 200");

    # Order does not matter: prev above cur folds the same way.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 500, 800, 100);            # cur rows 500..600
    rend_dmg_add(ae_prev_dmg, 0, 50, 800, 100);              # prev rows  50..150
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 50, "union: top comes from prev when prev is higher");
    assert_eq(rend_band_h(), 550, "union: bottom from cur (600-50)");

    # Clamped to the screen, both edges. An off-screen window rect must not produce a source pointer
    # or a destination row outside the framebuffer — `#39` clips, but the band's own src offset does not.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 0 - 200, 800, 300);        # rows -200..100
    rend_dmg_add(ae_prev_dmg, 0, 1400, 800, 500);            # rows 1400..1900
    rend_band_compute(1440, 0x121218);
    assert_eq(rend_band_y(), 0, "clamped: negative top pinned to 0");
    assert_eq(rend_band_h(), 1440, "clamped: bottom pinned to the screen height");

    # ⛔ A BACKGROUND CHANGE DAMAGES EVERY PIXEL WITHOUT MOVING A WINDOW. The band must refuse, so the
    # caller does a full clear — otherwise the old colour survives everywhere outside the band and reads
    # as a stale desktop that no window rect can explain.
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 100, 800, 50);
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 0, "theme switch: NO band — the whole screen must be cleared");
    # ...and only for that one frame: the new colour is recorded, so the next frame bands again.
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 1, "the frame AFTER a theme switch bands normally again");

    # ⛔ A MISSING TRACKER MEANS FULL SCREEN, NOT AN EMPTY BAND. Every unit suite runs with these unset,
    # and an empty band there would silently stop clearing anything at all.
    var save_cur = ae_frame_dmg;
    ae_frame_dmg = 0;
    rend_band_compute(1440, 0x334455);
    assert_eq(rend_band_valid(), 0, "no tracker: no band, so the caller clears everything");
    ae_frame_dmg = save_cur;

    # The roll: rend_dmg_copy is what makes THIS frame's cur become next frame's prev.
    rend_dmg_clear(ae_prev_dmg);
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_add(ae_frame_dmg, 0, 700, 800, 40);
    rend_dmg_copy(ae_prev_dmg, ae_frame_dmg);
    assert_eq(rend_dmg_valid(ae_prev_dmg), 1, "roll: prev takes cur's validity");
    assert_eq(rend_dmg_y(ae_prev_dmg), 700, "roll: prev takes cur's top");
    assert_eq(rend_dmg_h(ae_prev_dmg), 40, "roll: prev takes cur's height");

    # ⭐⭐ THE FAILURE MODE THE BAND CAN INTRODUCE, ASSERTED ON PIXELS: a window that MOVES must not
    # leave its old self behind. Nothing else tests this — the QEMU desktop's windows are static and its
    # present is full-frame (no GPU there), so a wrong band looks perfect on every substrate short of
    # iron, where the symptom reads as "the framebuffer is stale" rather than "the damage model is wrong".
    #
    # ⛔⛔ THE MOVE MUST HAPPEN ON FRAME 4, NOT FRAME 2, AND THIS COST A VACUOUS TEST.
    # The first version moved the window on frame 2 and PASSED against a mutant that dropped the old rect
    # from the fold entirely. Reason: frame 1 primes damage to the FULL SCREEN, so frame 2's band is
    # `union(cur, prev=full)` = full — it covers the vacated rows no matter what the fold does. Two
    # settling frames are needed to drain `prev` back to empty before a move can prove anything.
    # ⚠ Mutation-tested in both directions now: dropping the old rect FAILS the ghost assert, and
    # dropping prev from the union FAILS the union asserts above.
    #
    # ⚠ MIRRORS `render_desktop`'s ORDER (src/desktop.cyr) — damage, banded clear, draw, stamp — via
    # `ghost_frame` below, calling the real `rend_frame_damage` / `rend_clear_band` / `render_window`.
    test_group("render — AE-0a: a moved window leaves NO ghost");
    # ⚠ 400 TALL SO THE MOVED WINDOW FITS. At 300 the window at y=200 (+100 body +30 titlebar = 330)
    # runs off the bottom, the band clamps to 300, and the "reaches its new bottom" assert fails on the
    # TEST's geometry rather than on the code — which is how it failed first time round.
    var gfb = bhumi_fb_new(400, 400);
    var gcomp = comp_new();
    var gwin = comp_create_window(gcomp, 40, 40, 120, 100, "G");
    var GBG = 0x00101018;
    ae_dmg_primed = 0;                        # frame 1 must prime full, as it does at startup
    ae_last_bg = 0 - 1;
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);

    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 1 — primed full
    assert(bhumi_fb_get(gfb, 80, 100) != GBG, "frame 1: the window is actually on screen");
    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 2 — band still full (prev = frame 1)
    ghost_frame(gcomp, gfb, gwin, GBG);       # frame 3 — settled: nothing changed in two frames
    assert_eq(rend_band_h(), 0, "settled: an idle desktop writes NOTHING — the band is empty");

    # ---- frame 4: move it far down. Its old rows must come back to the background. ----
    win_move(gwin, 40, 200);
    rend_frame_damage(gcomp, gfb, GBG);
    assert_eq(rend_band_valid(), 1, "after the move: a band was computed");
    assert(rend_band_y() <= 40, "after the move: the band reaches the window's OLD top");
    assert(rend_band_y() + rend_band_h() >= 200 + 100 + 30,
           "after the move: ...and its NEW bottom + titlebar");
    if (rend_band_valid() == 1) {
        if (rend_band_h() > 0) { rend_clear_band(gfb, rend_band_y(), rend_band_h(), GBG); }
    }
    if (rend_band_valid() == 0) { bhumi_fb_clear(gfb, GBG); }
    render_window(gfb, gwin, 1);
    win_stamp_prev(gwin);
    # ⛔ THE GHOST ASSERT. (80,100) was inside the window on frames 1-3 and is outside it now, so it must
    # read the background. If the band ever narrows to the new rect alone, this pixel still holds chrome.
    assert_eq(bhumi_fb_get(gfb, 80, 100), GBG, "after the move: the VACATED region is background, not a ghost");
    assert(bhumi_fb_get(gfb, 80, 260) != GBG, "after the move: and the window is drawn at its new position");

    # ⛔⛔ `AE-0a`: A **CLOSED** WINDOW IS NOT A MOVED WINDOW, and the difference cost an iron burn.
    # The 2026-08-08 flash proved the move leaves no ghost (the group above). Closing a window instead
    # left it **standing on the panel, flashing** — because every damage producer walks the LIVE window
    # list, so a removed window is in neither `cur` nor `prev` and its rows are never repainted.
    # ⭐ THE LOAD-BEARING PROPERTY IS **TWO** FRAMES OF COVERAGE, NOT ONE. `#84 present` flips the render
    # target, so erasing a region takes one frame per buffer. A single frame erases the window from the
    # buffer being drawn and leaves it in the other, and the flip then alternates them — that IS the
    # flashing. Anything folded into `cur` gets two frames for free, because next frame's `prev` is this
    # frame's `cur`. These asserts are on the BAND rather than on pixels for exactly that reason: one
    # framebuffer cannot show a flip, but band coverage on two consecutive frames is what the flip needs.
    test_group("render — AE-0a: a CLOSED window's rows are covered for TWO frames");
    var kfb = bhumi_fb_new(400, 400);
    var kcomp = comp_new();
    var kwin = comp_create_window(kcomp, 40, 40, 120, 100, "K");
    var KBG = 0x00101018;
    ae_dmg_primed = 0;
    ae_last_bg = 0 - 1;
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    comp_retire_clear();
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 1 — primed full
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 2
    ghost_frame(kcomp, kfb, kwin, KBG);       # frame 3 — settled
    assert_eq(rend_band_h(), 0, "settled before the close: an idle desktop writes nothing");
    assert(bhumi_fb_get(kfb, 80, 100) != KBG, "the window really is on screen before the close");

    comp_close_window(kcomp, win_id(kwin));
    assert_eq(comp_count(kcomp), 0, "the close removed the window");
    assert_eq(comp_retire_valid(), 1, "the close RECORDED the vacated rect before unlinking");
    assert_eq(comp_retire_y(), 40, "the retired rect keeps the window's y");
    assert_eq(comp_retire_h(), 100, "the retired rect keeps the window's h (titlebar added by render)");

    # ---- frame 4: the close frame. The vacated rows must be in the band. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_valid(), 1, "close frame: a band was computed");
    assert(rend_band_y() <= 40, "close frame: the band reaches the closed window's top");
    assert(rend_band_y() + rend_band_h() >= 40 + 100 + 30,
           "close frame: ...and its bottom, titlebar included");
    assert_eq(comp_retire_valid(), 0, "the retired rect is CONSUMED by the frame that folded it in");
    if (rend_band_h() > 0) { rend_clear_band(kfb, rend_band_y(), rend_band_h(), KBG); }
    assert_eq(bhumi_fb_get(kfb, 80, 100), KBG, "close frame: the vacated region is background");

    # ---- frame 5: THE ASSERT THAT CATCHES THE FLASH. The other buffer still holds the window. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_valid(), 1, "frame after the close: a band was computed");
    assert(rend_band_y() <= 40,
           "frame after the close: the band STILL reaches the old top — this is the OTHER buffer");
    assert(rend_band_y() + rend_band_h() >= 40 + 100 + 30,
           "frame after the close: ...and the old bottom. One frame of coverage is what flashed");

    # ---- frame 6: and now it may settle. Coverage must not persist forever either. ----
    rend_frame_damage(kcomp, kfb, KBG);
    assert_eq(rend_band_h(), 0, "two frames after the close: settled — a retired rect does not linger");

    # ⛔ THE STATIC, CLIENTLESS WINDOW — the worse of the two symptoms, and a DIFFERENT code path.
    # A compositor-seeded window has no client buffer, so `win_bufid` is 0 and after its first frames
    # `win_rect_changed` is 0 too: it was in NEITHER `cur` nor `prev` even on the close frame, so closing
    # it damaged NOTHING and it stayed on screen in BOTH buffers permanently. That is "not disappearing"
    # as distinct from "flashing", and the retired rect is what covers it.
    test_group("render — AE-0a: closing a STATIC clientless window still damages its rows");
    var sfb = bhumi_fb_new(400, 400);
    var scomp = comp_new();
    var swin = comp_create_window(scomp, 60, 60, 100, 80, "S");
    var SBG = 0x00101018;
    ae_dmg_primed = 0;
    ae_last_bg = 0 - 1;
    rend_dmg_clear(ae_frame_dmg);
    rend_dmg_clear(ae_prev_dmg);
    comp_retire_clear();
    ghost_frame(scomp, sfb, swin, SBG);
    ghost_frame(scomp, sfb, swin, SBG);
    ghost_frame(scomp, sfb, swin, SBG);
    assert_eq(rend_band_h(), 0, "static window: settled, and it never moved");
    assert_eq(win_bufid(swin), 0, "static window: it genuinely has no client buffer");
    assert_eq(win_rect_changed(swin), 0, "static window: and its rect is genuinely unchanged");
    comp_close_window(scomp, win_id(swin));
    rend_frame_damage(scomp, sfb, SBG);
    assert_eq(rend_band_valid(), 1, "static close: a band was computed at all");
    assert(rend_band_h() > 0, "static close: and it is NOT empty — nothing else could have damaged it");
    assert(rend_band_y() <= 60, "static close: the band reaches the window's top");
    assert(rend_band_y() + rend_band_h() >= 60 + 80 + 30, "static close: ...and its bottom + titlebar");

    # Two windows closed in ONE frame must both be covered — the retired rect is a union.
    test_group("render — AE-0a: two closes in one frame union into one band");
    var ucomp = comp_new();
    var uw1 = comp_create_window(ucomp, 10, 10, 50, 50, "U1");
    var uw2 = comp_create_window(ucomp, 10, 300, 50, 50, "U2");
    comp_retire_clear();
    comp_close_window(ucomp, win_id(uw1));
    comp_close_window(ucomp, win_id(uw2));
    assert_eq(comp_retire_y(), 10, "union: top comes from the higher window");
    assert_eq(comp_retire_y() + comp_retire_h(), 350, "union: bottom comes from the lower window");
    assert_eq(comp_retire_valid(), 1, "union: still one valid box");
    comp_retire_clear();
    assert_eq(comp_retire_valid(), 0, "and clearing it invalidates it");

    # ⭐⭐ `AE-8` — THE PACKED 1bpp BITMAP MUST BE THE SAME GLYPHS THE CPU DRAWS.
    # This is the whole local verification of `#92` op 0x03, and it needs no GPU: expand the packed mask
    # the way the kernel's shader does (paint `color` where a bit is set, leave the rest) and compare it
    # pixel-for-pixel against `draw_text`'s own output on an identical framebuffer.
    # ⛔ IT CATCHES THE ONE MISTAKE THAT CANNOT BE EYEBALLED FROM CODE: the kernel reads the mask
    # **MSB-first**, and its own source names LSB-first as the error it was written to avoid — which
    # mirrors every glyph horizontally. A mirrored 'H' is still an 'H'-shaped blob in a pixel count, so
    # only an exact comparison against the reference renderer finds it.
    test_group("render — AE-8: the packed 1bpp mask equals what draw_text draws");
    # ⛔ THE GLYPH TABLES MUST BE LIVE. Without kashi_font_init() every `kashi_glyph_row` answers 0, so
    # BOTH the reference and the packed mask come out blank and compare EQUAL — a vacuous pass. The
    # `lit > 100` assert below exists to catch exactly that, and it did on the first run.
    kashi_font_init();
    var tw = 200;
    var th = 40;
    var fb_cpu = bhumi_fb_new(tw, th);
    var fb_gpu = bhumi_fb_new(tw, th);
    bhumi_fb_clear(fb_cpu, 0x00000000);
    bhumi_fb_clear(fb_gpu, 0x00000000);
    var msg = "Hg1|_ WM";                       # ascenders, descenders, a bar, an underscore, a space
    var mlen = strlen(msg);
    var TCOL = 0x00D7D7DF;

    # Reference: the per-pixel path, unchanged.
    # ⚠ ae_gpu_frame_ok must be 0 here or draw_text would ENQUEUE instead of drawing — the very routing
    # this test exists to validate would hollow out its own reference.
    ae_gpu_frame_ok = 0;
    draw_text(fb_cpu, msg, 5, 8, TCOL);

    # Under test: pack, then expand exactly as `gpu_glyph_surface` does.
    var stride = ae_text_stride(mlen);
    var mask = alloc(ae_text_bytes(mlen));
    var pw = ae_text_pack_1bpp(mask, msg, mlen);
    assert_eq(pw, mlen * FONT_ADV, "the packed width is one advance per character");
    assert_eq(stride, (pw + 7) / 8, "the row stride is the kernel's (w + 7) / 8");
    var gy = 0;
    while (gy < FONT_H) {
        var gx = 0;
        while (gx < pw) {
            var byi = gy * stride + gx / 8;
            var bit = gx - (gx / 8) * 8;
            if ((load8(mask + byi) & (1 << (7 - bit))) != 0) {
                bhumi_fb_set(fb_gpu, 5 + gx, 8 + gy, TCOL);
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }

    var diff = 0;
    var lit = 0;
    var py = 0;
    while (py < th) {
        var px = 0;
        while (px < tw) {
            var a = bhumi_fb_get(fb_cpu, px, py);
            var b = bhumi_fb_get(fb_gpu, px, py);
            if (a != b) { diff = diff + 1; }
            if (a == TCOL) { lit = lit + 1; }
            px = px + 1;
        }
        py = py + 1;
    }
    assert(lit > 100, "the reference actually drew glyphs (not comparing two blank buffers)");
    assert_eq(diff, 0, "the packed 1bpp mask expands to the EXACT pixels draw_text produces");

    # ⛔ NEGATIVE CONTROL: read the same mask LSB-first — the mistake the kernel warns about — and the
    # comparison must FAIL. Without this, a checker that passes two blank buffers looks identical.
    bhumi_fb_clear(fb_gpu, 0x00000000);
    gy = 0;
    while (gy < FONT_H) {
        var lx = 0;
        while (lx < pw) {
            var lbyi = gy * stride + lx / 8;
            var lbit = lx - (lx / 8) * 8;
            if ((load8(mask + lbyi) & (1 << lbit)) != 0) {        # LSB-first: mirrors each byte
                bhumi_fb_set(fb_gpu, 5 + lx, 8 + gy, TCOL);
            }
            lx = lx + 1;
        }
        gy = gy + 1;
    }
    var mdiff = 0;
    py = 0;
    while (py < th) {
        var mx = 0;
        while (mx < tw) {
            if (bhumi_fb_get(fb_cpu, mx, py) != bhumi_fb_get(fb_gpu, mx, py)) { mdiff = mdiff + 1; }
            mx = mx + 1;
        }
        py = py + 1;
    }
    assert(mdiff > 0, "reading the mask LSB-first MIRRORS the glyphs and is CAUGHT");

    # ---- the queue: routing, capacity, and the CPU fallback ----------------------------------------
    test_group("render — AE-8: the text queue routes and refuses honestly");
    ae_text_reset();
    assert_eq(ae_text_count(), 0, "reset empties the queue");
    assert_eq(ae_text_enqueue("title", 10, 20, 0x00FF0000), 1, "a run is accepted");
    assert_eq(ae_text_count(), 1, "and counted");
    assert_eq(ae_text_run_x(0), 10, "x is carried");
    assert_eq(ae_text_run_y(0), 20, "y is carried");
    assert_eq(ae_text_run_col(0), 0x00FF0000, "colour is carried");
    assert_eq(ae_text_run_len(0), 5, "length is the string length");
    assert_eq(load8(ae_text_run_ptr(0)), 0x74, "the string is COPIED into the pool, not aliased");
    # An empty string is queued as a no-op rather than refused: there is nothing to fall back TO, and
    # returning 0 would make the caller draw nothing on the CPU either — same result, more work.
    assert_eq(ae_text_enqueue("", 0, 0, 0), 1, "an empty run is a no-op, not a refusal");
    assert_eq(ae_text_count(), 1, "and does not occupy a slot");
    # ⛔ OVER-LONG AND OVER-FULL MUST REFUSE, so draw_text falls back to the CPU and the text still shows.
    var d0 = ae_text_dropped_get();
    var long = alloc(AE_TEXT_CHARS + 8);
    var li = 0;
    while (li < AE_TEXT_CHARS + 2) { store8(long + li, 0x41); li = li + 1; }
    store8(long + AE_TEXT_CHARS + 2, 0);
    assert_eq(ae_text_enqueue(long, 0, 0, 0), 0, "a run longer than the packer's cap is REFUSED");
    assert_eq(ae_text_dropped_get(), d0 + 1, "...and counted, because a silent drop is a lie");
    ae_text_reset();
    var qi = 0;
    while (qi < AE_TEXT_MAX) { ae_text_enqueue("x", 0, 0, 0); qi = qi + 1; }
    assert_eq(ae_text_count(), AE_TEXT_MAX, "the queue fills to exactly AE_TEXT_MAX");
    assert_eq(ae_text_enqueue("x", 0, 0, 0), 0, "and then refuses rather than overrunning");
    ae_text_reset();

    # ⛔ THE ONE-FRAME KILL SWITCH. draw_text enqueues BEFORE anyone knows the op will succeed, so a
    # refusing shader would mean captions absent on EVERY frame. gpu.cyr clears this flag on the first
    # refusal and draw_text must then take the CPU path again.
    ae_gpu_frame_ok = 1;
    assert_eq(ae_text_gpu_ok_get(), 1, "the GPU glyph path starts trusted");
    ae_text_reset();
    draw_text(fb_cpu, "queued", 0, 0, TCOL);
    assert_eq(ae_text_count(), 1, "on a GPU frame the run is QUEUED, not drawn");
    ae_text_gpu_disable();
    ae_text_reset();
    draw_text(fb_cpu, "drawn", 0, 0, TCOL);
    assert_eq(ae_text_count(), 0, "after a refusal draw_text goes back to the CPU path");
    assert_eq(ae_text_gpu_ok_get(), 0, "...and stays disabled for the rest of the run");
    ae_text_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_text_reset();

    # ⭐⭐ `AE-9` — the chrome rect queue. A wrong rect here is a hole in the frame, because with the
    # chrome on the GPU there is no userland framebuffer copy to fall back on after the fact.
    test_group("render — AE-9: chrome rects queue, clip, and refuse honestly");
    var rfb = bhumi_fb_new(400, 300);
    ae_gpu_frame_ok = 0;
    assert_eq(ae_chrome_on_gpu(), 0, "no GPU frame ⇒ chrome stays on the CPU");
    ae_gpu_frame_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "GPU frame + trusted path ⇒ chrome goes to #88");

    ae_rect_reset();
    assert_eq(ae_rect_count(), 0, "reset empties the queue");
    fill_rect(rfb, 10, 20, 30, 40, 0x00112233);
    assert_eq(ae_rect_count(), 1, "on a GPU frame fill_rect QUEUES instead of writing pixels");
    assert_eq(ae_rect_get_x(0), 10, "x carried");
    assert_eq(ae_rect_get_y(0), 20, "y carried");
    assert_eq(ae_rect_get_w(0), 30, "w carried");
    assert_eq(ae_rect_get_h(0), 40, "h carried");
    assert_eq(ae_rect_get_col(0), 0x00112233, "colour carried");
    # ⛔ AND IT MUST NOT HAVE TOUCHED THE FRAMEBUFFER. A fill that both queues and draws would double-paint
    # on the fallback path and waste the whole point on the GPU path.
    assert_eq(bhumi_fb_get(rfb, 15, 25), 0x00000000, "the framebuffer was NOT written");

    # ⛔ CLIPPING HAPPENS IN THE QUEUE, because `#88` REFUSES an out-of-range rect where `fill_rect` always
    # clipped silently. A window dragged one pixel past the edge must not retire the chrome path.
    ae_rect_reset();
    fill_rect(rfb, 0 - 10, 0 - 5, 30, 20, 0x00445566);
    assert_eq(ae_rect_count(), 1, "a partly off-screen rect is queued");
    assert_eq(ae_rect_get_x(0), 0, "clipped to x=0");
    assert_eq(ae_rect_get_y(0), 0, "clipped to y=0");
    assert_eq(ae_rect_get_w(0), 20, "width reduced by the clip (30 - 10)");
    assert_eq(ae_rect_get_h(0), 15, "height reduced by the clip (20 - 5)");
    ae_rect_reset();
    fill_rect(rfb, 390, 290, 100, 100, 0x00778899);
    assert_eq(ae_rect_get_w(0), 10, "clipped against the right edge");
    assert_eq(ae_rect_get_h(0), 10, "clipped against the bottom edge");
    ae_rect_reset();
    fill_rect(rfb, 500, 500, 10, 10, 0x00AABBCC);
    assert_eq(ae_rect_count(), 0, "a fully off-screen rect queues NOTHING");
    assert_eq(bhumi_fb_get(rfb, 0, 0), 0x00000000, "...and draws nothing either");

    # The clear band rides the same path as a full-width rect.
    ae_rect_reset();
    rend_clear_band(rfb, 50, 60, 0x00121218);
    assert_eq(ae_rect_count(), 1, "the clear band is queued as one rect");
    assert_eq(ae_rect_get_x(0), 0, "band starts at x=0");
    assert_eq(ae_rect_get_w(0), 400, "band spans the full width");
    assert_eq(ae_rect_get_y(0), 50, "band y carried");
    assert_eq(ae_rect_get_h(0), 60, "band height carried");

    # ⛔ OVERFLOW REFUSES, IS COUNTED, AND FALLS BACK TO DRAWING — never a silently missing rect.
    ae_rect_reset();
    var ri = 0;
    while (ri < AE_RECT_MAX) { ae_rect_enqueue(rfb, 0, 0, 2, 2, 0x00010203); ri = ri + 1; }
    assert_eq(ae_rect_count(), AE_RECT_MAX, "the queue fills to exactly AE_RECT_MAX");
    var rd0 = ae_rect_dropped_get();
    assert_eq(ae_rect_enqueue(rfb, 0, 0, 2, 2, 0x00010203), 0, "and then refuses");
    assert_eq(ae_rect_dropped_get(), rd0 + 1, "...counted, because a silent drop is a lie");
    bhumi_fb_clear(rfb, 0x00000000);
    fill_rect(rfb, 100, 100, 4, 4, 0x00FF00FF);
    assert_eq(bhumi_fb_get(rfb, 101, 101), 0x00FF00FF, "a refused fill DRAWS instead — no hole in the frame");

    # ⛔ THE LATCH: once gpu.cyr retires the path, every later frame draws on the CPU.
    ae_rect_reset();
    ae_chrome_gpu_disable();
    assert_eq(ae_chrome_on_gpu(), 0, "a refusal retires the chrome path for the run");
    bhumi_fb_clear(rfb, 0x00000000);
    fill_rect(rfb, 5, 5, 4, 4, 0x0000FF00);
    assert_eq(ae_rect_count(), 0, "and fill_rect stops queueing");
    assert_eq(bhumi_fb_get(rfb, 6, 6), 0x0000FF00, "...drawing instead");
    ae_chrome_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_rect_reset();

    # ⛔⛔ THE WINDOW'S VERTICAL CONVENTION IS PINNED HERE. `win_h` is the CONTENT height and the titlebar
    # sits ABOVE it, so a window at y=100 with h=300 occupies **100..430**, not 100..400. Five consumers
    # had drifted into three conventions (see the note in src/window.cyr); these asserts are what stops
    # that happening again, and two of them below were CHANGED by the reconciliation rather than added —
    # they used to encode the wrong convention and passed.
    test_group("render — the window geometry convention (chrome is OUTSIDE win_h)");
    var win = win_new(1, 100, 100, 400, 300, "T");
    assert_eq(win_body_y(win), 130, "content begins one TITLEBAR_H below the window origin");
    assert_eq(win_total_h(win), 330, "on-screen height is TITLEBAR_H + content height");
    assert_eq(win_bottom_y(win), 430, "exclusive bottom edge is y + TITLEBAR_H + h");

    test_group("render — decoration hit-test");
    assert_eq(deco_hit(win, 50, 50), Deco.DECO_NONE, "outside window");
    assert_eq(deco_hit(win, 300, 250), Deco.DECO_BODY, "body");
    assert_eq(deco_hit(win, 200, 110), Deco.DECO_TITLEBAR, "titlebar drag strip");
    assert_eq(deco_hit(win, 485, 112), Deco.DECO_CLOSE, "close button");
    assert_eq(deco_hit(win, 463, 112), Deco.DECO_MAX, "maximize button");
    assert_eq(deco_hit(win, 440, 112), Deco.DECO_MIN, "minimize button");
    assert_eq(deco_hit(win, 497, 250), Deco.DECO_RESIZE_R, "right resize edge");
    # ⚠ 424..429 is the bottom grab strip now (430 - RESIZE_M), NOT 394..399.
    assert_eq(deco_hit(win, 300, 427), Deco.DECO_RESIZE_B, "bottom resize edge");
    assert_eq(deco_hit(win, 497, 427), Deco.DECO_RESIZE_BR, "bottom-right resize corner");
    # ⛔ THE REGRESSION GUARD. (300,397) was asserted as DECO_RESIZE_B for as long as this test existed,
    # because the window was believed to end at y+h=400. Under the real convention it is 33 px inside the
    # client surface — so a drag there would have started a RESIZE in the middle of a window's content.
    # If this line ever reads RESIZE_B again, the chrome-inside convention has come back.
    assert_eq(deco_hit(win, 300, 397), Deco.DECO_BODY, "y+h-3 is BODY, not the bottom edge (was wrong before)");
    # The exact boundaries, so an off-by-one in either direction fails.
    assert_eq(deco_hit(win, 300, 129), Deco.DECO_TITLEBAR, "last titlebar row");
    assert_eq(deco_hit(win, 300, 130), Deco.DECO_BODY, "first content row");
    assert_eq(deco_hit(win, 300, 429), Deco.DECO_RESIZE_B, "last row inside the window");
    assert_eq(deco_hit(win, 300, 430), Deco.DECO_NONE, "first row BELOW the window");

    # ⭐ comp_window_at must agree with deco_hit, and it did not: it ended the window at y+win_h too, so
    # a click in the bottom TITLEBAR_H rows of a live client surface found whatever was BEHIND the window.
    test_group("render — comp_window_at agrees with the same convention");
    var hc = comp_new();
    var hw = comp_create_window(hc, 100, 100, 400, 300, "H");
    assert_eq(comp_window_at(hc, 300, 110), hw, "titlebar row hits the window");
    assert_eq(comp_window_at(hc, 300, 250), hw, "content hits the window");
    assert_eq(comp_window_at(hc, 300, 420), hw, "the bottom TITLEBAR_H rows hit it too (they did NOT before)");
    assert_eq(comp_window_at(hc, 300, 429), hw, "last row inside");
    assert_eq(comp_window_at(hc, 300, 430), 0, "one row below is a MISS");
    assert_eq(comp_window_at(hc, 300, 99), 0, "one row above is a MISS");
    win_set_state(hw, WinState.WS_MINIMIZED);
    assert_eq(comp_window_at(hc, 300, 250), 0, "a minimized window is not hit");
    win_set_state(hw, WinState.WS_NORMAL);

    # ⛔ THE THEME BODY MUST REACH THE BOTTOM OF THE CONTENT RECT. `render_window` used to fill it with
    # height `h - TITLEBAR_H` while blitting the client surface at the same origin with height `h`, in the
    # SAME function — so the theme body stopped TITLEBAR_H short of the surface drawn over it. Invisible
    # whenever a client covered it, and 30 px short on the compositor's own clientless window.
    # ⚠ Added because a mutant restoring `h - TITLEBAR_H` PASSED the whole suite: nothing measured the
    # body's height, so that half of the reconciliation was untested until these four lines.
    test_group("render — the theme body fills the whole content rect");
    var bfb = bhumi_fb_new(240, 240);
    var BBG = 0x00090909;
    bhumi_fb_clear(bfb, BBG);
    var bwin = win_new(9, 20, 20, 160, 120, "B");     # content 20+30=50 .. 170, bottom edge 170
    render_window(bfb, bwin, 0);
    var body_col = ae_bhumi(rupa_theme_widget(rupa_theme_active()));
    assert_eq(bhumi_fb_get(bfb, 100, win_body_y(bwin) + 2), body_col, "body is painted just below the titlebar");
    assert_eq(bhumi_fb_get(bfb, 100, win_bottom_y(bwin) - 2), body_col,
              "body reaches the LAST content row — a short fill stops TITLEBAR_H above this");
    assert_eq(bhumi_fb_get(bfb, 100, win_bottom_y(bwin) + 2), BBG, "and stops at the bottom edge");
    assert(bhumi_fb_get(bfb, 100, win_y(bwin) + 2) != body_col, "the titlebar is not the body colour");

    test_group("render — bitmap text (kashi VGA 8x16)");
    kashi_font_init();
    assert_eq(kashi_font_is_ready(), 1, "kashi font initialized");
    assert_eq(kashi_font_width(KASHI_FONT_VGA_8X16), 8, "glyph width 8");
    assert_eq(kashi_font_height(KASHI_FONT_VGA_8X16), 16, "glyph height 16");
    assert_eq(text_width("Hi"), 17, "text width = 2*9 - 1");
    assert_eq(text_width(""), 0, "empty string has width 0");
    var tfb = bhumi_fb_new(16, 20);
    bhumi_fb_clear(tfb, 0);
    var white = bhumi_xrgb(255, 255, 255);
    draw_char(tfb, 'A', 0, 0, white);
    var setpx = 0;
    var yy = 0;
    while (yy < 16) {
        var xx = 0;
        while (xx < 8) {
            if (bhumi_fb_get(tfb, xx, yy) == white) { setpx = setpx + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    var some = (setpx > 0);
    assert(some, "'A' glyph drew pixels");
    var notall = (setpx < 128);
    assert(notall, "'A' glyph is not a solid block");

    # ⭐ CLIPPING — fill_rect and blit_rect clamp the rectangle ONCE and then walk rows, rather
    # than testing every pixel against the bounds. That is a 8.7x speedup and it is also where a
    # clamp-once rewrite can silently disagree with the per-pixel original, so every edge is
    # asserted here rather than inferred from "the suite still passes". The old loop's behaviour
    # is the contract: out-of-bounds pixels are DROPPED, never wrapped and never clamped onto the
    # edge, and the in-bounds remainder is unaffected.
    test_group("render — fill_rect clipping");
    var cfb = bhumi_fb_new(20, 10);
    var red = bhumi_xrgb(255, 0, 0);
    var blu = bhumi_xrgb(0, 0, 255);

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 2, 2, 4, 3, red);
    assert_eq(bhumi_fb_get(cfb, 2, 2), red, "in-bounds: first pixel");
    assert_eq(bhumi_fb_get(cfb, 5, 4), red, "in-bounds: last pixel");
    assert_eq(bhumi_fb_get(cfb, 6, 2), 0, "in-bounds: one past the right edge untouched");
    assert_eq(bhumi_fb_get(cfb, 2, 5), 0, "in-bounds: one past the bottom edge untouched");
    assert_eq(bhumi_fb_get(cfb, 1, 2), 0, "in-bounds: one before the left edge untouched");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 0 - 3, 1, 5, 2, red);
    assert_eq(bhumi_fb_get(cfb, 0, 1), red, "clipped left: column 0 filled");
    assert_eq(bhumi_fb_get(cfb, 1, 1), red, "clipped left: the surviving 2 columns filled");
    assert_eq(bhumi_fb_get(cfb, 2, 1), 0, "clipped left: nothing beyond x+w");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 1, 0 - 2, 2, 5, red);
    assert_eq(bhumi_fb_get(cfb, 1, 0), red, "clipped top: row 0 filled");
    assert_eq(bhumi_fb_get(cfb, 1, 2), red, "clipped top: the surviving rows filled");
    assert_eq(bhumi_fb_get(cfb, 1, 3), 0, "clipped top: nothing beyond y+h");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 18, 8, 10, 10, red);
    assert_eq(bhumi_fb_get(cfb, 18, 8), red, "clipped bottom-right: the in-bounds corner is filled");
    assert_eq(bhumi_fb_get(cfb, 19, 9), red, "clipped bottom-right: last framebuffer pixel filled");
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "clipped bottom-right: no wrap to the far corner");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 50, 50, 4, 4, red);
    fill_rect(cfb, 0 - 50, 0 - 50, 4, 4, red);
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "fully offscreen draws nothing (positive and negative)");
    assert_eq(bhumi_fb_get(cfb, 19, 9), 0, "fully offscreen leaves the far corner alone");

    bhumi_fb_clear(cfb, 0);
    fill_rect(cfb, 2, 2, 0, 5, red);
    fill_rect(cfb, 2, 2, 5, 0, red);
    fill_rect(cfb, 2, 2, 0 - 4, 5, red);
    fill_rect(cfb, 2, 2, 5, 0 - 4, red);
    assert_eq(bhumi_fb_get(cfb, 2, 2), 0, "zero and negative w/h draw nothing");

    test_group("render — blit_rect clipping");
    # 4x3 source, each pixel encodes its own (x,y) so a wrong offset is visible, not just wrong.
    var src = alloc(4 * 3 * 4);
    var sy2 = 0;
    while (sy2 < 3) {
        var sx2 = 0;
        while (sx2 < 4) {
            store32(src + (sy2 * 4 + sx2) * 4, bhumi_xrgb(0, sy2 + 1, sx2 + 1));
            sx2 = sx2 + 1;
        }
        sy2 = sy2 + 1;
    }

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 5, 4, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 5, 4), bhumi_xrgb(0, 1, 1), "in-bounds: src (0,0) lands at (5,4)");
    assert_eq(bhumi_fb_get(cfb, 8, 6), bhumi_xrgb(0, 3, 4), "in-bounds: src (3,2) lands at (8,6)");
    assert_eq(bhumi_fb_get(cfb, 9, 4), 0, "in-bounds: one past the right edge untouched");

    # ⛔ THE ONE THAT MATTERS. The per-pixel original got source clipping for free — a dropped
    # write still advanced the source index. Walking rows does not: the source pointer must be
    # advanced by exactly the amount the destination was clipped by, or a partly-offscreen window
    # draws the WRONG PART of its own surface, which reads as a corrupt client, not as a clip bug.
    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 0 - 2, 0 - 1, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 0, 0), bhumi_xrgb(0, 2, 3),
              "clipped top-left: (0,0) shows src (2,1), NOT src (0,0)");
    assert_eq(bhumi_fb_get(cfb, 1, 1), bhumi_xrgb(0, 3, 4),
              "clipped top-left: (1,1) shows src (3,2)");
    assert_eq(bhumi_fb_get(cfb, 2, 0), 0, "clipped top-left: nothing past the source's right edge");

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 18, 9, src, 4, 3);
    assert_eq(bhumi_fb_get(cfb, 18, 9), bhumi_xrgb(0, 1, 1), "clipped bottom-right: corner pixel");
    assert_eq(bhumi_fb_get(cfb, 19, 9), bhumi_xrgb(0, 1, 2), "clipped bottom-right: second column");
    assert_eq(bhumi_fb_get(cfb, 0, 0), 0, "clipped bottom-right: no wrap onto the next row");

    bhumi_fb_clear(cfb, 0);
    blit_rect(cfb, 50, 50, src, 4, 3);
    blit_rect(cfb, 3, 3, 0, 4, 3);
    blit_rect(cfb, 3, 3, src, 0, 3);
    blit_rect(cfb, 3, 3, src, 4, 0);
    assert_eq(bhumi_fb_get(cfb, 3, 3), 0, "offscreen, null src, and zero dims all draw nothing");

    # ================================================================
    # AE-7: the cursor's DAMAGE rect must match the cursor's BITMAP
    # ================================================================
    # ⛔ WHEN THE CURSOR GREW FROM A GLYPH TO AN ARROW, THIS WAS THE SILENT HAZARD. The damage rect was
    # `FONT_W + 2` x `FONT_H + 2` (10x18) — which happens to be *almost* the arrow's 10x20, so a stale rect
    # would smear only the bottom two rows and only while moving. That is exactly the kind of defect that
    # survives a screenshot and shows up as "the pointer leaves a trail" three burns later.
    test_group("render — the cursor damages its own extent, and nothing when it is still");
    ae_ptr_x = 0; ae_ptr_y = 0;
    rend_cursor_mark_drawn(0, 0);
    var cd = rend_dmg_new();
    # Still -> no damage at all. This is what keeps an idle desktop free under AE-0a.
    assert_eq(rend_cursor_damage(cd), 0, "a stationary cursor returns 0");
    assert_eq(rend_dmg_valid(cd), 0, "a stationary cursor damages NOTHING");
    # Moved -> union of old and new, each the full bitmap extent.
    input_ptr_set(100, 200);
    rend_cursor_damage(cd);
    assert_eq(rend_dmg_valid(cd), 1, "a moved cursor damages");
    assert_eq(rend_dmg_x(cd), 0, "  union starts at the OLD position");
    assert_eq(rend_dmg_y(cd), 0, "  union starts at the OLD position");
    # old rect (0,0,w,h) + new rect (100,200,w,h) -> union is 100+w wide, 200+h tall.
    assert_eq(rend_dmg_w(cd), 100 + cursor_w(), "  union spans to the NEW rect's right edge");
    assert_eq(rend_dmg_h(cd), 200 + cursor_h(), "  union spans to the NEW rect's bottom edge");
    # ⭐ THE ASSERTION THAT CATCHES A FONT-SIZED RECT: the extent is the cursor's, not the glyph's.
    assert_eq(cursor_w(), 10, "  and that extent is the bitmap's width");
    assert_eq(cursor_h(), 20, "  and the bitmap's height (a FONT_H+2 rect would be 18 and smear)");
    # A single un-moved settle then re-damages nothing, proving mark_drawn pairs with the damage.
    rend_cursor_mark_drawn(100, 200);
    rend_dmg_clear(cd);
    assert_eq(rend_cursor_damage(cd), 0, "settled at the new position -> free again");
    assert_eq(rend_dmg_valid(cd), 0, "  and nothing damaged");

    # ================================================================
    # AE-7: a retired GPU cursor must FALL BACK, not vanish
    # ================================================================
    # ⛔⛔ THE BUG THIS CATCHES WAS SHIPPED AND CAUGHT BY A DEAD-CODE AUDIT, NOT BY A TEST. `render_cursor`
    # QUEUES for the GPU instead of drawing, so when the emit refused, the pointer was absent for that frame
    # — and because the next frame queues and refuses again, absent FOREVER, with one log line. That is
    # precisely what a refused glyph did to every caption on the desktop on 1.56.42, reproduced in the
    # cursor path by the fix for it.
    # ⇒ `ae_cursor_gpu_disable()` must send the next frame to `render_cursor_cpu`, which draws per-pixel and
    # cannot be refused. Verified by DRAWN PIXELS, not by a flag.
    test_group("render — a retired GPU cursor falls back to the CPU and is still drawn");
    var curfb = bhumi_fb_new(64, 64);
    ae_ptr_x = 0; ae_ptr_y = 0;
    input_ptr_set(4, 4);
    # A GPU frame with the cursor path healthy: render_cursor QUEUES and draws NOTHING itself.
    ae_gpu_frame_ok = 1;
    ae_text_gpu_ok = 1;
    ae_cursor_gpu_ok = 1;
    ae_cursor_q_clear();
    render_cursor(curfb);
    assert_eq(ae_cursor_q_pending(), 1, "a healthy GPU frame QUEUES the cursor");
    assert_eq(ae_cursor_q_x(), 4, "  at the pointer x");
    assert_eq(ae_cursor_q_y(), 4, "  at the pointer y");
    # ⭐ AND IT DREW NOTHING — which is exactly why a refusal used to lose the pointer entirely.
    assert_eq(bhumi_fb_get(curfb, 4, 4), 0, "  and drew NO pixel itself (the emit owes it)");

    # Now retire it, as gpu.cyr does on a refusal, and demand real pixels.
    ae_cursor_gpu_disable();
    assert_eq(ae_cursor_gpu_ok_get(), 0, "the cursor GPU path is retired");
    # ⛔⛔ THE ASSERTION THAT WOULD HAVE CAUGHT A SHIPPED-BUT-USELESS FIX. Falling back to the CPU is only
    # a fix if those pixels reach the panel, and they only do when the `#39` blit runs — which
    # `ae_chrome_on_gpu()` decides. It consulted `ae_text_gpu_ok` alone, so retiring the CURSOR left chrome
    # on the GPU, the blit skipped, and `render_cursor_cpu` painting into a buffer nothing copies. The
    # "fix" for an invisible cursor produced an invisible cursor. Found by audit, not by the test above —
    # which passes either way, because it only checks which BRANCH runs.
    assert_eq(ae_chrome_on_gpu(), 0, "a retired CURSOR pulls chrome off the GPU too, restoring the #39 blit");
    ae_cursor_q_clear();
    render_cursor(curfb);
    assert_eq(ae_cursor_q_pending(), 0, "a retired path does NOT queue");
    # ⛔⛔ PRE-FILL, OR THIS ENTIRE CHECK IS VACUOUS — and the first version of it was. The outline colour is
    # `bhumi_xrgb(0,0,0)` = **0**, which is byte-identical to an untouched framebuffer: a `!= 0` count sees
    # only the FILL (73 of 131 pixels), and `assert_eq(fb_get(tip), xrgb(0,0,0))` passes on a zeroed buffer
    # whether or not anything was drawn. Painting a distinctive background first makes "black" an observable
    # WRITE instead of an absence. [[feedback_instrument_discipline]] rule 2 — calibrate the null.
    # ⚠ PAINTED WITH `bhumi_fb_set` DIRECTLY, not `fill_rect`: this test needs `ae_gpu_frame_ok == 1` (that
    # is the whole point — the LATCH, not the frame kind, must cause the fallback), and on a GPU frame
    # `fill_rect` enqueues for the shader instead of touching the buffer. Measured: it painted nothing and
    # the count read 200, i.e. the full bitmap box differing from a background that was never there.
    var BG = bhumi_xrgb(9, 9, 9);
    var by = 0;
    while (by < 40) {
        var bx = 0;
        while (bx < 32) { bhumi_fb_set(curfb, bx, by, BG); bx = bx + 1; }
        by = by + 1;
    }
    assert_eq(bhumi_fb_get(curfb, 4, 4), BG, "  precondition: the tip pixel starts as background");
    assert_eq(ae_gpu_frame_ok, 1, "  precondition: this IS a GPU frame -- the latch is what redirects it");
    ae_cursor_q_clear();
    render_cursor(curfb);
    # The tip is at the hotspot and it is outline (black); the body is white. Both are now REAL writes.
    assert_eq(bhumi_fb_get(curfb, 4, 4), bhumi_xrgb(0, 0, 0), "the TIP is drawn on the CPU, in outline black");
    assert_eq(bhumi_fb_get(curfb, 5, 6), bhumi_xrgb(255, 255, 255), "the BODY is drawn on the CPU, in fill white");
    # Count what CHANGED from the background, so neither a one-pixel stub nor a fill-only draw can pass.
    var drawn = 0;
    var cy2 = 0;
    while (cy2 < cursor_h()) {
        var cx2 = 0;
        while (cx2 < cursor_w()) {
            if (bhumi_fb_get(curfb, 4 + cx2, 4 + cy2) != BG) { drawn = drawn + 1; }
            cx2 = cx2 + 1;
        }
        cy2 = cy2 + 1;
    }
    assert_eq(drawn, t_layer_count_r(CursorK.CUR_FILL) + t_layer_count_r(CursorK.CUR_OUTLINE),
              "every fill AND outline pixel of the arrow reached the framebuffer");
    assert_eq(t_gt_r(t_layer_count_r(CursorK.CUR_OUTLINE), 0), 1, "  (and the outline count is non-zero)");
    # ⚠ Restore, or every later assertion inherits a retired cursor.
    ae_cursor_gpu_ok = 1;
    ae_gpu_frame_ok = 0;
    ae_cursor_q_clear();

    # ================================================================
    # AE-7 iron regression: the glyph run that retired the whole text path
    # ================================================================
    # ⛔ THE 1.56.42 BURN. `#92` op 0x03 REFUSES an out-of-range rect (it does not clip), and the cursor
    # was then a GLYPH at the cursor position. The position was clamped to `bound_w - 1`, so an 8 px glyph
    # at x=2559 on a 2560-wide back buffer reached 2567, the op refused, `ae_text_gpu_disable()` retired the
    # path for the session — and every glyph on the desktop disappeared, titles included.
    # ⇒ The enqueue must refuse locally, exactly as `ae_rect_enqueue` already does for `#88`.
    # ⚠ THE CURSOR NO LONGER TAKES THIS PATH — it is a real bitmap in `src/cursor.cyr` and CLIPS instead of
    # refusing, so the pointer can sit on the last pixel. This guard is still load-bearing for CAPTIONS,
    # which have no clipping of their own, and the cursor is only how it was found.
    test_group("render — a text run outside the back buffer is refused LOCALLY, not by the kernel");
    var tfb2 = bhumi_fb_new(2560, 1440);
    ae_text_reset();
    ae_text_gpu_ok = 1;
    assert_eq(ae_text_fits(tfb2, "A", 100, 100), 1, "a run well inside fits");
    # One 8x16 glyph at 2559 ends at 2567 — the exact case the burn hit.
    assert_eq(ae_text_fits(tfb2, "A", 2559, 700), 0, "a glyph past the RIGHT edge does NOT fit");
    assert_eq(ae_text_fits(tfb2, "A", 700, 1439), 0, "a glyph past the BOTTOM edge does NOT fit");
    assert_eq(ae_text_fits(tfb2, "A", 0 - 1, 100), 0, "a negative x does not fit");
    assert_eq(ae_text_fits(tfb2, "A", 100, 0 - 1), 0, "a negative y does not fit");
    # The exact boundary, so an off-by-one in either direction fails.
    # ⚠ 2551, not 2552: `ae_text_width` is `n * FONT_ADV` and FONT_ADV is 9 (an 8 px glyph plus 1 px of
    # spacing), so one character occupies 9 columns. Deriving this from the constant rather than assuming
    # the glyph width is what makes the boundary assert meaningful.
    assert_eq(ae_text_fits(tfb2, "A", 2551, 700), 1, "the LAST fully-inside x fits (2551 + 9 = 2560)");
    assert_eq(ae_text_fits(tfb2, "A", 2552, 700), 0, "one past it does NOT");
    assert_eq(ae_text_fits(tfb2, "A", 700, 1424), 1, "the LAST fully-inside y fits");
    # A multi-character run must account for its whole width, not one glyph.
    assert_eq(ae_text_fits(tfb2, "AAAA", 2524, 700), 1, "a 4-char run ending exactly at the edge fits");
    assert_eq(ae_text_fits(tfb2, "AAAA", 2530, 700), 0, "...and one that overruns it does not (whole RUN width, not one glyph)");
    # ⚠ And a refusal must NOT retire the path — that is the difference between one missing frame and a
    # blank desktop for the session.
    assert_eq(ae_text_gpu_ok_get(), 1, "a locally-refused run leaves the GPU text path ENABLED");

    # ⛔⛔ AND IF TEXT DOES RETIRE, CHROME MUST RETIRE WITH IT. `AE-8`'s fallback comment promised the
    # desktop keeps its titles; `AE-9` then deleted the `#39` blit, so CPU-drawn glyphs land in a
    # framebuffer nothing copies to screen. Coupling the two is what makes the fallback real.
    test_group("render — a retired text path takes chrome off the GPU with it");
    ae_gpu_frame_ok = 1;
    ae_chrome_gpu_ok = 1;
    ae_text_gpu_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "both enabled: chrome is on the GPU");
    ae_text_gpu_disable();
    assert_eq(ae_chrome_on_gpu(), 0,
              "text retired ⇒ chrome retires too, so the #39 blit returns and CPU text is VISIBLE");
    ae_text_gpu_ok = 1;
    assert_eq(ae_chrome_on_gpu(), 1, "and it comes back when text does");
    ae_gpu_frame_ok = 0;
    assert_eq(ae_chrome_on_gpu(), 0, "no GPU frame ⇒ never on the GPU");
    ae_gpu_frame_ok = 1;

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
