# aethersafha — wallpaper files: what `wp_load_file` takes, refuses and spends.
#
# The fixtures are small and built here, so a refusal is the file's and not the machine's.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme.cyr"
include "src/cursor.cyr"
include "src/render.cyr"
include "src/gpu.cyr"
include "src/wallpaper.cyr"
include "src/input.cyr"

var WT_PNG_1X1 = "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000d4944415478da63105432fe0f0002140166dbbecc6f0000000049454e44ae426082";  #skip-lint
# a 16 x 16 PNG whose header says 5000 x 5000 (CRC good): 79 bytes declaring 100 MB of pixels
var WT_PNG_BOMB = "89504e470d0a1a0a0000000d49484452000013880000138808060000005d9887cb000000164944415478da6308a510308c1a306ac0a801c3c50000cc7e5410e1d6beff0000000049454e44ae426082";  #skip-lint
var WT_BMP_1X1 =
"424d3a0000000000000036000000280000000100000001000000010020000000000004000000130b0000130b00000000000000000000112233ff";
var WT_GIF_1X1 = "47494638396101000100800000000000ffffff2c00000000010001000002024401003b";

var wt_path[64];

fn wt_nib(c): i64 {
    if (c >= 97) { return c - 87; }
    return c - 48;
}

# Write the hex string to this run's fixture file, padded with zeros to `pad` bytes when it is longer. -> the path.
fn wt_file(hex, pad): i64 {
    var fd = sys_open(&wt_path, 0x241, 0x180);     # O_WRONLY | O_CREAT | O_TRUNC, 0600
    var n = strlen(hex) / 2;
    var b = alloc(n);
    var i = 0;
    while (i < n) {
        store8(b + i, wt_nib(load8(hex + i * 2)) * 16 + wt_nib(load8(hex + i * 2 + 1)));
        i = i + 1;
    }
    sys_write(fd, b, n);
    if (pad > n) { syscall(77, fd, pad); }         # ftruncate: a sparse tail
    sys_close(fd);
    return &wt_path;
}

fn main(): i64 {
    alloc_init();
    # a name of this run's own, so two runs cannot meet
    memcpy(&wt_path, "/tmp/ae-wp-test-", 16);
    var pid = syscall(39);
    var k = 0;
    while (k < 8) {
        store8(&wt_path + 16 + k, 97 + ((pid >> (k * 4)) & 15));
        k = k + 1;
    }
    store8(&wt_path + 24, 0);

    test_group("wallpaper — the ceiling follows the screen");
    var floor4k = 3840 * 2160 * 4;
    assert_eq(wp_decode_ceiling(2560, 1440), 2560 * 1440 * 4 * 4, "1440p: four screens of RGBA8");
    assert_eq(wp_decode_ceiling(3840, 2160), 3840 * 2160 * 4 * 4, "4K: four screens of RGBA8");
    assert_eq(wp_decode_ceiling(800, 600), floor4k, "a small screen still takes a 4K image");
    assert_eq(wp_decode_ceiling(0, 0), floor4k, "no answer from the kernel: the same floor");

    test_group("wallpaper — PNG and JPEG are what it takes");
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_1X1, 0), floor4k), 0, "a 1 x 1 PNG loads");
    assert_eq(wp_image_width(), 1, "  its width");
    assert_eq(wp_image_height(), 1, "  its height");
    assert_eq(wp_kind(), AeWallpaperKind.AE_WP_IMAGE, "  and it is the wallpaper");
    assert_eq(load32(wp_image()), 0x00112233, "  repacked to XRGB");
    var ser = wp_serial();
    assert_eq(wp_load_file_budget(wt_file(WT_BMP_1X1, 0), floor4k), 0 - 7, "a BMP is refused with its own code");
    assert_eq(wp_load_file_budget(wt_file(WT_GIF_1X1, 0), floor4k), 0 - 7, "a GIF is refused with its own code");
    assert_eq(wp_serial(), ser, "  and neither touched the wallpaper");

    test_group("wallpaper — a bomb is refused before it is decoded");
    var used0 = alloc_used();
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_BOMB, 0), floor4k), 0 - 8, "a header past the ceiling: its own code");
    assert_lt(alloc_used() - used0, 16777216 + 65536, "  and nothing past the read buffer was spent");
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_1X1, 0), 3), 0 - 8, "a 4 byte image against a 3 byte ceiling");
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_1X1, 0), 4), 0, "  and against a 4 byte one it loads");

    test_group("wallpaper — a file past the read cap says so");
    var cap = 16777216;
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_1X1, cap + 1), floor4k), 0 - 6, "one byte past 16 MiB: its own code");
    assert_eq(wp_load_file_budget(wt_file(WT_PNG_1X1, cap), floor4k), 0, "exactly 16 MiB is read whole");
    assert_eq(wp_load_file_budget("/nonexistent/wallpaper.png", floor4k), 0 - 1, "a missing file is still -1");
    sys_unlink(&wt_path);
    return assert_summary();
}

var ec = main();
syscall(60, ec);
