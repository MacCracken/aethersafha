# aethersafha — setu placed-client handshake state machine (pure kind dispatch).
#
# ⭐⭐ WHY THIS SUITE EXISTS. The handshake had NO test at all, and it was wrong on iron for a reason
# no amount of reading it would surface: the agnos channel is a 64-slot ring that DROPS THE OLDEST
# record when full (`chan_queue`, agnos kernel/core/syscall.cyr:4586). A client that presents every
# frame emits ATTACH+COMMIT per frame; the compositor's frame is far slower, so the client wraps the
# ring between two compositor reads and the read cursor lands at an ARBITRARY point in the
# …A,C,A,C,A,C… stream. The old machine demanded the exact next kind and therefore failed forever on a
# parity it did not pick — puka got no client fd, so every key died at forward_key's `cfd == 0`.
#
# ⭐ THE ORACLE IS EXTERNAL, not a mirror of the code: "from ANY offset into a client's present stream,
# the handshake must complete within a bounded number of records, and must never report a protocol
# error for something record LOSS can explain." That is the field requirement the transport imposes;
# it is not derived from how the machine is written. [[feedback_oracle_must_test_external_invariant]]
#
# Stdlib + [deps.*] auto-included via cyrius.cyml.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/setu_server.cyr"     # the transport the step reads and writes through
include "src/setu_dispatch.cyr"

fn t_gt(a, b): i64 {
    if (a > b) { return 1; }
    return 0;
}

# The state transition the step applies, and nothing else — no fds, no buffers, no compositor.
# Kept to three lines so the simulator cannot drift from production behaviour.
fn hs_next_state(state, act): i64 {
    if (act == SetuHsAct.HS_CREATE) { return 1; }
    if (act == SetuHsAct.HS_ATTACH) { return 2; }
    if (act == SetuHsAct.HS_COMMIT) { return 3; }
    return state;                                  # HS_SKIP holds; HS_BAD is caught by the caller
}

# Drive `stream[0..len)` from `start` and return the number of records consumed to reach state 3,
# or 0 - 1 if the machine reported HS_BAD, or 0 - 2 if it ran out of records without completing.
fn hs_sim(start, stream, len): i64 {
    var st = start;
    var i = 0;
    while (i < len) {
        var act = setu_hs_action(st, load64(stream + i * 8));
        if (act == SetuHsAct.HS_BAD) { return 0 - 1; }
        st = hs_next_state(st, act);
        i = i + 1;
        if (st == 3) { return i; }
    }
    return 0 - 2;
}

# An `n`-record present stream as the ring holds it: ATTACH, COMMIT, ATTACH, COMMIT, …
# `off` skips the first `off` records — exactly what "the ring dropped the oldest" does to a reader.
fn hs_present_stream(n, off): i64 {
    var s = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var k = SETU_ATTACH;
        if (((i + off) % 2) == 1) { k = SETU_COMMIT; }
        store64(s + i * 8, k);
        i = i + 1;
    }
    return s;
}

# A connected AF_UNIX / SOCK_SEQPACKET pair: Linux's setu transport, one record per write. The test
# plays the client on `hs_cli` and hands `hs_srv` to the compositor's own dispatch, so the REAL
# handshake code runs — not a model of it.
var hs_srv = 0;
var hs_cli = 0;
fn hs_pair(): i64 {
    var fds = alloc(16);
    if (sys_socketpair(SETU_AF_UNIX, SETU_SOCK_SEQPACKET, 0, fds) != 0) { return 0 - 1; }
    hs_srv = load32(fds);           # socketpair fills int[2]
    hs_cli = load32(fds + 4);
    return 0;
}
fn hs_unpair(): i64 {
    syscall(SYS_CLOSE, hs_srv);
    syscall(SYS_CLOSE, hs_cli);
    return 0;
}
fn hs_st_new(): i64 { return setu_hs_st_new(); }   # the caller-owned handshake scratch, zeroed (SetuHsSt)
fn hs_step(st, comp): i64 { return setu_srv_handshake_step(st, hs_srv, comp, 0, 0, "probe"); }

fn main() {
    alloc_init();

    # -----------------------------------------------------------------------
    test_group("setu handshake — the action table, per state");
    assert_eq(setu_hs_action(0, SETU_CREATE_SURFACE), SetuHsAct.HS_CREATE, "state 0 + create_surface -> create");
    assert_eq(setu_hs_action(1, SETU_ATTACH), SetuHsAct.HS_ATTACH, "state 1 + attach -> attach");
    assert_eq(setu_hs_action(2, SETU_COMMIT), SetuHsAct.HS_COMMIT, "state 2 + commit -> commit");

    # ⭐ THE TWO RESYNCS — the whole fix. Neither of these is a protocol error, because record LOSS
    # produces both of them from a perfectly well-behaved client.
    assert_eq(setu_hs_action(1, SETU_COMMIT), SetuHsAct.HS_SKIP, "state 1 + commit -> SKIP (its attach was dropped)");
    assert_eq(setu_hs_action(2, SETU_ATTACH), SetuHsAct.HS_ATTACH, "state 2 + attach -> re-attach (our commit was dropped)");

    # -----------------------------------------------------------------------
    test_group("setu handshake — kinds loss CANNOT explain are still errors");
    # A client blocks on SURFACE_CREATED before it sends anything else, so its CREATE_SURFACE can never
    # be pushed out of the ring by its own later writes — a missing one is a real protocol error.
    assert_eq(setu_hs_action(0, SETU_ATTACH), SetuHsAct.HS_BAD, "state 0 + attach is a protocol error");
    assert_eq(setu_hs_action(0, SETU_COMMIT), SetuHsAct.HS_BAD, "state 0 + commit is a protocol error");
    assert_eq(setu_hs_action(1, SETU_CREATE_SURFACE), SetuHsAct.HS_BAD, "state 1 + create_surface is a protocol error");
    assert_eq(setu_hs_action(2, SETU_CREATE_SURFACE), SetuHsAct.HS_BAD, "state 2 + create_surface is a protocol error");
    assert_eq(setu_hs_action(1, SETU_CLOSE), SetuHsAct.HS_BAD, "state 1 + close is not a handshake record");
    assert_eq(setu_hs_action(2, SETU_CLOSE), SetuHsAct.HS_BAD, "state 2 + close is not a handshake record");
    # ⛔⛔ STATE 3 IS NOT TERMINAL — THIS ASSERTION USED TO SAY IT WAS.
    # It read `assert_eq(setu_hs_action(3, SETU_COMMIT), HS_BAD, "already done -> no action")`, and
    # the whole state fell through to HS_BAD. That looked right because a committed client keeps its
    # window alive through the LIVE re-read (the compositor re-reads the attached slot every frame),
    # so rejecting later records changed nothing observable — until the surface RESIZED. setu
    # recreates the `#86` slot when the byte count changes, so a maximized client presents a NEW id
    # at a NEW extent and the compositor answered "protocol error" and kept blitting the old slot.
    # Iron 2026-08-19: puka logged `grid 320x88 cells, 2560x1408 px` while the displayed area never
    # grew. A re-attach is the ONLY way the compositor can learn a new slot id.
    assert_eq(setu_hs_action(3, SETU_ATTACH), SetuHsAct.HS_ATTACH,
      "state 3 + attach -> RE-ATTACH: this is how a resize is learned");
    # ⚠ A bare COMMIT asks for nothing new. SKIP, not BAD: a client whose ATTACH the ring ate must
    # not be torn down for it, and presenting clients send this pair every frame.
    assert_eq(setu_hs_action(3, SETU_COMMIT), SetuHsAct.HS_SKIP,
      "state 3 + commit -> skip, nothing new is being asked for");
    assert_eq(setu_hs_action(3, SETU_CREATE_SURFACE), SetuHsAct.HS_BAD,
      "state 3 + create_surface is still a protocol error");
    assert_eq(setu_hs_action(3, SETU_CLOSE), SetuHsAct.HS_BAD,
      "state 3 + close is still not a handshake record");

    # -----------------------------------------------------------------------
    test_group("setu handshake — a lossless stream completes");
    var clean = alloc(3 * 8);
    store64(clean + 0, SETU_CREATE_SURFACE);
    store64(clean + 8, SETU_ATTACH);
    store64(clean + 16, SETU_COMMIT);
    assert_eq(hs_sim(0, clean, 3), 3, "create + attach + commit completes in exactly 3 records");

    # -----------------------------------------------------------------------
    # ⭐⭐ THE INVARIANT THAT WAS BROKEN ON IRON. After CREATE_SURFACE the compositor is at state 1 and
    # the channel holds some suffix of the client's endless present stream. Whichever parity that suffix
    # starts on, the handshake must complete — and quickly, because the window is invisible until it does.
    test_group("setu handshake — completes from EVERY offset a dropping ring can leave");
    var off = 0;
    var worst = 0;
    while (off < 16) {
        var s = hs_present_stream(8, off);
        var n = hs_sim(1, s, 8);
        assert_eq(t_gt(n, 0), 1, "state 1 completes from a stream at this drop offset");
        if (n > worst) { worst = n; }
        off = off + 1;
    }
    # An odd offset costs ONE skipped orphan commit, then attach+commit: 3 records, never more.
    assert_eq(worst, 3, "worst case over all offsets is 3 records, not unbounded");

    # The same from state 2 — the compositor already read an ATTACH, then the ring ate its COMMIT.
    off = 0;
    while (off < 16) {
        var s2 = hs_present_stream(8, off);
        assert_eq(t_gt(hs_sim(2, s2, 8), 0), 1, "state 2 completes from a stream at this drop offset");
        off = off + 1;
    }

    # -----------------------------------------------------------------------
    test_group("setu handshake — a long run of orphan commits does not fail, it waits");
    # The pathological case: the reader landed such that every surviving record is a COMMIT (the client
    # was killed mid-stream, or the ring holds one parity). This must be "not yet", never "error".
    var orphans = alloc(8 * 8);
    var oi = 0;
    while (oi < 8) { store64(orphans + oi * 8, SETU_COMMIT); oi = oi + 1; }
    assert_eq(hs_sim(1, orphans, 8), 0 - 2, "all-commits from state 1 is incomplete, NOT an error");

    # -----------------------------------------------------------------------
    # ⛔⛔ 0.16.30: SURFACE GEOMETRY IS CLIENT INPUT. Both handshake paths checked only
    # `0 < h * stride <= 16 MB`, and every CPU frame re-reads `w * h * 4` bytes into that `h * stride`
    # cache — so a client could make the compositor write past its own heap block.
    test_group("setu handshake — the geometry rule (Rust's ShmBufferInfo::validate)");
    assert_eq(setu_surface_dims_ok(100, 50), 1, "100x50 is a surface");
    assert_eq(setu_surface_dims_ok(0, 50), 0, "zero width is not");
    assert_eq(setu_surface_dims_ok(100, 0), 0, "zero height is not");
    assert_eq(setu_surface_dims_ok(0 - 100, 50), 0, "negative width is not (it slipped under the read's clamp)");
    assert_eq(setu_surface_dims_ok(100, 0 - 50), 0, "negative height is not");
    assert_eq(setu_surface_dims_ok(16384, 16384), 1, "16384 a side is the limit");
    assert_eq(setu_surface_dims_ok(16385, 1), 0, "one past it in width is refused");
    assert_eq(setu_surface_dims_ok(1, 16385), 0, "one past it in height is refused");
    assert_eq(setu_attach_ok(100, 50, 400), 1, "packed rows (stride = 4w)");
    assert_eq(setu_attach_ok(100, 50, 512), 1, "padded rows are allowed, as Rust allowed them");
    assert_eq(setu_attach_ok(100, 50, 399), 0, "a row one byte short is refused");
    assert_eq(setu_attach_ok(1000, 600, 4), 0,
      "THE OVERFLOW: a 2,400-byte cache for a 2,400,000-byte read is refused");
    assert_eq(setu_attach_ok(100, 0 - 50, 0 - 400), 0,
      "negative h and stride are refused, though their product (+20000) passed the old check");
    assert_eq(setu_attach_ok(2048, 2048, 8192), 1, "exactly 16 MB is the cap");
    assert_eq(setu_attach_ok(2048, 2049, 8192), 0, "one row over the cap is refused");
    assert_eq(setu_attach_ok(100, 1, 16777217), 0, "a stride over the cap is refused");
    # ⚠ h = 2^62 + 1 at stride 4: h * stride WRAPS to 4, which the old `0 < nbytes <= 16 MB` accepted.
    assert_eq(setu_attach_ok(1, 4611686018427387905, 4), 0, "a product that wraps i64 is refused");

    #ifndef CYRIUS_TARGET_AGNOS
    # -----------------------------------------------------------------------
    # ⭐ THE REAL STEP OVER A REAL SOCKET. The rule above is pure, so on its own it cannot catch a call
    # site that stops using it; this drives `setu_srv_handshake_step` itself. Before 0.16.30 each hostile
    # ATTACH below passed the product check, allocated, and tried to read buffer 7, coming back -14
    # (no such buffer) instead of -12 — and only because buffer 7 did not exist. A client that made one
    # had its bytes written past the cache every frame.
    test_group("setu handshake — a hostile surface is refused before anything is read or kept");
    assert_eq(hs_pair(), 0, "socketpair(AF_UNIX, SOCK_SEQPACKET)");
    var hcomp = comp_new();
    var hst = hs_st_new();
    setu_send(hs_cli, setu_create_surface(100, 50, 0));
    assert_eq(hs_step(hst, hcomp), 0, "a sane create_surface is taken");
    assert_eq(load64(hst), 1, "-> state 1, awaiting attach");
    var hrep = setu_msg_new();
    setu_read_msg(hs_cli, hrep);
    var hsid = setu_msg_arg(hrep, 0);
    setu_send(hs_cli, setu_attach_buf(hsid, 100, 50, 4, 1, 7));
    assert_eq(hs_step(hst, hcomp), 0 - 12, "stride 4 on a 100-wide surface is refused (-12, not -14)");
    setu_send(hs_cli, setu_attach_buf(hsid, 100, 0 - 50, 0 - 400, 1, 7));
    assert_eq(hs_step(hst, hcomp), 0 - 12, "negative h and stride are refused (-12, not -14)");
    assert_eq(load64(hst), 1, "a refused attach leaves the state alone");
    assert_eq(win_pix(load64(hst + 8)), 0, "and allocates no cache");
    assert_eq(win_pixcap(load64(hst + 8)), 0, "none at all");
    assert_eq(win_bufid(load64(hst + 8)), 0, "and attaches nothing to the window");
    assert_eq(comp_count(hcomp), 0, "the window minted at create_surface is not on the desktop");

    # ⭐ AN ATTACH IS KEPT, A COMMIT APPLIES IT (0.17.6). A sane attach naming a buffer that does not exist
    # reads nothing until its commit — and an attach that no commit follows changes nothing.
    setu_send(hs_cli, setu_attach_buf(hsid, 100, 50, 400, 1, 7));
    assert_eq(hs_step(hst, hcomp), 0, "an attach of a missing buffer is taken: nothing is read yet");
    assert_eq(load64(hst), 2, "-> state 2");
    assert_eq(win_bufid(load64(hst + 8)), 0, "and nothing is attached to the window");
    setu_send(hs_cli, setu_commit(hsid));
    assert_eq(hs_step(hst, hcomp), 0 - 14, "its commit reads the buffer, and the read fails (-14)");
    assert_eq(win_pix(load64(hst + 8)), 0, "the failed read keeps no cache");
    assert_eq(comp_count(hcomp), 0, "and puts nothing on the desktop");
    var hst3 = hs_st_new();
    setu_send(hs_cli, setu_create_surface(100, 50, 0));
    assert_eq(hs_step(hst3, hcomp), 0, "a fresh surface for the rest");
    var hrep3 = setu_msg_new();
    setu_read_msg(hs_cli, hrep3);
    hsid = setu_msg_arg(hrep3, 0);
    hst = hst3;

    # A sane attach still lands, so the refusal is the rule and not a broken path.
    var hnb = 100 * 50 * 4;
    var hbid = setu_buf_create(hnb);
    assert_eq(t_gt(hbid, 0), 1, "a real shared buffer");
    setu_buf_write(hbid, alloc(hnb), hnb);
    setu_send(hs_cli, setu_attach_buf(hsid, 100, 50, 400, 1, hbid));
    assert_eq(hs_step(hst, hcomp), 0, "a sane attach is taken");
    assert_eq(load64(hst), 2, "-> state 2");
    setu_send(hs_cli, setu_commit(hsid));
    assert_eq(t_gt(hs_step(hst, hcomp), 0), 1, "commit completes with a window id");
    var hwin = load64(hst + 8);
    assert_eq(win_buf_w(hwin), 100, "the attached width is recorded");
    assert_eq(win_buf_h(hwin), 50, "the attached height is recorded");

    # ⛔ A LIVE WINDOW CANNOT BE TURNED HOSTILE. State 3 accepts a re-attach (that is how a resize lands),
    # so the rule has to hold there too.
    setu_send(hs_cli, setu_attach_buf(hsid, 100, 50, 4, 1, hbid));
    assert_eq(hs_step(hst, hcomp), 0 - 12, "a hostile re-attach on a live window is refused");
    assert_eq(load64(hst), 3, "the window stays live");
    assert_eq(win_buf_w(hwin), 100, "with the extent it validly attached");
    assert_eq(win_bufid(hwin), hbid, "and its buffer");

    # A hostile CREATE_SURFACE never mints a window.
    var hst2 = hs_st_new();
    var hn0 = comp_count(hcomp);
    setu_send(hs_cli, setu_create_surface(0 - 100, 50, 0));
    assert_eq(hs_step(hst2, hcomp), 0 - 12, "a negative width is refused at create_surface");
    setu_send(hs_cli, setu_create_surface(100, 16385, 0));
    assert_eq(hs_step(hst2, hcomp), 0 - 12, "so is a side over 16384");
    assert_eq(comp_count(hcomp), hn0, "and neither minted a window");
    setu_buf_close(hbid);
    hs_unpair();

    # -----------------------------------------------------------------------
    test_group("setu handshake — the accept path refuses the same surfaces");
    assert_eq(hs_pair(), 0, "socketpair(AF_UNIX, SOCK_SEQPACKET)");
    var acomp = comp_new();
    var aout = alloc(32);
    setu_send(hs_cli, setu_attach_buf(1, 100, 50, 4, 1, 7));
    setu_send(hs_cli, setu_commit(1));
    assert_eq(setu_srv_commit_from_create(setu_create_surface(100, 50, 0), hs_srv, acomp, aout), 0 - 12,
      "stride 4 on a 100-wide surface is refused (-12, not -14)");
    var an0 = comp_count(acomp);
    assert_eq(setu_srv_commit_from_create(setu_create_surface(100, 0 - 50, 0), hs_srv, acomp, aout), 0 - 12,
      "a negative height is refused at create_surface");
    assert_eq(comp_count(acomp), an0, "without minting a window");
    hs_unpair();
    #endif

    return assert_summary();
}

var ec = main();
syscall(60, ec);
