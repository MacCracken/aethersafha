    # --- end-to-end (rust-old/src/system_tests.rs:1177-1199,
    #     test_e2e_smart_window_placement): Idle placement, then a "terminal"
    #     WindowOpened from the compositor switches to Development placement.
    #     Rust's `_app_id` argument is unused, so the port takes none. ---
    test_group("ai_features — e2e smart window placement");
    var fe2e = ai_new();
    var re0 = ai_smart_window_placement(fe2e);
    assert_eq(ai_place_x(re0), 100, "e2e idle x=100");
    assert_eq(ai_place_y(re0), 100, "e2e idle y=100");
    assert_eq(ai_place_w(re0), 1200, "e2e idle w=1200");
    assert_eq(ai_place_h(re0), 800, "e2e idle h=800");
    var e2e_meta = map_new();
    map_set(e2e_meta, "app", str_from("terminal"));
    ai_update_context(fe2e, ai_event_new(303, AI_ContextEventType.AI_CE_WINDOW_OPENED,
        str_from("compositor"), clock_epoch_secs(), e2e_meta));
    var re1 = ai_smart_window_placement(fe2e);
    assert_eq(ai_place_x(re1), 100, "e2e development x=100");
    assert_eq(ai_place_y(re1), 100, "e2e development y=100");
    assert_eq(ai_place_w(re1), 1400, "e2e development w=1400");
    assert_eq(ai_place_h(re1), 900, "e2e development h=900");

    # --- register / initial state / count (test_register_agent_hud_initial_state) ---
