# aethersafha input-routing test (Bite A3).
# bhumi key events → actions → compositor window management.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/input.cyr"

fn main() {
    alloc_init();

    test_group("input — key → action mapping");
    assert_eq(input_map(bhumi_key_event(1, 0x29)), InputAction.IA_QUIT, "ESC pressed → quit");
    assert_eq(input_map(bhumi_key_event(1, 0x2B)), InputAction.IA_FOCUS_NEXT, "TAB → focus next");
    assert_eq(input_map(bhumi_key_event(1, 0x3D)), InputAction.IA_CLOSE_FOCUSED, "F4 → close focused");
    assert_eq(input_map(bhumi_key_event(1, 0x3E)), InputAction.IA_MAXIMIZE_FOCUSED, "F5 → toggle maximize");
    assert_eq(input_map(bhumi_key_event(1, 0x3F)), InputAction.IA_MINIMIZE_FOCUSED, "F6 → minimize");
    assert_eq(input_map(bhumi_key_event(0, 0x3D)), InputAction.IA_NONE, "key release → none");
    assert_eq(input_map(bhumi_key_event(1, 0x04)), InputAction.IA_NONE, "unmapped key → none");

    # ⭐⭐ THE WINDOW MOVER'S MAPPING. This group exists because the first mover was written as an
    # inline block in main.cyr's frame loop, where nothing could reach it — it was nested inside the
    # TAB branch, so its `usage >= 0x3A` guard sat inside `usage == 0x2B` and was unsatisfiable. It
    # compiled, it shipped, it flew to hardware, and the only symptom was one missing log line.
    # ⇒ The mapping lives in `input_map` now specifically so these seven lines can fail.
    test_group("input — F7-F10 map to the window mover");
    assert_eq(input_map(bhumi_key_event(1, 0x40)), InputAction.IA_MOVE_LEFT,  "F7 → move left");
    assert_eq(input_map(bhumi_key_event(1, 0x41)), InputAction.IA_MOVE_RIGHT, "F8 → move right");
    assert_eq(input_map(bhumi_key_event(1, 0x42)), InputAction.IA_MOVE_UP,    "F9 → move up");
    assert_eq(input_map(bhumi_key_event(1, 0x43)), InputAction.IA_MOVE_DOWN,  "F10 → move down");
    assert_eq(input_map(bhumi_key_event(0, 0x40)), InputAction.IA_NONE, "F7 RELEASE moves nothing");
    # ⛔ THE COLLISION GUARD. F4 was bound to the mover once and it is ALSO IA_CLOSE_FOCUSED, so
    # "move the focused window down" and "destroy the focused window" were the same keystroke. If a
    # future edit re-binds F4-F6 to directions, this line is what says no.
    assert_eq(input_map(bhumi_key_event(1, 0x3D)), InputAction.IA_CLOSE_FOCUSED, "F4 is STILL close, not a move");
    assert_eq(input_map(bhumi_key_event(1, 0x3E)), InputAction.IA_MAXIMIZE_FOCUSED, "F5 is STILL maximize, not a move");
    assert_eq(input_action_is_move(InputAction.IA_MOVE_LEFT), 1, "is_move: left");
    assert_eq(input_action_is_move(InputAction.IA_MOVE_DOWN), 1, "is_move: down");
    assert_eq(input_action_is_move(InputAction.IA_NONE), 0, "is_move: none is not a move");
    assert_eq(input_action_is_move(InputAction.IA_FOCUS_NEXT), 0, "is_move: focus is not a move");
    assert_eq(input_action_is_move(InputAction.IA_MINIMIZE_FOCUSED), 0, "is_move: minimize is not a move");

    test_group("input — apply to compositor focus + window state");
    var c = comp_new();
    comp_create_window(c, 0, 0, 100, 100, "A");
    comp_create_window(c, 0, 0, 100, 100, "B");
    comp_create_window(c, 0, 0, 100, 100, "C");
    assert_eq(comp_focused(c), 2, "focus follows newest window");
    # ⭐ WITH RAISE-ON-FOCUS THE ACTIVE WINDOW IS ALWAYS THE TOP, so `focused` is always `count-1` and
    # asserting an index proves nothing. What FOCUS-NEXT means now is a ROTATION: it takes the
    # bottom-most window and raises it, so repeated presses visit every window in turn.
    var top_before = comp_get(c, 2);
    var bottom_before = comp_get(c, 0);
    input_apply(c, InputAction.IA_FOCUS_NEXT, 800, 600);
    assert_eq(comp_focused(c), 2, "focus-next leaves focus on the TOP of the stack");
    assert_eq(comp_focused_window(c), bottom_before, "  ...and the window it raised is the old BOTTOM");
    assert_eq(comp_get(c, 1), top_before, "  ...with the old top pushed down one");
    # ⛔⛔ MAXIMIZE MUST CHANGE GEOMETRY, NOT JUST THE FLAG. Until 2026-08-17 this arm flipped
    # `WS_MAXIMIZED` and nothing read it — zero consumers outside the enum — so F5 "maximized" a window
    # that never moved. The state assertion below passed the whole time, which is exactly why it was not
    # noticed: it was testing the flag, and the flag was the bug.
    var xw = comp_focused_window(c);
    win_move(xw, 37, 41);
    win_resize(xw, 120, 90);
    input_apply(c, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600);
    assert_eq(win_x(xw), 0, "maximize moves the window to the origin");
    assert_eq(win_y(xw), 0, "  ...top edge too");
    assert_eq(win_w(xw), 800, "  ...and fills the work area's width");
    assert_eq(win_h(xw), 600, "  ...and its CONTENT height (chrome sits above it)");
    # ⚠ The total on-screen extent must not exceed the screen, or `#88`/`#87` REJECT the rect and the
    # GPU refuses the whole frame rather than drawing a too-tall window.
    assert_eq(win_total_h(xw), 600 + TITLEBAR_H, "  ...total extent = content + chrome");
    input_apply(c, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600);
    assert_eq(win_x(xw), 37, "un-maximize RESTORES the previous x");
    assert_eq(win_y(xw), 41, "  ...y");
    assert_eq(win_w(xw), 120, "  ...width");
    assert_eq(win_h(xw), 90, "  ...and height — the restore rect survived");
    # Put it back for the state assertions that follow.
    input_apply(c, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600);
    assert_eq(win_state(comp_focused_window(c)), WinState.WS_MAXIMIZED, "maximize focused");
    input_apply(c, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600);
    assert_eq(win_state(comp_focused_window(c)), WinState.WS_NORMAL, "maximize toggles back");
    input_apply(c, InputAction.IA_MINIMIZE_FOCUSED, 800, 600);
    assert_eq(win_state(comp_focused_window(c)), WinState.WS_MINIMIZED, "minimize focused");
    input_apply(c, InputAction.IA_CLOSE_FOCUSED, 800, 600);
    assert_eq(comp_count(c), 2, "close focused removes a window");

    # ⭐ THE MOVE ITSELF — position arithmetic, and the clamp that keeps the GPU path reachable.
    # ⚠ Bounds here are the USABLE extent (the caller reduces height by reserved chrome), so 800x600
    # means a window may occupy x in [0, 800-w] and y in [0, 600-h].
    test_group("input — the move slides the window and clamps it");
    var m = comp_new();
    comp_create_window(m, 200, 200, 100, 100, "M");
    var mw = comp_focused_window(m);
    assert_eq(input_apply(m, InputAction.IA_MOVE_LEFT, 800, 600), 1, "a real move reports 1");
    assert_eq(win_x(mw), 160, "left moves by one AE_MOVE_STEP");
    assert_eq(win_y(mw), 200, "left does not touch y");
    input_apply(m, InputAction.IA_MOVE_UP, 800, 600);
    assert_eq(win_y(mw), 160, "up moves by one step");
    assert_eq(win_x(mw), 160, "up does not touch x");
    input_apply(m, InputAction.IA_MOVE_RIGHT, 800, 600);
    input_apply(m, InputAction.IA_MOVE_RIGHT, 800, 600);
    assert_eq(win_x(mw), 240, "two rights are two steps");
    input_apply(m, InputAction.IA_MOVE_DOWN, 800, 600);
    assert_eq(win_y(mw), 200, "down moves by one step");

    # ----- ⭐⭐ M7 — RESIZE: the grips existed and nothing consumed them --------------------------
    # ⛔ `deco_hit` has returned DECO_RESIZE_R/_B/_BR since it was written, and the pointer handler
    # consumed four of nine regions — hit-tested every frame, answer discarded. Same shape as the
    # maximize/minimize buttons, which were painted and inert until wired.
    test_group("input — resize grips change the size, with a floor and an edge clamp");
    var r = comp_new();
    comp_create_window(r, 100, 100, 200, 150, "R");
    var rw = comp_focused_window(r);
    assert_eq(win_grip_is_resize(Deco.DECO_RESIZE_R), 1, "R is a grip");
    assert_eq(win_grip_is_resize(Deco.DECO_RESIZE_BR), 1, "BR is a grip");
    assert_eq(win_grip_is_resize(Deco.DECO_TITLEBAR), 0, "the titlebar is NOT a grip — it moves");
    assert_eq(win_grip_is_resize(Deco.DECO_CLOSE), 0, "nor is the close button");

    assert_eq(win_resize_by(rw, Deco.DECO_RESIZE_R, 40, 999, 2000, 2000), 1, "the right grip resizes");
    assert_eq(win_w(rw), 240, "  ...width grew by the delta");
    assert_eq(win_h(rw), 150, "  ...and the RIGHT grip ignores dy entirely");
    win_resize_by(rw, Deco.DECO_RESIZE_B, 999, 30, 2000, 2000);
    assert_eq(win_h(rw), 180, "the bottom grip grows height");
    assert_eq(win_w(rw), 240, "  ...and ignores dx");
    win_resize_by(rw, Deco.DECO_RESIZE_BR, 10, 10, 2000, 2000);
    assert_eq(win_w(rw), 250, "the corner grip moves both");
    assert_eq(win_h(rw), 190, "  ...both axes");

    # ⛔ THE FLOOR IS A GPU CONSTRAINT, NOT TASTE. A window dragged to zero or negative width makes
    # `w < 1`, and `#88`/`#87` REJECT such a rect rather than clipping — the GPU refuses the WHOLE
    # frame, so one over-drag blanks the desktop instead of pinching one window.
    win_resize_by(rw, Deco.DECO_RESIZE_BR, 0 - 5000, 0 - 5000, 2000, 2000);
    assert_eq(win_w(rw), WIN_MIN_W, "an over-drag inward clamps to the minimum width");
    assert_eq(win_h(rw), WIN_MIN_H, "  ...and the minimum height");
    assert_eq(win_resize_by(rw, Deco.DECO_RESIZE_BR, 0 - 100, 0 - 100, 2000, 2000), 0,
              "  ...and once at the floor it reports NO change");

    # ⛔ AND THE OUTWARD CLAMP IS THE SAME HAZARD MIRRORED: growing past the bound is the out-of-range
    # rect the GPU refuses. The window keeps its origin, so the limit is bound - origin.
    win_move(rw, 100, 100);
    win_resize_by(rw, Deco.DECO_RESIZE_BR, 9000, 9000, 800, 600);
    assert_eq(win_w(rw), 700, "growth clamps to bound_w - x");
    assert_eq(win_h(rw), 500, "  ...and bound_h - y");

    # ⛔ THE EDGE CLAMP IS THE POINT, NOT A NICETY. `#88`/`#87` REJECT an out-of-range rect instead of
    # clipping it, so a window pushed past an edge does not look wrong — it drops the entire frame off
    # the GPU. Each of these asserts the coordinate AND the "did not move" return value, because a
    # clamp that silently keeps returning 1 would make the caller's marker lie.
    win_move(mw, 20, 20);
    assert_eq(input_apply(m, InputAction.IA_MOVE_LEFT, 800, 600), 1, "a partial step still moves");
    assert_eq(win_x(mw), 0, "left clamps at the origin, not past it");
    assert_eq(input_apply(m, InputAction.IA_MOVE_LEFT, 800, 600), 0, "already at the left edge: no move");
    assert_eq(win_x(mw), 0, "and it stays at 0");
    win_move(mw, 0, 20);
    input_apply(m, InputAction.IA_MOVE_UP, 800, 600);
    assert_eq(win_y(mw), 0, "up clamps at the origin");
    win_move(mw, 690, 480);
    input_apply(m, InputAction.IA_MOVE_RIGHT, 800, 600);
    assert_eq(win_x(mw), 700, "right clamps so the window ends exactly at the bound");
    assert_eq(input_apply(m, InputAction.IA_MOVE_RIGHT, 800, 600), 0, "at the right edge: no move");
    input_apply(m, InputAction.IA_MOVE_DOWN, 800, 600);
    assert_eq(win_y(mw), 500, "down clamps so the window ends exactly at the bound");
    assert_eq(input_apply(m, InputAction.IA_MOVE_DOWN, 800, 600), 0, "at the bottom edge: no move");

    # ⛔ THE OVERSIZED WINDOW, which is the case that produces a NEGATIVE coordinate if the clamp is
    # written in the obvious order. A window wider than the bound makes the low clamp and the high
    # clamp disagree, the high one wins, and x goes negative — exactly the out-of-range rect the GPU
    # refuses. Deleting the re-clamp in `input_move` must fail here.
    var big = comp_new();
    comp_create_window(big, 0, 0, 900, 700, "BIG");
    var bw = comp_focused_window(big);
    input_apply(big, InputAction.IA_MOVE_RIGHT, 800, 600);
    assert_eq(win_x(bw), 0, "a window wider than the screen pins at x=0, never negative");
    input_apply(big, InputAction.IA_MOVE_DOWN, 800, 600);
    assert_eq(win_y(bw), 0, "a window taller than the screen pins at y=0, never negative");

    # An empty compositor: the move must be a no-op, not a null dereference.
    var none = comp_new();
    assert_eq(input_apply(none, InputAction.IA_MOVE_LEFT, 800, 600), 0, "no focused window: move is a no-op");

    # ⭐ THE KEY-ARRIVAL INSTRUMENT. Tested here because its first version lived inline in main.cyr's
    # frame loop where nothing could call it — the same structural mistake that let the window mover
    # ship as dead code. ⚠ `ae_inp_seen` is GLOBAL state, so every assert below uses a usage no other
    # assert touches; do not "tidy" them onto shared values.
    test_group("input — the key-usage trace names each DISTINCT usage once");
    assert_eq(ae_usage_first_sight(0x40), 1, "F7 is named the first time");
    assert_eq(ae_usage_first_sight(0x40), 0, "and NEVER again — a repeat costs no budget");
    assert_eq(ae_usage_first_sight(0x40), 0, "still nothing on the third press");
    assert_eq(ae_usage_first_sight(0x41), 1, "a DIFFERENT usage is still named");
    # ⛔ THE WORD BOUNDARY. 256 bits live in 4 u64 slots, so bit 63 of one word and bit 0 of the next
    # are adjacent usages in DIFFERENT words. A shift written `1 << u` instead of `1 << (u & 63)`
    # aliases them, and a slot index used as a byte offset reads the wrong word entirely.
    # ⚠ THE PAIR IS 191/192, NOT 63/64, and the first draft of this test got that wrong in a way worth
    # recording: `0x40` IS 64, so the F7 assert above had already marked the very bit the boundary case
    # then asserted was untouched — and the failure read as a bug in the bitmap rather than in the test.
    # ⇒ Never mix hex and decimal for the same value in a test over shared state.
    assert_eq(ae_usage_first_sight(191), 1, "usage 191 (last bit of word 2)");
    assert_eq(ae_usage_first_sight(192), 1, "usage 192 (first bit of word 3) is INDEPENDENT of 191");
    assert_eq(ae_usage_first_sight(191), 0, "191 stayed marked after 192 was marked");
    assert_eq(ae_usage_first_sight(192), 0, "192 stayed marked too");
    # ⛔ NEIGHBOUR ALIASING: marking 191 and 192 must not have marked anything either side of them.
    assert_eq(ae_usage_first_sight(190), 1, "190 was NOT marked by its neighbour 191");
    assert_eq(ae_usage_first_sight(193), 1, "193 was NOT marked by its neighbour 192");
    assert_eq(ae_usage_first_sight(63), 1, "usage 63 — the last bit of word 0, sign-bit position");
    assert_eq(ae_usage_first_sight(63), 0, "63 marks like any other despite being the sign bit");
    assert_eq(ae_usage_first_sight(127), 1, "usage 127 (last bit of word 1)");
    assert_eq(ae_usage_first_sight(255), 1, "usage 255 — the last bit of the last word");
    assert_eq(ae_usage_first_sight(255), 0, "255 marks like any other");
    # Out of range must be refused, not wrap into someone else's bit or write past the array.
    assert_eq(ae_usage_first_sight(256), 0, "256 is out of range — refused, not wrapped to 0");
    assert_eq(ae_usage_first_sight(0 - 1), 0, "a negative usage is refused");
    assert_eq(ae_usage_first_sight(0), 1, "usage 0 was NOT marked by the out-of-range calls");
    # And a usage nothing has touched is still unseen after all of the above.
    assert_eq(ae_usage_first_sight(200), 1, "an untouched usage is still first-sight at the end");
    # ⛔⛔ THE STRIDE. `load64(&ae_inp_seen + w * 8)` must scale the slot index by 8, because module-scope
    # slots are u64-wide. Dropping the `* 8` makes the four words OVERLAP at byte offsets 0,1,2,3 instead
    # of 0,8,16,24 — and the boundary asserts above DO NOT CATCH IT: under that aliasing usage 191 lands
    # in byte 9 and 192 in byte 3, still independent, so every one of them still passes.
    # ⇒ These two pairs are the ones that actually collide. Correct code maps usage u to byte u>>3 bit
    # u&7; the broken stride maps it to byte (u>>6)+((u&63)>>3), which sends 8 and 64 to the same bit,
    # and 16 and 128 likewise. `0x40` (= 64) was marked at the top of this group, so under the broken
    # stride usage 8 reads back as ALREADY SEEN.
    # ⚠ Verified as a real mutant: dropping the `* 8` fails exactly these lines and nothing else.
    assert_eq(ae_usage_first_sight(8), 1, "usage 8 is unseen — it must NOT alias usage 64 (0x40, marked above)");
    assert_eq(ae_usage_first_sight(128), 1, "usage 128 (word 2, bit 0)");
    assert_eq(ae_usage_first_sight(16), 1, "usage 16 is unseen — it must NOT alias usage 128");
    assert_eq(ae_usage_first_sight(24), 1, "usage 24 is unseen — it must NOT alias usage 192 (marked above)");

    # ================================================================
    # AE-7 — the pointer
    # ================================================================
    # ⛔ THE KIND GUARD IS THE SAFETY PROPERTY. `input_map` reads `ev & 0xFF`, so an unguarded pointer
    # event is interpreted as a keystroke — and a vertical motion of 41 is HID 0x29 = Escape = IA_QUIT.
    # Without this guard, moving the mouse downward would QUIT THE DESKTOP.
    test_group("input — a pointer event is NEVER read as a key");
    # ⛔ dx = 297 IS THE CASE THAT DISCRIMINATES, and deriving it mattered: `bhumi_key_usage` is the LOW
    # BYTE of dx and `bhumi_key_pressed` is BIT 8 of dx. So the hazard needs both — bit 8 set AND a low
    # byte that maps. 297 = 0x129: bit 8 set, low byte 0x29 = Escape. A horizontal flick of 297 px would
    # QUIT THE DESKTOP without the kind guard.
    # ⚠ The first version of this test used dy=41 and PASSED WITH THE GUARD REMOVED — dy lives in bits
    # 24-47 and cannot touch bit 8, so the `pressed` check caught it and the guard was never exercised.
    # A mutant that survives means the test proved nothing; this one kills it.
    assert_eq(input_map(bhumi_motion_event(297, 0)), InputAction.IA_NONE,
              "dx=297 does NOT map to IA_QUIT (bit 8 set + low byte 0x29 = Escape)");
    assert_eq(input_map(bhumi_motion_event(256 + 0x2B, 0)), InputAction.IA_NONE, "dx=299 is not TAB");
    assert_eq(input_map(bhumi_motion_event(256 + 0x40, 0)), InputAction.IA_NONE, "dx=320 is not F7");
    assert_eq(input_map(bhumi_motion_event(0, 41)), InputAction.IA_NONE, "dy=41 is inert either way");
    assert_eq(input_map(bhumi_button_event(1, 1)), InputAction.IA_NONE, "a button event maps to nothing");
    # ...and the guard must not have broken real keys.
    assert_eq(input_map(bhumi_key_event(1, 0x29)), InputAction.IA_QUIT, "a REAL Esc still quits");
    assert_eq(input_map(bhumi_key_event(1, 0x40)), InputAction.IA_MOVE_LEFT, "a REAL F7 still moves");

    test_group("input — the cursor clamps to the screen");
    input_ptr_set(100, 100);
    assert_eq(input_ptr_move(10, 5, 800, 600), 1, "a real move reports 1");
    assert_eq(input_ptr_x(), 110, "x advanced");
    assert_eq(input_ptr_y(), 105, "y advanced");
    assert_eq(input_ptr_move(0 - 20, 0 - 10, 800, 600), 1, "negative deltas move it back");
    assert_eq(input_ptr_x(), 90, "x went LEFT (a lost sign would send it right)");
    assert_eq(input_ptr_y(), 95, "y went UP");
    input_ptr_set(5, 5);
    input_ptr_move(0 - 50, 0 - 50, 800, 600);
    assert_eq(input_ptr_x(), 0, "clamps at the left edge");
    assert_eq(input_ptr_y(), 0, "clamps at the top edge");
    assert_eq(input_ptr_move(0 - 5, 0 - 5, 800, 600), 0, "already at the origin: no move");
    # ⛔ THE HIGH EDGE IS EXCLUSIVE. A cursor at x == bound_w sits one pixel off a bound_w-wide screen,
    # where it is outside every window's hit rect — and the screen edge is somewhere users do click.
    input_ptr_set(700, 500);
    input_ptr_move(500, 500, 800, 600);
    assert_eq(input_ptr_x(), 799, "clamps to bound_w - 1, not bound_w");
    assert_eq(input_ptr_y(), 599, "clamps to bound_h - 1, not bound_h");
    # ⛔ THE CALLER REDUCES THE BOUND BY THE GLYPH. This clamps a POINT, which is right — but the cursor
    # is 9x16 px, so the compositor passes `ae_geom_w - FONT_ADV + 1`. On a 2560-wide screen that caps x at
    # 2551, and the glyph then ends exactly at 2560. Without it, x=2559 puts the glyph at 2568, `#92`
    # op 0x03 refuses the rect, and the 1.56.42 burn showed that one refusal blanking every glyph on the
    # desktop. Asserted here with the same arithmetic the compositor uses.
    input_ptr_set(0, 0);
    input_ptr_move(9999, 9999, 2560 - 9 + 1, 1440 - 16 + 1);
    assert_eq(input_ptr_x(), 2551, "a 9 px cursor stops where its glyph still fits (2551 + 9 = 2560)");
    assert_eq(input_ptr_y(), 1424, "...and a 16 px tall one at 1424 (1424 + 16 = 1440)");

    test_group("input — button edges are what a click IS");
    # ⛔ `input_btn_edge`'s tests are gone with the function. They asserted `input_btn_edge(1, 0, 1) == -1`
    # — a RELEASE — using an argument pair the only production caller could NOT produce, because the
    # kernel re-seeds `buttons_seen` to the held level. A green unit test on unreachable inputs is what let
    # the burn blocker ship. `input_btn_transitions` is tested against the sequences hardware really emits.
    # ⇒ Ported to the surviving API rather than dropped: the MASK coverage below is real and the new
    # sequence tests do not otherwise exercise a non-left button.
    assert_eq(input_btn_transitions(0, 0, 0, 1), 0, "idle is neither press nor release");
    assert_eq(input_btn_pressed(input_btn_transitions(0, 2, 2, 1)), 0, "a RIGHT press is not a left press");
    assert_eq(input_btn_released(input_btn_transitions(0, 2, 2, 1)), 0, "...and not a left release");
    assert_eq(input_btn_pressed(input_btn_transitions(0, 2, 2, 2)), 1, "...but it IS a right-button press");
    # ⚠ And the right button's own release must work for the same reason the left's does.
    assert_eq(input_btn_released(input_btn_transitions(1, 0, 2, 2)), 1, "a right-button RELEASE fires too");

    # =====================================================================
    # AE-7: the button state machine — press and release are NOT one edge
    # =====================================================================
    # ⛔⛔ THE BUG THIS EXISTS FOR WAS A BURN-BLOCKER, caught by audit. The old code took ONE edge on
    # `cur | seen`. The kernel re-seeds `seen` to the held LEVEL on every drain
    # (`hid_mouse_take`, agnos kernel/arch/x86_64/usb/hid.cyr:232 `hid_mouse_btn_seen = hid_mouse_btn`),
    # so `cur | seen` reads 1 while the button is down AND on the poll where it comes up — the release
    # transition never appears. A titlebar drag was entered and never exited: the window follows the
    # pointer for the rest of the session, and no client ever receives a button-up.
    test_group("input — button transitions (press uses cur|seen, release uses cur ALONE)");
    # A normal press: level down, seen down.
    var t1 = input_btn_transitions(0, 1, 1, 1);
    assert_eq(input_btn_pressed(t1), 1, "press: fires on the way down");
    assert_eq(input_btn_released(t1), 0, "press: no release while the level is down");

    # ⭐ THE REGRESSION. Believed-down, level now UP, but `seen` still 1 from the kernel's re-seed.
    var t2 = input_btn_transitions(1, 0, 1, 1);
    assert_eq(input_btn_released(t2), 1, "RELEASE fires even though seen is still 1 -- the blocker");
    assert_eq(input_btn_pressed(t2), 0, "release: not also a press");

    # Held down across polls: neither transition.
    var t3 = input_btn_transitions(1, 1, 1, 1);
    assert_eq(input_btn_pressed(t3), 0, "held: no repeat press");
    assert_eq(input_btn_released(t3), 0, "held: no release");

    # ⭐ A FOLDED CLICK — began and ended inside one frame, so the level is already back up. It must
    # emit BOTH, or the client is left holding a button that was never released.
    var t4 = input_btn_transitions(0, 0, 1, 1);
    assert_eq(input_btn_pressed(t4), 1, "folded click: press");
    assert_eq(input_btn_released(t4), 1, "folded click: AND release, in the same event");

    # Idle: nothing at all.
    var t5 = input_btn_transitions(0, 0, 0, 1);
    assert_eq(input_btn_pressed(t5), 0, "idle: no press");
    assert_eq(input_btn_released(t5), 0, "idle: no release");

    # Believed-up with the level up stays quiet even if a stale seen lingers at 0.
    assert_eq(input_btn_transitions(0, 0, 0, 1), 0, "idle is exactly zero");

    # Mask isolation: the right button must not drive the left button's state.
    var t6 = input_btn_transitions(0, 2, 2, 1);
    assert_eq(input_btn_pressed(t6), 0, "a RIGHT-button press is not a left press");
    assert_eq(input_btn_released(t6), 0, "and not a left release");

    # ⭐ THE FULL SEQUENCE a real click produces on hardware, driven through the machine the way the
    # compositor drives it — this is the end-to-end statement that a drag can be exited.
    var believed = 0;
    var seq = input_btn_transitions(believed, 1, 1, 1);          # poll N: pressed
    assert_eq(input_btn_pressed(seq), 1, "sequence: press at poll N");
    believed = 0;
    if (input_btn_pressed(seq) == 1) { if (input_btn_released(seq) == 0) { believed = 1; } }
    assert_eq(believed, 1, "sequence: believed down after the press");
    seq = input_btn_transitions(believed, 0, 1, 1);               # poll N+1: released, seen re-seeded
    assert_eq(input_btn_released(seq), 1, "sequence: RELEASE at poll N+1 -- the drag can end");
    believed = 0;
    if (input_btn_pressed(seq) == 1) { if (input_btn_released(seq) == 0) { believed = 1; } }
    assert_eq(believed, 0, "sequence: believed up again, so the next click is not swallowed");

    return assert_summary();

    # ----- input.cyr — action provenance (A2) ---------------------
    # ⛔ `AE-M`'s BUTTON path was un-adjudicable from a burn capture: min/max route identically whether
    # a titlebar click or F5/F6 produced them, and neither printed a line. The source is recorded now,
    # so a capture can say WHICH produced the action — and this asserts the taxonomy with no output.
    test_group("input.cyr — action provenance");
    var pc = comp_new();
    comp_create_window(pc, 10, 10, 200, 120, "prov");
    comp_focus(pc, 0);

    input_apply_from(pc, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600, IA_SRC_BUTTON);
    assert_eq(input_last_action(), InputAction.IA_MAXIMIZE_FOCUSED, "button maximize records the action");
    assert_eq(input_last_src(), IA_SRC_BUTTON, "  ...and records BUTTON as the source");

    input_apply_from(pc, InputAction.IA_MINIMIZE_FOCUSED, 800, 600, IA_SRC_KEY);
    assert_eq(input_last_action(), InputAction.IA_MINIMIZE_FOCUSED, "key minimize records the action");
    assert_eq(input_last_src(), IA_SRC_KEY, "  ...and records KEY as the source");

    # ⛔ THE LOAD-BEARING ONE: the key path must tag itself too, or `input_last_src()` reports a STALE
    # BUTTON from an earlier action and a capture claims a click that never happened — worse than no
    # instrument, because it is confidently wrong.
    input_apply_from(pc, InputAction.IA_MAXIMIZE_FOCUSED, 800, 600, IA_SRC_BUTTON);
    input_handle(pc, bhumi_key_event(1, BHUMI_HID_TAB), 800, 600);
    assert_eq(input_last_src(), IA_SRC_KEY, "a key action CLEARS a previously recorded button source");
    assert_neq(IA_SRC_KEY, IA_SRC_BUTTON, "the two sources are distinguishable");
}

var ec = main();
syscall(60, ec);
