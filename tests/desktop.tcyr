# aethersafha desktop-aggregate test (B3 wiring).
# The Desktop owns the compositor + all 8 leaf subsystems and wires the live
# compositor→accessibility connection. Stdlib + [deps.*] auto-included.
include "src/frametime.cyr"   # render_desktop times the background clear through it
include "src/sysprobe.cyr"    # desktop_status_tick reads the panel producers
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/gestures.cyr"
include "src/accessibility.cyr"
include "src/ai_features.cyr"
include "src/shell.cyr"
include "src/security_ui.cyr"
include "src/plugin_host.cyr"
include "src/desktop.cyr"
# ⚠ Added for the z-order PIXEL test below: it renders a real frame through `render_desktop`, which
# needs the framebuffer, the renderer, the wallpaper backdrop and the cursor it draws.
include "lib/bhumi.cyr"
include "src/theme.cyr"
include "src/cursor.cyr"
include "src/render.cyr"
include "src/wallpaper.cyr"
include "src/launcher.cyr"   # render_desktop draws the launcher panel
include "src/input.cyr"
# ⚠ `render_desktop` paints the shell status panel and asks gpu.cyr whether the wallpaper is staged, so
# both must be linked for a REAL frame — this suite previously never rendered one, which is why it did
# not need them. Including them is what makes the pixel assertion below exercise the production path
# rather than a trimmed-down lookalike.
include "src/shell_render.cyr"
include "src/gpu.cyr"

# Fill a w*h XRGB client surface with one word, the way a setu client would. Same helper as
# tests/gpu_fallback.tcyr — a distinct sentinel per window is what makes "who owns this pixel"
# answerable at all.
fn t_ne_d(a, b): i64 { if (a == b) { return 0; } return 1; }

fn zseed(w, h, word): i64 {
    var px = alloc(w * h * 4);
    if (px == 0) { return 0; }
    var i = 0;
    while (i < w * h) { store32(px + i * 4, word); i = i + 1; }
    return px;
}

fn t_ok(x): i64 {
    if (x != 0) { return 1; }
    return 0;
}

fn t_streq(a, b): i64 {
    var i = 0;
    while (load8(a + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(b + i) != 0) { return 0; }
    return 1;
}

# Does the stored gauge `v` match a fresh read `p` of its producer? Same known-ness, and when both
# are known, within `tol` permille (the number moved between the two reads).
fn t_gauge_from(v, p, tol): i64 {
    if (sysp_is_known(v) != sysp_is_known(p)) { return 0; }
    if (sysp_is_known(v) == 0) { return 1; }
    var dlt = v - p;
    if (dlt < 0) { dlt = 0 - dlt; }
    if (dlt > tol) { return 0; }
    return 1;
}

fn t_le(a, b): i64 { if (a <= b) { return 1; } return 0; }
fn t_ge(a, b): i64 { if (a >= b) { return 1; } return 0; }

fn main() {
    alloc_init();

    # ----- ⭐⭐ THE ACTIVE WINDOW IS THE TOP LAYER — PROVEN IN COMPOSITED PIXELS ------------------
    # ⛔ SEEN ON IRON 2026-08-17: *"active window should be the highest layer"* — puka focused with crab
    # drawn over it. `comp_focus` stored an index and never touched the window vector; both draw paths
    # walk that vector bottom-to-top, so z-order was pure creation order and clicking changed nothing.
    # ⭐ THIS ASSERTS PIXELS THROUGH THE REAL `render_desktop`, not the vector. `tests/aethersafha.tcyr`
    # already gates the reorder; a reorder that never reaches the framebuffer is the same class of green
    # as a compositor's own "presented ok" line.
    test_group("desktop — focusing a window RAISES it to the top layer (composited pixels)");
    var zd = desktop_new();
    var zc = desk_comp(zd);
    var zfb = bhumi_fb_new(400, 300);
    var zA = comp_create_window(zc, 20, 20, 200, 150, "A");
    var zB = comp_create_window(zc, 90, 70, 200, 150, "B");
    win_set_pix(zA, zseed(200, 150, 0x00AA1111));
    win_set_pix(zB, zseed(200, 150, 0x0022BB22));
    var zx = 120;
    var zy = win_body_y(zB) + 20;      # inside BOTH bodies
    ae_gpu_frame_ok = 0;               # CPU path: render_desktop composites the surfaces itself
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x0022BB22, "precondition: B is newest, so B owns the overlap");

    # ⚠ NON-VACUITY — the sample must be inside A as well, or "B owns it" is trivially true and the
    # raise below proves nothing. Raise A and require the SAME pixel to flip to A's sentinel.
    comp_focus(zc, comp_find_by_id(zc, win_id(zA)));
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x00AA1111, "focusing A RAISES it — A now owns those pixels");

    # ...and back, so the top layer FOLLOWS focus rather than latching one way.
    comp_focus(zc, comp_find_by_id(zc, win_id(zB)));
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x0022BB22, "focusing B raises it back — it follows focus");

    # ----- ⭐⭐ THE LAUNCHER PANEL REACHES THE FRAMEBUFFER -----------------------------------------
    # ⚠ `tests/launcher.tcyr` gates the registry, keys and geometry — all pure. NONE of that proves the
    # panel is DRAWN: `render_launcher` could be unhooked from `render_desktop` and every one of those
    # 44 assertions would stay green. This is the seam that a pure test structurally cannot see, and it
    # is the same gap that let a z-order reorder pass while never reaching the pixels.
    # ----- ⭐⭐ M7-E: SWITCHING THE THEME REPAINTS THE WHOLE FRAME ---------------------------------
    # ⛔ A theme change moves no window, so a damage model that tracks window rects cannot see it — the
    # frame would band and the OLD colours would survive underneath. `wp_track_theme` is what closes
    # that: it compares the background token and bumps the wallpaper serial only when the colour really
    # changed, and `rend_band_compute` refuses to band across a serial change.
    # ⚠ ASSERTED ON THE BACKDROP, far from any window, because that is the region a banded frame would
    # leave stale — a pixel inside a window repaints for unrelated reasons and would prove nothing.
    test_group("desktop — cycling the theme repaints the backdrop (pixel proof)");
    var td = desktop_new();
    var tfb = bhumi_fb_new(320, 240);
    ae_gpu_frame_ok = 0;
    ae_theme_select(0);
    # ⛔⛔ WHAT THIS TEST DOES **NOT** PROVE, STATED BECAUSE I FIRST CLAIMED IT DID.
    # The interesting half of a theme switch is that it INVALIDATES THE DAMAGE BAND — a theme moves no
    # window, so a banded frame would repaint only the rows a window happened to be in and leave the old
    # colours everywhere else. This test cannot see that: measured 2026-08-17, deleting the
    # `ae_wp_serial` bump from `wp_track_theme` leaves every assertion below GREEN, because
    # `rend_band_valid()` is 0 throughout here (`render_desktop` full-repaints in this harness) so a
    # stale frame is not even possible to produce.
    # ⇒ What IS proven below: the four variants are reachable, the cycle wraps, out-of-range is refused,
    # and the backdrop token actually changes. The invalidation half needs a harness where the band is
    # live — the QEMU framebuffer oracle is the honest home for it, not this file.
    # ⚠ Do not "strengthen" this by asserting `rend_band_valid() == 1`; it is 0 here and the assertion
    # would be a false precondition, which is worse than an acknowledged gap.
    render_desktop(td, tfb);
    var bg0 = bhumi_fb_get(tfb, 300, 220);
    assert_eq(ae_theme_index(), 0, "precondition: variant 0 is active");

    ae_theme_cycle();
    render_desktop(td, tfb);
    assert_eq(ae_theme_index(), 1, "cycling advances the variant");
    assert_eq(t_ne_d(bhumi_fb_get(tfb, 300, 220), bg0), 1,
      "  ...and the BACKDROP actually repaints — the band did not hold the old colour");

    # ⛔ ALL FOUR ARE REACHABLE AND IT RETURNS HOME. A cycle that stops early, or one that never wraps,
    # strands variants that shipped — which is the state this rung exists to fix.
    ae_theme_cycle(); ae_theme_cycle();
    assert_eq(ae_theme_index(), 3, "  ...through every variant");
    ae_theme_cycle();
    assert_eq(ae_theme_index(), 0, "  ...and wraps back to the default");
    render_desktop(td, tfb);
    assert_eq(bhumi_fb_get(tfb, 300, 220), bg0, "a full cycle restores the original backdrop exactly");

    # ⚠ Out of range is REFUSED, not clamped: a caller computing an index wrongly should see it rather
    # than silently getting the default and concluding the switch is broken.
    assert_eq(ae_theme_select(4), 0, "an out-of-range variant is refused");
    assert_eq(ae_theme_select(0 - 1), 0, "  ...as is a negative one");
    assert_eq(ae_theme_index(), 0, "  ...and the active variant is untouched");

    test_group("desktop — the launcher panel is composited (pixel proof)");
    var ld = desktop_new();
    var lfb = bhumi_fb_new(400, 300);
    ae_gpu_frame_ok = 0;
    lnch_reset();
    lnch_register("/bin/puka", 9, "puka");
    lnch_register("/bin/crab", 9, "crab");
    # Sample the centre of the panel's accent seal — a 2 px strip only the launcher draws.
    var lpx = lnch_panel_x(400) + lnch_panel_w() / 2;
    var lpy = lnch_panel_y(300);
    render_desktop(ld, lfb);
    var closed_px = bhumi_fb_get(lfb, lpx, lpy);
    assert_eq(lnch_is_open(), 0, "precondition: the launcher is closed");

    lnch_openp();
    render_desktop(ld, lfb);
    var open_px = bhumi_fb_get(lfb, lpx, lpy);
    assert_eq(t_ne_d(open_px, closed_px), 1, "opening the launcher CHANGES those pixels");
    assert_eq(open_px, ae_bhumi(rupa_theme_accent(rupa_theme_active())),
      "  ...to the accent seal the panel draws");

    # ⛔ AND IT GOES AWAY AGAIN. A panel that paints but never un-paints looks identical on the frame
    # that matters and leaves the desktop permanently covered — the damage model does not repaint what
    # nothing reports as changed.
    lnch_close();
    render_desktop(ld, lfb);
    assert_eq(bhumi_fb_get(lfb, lpx, lpy), closed_px, "closing it restores the pixels underneath");

    test_group("desktop — aggregate instantiates every subsystem");
    var d = desktop_new();
    assert(t_ok(d), "desktop_new");
    assert(t_ok(desk_comp(d)), "compositor");
    assert(t_ok(desk_shell(d)), "shell");
    assert(t_ok(desk_ai(d)), "ai_features");
    assert(t_ok(desk_sec(d)), "security_ui");
    assert(t_ok(desk_a11y(d)), "accessibility");
    assert(t_ok(desk_gest(d)), "gestures");
    assert(t_ok(desk_plug(d)), "plugin_host");

    test_group("desktop — a11y tree mirrors the compositor window stack");
    var comp = desk_comp(d);
    var ax = desk_a11y(d);
    assert_eq(comp_a11y(comp), ax, "desktop_new hands the compositor the desktop's tree");
    assert_eq(desktop_sync_accessibility(d), 0, "no windows -> nothing to reconcile");
    # create -> a node keyed by the WINDOW id, Rust's role/name/bounds/actions, and the announcement
    var wa = comp_create_window(comp, 10, 20, 300, 200, "A");
    var na = a11y_tree_get_node(ax, win_id(wa));
    assert(t_ok(na), "create adds a node keyed by the window id");
    assert_eq(a11y_tree_len(ax), 1, "  ...exactly one");
    assert_eq(a11y_node_role(na), AxRole.AX_ROLE_WINDOW, "  ...role Window");
    assert_eq(streq(a11y_node_name(na), "A"), 1, "  ...name = title");
    assert_eq(rect_x(a11y_node_bounds(na)), 10, "  ...bounds x");
    assert_eq(rect_y(a11y_node_bounds(na)), 20, "  ...bounds y");
    assert_eq(rect_w(a11y_node_bounds(na)), 300, "  ...bounds w");
    assert_eq(rect_h(a11y_node_bounds(na)), 200, "  ...bounds h");
    assert_eq(vec_len(a11y_node_actions(na)), 3, "  ...three actions");
    assert_eq(vec_get(a11y_node_actions(na), 0), AxAction.AX_ACT_FOCUS, "  ...Focus");
    assert_eq(vec_get(a11y_node_actions(na), 1), AxAction.AX_ACT_CLICK, "  ...Click");
    assert_eq(vec_get(a11y_node_actions(na), 2), AxAction.AX_ACT_DISMISS, "  ...Dismiss");
    var an1 = a11y_tree_pending_announcements(ax);
    assert_eq(vec_len(an1), 1, "create announces once");
    assert_eq(streq(vec_get(an1, 0), "Window opened: A"), 1, "  ...\"Window opened: A\"");
    assert_eq(a11y_tree_focused_id(ax), win_id(wa), "the created window has tree focus (compositor focused it)");
    var wb = comp_create_window(comp, 0, 0, 100, 100, "B");
    var wc = comp_create_window(comp, 0, 0, 100, 100, "C");
    assert_eq(a11y_tree_len(ax), 3, "three windows, three nodes");
    assert_eq(a11y_tree_focused_id(ax), win_id(wc), "tree focus follows creation to C");
    assert_eq(a11y_node_is_focused(a11y_tree_get_node(ax, win_id(wb))), 0, "  ...B's node is not focused");
    # focus moves sync tree focus (comp_focus: click / Ctrl+Tab / setu focus all land here)
    comp_focus(comp, comp_find_by_id(comp, win_id(wa)));
    assert_eq(a11y_tree_focused_id(ax), win_id(wa), "comp_focus(A) moves tree focus to A");
    assert_eq(a11y_node_is_focused(a11y_tree_get_node(ax, win_id(wa))), 1, "  ...A's node state.focused");
    assert_eq(a11y_node_is_focused(a11y_tree_get_node(ax, win_id(wc))), 0, "  ...C's node unfocused");
    comp_focus(comp, comp_count(comp) - 1);
    assert_eq(a11y_tree_focused_id(ax), win_id(wa), "re-focusing the top window (the no-op raise) keeps A");
    # sync twice -> no duplicates, and a count that says nothing changed
    assert_eq(desktop_sync_accessibility(d), 0, "sync after mirrored windows changes nothing");
    assert_eq(desktop_sync_accessibility(d), 0, "  ...and again");
    assert_eq(a11y_tree_len(ax), 3, "  ...no duplicate nodes");
    assert_eq(a11y_tree_focused_id(ax), win_id(wa), "  ...focus untouched");
    a11y_tree_pending_announcements(ax);
    # close the FOCUSED window -> node gone, the exact announcement, focus handed off and synced
    var wa_id = win_id(wa);
    comp_close_window(comp, wa_id);
    assert_eq(a11y_tree_get_node(ax, wa_id), 0, "close removes the window's node");
    assert_eq(a11y_tree_len(ax), 2, "  ...two nodes left");
    var an2 = a11y_tree_pending_announcements(ax);
    assert_eq(vec_len(an2), 1, "close announces once");
    assert_eq(streq(vec_get(an2, 0), "Window closed: A"), 1, "  ...\"Window closed: A\"");
    assert_eq(comp_focused_id(comp), win_id(wc), "precondition: the hand-off focused C (topmost)");
    assert_eq(a11y_tree_focused_id(ax), win_id(wc), "the close hand-off syncs tree focus to C");
    # close an UNfocused window -> focus stays
    comp_close_window(comp, win_id(wb));
    assert_eq(a11y_tree_len(ax), 1, "closing unfocused B removes its node");
    assert_eq(a11y_tree_focused_id(ax), win_id(wc), "  ...tree focus stays on C");
    # minimize / unminimize: every window minimized -> nothing focused, in the tree too
    win_minimize(wc);
    comp_focus_topmost_visible(comp);
    assert_eq(comp_focused_id(comp), 0, "precondition: all minimized, compositor focuses nothing");
    assert_eq(a11y_tree_focused_id(ax), 0, "  ...and the tree focuses nothing");
    assert_eq(a11y_node_is_focused(a11y_tree_get_node(ax, win_id(wc))), 0, "  ...C's node unfocused");
    comp_focus(comp, comp_find_by_id(comp, win_id(wc)));
    assert_eq(a11y_tree_focused_id(ax), win_id(wc), "focusing the minimized C restores it and its tree focus");
    # reconcile repairs what bypassed the hooks: a window made while the mirror was detached, and a stale node
    comp_set_a11y(comp, 0);
    var wd = comp_create_window(comp, 1, 2, 30, 40, "D");
    comp_set_a11y(comp, ax);
    assert_eq(a11y_tree_get_node(ax, win_id(wd)), 0, "precondition: D was not mirrored");
    a11y_tree_window_open(ax, 4242, "Ghost", 0, 0, 1, 1);
    a11y_tree_pending_announcements(ax);
    assert_eq(desktop_sync_accessibility(d), 2, "sync adds D and drops the ghost: 2 changes");
    assert(t_ok(a11y_tree_get_node(ax, win_id(wd))), "  ...D has its node");
    assert_eq(a11y_tree_get_node(ax, 4242), 0, "  ...the ghost is gone");
    assert_eq(a11y_tree_focused_id(ax), win_id(wd), "  ...tree focus synced to D");
    var an3 = a11y_tree_pending_announcements(ax);
    assert_eq(vec_len(an3), 2, "  ...two announcements");
    assert_eq(streq(vec_get(an3, 0), "Window closed: Ghost"), 1, "  ...the ghost's close");
    assert_eq(streq(vec_get(an3, 1), "Window opened: D"), 1, "  ...D's open");
    assert_eq(desktop_sync_accessibility(d), 0, "a second sync changes nothing");
    assert_eq(a11y_tree_len(ax), 2, "  ...C and D, no duplicates");
    # a title with control bytes (incl. a C2 85 NEL) is sanitised in the announcements
    var ctl = alloc(16);
    store8(ctl + 0, 0x45);
    store8(ctl + 1, 0x1B);
    store8(ctl + 2, 0x5B);
    store8(ctl + 3, 0xC2);
    store8(ctl + 4, 0x85);
    store8(ctl + 5, 0x78);
    store8(ctl + 6, 0x07);
    store8(ctl + 7, 0);
    var we = comp_create_window(comp, 0, 0, 50, 50, ctl);
    comp_close_window(comp, win_id(we));
    var an4 = a11y_tree_pending_announcements(ax);
    assert_eq(streq(vec_get(an4, 0), "Window opened: E[x"), 1, "open: ESC, NEL and BEL stripped");
    assert_eq(streq(vec_get(an4, 1), "Window closed: E[x"), 1, "close: the same");

    test_group("desktop — an open launcher renders without disturbing the frame");
    # ⛔⛔ WHAT THIS DOES **NOT** COVER, STATED SO NOBODY READS IT AS COVERAGE. The 2026-08-18 burn's
    # "f2 brought up launcher but started flashing background" is fixed in `render_desktop` by
    # retiring the panel rect while the launcher is up — no window moves when it opens, so without
    # that the frame bands to the windows and the panel is drawn into a region never copied.
    # ⚠ A test that DISCRIMINATES needs a narrow band to exist, and `rend_band_compute` returns early
    # unless `ae_frame_dmg`/`ae_prev_dmg` are live — allocation only `main.cyr` performs. Priming
    # frames here still leave `rend_band_valid() == 0`, which makes any "is the panel covered" check
    # vacuously true; a mutation removing the damage call PASSED such a check. Rather than ship a
    # test that cannot fail, this asserts only what it can: the panel geometry lands on screen and
    # rendering with it open is stable. `tests/launcher.tcyr` proves the retire union covers the rect.
    # ⇒ The wiring itself is verified on iron, not here. Next burn: F2, then watch for flashing.
    var xfb = bhumi_fb_new(1280, 800);
    var xd = desktop_new();
    lnch_reset();
    lnch_register("/bin/puka", 9, "puka");
    lnch_register("/bin/crab", 9, "crab");
    lnch_openp();
    assert_eq(lnch_is_open(), 1, "the launcher is open");
    render_desktop(xd, xfb);
    render_desktop(xd, xfb);
    assert_eq(lnch_is_open(), 1, "  ...and stays open across frames");
    assert_eq(t_ge(lnch_panel_x(1280), 0), 1, "the panel is on screen horizontally");
    assert_eq(t_le(lnch_panel_y(800) + lnch_panel_h(), 800), 1, "  ...and vertically");

    # -----------------------------------------------------------------------
    test_group("desktop — the background clear is full-screen wherever #84 flips");
    # ⛔⛔ ESTABLISHED BY EXPERIMENT, NOT BY READING. Iron 2026-08-19 (b8), three runs, same actions:
    # control flickered; `--clearbg` (background full-screen, everything else still banded) was
    # CLEAN; `--fullclear` was also clean but a whole-screen refresh. ⇒ the BACKGROUND CLEAR's extent
    # is the cause and every other producer is innocent.
    # Since AE-9 the clear is a `#88` fill into the GPU back buffer and `#84` FLIPS, so a band-limited
    # clear paints rows into ONE buffer and the other keeps what it had — forever, because the band
    # never returns. AE-0a's 3.83 ms -> 2.46 ms was measured on a CPU store loop against a SINGLE
    # framebuffer, where a band is exactly right; that path keeps it.
    assert_eq(desk_bg_clear_is_full(1, 0), 1, "chrome on GPU: #84 flips, so the clear is full-screen");
    assert_eq(desk_bg_clear_is_full(0, 0), 0, "no GPU chrome: single buffer, AE-0a's band is kept");
    assert_eq(desk_bg_clear_is_full(0, 1), 1, "--clearbg forces the full clear off the GPU path");
    assert_eq(desk_bg_clear_is_full(1, 1), 1, "both: still full — the flag cannot narrow the clear");

    # -----------------------------------------------------------------------
    test_group("desktop — initialize (rust test_desktop_environment_initialize, main.rs:112-133)");
    # ⚠ Rust's test only asserted `is_ok()`. This asserts what initialize DOES: the welcome notice with
    # its exact fields, and both AI toggles on.
    var wdk = desktop_new();
    var wsh = desk_shell(wdk);
    var wai = desk_ai(wdk);
    # ⛔ ai_new already defaults both on, so they are switched OFF first — otherwise "initialize turns
    # them on" passes against an initialize that never touches them.
    ai_set_proactive_mode(wai, 0);
    ai_set_ambient_enabled(wai, 0);
    assert_eq(shell_notification_count(wsh), 0, "precondition: a fresh desktop holds no notification");
    assert_eq(desktop_initialize(wdk, 1700000000), 0, "initialize returns Ok");
    assert_eq(shell_notification_count(wsh), 1, "exactly one notification is stored");
    # ⚠ A blank stand-in when the notice is missing, so the field checks FAIL rather than fault.
    var wn = shell_notif_default(0, 0);
    if (shell_notification_count(wsh) == 1) { wn = vec_get(shell_get_notifications(wsh), 0); }
    assert_eq(t_streq(shell_notif_app_name(wn), "AGNOS Desktop"), 1, "app_name AGNOS Desktop");
    assert_eq(t_streq(shell_notif_title(wn), "Welcome to AGNOS"), 1, "title Welcome to AGNOS");
    assert_eq(t_streq(shell_notif_body(wn), "Your AI-native desktop environment"), 1, "body");
    assert_eq(shell_notif_priority(wn), SH_NotifPriority.SH_PRIO_NORMAL, "priority Normal");
    assert_eq(shell_notif_timestamp(wn), 1700000000, "timestamp is the caller's now");
    assert_eq(shell_notif_requires_action(wn), 0, "requires_action false");
    assert_eq(shell_notif_is_agent(wn), 0, "is_agent_related false");
    assert_eq(ai_proactive_mode(wai), 1, "proactive mode on");
    assert_eq(ai_ambient_enabled(wai), 1, "ambient on");
    var wfb = bhumi_fb_new(640, 400);
    assert_eq(render_notifications(wfb, wsh), 1, "the welcome notice is drawn as one card");
    # ⛔ AND IT COSTS NO HEAP PER FRAME. The notice never expires, so the panel's badge is drawn on
    # every frame of the session; the arena never frees, so a per-frame alloc there is a leak forever.
    ae_gpu_frame_ok = 0;
    render_desktop(wdk, wfb);
    var wh0 = alloc_used();
    render_desktop(wdk, wfb);
    assert_eq(alloc_used() - wh0, 0, "a frame of the initialized desktop allocates 0 B");

    # -----------------------------------------------------------------------
    test_group("desktop — status tick (rust test_desktop_environment_update_system_status, main.rs:163-183)");
    var kd = desktop_new();
    var ksh = desk_shell(kd);
    var kai = desk_ai(kd);
    # Seed every field with a value no producer can emit, so each write is observable.
    shell_update_system_status(ksh, shell_status_new(5555, 5555, 5555, 15, SH_NetStatus.SH_NET_CONNECTED, 42));
    ai_register_agent_hud(kai, 701, str_from("a"));
    ai_register_agent_hud(kai, 702, str_from("b"));
    var khist0 = vec_len(ai_history(kai));
    # ⚠ Each producer is read once first, so one that needs a prior sample (a cpu delta) is already
    # answering when the tick and the check below read it.
    sysp_cpu_permille_now();
    sysp_mem_permille_now();
    sysp_disk_permille_now();
    assert_eq(desktop_status_tick(kd, 1700000005), 0, "tick returns Ok");
    var kst = shell_status(ksh);
    # ⛔ AGAINST THE PRODUCER, NOT A RANGE: a tick writing -1 (or swapping two gauges) is in range too.
    # On this host mem is a real permille, so the check tells a wired gauge from a constant.
    var kmem = sysp_mem_permille_now();
    assert_eq(sysp_is_known(kmem), 1, "precondition: the host answers mem, so the next check can discriminate");
    assert_eq(t_gauge_from(shell_status_mem(kst), kmem, 20), 1, "mem is sysp_mem_permille_now (within 20 permille)");
    assert_eq(t_gauge_from(shell_status_cpu(kst), sysp_cpu_permille_now(), 1000), 1, "cpu is sysp_cpu_permille_now (known iff it is)");
    assert_eq(t_gauge_from(shell_status_disk(kst), sysp_disk_permille_now(), 20), 1, "disk is sysp_disk_permille_now (within 20 permille)");
    assert_eq(shell_status_battery_is_none(kst), 1, "battery None, as Rust writes it");
    # ⛔ NOT Connected — Rust hardcoded that (main.rs:173) with nothing measuring it.
    assert_eq(shell_status_net(kst), SH_NetStatus.SH_NET_UNKNOWN, "net UNKNOWN, not a claimed Connected");
    assert_eq(shell_status_agents(kst), 2, "agent count is the live agent registry");
    assert_eq(vec_len(ai_history(kai)), khist0 + 1, "one context event reached the AI history");
    var kev = ai_event_new(0, 0, str_from(""), 0, 0);   # stand-in: a missing event fails, not faults
    if (vec_len(ai_history(kai)) > khist0) { kev = vec_get(ai_history(kai), khist0); }
    assert_eq(ai_event_type(kev), AI_ContextEventType.AI_CE_USER_PRESENT, "  ...a UserPresent");
    assert_eq(str_eq(ai_event_source(kev), str_from("desktop")), 1, "  ...from source desktop");
    assert_eq(ai_event_ts(kev), 1700000005, "  ...stamped with the caller's now");
    ai_unregister_agent_hud(kai, 701);
    desktop_status_tick(kd, 1700000010);
    assert_eq(shell_status_agents(shell_status(ksh)), 1, "the count follows the registry down");
    var kev2 = kev;
    if (vec_len(ai_history(kai)) > khist0 + 1) { kev2 = vec_get(ai_history(kai), khist0 + 1); }
    assert_eq(t_ne_d(ai_event_id(kev2), ai_event_id(kev)), 1, "each event has its own id");

    # -----------------------------------------------------------------------
    test_group("desktop — the status tick is due every 5 s of the #95 clock");
    assert_eq(desk_tick_due(0, 0 - 1, 0, 120), 1, "first frame ticks (tokio's first tick is immediate)");
    assert_eq(desk_tick_due(123456, 0 - 1, 7, 120), 1, "the first tick does not wait for a frame multiple");
    assert_eq(desk_tick_due(4999999, 0, 1, 120), 0, "4.999999 s after the last: not yet");
    assert_eq(desk_tick_due(5000000, 0, 2, 120), 1, "5 s after the last: due");
    assert_eq(desk_tick_due(12000000, 5000000, 3, 120), 1, "7 s after the last: due");
    # ⛔ THE FRAME COUNT NO LONGER DRIVES IT when the clock answers — 120 frames is 5 s at one rate only.
    assert_eq(desk_tick_due(5000100, 5000000, 120, 120), 0, "a frame multiple is not due on a live clock");
    assert_eq(desk_tick_due(100, 5000000, 3, 120), 1, "a clock that ran backwards re-arms");
    test_group("desktop — ...and on the frame cadence when #95 says -1");
    assert_eq(desk_tick_due(0 - 1, 0 - 1, 0, 120), 1, "no clock: the first frame still ticks");
    assert_eq(desk_tick_due(0 - 1, 5000000, 119, 120), 0, "no clock: off-cadence frame waits");
    assert_eq(desk_tick_due(0 - 1, 5000000, 240, 120), 1, "no clock: every 120th frame ticks, never never");

    test_group("desktop — the frame loop's poll records the tick it ran");
    var pd = desktop_new();
    var pai = desk_ai(pd);
    desk_last_tick_us = 0 - 1;
    var ph0 = vec_len(ai_history(pai));
    assert_eq(desktop_status_poll(pd, 1000000, 0, 120), 1, "frame 0 ticks");
    assert_eq(desktop_status_poll(pd, 2000000, 1, 120), 0, "1 s later does not");
    assert_eq(desktop_status_poll(pd, 6000000, 2, 120), 1, "5 s after the first does");
    assert_eq(vec_len(ai_history(pai)), ph0 + 2, "two ticks, two UserPresent events");
    assert_eq(desktop_status_poll(pd, 0 - 1, 120, 120), 1, "a -1 clock falls back to the frame cadence");
    assert_eq(desk_last_tick_us, 6000000, "  ...without recording -1 as the last tick");

    return assert_summary();
}

var ec = main();
syscall(60, ec);
