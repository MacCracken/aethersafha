# aethersafha desktop-aggregate test (B3 wiring).
# The Desktop owns the compositor + all 8 leaf subsystems and wires the live
# compositor→accessibility connection. Stdlib + [deps.*] auto-included.
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme_bridge.cyr"
include "src/gestures.cyr"
include "src/accessibility.cyr"
include "src/ai_features.cyr"
include "src/shell.cyr"
include "src/security_ui.cyr"
include "src/shell_integration.cyr"
include "src/plugin_host.cyr"
include "src/desktop.cyr"
# ⚠ Added for the z-order PIXEL test below: it renders a real frame through `render_desktop`, which
# needs the framebuffer, the renderer, the wallpaper backdrop and the cursor it draws.
include "lib/bhumi.cyr"
include "src/theme.cyr"
include "src/cursor.cyr"
include "src/render.cyr"
include "src/wallpaper.cyr"
include "src/launcher.cyr"   # render_desktop draws the launcher panel
include "src/input.cyr"
# ⚠ `render_desktop` paints the shell status panel and asks gpu.cyr whether the wallpaper is staged, so
# both must be linked for a REAL frame — this suite previously never rendered one, which is why it did
# not need them. Including them is what makes the pixel assertion below exercise the production path
# rather than a trimmed-down lookalike.
include "src/shell_render.cyr"
include "src/gpu.cyr"

# Fill a w*h XRGB client surface with one word, the way a setu client would. Same helper as
# tests/gpu_fallback.tcyr — a distinct sentinel per window is what makes "who owns this pixel"
# answerable at all.
fn t_ne_d(a, b): i64 { if (a == b) { return 0; } return 1; }

fn zseed(w, h, word): i64 {
    var px = alloc(w * h * 4);
    if (px == 0) { return 0; }
    var i = 0;
    while (i < w * h) { store32(px + i * 4, word); i = i + 1; }
    return px;
}

fn t_ok(x): i64 {
    if (x != 0) { return 1; }
    return 0;
}

fn t_le(a, b): i64 { if (a <= b) { return 1; } return 0; }
fn t_ge(a, b): i64 { if (a >= b) { return 1; } return 0; }

fn main() {
    alloc_init();

    # ----- ⭐⭐ THE ACTIVE WINDOW IS THE TOP LAYER — PROVEN IN COMPOSITED PIXELS ------------------
    # ⛔ SEEN ON IRON 2026-08-17: *"active window should be the highest layer"* — puka focused with crab
    # drawn over it. `comp_focus` stored an index and never touched the window vector; both draw paths
    # walk that vector bottom-to-top, so z-order was pure creation order and clicking changed nothing.
    # ⭐ THIS ASSERTS PIXELS THROUGH THE REAL `render_desktop`, not the vector. `tests/aethersafha.tcyr`
    # already gates the reorder; a reorder that never reaches the framebuffer is the same class of green
    # as a compositor's own "presented ok" line.
    test_group("desktop — focusing a window RAISES it to the top layer (composited pixels)");
    var zd = desktop_new();
    var zc = desk_comp(zd);
    var zfb = bhumi_fb_new(400, 300);
    var zA = comp_create_window(zc, 20, 20, 200, 150, "A");
    var zB = comp_create_window(zc, 90, 70, 200, 150, "B");
    win_set_pix(zA, zseed(200, 150, 0x00AA1111));
    win_set_pix(zB, zseed(200, 150, 0x0022BB22));
    var zx = 120;
    var zy = win_body_y(zB) + 20;      # inside BOTH bodies
    ae_gpu_frame_ok = 0;               # CPU path: render_desktop composites the surfaces itself
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x0022BB22, "precondition: B is newest, so B owns the overlap");

    # ⚠ NON-VACUITY — the sample must be inside A as well, or "B owns it" is trivially true and the
    # raise below proves nothing. Raise A and require the SAME pixel to flip to A's sentinel.
    comp_focus(zc, comp_find_by_id(zc, win_id(zA)));
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x00AA1111, "focusing A RAISES it — A now owns those pixels");

    # ...and back, so the top layer FOLLOWS focus rather than latching one way.
    comp_focus(zc, comp_find_by_id(zc, win_id(zB)));
    render_desktop(zd, zfb);
    assert_eq(bhumi_fb_get(zfb, zx, zy), 0x0022BB22, "focusing B raises it back — it follows focus");

    # ----- ⭐⭐ THE LAUNCHER PANEL REACHES THE FRAMEBUFFER -----------------------------------------
    # ⚠ `tests/launcher.tcyr` gates the registry, keys and geometry — all pure. NONE of that proves the
    # panel is DRAWN: `render_launcher` could be unhooked from `render_desktop` and every one of those
    # 44 assertions would stay green. This is the seam that a pure test structurally cannot see, and it
    # is the same gap that let a z-order reorder pass while never reaching the pixels.
    # ----- ⭐⭐ M7-E: SWITCHING THE THEME REPAINTS THE WHOLE FRAME ---------------------------------
    # ⛔ A theme change moves no window, so a damage model that tracks window rects cannot see it — the
    # frame would band and the OLD colours would survive underneath. `wp_track_theme` is what closes
    # that: it compares the background token and bumps the wallpaper serial only when the colour really
    # changed, and `rend_band_compute` refuses to band across a serial change.
    # ⚠ ASSERTED ON THE BACKDROP, far from any window, because that is the region a banded frame would
    # leave stale — a pixel inside a window repaints for unrelated reasons and would prove nothing.
    test_group("desktop — cycling the theme repaints the backdrop (pixel proof)");
    var td = desktop_new();
    var tfb = bhumi_fb_new(320, 240);
    ae_gpu_frame_ok = 0;
    ae_theme_select(0);
    # ⛔⛔ WHAT THIS TEST DOES **NOT** PROVE, STATED BECAUSE I FIRST CLAIMED IT DID.
    # The interesting half of a theme switch is that it INVALIDATES THE DAMAGE BAND — a theme moves no
    # window, so a banded frame would repaint only the rows a window happened to be in and leave the old
    # colours everywhere else. This test cannot see that: measured 2026-08-17, deleting the
    # `ae_wp_serial` bump from `wp_track_theme` leaves every assertion below GREEN, because
    # `rend_band_valid()` is 0 throughout here (`render_desktop` full-repaints in this harness) so a
    # stale frame is not even possible to produce.
    # ⇒ What IS proven below: the four variants are reachable, the cycle wraps, out-of-range is refused,
    # and the backdrop token actually changes. The invalidation half needs a harness where the band is
    # live — the QEMU framebuffer oracle is the honest home for it, not this file.
    # ⚠ Do not "strengthen" this by asserting `rend_band_valid() == 1`; it is 0 here and the assertion
    # would be a false precondition, which is worse than an acknowledged gap.
    render_desktop(td, tfb);
    var bg0 = bhumi_fb_get(tfb, 300, 220);
    assert_eq(ae_theme_index(), 0, "precondition: variant 0 is active");

    ae_theme_cycle();
    render_desktop(td, tfb);
    assert_eq(ae_theme_index(), 1, "cycling advances the variant");
    assert_eq(t_ne_d(bhumi_fb_get(tfb, 300, 220), bg0), 1,
              "  ...and the BACKDROP actually repaints — the band did not hold the old colour");

    # ⛔ ALL FOUR ARE REACHABLE AND IT RETURNS HOME. A cycle that stops early, or one that never wraps,
    # strands variants that shipped — which is the state this rung exists to fix.
    ae_theme_cycle(); ae_theme_cycle();
    assert_eq(ae_theme_index(), 3, "  ...through every variant");
    ae_theme_cycle();
    assert_eq(ae_theme_index(), 0, "  ...and wraps back to the default");
    render_desktop(td, tfb);
    assert_eq(bhumi_fb_get(tfb, 300, 220), bg0, "a full cycle restores the original backdrop exactly");

    # ⚠ Out of range is REFUSED, not clamped: a caller computing an index wrongly should see it rather
    # than silently getting the default and concluding the switch is broken.
    assert_eq(ae_theme_select(4), 0, "an out-of-range variant is refused");
    assert_eq(ae_theme_select(0 - 1), 0, "  ...as is a negative one");
    assert_eq(ae_theme_index(), 0, "  ...and the active variant is untouched");

    test_group("desktop — the launcher panel is composited (pixel proof)");
    var ld = desktop_new();
    var lfb = bhumi_fb_new(400, 300);
    ae_gpu_frame_ok = 0;
    lnch_reset();
    lnch_register("/bin/puka", 9, "puka");
    lnch_register("/bin/crab", 9, "crab");
    # Sample the centre of the panel's accent seal — a 2 px strip only the launcher draws.
    var lpx = lnch_panel_x(400) + lnch_panel_w() / 2;
    var lpy = lnch_panel_y(300);
    render_desktop(ld, lfb);
    var closed_px = bhumi_fb_get(lfb, lpx, lpy);
    assert_eq(lnch_is_open(), 0, "precondition: the launcher is closed");

    lnch_openp();
    render_desktop(ld, lfb);
    var open_px = bhumi_fb_get(lfb, lpx, lpy);
    assert_eq(t_ne_d(open_px, closed_px), 1, "opening the launcher CHANGES those pixels");
    assert_eq(open_px, ae_bhumi(rupa_theme_accent(rupa_theme_active())),
              "  ...to the accent seal the panel draws");

    # ⛔ AND IT GOES AWAY AGAIN. A panel that paints but never un-paints looks identical on the frame
    # that matters and leaves the desktop permanently covered — the damage model does not repaint what
    # nothing reports as changed.
    lnch_close();
    render_desktop(ld, lfb);
    assert_eq(bhumi_fb_get(lfb, lpx, lpy), closed_px, "closing it restores the pixels underneath");

    test_group("desktop — aggregate instantiates every subsystem");
    var d = desktop_new();
    assert(t_ok(d), "desktop_new");
    assert(t_ok(desk_comp(d)), "compositor");
    assert(t_ok(desk_shell(d)), "shell");
    assert(t_ok(desk_ai(d)), "ai_features");
    assert(t_ok(desk_sec(d)), "security_ui");
    assert(t_ok(desk_a11y(d)), "accessibility");
    assert(t_ok(desk_gest(d)), "gestures");
    assert(t_ok(desk_theme(d)), "theme");
    assert(t_ok(desk_plug(d)), "plugin_host");

    test_group("desktop — a11y tree mirrors the compositor window stack");
    var comp = desk_comp(d);
    assert_eq(desktop_sync_accessibility(d), 0, "no windows -> no a11y nodes");
    comp_create_window(comp, 0, 0, 100, 100, "A");
    comp_create_window(comp, 0, 0, 100, 100, "B");
    assert_eq(desktop_sync_accessibility(d), 2, "sync returns one node per window");
    assert_eq(a11y_tree_len(desk_a11y(d)), 2, "a11y tree has a node per window");

    test_group("desktop — shell-integration tray");
    assert_eq(desk_tray_count(d), 0, "tray starts empty");
    desktop_add_tray_item(d, 1, "net", "Network");
    desktop_add_tray_item(d, 2, "vol", "Volume");
    assert_eq(desk_tray_count(d), 2, "two tray items registered");

    test_group("desktop — theme → renderer background");
    assert_eq(desk_bg_color(d), 0x121218, "desktop bg comes from the theme (alpha masked)");

    test_group("desktop — an open launcher renders without disturbing the frame");
    # ⛔⛔ WHAT THIS DOES **NOT** COVER, STATED SO NOBODY READS IT AS COVERAGE. The 2026-08-18 burn's
    # "f2 brought up launcher but started flashing background" is fixed in `render_desktop` by
    # retiring the panel rect while the launcher is up — no window moves when it opens, so without
    # that the frame bands to the windows and the panel is drawn into a region never copied.
    # ⚠ A test that DISCRIMINATES needs a narrow band to exist, and `rend_band_compute` returns early
    # unless `ae_frame_dmg`/`ae_prev_dmg` are live — allocation only `main.cyr` performs. Priming
    # frames here still leave `rend_band_valid() == 0`, which makes any "is the panel covered" check
    # vacuously true; a mutation removing the damage call PASSED such a check. Rather than ship a
    # test that cannot fail, this asserts only what it can: the panel geometry lands on screen and
    # rendering with it open is stable. `tests/launcher.tcyr` proves the retire union covers the rect.
    # ⇒ The wiring itself is verified on iron, not here. Next burn: F2, then watch for flashing.
    var xfb = bhumi_fb_new(1280, 800);
    var xd = desktop_new();
    lnch_reset();
    lnch_register("/bin/puka", 9, "puka");
    lnch_register("/bin/crab", 9, "crab");
    lnch_openp();
    assert_eq(lnch_is_open(), 1, "the launcher is open");
    render_desktop(xd, xfb);
    render_desktop(xd, xfb);
    assert_eq(lnch_is_open(), 1, "  ...and stays open across frames");
    assert_eq(t_ge(lnch_panel_x(1280), 0), 1, "the panel is on screen horizontally");
    assert_eq(t_le(lnch_panel_y(800) + lnch_panel_h(), 800), 1, "  ...and vertically");

    return assert_summary();
}

var ec = main();
syscall(60, ec);
