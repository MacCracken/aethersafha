# aethersafha test suite — foundational compositor core.
# Includes the bhumi-free core modules directly (geom/window/compositor);
# render/input/main bind bhumi and are exercised by the smoke program.
# Stdlib + [deps.*] auto-included via cyrius.cyml.
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "lib/bhumi.cyr"
include "src/theme.cyr"
include "src/cursor.cyr"
include "src/render.cyr"
include "src/wallpaper.cyr"   # M6-C1a: the backdrop source under test below

fn main() {
    alloc_init();

    test_group("geom — Rectangle");
    var r = rect_new(10, 20, 100, 50);
    assert_eq(rect_x(r), 10, "rect x");
    assert_eq(rect_w(r), 100, "rect w");
    assert_eq(rect_contains(r, 50, 40), 1, "point inside");
    assert_eq(rect_contains(r, 5, 40), 0, "point left of rect");
    assert_eq(rect_contains(r, 50, 200), 0, "point below rect");

    test_group("window — Window model");
    var w = win_new(7, 0, 0, 400, 300, "term");
    assert_eq(win_id(w), 7, "win id");
    assert_eq(win_w(w), 400, "win width");
    assert_eq(win_state(w), WinState.WS_NORMAL, "default state NORMAL");
    win_set_state(w, WinState.WS_MAXIMIZED);
    assert_eq(win_state(w), WinState.WS_MAXIMIZED, "state mutates");
    win_move(w, 15, 25);
    assert_eq(win_x(w), 15, "window moves");

    test_group("compositor — window stack + focus");
    var c = comp_new();
    assert_eq(comp_count(c), 0, "starts empty");
    assert_eq(comp_focused(c), 0 - 1, "no focus when empty");
    var w1 = comp_create_window(c, 0, 0, 100, 100, "a");
    var w2 = comp_create_window(c, 0, 0, 100, 100, "b");
    assert_eq(comp_count(c), 2, "two windows");
    assert_eq(win_id(w1), 1, "ids assigned from 1");
    assert_eq(win_id(w2), 2, "ids increment");
    assert_eq(comp_focused(c), 1, "focus follows newest window");
    # ⭐⭐ FOCUSING RAISES (2026-08-17). These two used to assert `focused == 0` and `find_by_id(2) == 1`
    # — i.e. that focus was a stored index with no effect on the stack. That was the defect the operator
    # hit on iron: *"active window should be the highest layer"*, with puka focused UNDER crab. Both draw
    # paths walk the window vector bottom-to-top, so the only way to be on top is to BE last.
    comp_focus(c, 0);
    assert_eq(comp_focused(c), 1, "focusing RAISES — the focused window is the top of the stack");
    assert_eq(comp_find_by_id(c, 1), 1, "  ...w1 moved to the top");
    assert_eq(comp_find_by_id(c, 2), 0, "  ...and w2 shifted down to make room");
    # ⚠ NON-VACUITY: re-focusing the window that is ALREADY on top must not churn the vector.
    comp_focus(c, 1);
    assert_eq(comp_focused(c), 1, "re-focusing the top window is a no-op");
    assert_eq(comp_find_by_id(c, 1), 1, "  ...and does not reorder anything");
    assert_eq(comp_find_by_id(c, 99), 0 - 1, "missing id -> -1");
    comp_close_window(c, 1);
    assert_eq(comp_count(c), 1, "count drops after close");
    assert_eq(comp_find_by_id(c, 1), 0 - 1, "closed window gone");

    test_group("compositor — workspaces, modes, hit-test");
    var c2 = comp_new();
    assert_eq(comp_workspace_count(c2), 1, "default workspace exists");
    assert_eq(comp_active_workspace(c2), 0, "active workspace is 0");
    assert_eq(comp_secure_mode(c2), 0, "secure mode off by default");
    comp_set_secure_mode(c2, 1);
    assert_eq(comp_secure_mode(c2), 1, "secure mode toggles on");
    assert_eq(comp_agent_aware(c2), 0, "agent-aware off by default");
    comp_set_agent_aware(c2, 1);
    assert_eq(comp_agent_aware(c2), 1, "agent-aware toggles on");
    var ws1 = comp_create_workspace(c2, "Dev", CtxType.CTX_DEVELOPMENT);
    assert_eq(ws1, 1, "second workspace has index 1");
    assert_eq(comp_workspace_count(c2), 2, "two workspaces");
    assert_eq(comp_switch_workspace(c2, 1), 0, "switch to workspace 1");
    assert_eq(comp_active_workspace(c2), 1, "active workspace now 1");
    assert_eq(comp_switch_workspace(c2, 9), 0 - 1, "invalid workspace rejected");
    var wA = comp_create_window(c2, 0, 0, 100, 100, "a");
    var wsp1 = comp_get_workspace(c2, 1);
    assert_eq(wsp_count(wsp1), 1, "new window lands in active workspace");
    assert_eq(comp_move_window_to_workspace(c2, win_id(wA), 0), 0, "move window to ws0");
    assert_eq(wsp_count(wsp1), 0, "window removed from ws1");
    assert_eq(wsp_count(comp_get_workspace(c2, 0)), 1, "window added to ws0");

    test_group("compositor — window_at hit-test");
    var c3 = comp_new();
    var hw = comp_create_window(c3, 100, 100, 200, 150, "hit");
    assert_eq(win_id(comp_window_at(c3, 150, 150)), win_id(hw), "point inside finds window");
    assert_eq(comp_window_at(c3, 5, 5), 0, "point outside returns 0");

    # Parity: compositor.rs test_compositor_close_updates_active_window /
    # test_compositor_close_last_window_clears_active (rust-old/src/compositor.rs:1589-1613).
    test_group("compositor — close updates the workspace's active window");
    var c4 = comp_new();
    var ca1 = comp_create_window(c4, 0, 0, 100, 100, "W1");
    var ca2 = comp_create_window(c4, 0, 0, 100, 100, "W2");
    var c4ws = comp_get_workspace(c4, 0);
    assert_eq(wsp_active(c4ws), win_id(ca2), "the newest window is the workspace's active one");
    assert_eq(comp_close_window(c4, win_id(ca2)), 0, "close the active window");
    assert_eq(wsp_active(c4ws), win_id(ca1), "active falls back to the last remaining window");
    assert_eq(comp_close_window(c4, win_id(ca1)), 0, "close the last window");
    assert_eq(wsp_active(c4ws), 0 - 1, "closing the last window clears active to -1");
    # ⚠ NON-VACUITY: a create always makes the newest window active, so "active == last" holds and a
    # missing guard or a first-not-last pick would still pass the two cases above. These break it.
    var c5 = comp_new();
    var cb1 = comp_create_window(c5, 0, 0, 100, 100, "X1");
    var cb2 = comp_create_window(c5, 0, 0, 100, 100, "X2");
    comp_create_workspace(c5, "Two", CtxType.CTX_GENERAL);
    comp_move_window_to_workspace(c5, win_id(cb2), 1);   # ws0 = [X1], its active still X2 (as in Rust)
    var c5ws = comp_get_workspace(c5, 0);
    assert_eq(wsp_active(c5ws), win_id(cb2), "a move away leaves the old workspace's active stale");
    comp_close_window(c5, win_id(cb1));
    assert_eq(wsp_active(c5ws), win_id(cb2), "closing a NON-active window leaves active alone");
    var c6 = comp_new();
    comp_create_window(c6, 0, 0, 100, 100, "Y1");
    var cc2 = comp_create_window(c6, 0, 0, 100, 100, "Y2");
    var cc3 = comp_create_window(c6, 0, 0, 100, 100, "Y3");
    comp_close_window(c6, win_id(cc3));
    assert_eq(wsp_active(comp_get_workspace(c6, 0)), win_id(cc2), "active goes to the LAST remaining, not the first");
    # ⚠ `retain` (compositor.rs:308) drops every entry: moving one window to ws1 twice lists it twice.
    var c7 = comp_new();
    var cd1 = comp_create_window(c7, 0, 0, 100, 100, "Z1");
    comp_create_workspace(c7, "Two", CtxType.CTX_GENERAL);
    comp_move_window_to_workspace(c7, win_id(cd1), 1);
    comp_move_window_to_workspace(c7, win_id(cd1), 1);
    var c7ws = comp_get_workspace(c7, 1);
    assert_eq(wsp_count(c7ws), 2, "a double move lists the window twice");
    comp_switch_workspace(c7, 1);
    comp_close_window(c7, win_id(cd1));
    assert_eq(wsp_count(c7ws), 0, "close removes EVERY entry for the id");
    assert_eq(wsp_active(c7ws), 0 - 1, "  ...so active is -1, not the closed window");
    # ⚠ The move's own removal is `retain` too (compositor.rs:426): moving the doubled id ON leaves none.
    var c8 = comp_new();
    var ce1 = comp_create_window(c8, 0, 0, 100, 100, "W1");
    comp_create_workspace(c8, "Two", CtxType.CTX_GENERAL);
    comp_create_workspace(c8, "Three", CtxType.CTX_GENERAL);
    comp_move_window_to_workspace(c8, win_id(ce1), 1);
    comp_move_window_to_workspace(c8, win_id(ce1), 1);
    var c8ws1 = comp_get_workspace(c8, 1);
    assert_eq(wsp_count(c8ws1), 2, "a double move lists the window twice (move path)");
    comp_switch_workspace(c8, 1);
    comp_move_window_to_workspace(c8, win_id(ce1), 2);
    assert_eq(wsp_count(c8ws1), 0, "moving away removes EVERY entry for the id");
    assert_eq(wsp_count(comp_get_workspace(c8, 2)), 1, "  ...and the target lists it once");

    # ----- wallpaper.cyr — the backdrop source (M6-C1a, pure) -----
    test_group("wallpaper.cyr — row source");
    wp_set_solid(0x123456);
    assert_eq(wp_kind(), 0, "solid kind");
    assert_eq(wp_row_color(0, 100),  0x123456, "solid: row 0");
    assert_eq(wp_row_color(99, 100), 0x123456, "solid: last row identical");
    assert_eq(wp_tracking(), 0, "an explicit set stops tracking the theme");

    wp_set_vgrad(0x000000, 0xFFFFFF);
    assert_eq(wp_kind(), 1, "vgrad kind");
    assert_eq(wp_row_color(0, 100),  0x000000, "vgrad: top row is c0 exactly");
    assert_eq(wp_row_color(99, 100), 0xFFFFFF, "vgrad: bottom row is c1 exactly");
    # ⛔ The endpoints are the assertion that matters. An off-by-one in the `h - 1` divisor makes the
    # bottom row NEARLY c1 — invisible by eye, and it means a damage band repainting the last row
    # paints a different colour than a full repaint of the same pixel.
    assert_eq(wp_row_color(50, 100), 0x808080, "vgrad: midpoint interpolates all three channels");
    assert_eq(wp_row_color(-5, 100), 0x000000, "vgrad: clamps below");
    assert_eq(wp_row_color(999, 100), 0xFFFFFF, "vgrad: clamps above");
    assert_eq(wp_lerp8(0, 255, 0, 1), 0, "lerp: h<=1 returns the low end, no divide by zero");

    test_group("wallpaper.cyr — serial + theme tracking");
    var s0 = wp_serial();
    wp_set_vgrad(0x111111, 0x222222);
    assert(wp_serial() > s0, "a mutation bumps the serial");
    # ⛔⛔ THE LOAD-BEARING ONE: tracking must NOT bump the serial when the colour is unchanged, or the
    # damage band is invalidated every frame and AE-0a's saving is silently undone.
    wp_set_solid(0x334455);
    ae_wp_track = 1;
    var s1 = wp_serial();
    wp_track_theme(0x334455);
    assert_eq(wp_serial(), s1, "tracking the SAME colour does not bump the serial");
    wp_track_theme(0x667788);
    assert(wp_serial() > s1, "tracking a NEW colour does bump it");
    assert_eq(wp_row_color(0, 10), 0x667788, "tracking updated the source");

    test_group("wallpaper.cyr — GPU expressibility");
    wp_set_solid(0x010203);
    assert_eq(wp_gpu_expressible(), 1, "a solid IS one #88 fill");
    wp_set_vgrad(0x010203, 0x040506);
    assert_eq(wp_gpu_expressible(), 0, "a gradient is NOT — the frame must demote");
    wp_set_solid(0x0E1621);   # leave the suite in a sane state

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
