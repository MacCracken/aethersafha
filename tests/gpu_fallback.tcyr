# aethersafha — the CPU-fallback oracle.
#
# ⭐ THE INVARIANT UNDER TEST, stated once so it is not weakened by later edits:
#
#     The exact 32-bit word a client wrote into its surface is readable at that client's
#     screen coordinates after a frame, WHATEVER THE GPU DECIDED.
#
# That is an EXTERNAL invariant. The sentinels below are chosen by this file and are
# derivable from no compositor state, so a compositor that shares every one of the
# renderer's premises still cannot produce them by accident. This matters here more than
# usual: this arc has twice paid an iron burn for a green oracle that compared two
# implementations of the same idea (agnos gpu.md §2.1, "A GREEN ORACLE ON A SHARED
# PREMISE PROVES NOTHING").
#
# ⛔ WHAT THIS CATCHES, and why the bug is invisible without forcing the mode.
# render_window skips its per-pixel client composite whenever hardware compositing is
# believed to be active. Before this suite, the belief was `ae_gpu_active()` — a global
# set once at startup and never cleared. But ae_gpu_present_frame refuses a frame for
# ordinary reasons (a window past an edge, a premultiplied surface with no shader path),
# and on refusal the caller presents the framebuffer it has: chrome, and no window
# content. The two decisions were made in different places from different data.
#
# ⚠ On a host build ae_gpu_probe() cannot set the mode — the whole probe is inside
# `#ifdef CYRIUS_TARGET_AGNOS`. So the test writes `ae_gpu_mode` DIRECTLY. That is not a
# hack around the seam; it is the only way to reach the branch on a machine with no GPU,
# and it reproduces the agnos condition exactly: mode believed active, present refusing.
#
# Stdlib + [deps.*] auto-included via cyrius.cyml.
include "lib/bhumi.cyr"
include "src/geom.cyr"
include "src/window.cyr"
include "src/compositor.cyr"
include "src/theme.cyr"
include "src/cursor.cyr"   # gpu.cyr's cursor emit packs this bitmap
include "src/render.cyr"
include "src/gpu.cyr"
include "src/wallpaper.cyr"   # rend_band_compute reads wp_serial(); gpu frame plan reads wp_gpu_expressible()

# Sentinels. ⚠ Deliberately not black, not white, not any rupa token, and not a value any
# fill_rect in the chrome path emits — so "the sentinel is present" cannot be satisfied by
# a coincidence of the background or a decoration.
enum Sentinel {
    SENT_A = 0x00C0FFEE;
    SENT_B = 0x00BADA55;
}

# Fill a w*h XRGB8888 client surface with one word, the way a setu client would.
fn seed_surface(w, h, word): i64 {
    var px = alloc(w * h * 4);
    if (px == 0) { return 0; }
    var i = 0;
    while (i < w * h) {
        store32(px + i * 4, word);
        i = i + 1;
    }
    return px;
}

fn main() {
    alloc_init();
    kashi_font_init();

    # ── Case 1 — a window the GPU would ACCEPT (fully on-screen) ────────────────
    # Even here the host has no GPU, so the frame must fall back and the content must land.
    test_group("gpu fallback — an accepted-shape window still shows its content");
    var fb = bhumi_fb_new(400, 400);
    bhumi_fb_clear(fb, 0);
    var comp = comp_new();
    var wa = comp_create_window(comp, 20, 20, 100, 100, "A");
    win_set_pix(wa, seed_surface(100, 100, Sentinel.SENT_A));

    # Force the belief that hardware compositing is live — the agnos condition.
    ae_gpu_mode = 1;
    ae_gpu_blend = 0;

    ae_gpu_frame_plan(comp, fb);
    render_window(fb, wa, 1);
    # The body sits below the titlebar, exactly as render_window and gpu.cyr both place it.
    assert_eq(bhumi_fb_get(fb, 20 + 50, 20 + TITLEBAR_H + 50),
              Sentinel.SENT_A, "on-screen window: client word reaches the framebuffer");
    assert_eq(bhumi_fb_get(fb, 20, 20 + TITLEBAR_H),
              Sentinel.SENT_A, "on-screen window: top-left body pixel is the client's");

    # ── Case 2 — a window the GPU REFUSES (runs past the bottom edge) ──────────────
    # ⛔ This is the case that was silently blank. The kernel rejects rather than clips, so a
    # window dragged past an edge — ordinary use, not an edge case — made EVERY window in
    # the frame vanish, not just this one.
    test_group("gpu fallback — a refused window still shows its content");
    var fb2 = bhumi_fb_new(400, 400);
    bhumi_fb_clear(fb2, 0);
    var comp2 = comp_new();
    var wb = comp_create_window(comp2, 10, 340, 80, 80, "B");   # 340 + 30 + 80 = 450 > 400
    win_set_pix(wb, seed_surface(80, 80, Sentinel.SENT_B));
    # ⚠ Deliberately NO bufid on the window that gets RENDERED. render_window pulls a live surface
    # through setu_buf_read, and this suite does not include setu — it is testing the renderer's
    # gate, not the transport. The admissibility group below uses its own bufid-bearing windows,
    # which are never rendered.

    ae_gpu_mode = 1;
    ae_gpu_frame_plan(comp2, fb2);
    render_window(fb2, wb, 1);
    assert_eq(bhumi_fb_get(fb2, 10 + 40, 340 + TITLEBAR_H + 10),
              Sentinel.SENT_B, "refused window: client word STILL reaches the framebuffer");

    # ⚠ And the present must not issue a partial frame after declining.
    assert_eq(ae_gpu_present_frame(comp2, fb2), 0, "a declined frame is not presented on the GPU");

    # ── The admissibility rule itself, tested directly ────────────────────
    # ⚠ ae_gpu_frame_plan short-circuits to 0 off agnos (there is no GPU frame on a host, ever),
    # so asserting on IT here would be vacuous — it returns 0 whether or not the rule works. The
    # rule is factored into a pure, #ifdef-free function precisely so it can be exercised on a
    # machine with no GPU, instead of being tested by burning a boot on the operator's only box.
    test_group("gpu fallback — the admissibility rule (pure, target-independent)");
    var woff = win_new(40, 10, 340, 80, 80, "OFF");   # never rendered — see the note above
    win_set_bufid(woff, 7);
    assert_eq(ae_gpu_window_admissible(woff, 400, 400), 0, "past the bottom edge: refused");
    assert_eq(ae_gpu_window_admissible(woff, 400, 800), 1, "same window, taller surface: admitted");
    # ⚠ A window with NO client buffer has nothing for the GPU to blit, so it is trivially
    # admissible whatever its geometry — the rule must not refuse a frame over chrome-only windows.
    var wnobuf = win_new(41, 10, 340, 80, 80, "NOBUF");
    assert_eq(ae_gpu_window_admissible(wnobuf, 400, 400), 1, "no client buffer: always admitted");
    var wedge = win_new(50, 0, 0, 100, 100, "E");
    win_set_bufid(wedge, 8);
    assert_eq(ae_gpu_window_admissible(wedge, 100, 130), 1, "exactly flush with both edges: admitted");
    assert_eq(ae_gpu_window_admissible(wedge, 99, 130), 0, "one column short: refused");
    assert_eq(ae_gpu_window_admissible(wedge, 100, 129), 0, "one row short: refused");
    win_move(wedge, 0 - 1, 0);
    assert_eq(ae_gpu_window_admissible(wedge, 400, 400), 0, "negative x: refused");
    win_move(wedge, 0, 0);
    # ⭐ A PREMULTIPLIED SURFACE IS ADMISSIBLE EITHER WAY — CHANGED, and the old expectation was the bug.
    # This used to assert that a premultiplied window with no shader envelope is REFUSED. Refusing it here
    # fails the whole frame to the CPU, so one client asking for a blend cost EVERY window its hardware
    # compositing. Which op composites a surface is a per-window routing question, answered in
    # ae_gpu_present_frame (`#92` when the envelope exists, `#87` otherwise) — and at the alpha 255 real
    # clients produce, that fallback is byte-exact rather than approximate.
    win_set_premul(wedge, 1);
    ae_gpu_blend = 0;
    assert_eq(ae_gpu_window_admissible(wedge, 400, 400), 1,
    "premultiplied, no shader envelope: ADMITTED (routing falls back to #87, the frame is not lost)");
    ae_gpu_blend = 1;
    assert_eq(ae_gpu_window_admissible(wedge, 400, 400), 1, "premultiplied, shader available: admitted");
    ae_gpu_blend = 0;
    # ⚠ Geometry still refuses regardless of premul — admissibility did not become a no-op.
    win_move(wedge, 0 - 1, 0);
    assert_eq(ae_gpu_window_admissible(wedge, 400, 400), 0, "premultiplied AND off-screen: still refused");
    win_move(wedge, 0, 0);
    win_set_premul(wedge, 0);

    # ── Case 3 — a bufid == 0 window (a one-shot static present) ────────────────
    # Skipped by gpu.cyr's blit loop AND, before this fix, by render.cyr's CPU path — so
    # it was drawn by nobody at all.
    test_group("gpu fallback — a static (bufid 0) surface is drawn by someone");
    var fb3 = bhumi_fb_new(200, 200);
    bhumi_fb_clear(fb3, 0);
    var comp3 = comp_new();
    var wc = comp_create_window(comp3, 10, 10, 60, 60, "C");
    win_set_pix(wc, seed_surface(60, 60, Sentinel.SENT_A));
    assert_eq(win_bufid(wc), 0, "case 3 really is the bufid==0 shape");

    ae_gpu_mode = 1;
    ae_gpu_frame_plan(comp3, fb3);
    render_window(fb3, wc, 0);
    assert_eq(bhumi_fb_get(fb3, 10 + 30, 10 + TITLEBAR_H + 30),
              Sentinel.SENT_A, "static surface: client word reaches the framebuffer");

    # ── Case 4 — W_PREMUL is initialised, not inherited ───────────────────
    # ⚠ lib/alloc.cyr is a bump allocator with no memset, so an uninitialised slot reads
    # whatever the previous tenant left. win_new zeroed every other field and missed this
    # one. A garbage premul flag routes an opaque surface down the blend path.
    test_group("window — every field win_new owns is initialised");
    var wd = win_new(99, 0, 0, 10, 10, "D");
    assert_eq(win_premul(wd), 0, "W_PREMUL is zero on a fresh window");
    assert_eq(win_keymode(wd), 0, "W_KEYMODE is zero on a fresh window");
    assert_eq(win_bufid(wd), 0, "W_BUFID is zero on a fresh window");
    assert_eq(win_cfd(wd), 0, "W_CFD is zero on a fresh window");

    # ── Case 5 — the mode demotes on refusal instead of latching ────────────────
    # A GPU that starts refusing must leave a WORKING CPU desktop behind, not a permanently
    # chrome-only one.
    test_group("gpu fallback — a hard refusal demotes the mode");
    ae_gpu_mode = 1;
    ae_gpu_demote();
    assert_eq(ae_gpu_active(), 0, "demote clears the active flag");
    assert_eq(ae_gpu_frame_plan(comp, fb), 0, "a demoted compositor plans no GPU frame");

    # =====================================================================
    # AE-7: a retired cursor must take the WHOLE frame off the GPU
    # =====================================================================
    # ⛔⛔ ORDERING, NOT VISIBILITY — restoring the `#39` blit alone does NOT fix it. The blit is the BOTTOM
    # layer; client surfaces composite on top of it (step 2 of `ae_gpu_present_frame`, before the text and
    # cursor emits). A CPU-drawn cursor therefore sits UNDER every hosted window, and the pointer vanishes
    # the moment it crosses puka or crab — most of the screen. Only a CPU frame composites clients
    # per-pixel and lets `render_desktop` draw the cursor LAST.
    test_group("gpu — a retired cursor demotes the whole frame, so the pointer stays on top");
    ae_gpu_mode = 1;
    ae_cursor_gpu_ok = 1;
    ae_cursor_gpu_disable();
    assert_eq(ae_cursor_gpu_ok_get(), 0, "precondition: the cursor path is retired");
    assert_eq(ae_gpu_frame_plan(comp, fb), 0, "a retired cursor refuses the GPU frame");
    assert_eq(ae_gpu_frame_ok, 0, "  ae_gpu_frame_ok stays clear, so render_cursor takes the CPU arm");
    assert_eq(ae_chrome_on_gpu(), 0, "  and chrome follows, so the #39 blit runs");
    ae_cursor_gpu_ok = 1;

    # ⛔ A BARE `return 0;` SAT HERE AND SWITCHED OFF THE REST OF THE FILE. 26 assertions ran; the
    # 20 below never executed — including the ENTIRE op-support-mask suite, which is the one place
    # a caps-decode error for a newly minted #92 op would be caught. A suite that prints nothing
    # looks exactly like a suite that passes.
    # ----- gpu.cyr — #89 byte +28, the #92 op-support mask (A3) ---
    # ⛔ Before this, the compositor read caps +0..+24 and discovered which #92 ops existed by ISSUING
    # one and reading the error — the shape #86 already proved wrong. The kernel publishes a bitmask
    # (agnos syscall.cyr:1514, GPU_OP_SUPPORTED = 0x1FF5F) exactly so a caller need not probe by trial.
    # ⚠ The published value is NOT that constant: gpu_caps computes `GPU_OP_SUPPORTED & ~GPU_OP_NOTIMPL_MASK`,
    # and with bit 6 (BLEND_ALPHA) currently NOTIMPL the wire value is still 0x1FF1F. The literals below
    # deliberately keep testing 0x1FF1F — that is what a caller actually receives today.
    test_group("gpu.cyr — #92 op-support mask (pure)");
    assert_eq(ae_gpu_op_supported(0x1FF1F, 1), 1, "0x1FF1F advertises op 0x01 (BLEND_RECT)");
    assert_eq(ae_gpu_op_supported(0x1FF1F, 3), 1, "0x1FF1F advertises op 0x03 (GLYPH_1BPP)");
    assert_eq(ae_gpu_op_supported(0x1FF1F, 5), 0, "bit 5 is NOT in 0x1FF1F");
    # ⭐ M6-C3. Op 0x06 BLEND_ALPHA. ⚠ 0x1FF1F is what a kernel PUBLISHES today: agnos's
    # GPU_OP_SUPPORTED is 0x1FF5F but bit 6 sits in GPU_OP_NOTIMPL_MASK because the shader is unburned,
    # and #89 reports `SUPPORTED & ~NOTIMPL`. So the wire value still has bit 6 CLEAR, and that is the
    # case worth pinning — a compositor must not use an op the kernel declines to advertise.
    assert_eq(ae_gpu_op_supported(0x1FF1F, 6), 0, "bit 6 (BLEND_ALPHA) is NOT advertised while NOTIMPL");
    assert_eq(ae_gpu_op_supported(0x1FF5F, 6), 1, "...and IS, on a kernel that has cleared NOTIMPL");
    assert_eq(ae_gpu_op_supported(0x1FF1F, 8), 1, "bit 8 (EDGE_COV) is");
    assert_eq(ae_gpu_op_supported(0, 1), 0, "an empty mask advertises nothing");
    # ⚠ The two ops this compositor actually issues, isolated: a kernel offering one and not the other
    # is the case the old call-and-see could only discover mid-frame, per window.
    assert_eq(ae_gpu_op_supported(2, 1), 1, "blend-only mask: op 1 yes");
    assert_eq(ae_gpu_op_supported(2, 3), 0, "blend-only mask: op 3 no");
    assert_eq(ae_gpu_op_supported(8, 3), 1, "glyph-only mask: op 3 yes");
    assert_eq(ae_gpu_op_supported(8, 1), 0, "glyph-only mask: op 1 no");
    # The named bit constants must match the shifts, or the gates read the wrong op.
    assert_eq(AE_GPU_OPBIT_BLEND, 1 << 1, "AE_GPU_OPBIT_BLEND == 1 << 0x01");
    assert_eq(AE_GPU_OPBIT_GLYPH, 1 << 3, "AE_GPU_OPBIT_GLYPH == 1 << 0x03");

    # ----- gpu.cyr — the #87 wallpaper slot budget (pure) ---------
    # ⛔ A `#86` slot is capped at 2 MB (agnos SHM_MAX_SIZE = 2097152, 16 slots system-wide), so a
    # full-screen XRGB wallpaper fits only at some geometries. This is the ONLY part of the #87
    # wallpaper path a box without an AMD GPU can execute — QEMU exposes no AMD PCI device, so
    # `gpu_find` never matches and every other branch is dead there.
    # ---- the capability gate the consumer will branch on ------------------------------------
    # ⛔ THE TWO-CONDITION SHAPE IS THE POINT. `ae_gpu_alpha_ok` must answer 0 when the kernel does not
    # advertise op 6 AND when there is no shader envelope at all — a mask bit alone is not permission.
    test_group("gpu.cyr — the M6-C3 alpha capability gate");
    ae_gpu_blend = 1;
    ae_gpu_op_mask = 0x1FF1F;
    assert_eq(ae_gpu_alpha_ok(), 0, "today's kernel advertises no bit 6 -> alpha path OFF");
    ae_gpu_op_mask = 0x1FF5F;
    assert_eq(ae_gpu_alpha_ok(), 1, "a post-burn kernel advertising bit 6 -> alpha path ON");
    ae_gpu_blend = 0;
    assert_eq(ae_gpu_alpha_ok(), 0, "bit 6 advertised but NO shader envelope -> still OFF");
    ae_gpu_blend = 0; ae_gpu_op_mask = 0;

    test_group("gpu.cyr — wallpaper #86 slot budget (pure)");
    # 800x600x4 = 1,920,000 — archaemenid's actual scanout geometry, and it FITS.
    assert_eq(ae_gpu_wp_fits(800, 600, 2097152), 1, "800x600 fits one 2 MB slot");
    # 1280x800x4 = 4,096,000 and 2560x1440x4 = 14,745,600 — they do not.
    assert_eq(ae_gpu_wp_fits(1280, 800, 2097152), 0, "1280x800 does NOT");
    assert_eq(ae_gpu_wp_fits(2560, 1440, 2097152), 0, "2560x1440 does NOT");
    # Exact boundary, both sides: 724x724x4 = 2,096,704 <= cap; one more row is over.
    assert_eq(ae_gpu_wp_fits(724, 724, 2097152), 1, "just under the cap fits");
    assert_eq(ae_gpu_wp_fits(724, 725, 2097152), 0, "one row more does not");
    # ⛔ THE LOAD-BEARING ONE: "the kernel told us nothing" must not read as "fits". A zero slot_max
    # comes from a caps record that was never populated, and treating it as unlimited would issue a
    # #86 request the kernel refuses — turning a clean CPU fallback into a demotion mid-frame.
    assert_eq(ae_gpu_wp_fits(800, 600, 0), 0, "slot_max 0 is NOT a fit");
    assert_eq(ae_gpu_wp_fits(0, 600, 2097152), 0, "zero width is not a fit");
    assert_eq(ae_gpu_wp_fits(800, 0, 2097152), 0, "zero height is not a fit");
    # A larger cap in a later kernel should light this up with no code edit.
    assert_eq(ae_gpu_wp_fits(1280, 800, 8388608), 1, "an 8 MB slot would fit 1280x800");
}
