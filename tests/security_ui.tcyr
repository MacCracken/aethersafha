# aethersafha — security_ui BEHAVIORAL parity test.
# Mirrors rust-old/src/security_ui.rs #[cfg(test)] mod tests + mod badge_tests.
#
# The module references only stdlib (vec / hashmap-u64 / string:streq) — all
# auto-prepended by `cyrius build` (see cyrius.cyml [deps.stdlib]) — so we only
# include the module itself. No src peer modules are referenced by security_ui.
include "src/security_ui.cyr"

# assert(cond) passes only when cond == 1; normalize a non-zero pointer to 1.
fn t_ok(x): i64 {
    if (x != 0) { return 1; }
    return 0;
}

# ---------------------------------------------------------------------------
# Audit-log + signal helpers.
# ⛔ The suite writes only to a temp file it creates (t_audit_path) and signals
# only children it forks itself. With a WRONG pid guard, what each bad pid
# would reach:
#   - main's preflight runs first and stops the suite, before any enforced
#     call, if sec_pid_ok passes -1, 0, -2 or None, or None is not INT_MIN.
#   - None (SEC_PID_NONE, INT_MIN) and 2^31: Linux truncates both to INT_MIN
#     and kill answers -ESRCH. -2^31 - 1 and 0x7FFFFFFF truncate to i32::MAX,
#     above PID_MAX_LIMIT (2^22): -ESRCH as well.
#   - pid 0 is passed only in a forked child that first leaves the suite's
#     process group (setpgid), so kill(0) reaches nobody but that child.
#   - -1, -2 and 2^32 + 1 (which truncates to 1) go only to sec_pid_ok itself,
#     never to an enforced call: no process group contains kill(-1).
# ---------------------------------------------------------------------------
var t_audit_path = 0;

# The whole file as a cstr ("" when absent or empty).
fn t_read(path): i64 {
    var buf = alloc(65537);
    var n = file_read_all(path, buf, 65536);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return buf;
}

# A forked child that waits for a signal. -> its pid (> 0), or <= 0 on failure.
fn t_fork_paused(): i64 {
    var pid = sys_fork();
    if (pid == 0) {
        # ⚠ A child inherits dispositions and the mask: under `nohup` (SIGHUP ignored) or a runner
        # that blocks signals, SIGHUP would never end it and a correct port would fail. Reset both.
        signal_default(SIGHUP);
        var none: i64[1];
        store64(&none, 0);
        sys_sigprocmask(SIG_SETMASK, &none, 0);
        while (1 == 1) { sys_pause(); }
        syscall(60, 0);
    }
    return pid;
}

# Reap child `pid` (> 0): -> the signal that ended it, 1000 + its exit code if it
# exited, -1 if it was still running after ~2 s (it is then SIGKILLed and
# reaped, so no test leaves a child behind), or -2 if waitpid failed (the pid is
# no child of ours, so it is never signalled).
fn t_reap(pid): i64 {
    var st[8];
    store64(&st, 0);
    var tries = 0;
    while (tries < 200) {
        var r = sys_waitpid(pid, &st, 1);    # WNOHANG
        if (r == pid) {
            var status = load64(&st) & 0xFFFFFFFF;
            if (WIFSIGNALED(status) == 1) { return WTERMSIG(status); }
            return 1000 + WEXITSTATUS(status);
        }
        if (r < 0) { return 0 - 2; }
        sleep_ms(10);
        tries = tries + 1;
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 0 - 1;
}

# ---------------------------------------------------------------------------
# The kill's daimon DELETE. ⛔ A real daimon may run on this machine at 127.0.0.1:8090, and a
# DELETE there deregisters a real agent: main points the client at a port of its own before any
# kill, so no request from this suite can reach it.
# ---------------------------------------------------------------------------
var t_dport = 0;

# A non-blocking TCP socket bound to 127.0.0.1 on an ephemeral port (left in t_dport), listening
# when `listen` is 1. Bound and NOT listening, the port refuses every connect and nobody else can
# take it while it stays open.
fn t_bind_lo(listen): i64 {
    var fd = sys_socket(AF_INET, SOCK_STREAM | 2048, 0);   # SOCK_NONBLOCK
    if (fd < 0) { return 0 - 1; }
    var sa[16];
    memset(&sa, 0, 16);
    store16(&sa, AF_INET);
    store32(&sa + 4, 0x0100007F);
    if (sys_bind(fd, &sa, 16) < 0) { return 0 - 1; }
    if (listen == 1) { if (sys_listen(fd, 8) < 0) { return 0 - 1; } }
    var sl[8];
    store64(&sl, 16);
    sys_getsockname(fd, &sa, &sl);
    t_dport = (load8(&sa + 2) << 8) | load8(&sa + 3);
    return fd;
}

fn t_now_us(): i64 { return clock_now_ns() / 1000; }

fn t_sleep_1ms(): i64 {
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);
    sys_nanosleep(&ts, 0);
    return 0;
}

# Run sec_ui_emergency_kill_agent (which == 0) or sec_ui_revoke_permission_enforced
# (which == 1) with `pid` in a forked child of its own process group, which exits
# with the result code (+ 100 per alert recorded). -> t_reap's answer: the child
# dying of a signal means the port signalled its own group.
fn t_effect_in_child(which, pid): i64 {
    var child = sys_fork();
    if (child == 0) {
        if (syscall(109, 0, 0) != 0) { syscall(60, 99); }    # setpgid(0, 0)
        var cu = sec_ui_new();
        var code = 0;
        if (which == 0) {
            code = sec_ui_emergency_kill_agent(cu, 77, pid, 1760000000);
        } else {
            sec_ui_grant_permission_enforced(cu, 77, "agent", "file:read", 1760000000);
            code = sec_ui_revoke_permission_enforced(cu, 77, "file:read", pid, 1760000000);
        }
        syscall(60, code + 100 * vec_len(sec_ui_alerts(cu)));
    }
    if (child <= 0) { return 0 - 3; }
    return t_reap(child);
}

# ---------------------------------------------------------------------------
# write_audit_log: the line, its timestamp and escaping, from fixed epochs.
# ---------------------------------------------------------------------------
fn t_audit_format(): i64 {
    test_group("security_ui — audit line format");
    assert_streq(sec_audit_rfc3339(0), "1970-01-01T00:00:00+00:00", "rfc3339 epoch");
    assert_streq(sec_audit_rfc3339(1760000000), "2025-10-09T08:53:20+00:00", "rfc3339 1760000000");
    assert_streq(sec_audit_rfc3339(951782400), "2000-02-29T00:00:00+00:00", "rfc3339 leap day 2000");
    assert_streq(sec_audit_rfc3339(1709210096), "2024-02-29T12:34:56+00:00", "rfc3339 2024-02-29T12:34:56");
    assert_streq(sec_audit_rfc3339(0 - 5), "1970-01-01T00:00:00+00:00", "rfc3339 negative clamps to epoch");

    # serde_json (no preserve_order) sorts the keys and prints compact.
    assert_streq(sec_audit_line("permission_granted", 700,
        "Permission 'file:read' granted to 'test-agent'", 1760000000),
      "{\"agent_id\":\"700\",\"details\":\"Permission 'file:read' granted to 'test-agent'\",\"event_type\":\"permission_granted\",\"source\":\"security-ui\",\"timestamp\":\"2025-10-09T08:53:20+00:00\"}",
      "audit line: exact serde_json text");

    # Escaping: " \ newline tab and a raw 0x01, as serde_json writes them.
    var det = alloc(16);
    memcpy(det, "a\"b\\c\nd", 7);
    store8(det + 7, 1);
    store8(det + 8, 9);
    store8(det + 9, 101);    # 'e'
    store8(det + 10, 0);
    assert_streq(sec_audit_line("x", 0 - 3, det, 0),
      "{\"agent_id\":\"-3\",\"details\":\"a\\\"b\\\\c\\nd\\u0001\\te\",\"event_type\":\"x\",\"source\":\"security-ui\",\"timestamp\":\"1970-01-01T00:00:00+00:00\"}",
      "audit line: JSON escaping");
    return 0;
}

# ---------------------------------------------------------------------------
# The writer: appends to the injected path; a failing path warns and the
# caller still succeeds.
# ---------------------------------------------------------------------------
fn t_audit_file(): i64 {
    test_group("security_ui — audit log file");
    var au = sec_ui_new();
    var before = strlen(t_read(t_audit_path));

    assert_eq(sec_ui_grant_permission_enforced(au, 31, "test-agent", "file:read", 1760000000),
      SecErr.SEC_ERR_OK, "audited grant OK");
    var got1 = t_read(t_audit_path) + before;
    var want1 = "{\"agent_id\":\"31\",\"details\":\"Permission 'file:read' granted to 'test-agent'\",\"event_type\":\"permission_granted\",\"source\":\"security-ui\",\"timestamp\":\"2025-10-09T08:53:20+00:00\"}\n";
    assert_streq(got1, want1, "grant appends its exact line");

    assert_eq(sec_ui_revoke_permission_enforced(au, 31, "file:read", SecPid.SEC_PID_NONE, 1760000001),
      SecErr.SEC_ERR_OK, "audited revoke OK");
    var got2 = t_read(t_audit_path) + before + strlen(want1);
    assert_streq(got2,
      "{\"agent_id\":\"31\",\"details\":\"Permission 'file:read' revoked\",\"event_type\":\"permission_revoked\",\"source\":\"security-ui\",\"timestamp\":\"2025-10-09T08:53:21+00:00\"}\n",
      "revoke appends after the grant line");

    var mid = strlen(t_read(t_audit_path));
    assert_eq(sec_ui_emergency_kill_agent(au, 31, SecPid.SEC_PID_NONE, 1760000002),
      SecErr.SEC_ERR_OK, "audited kill OK");
    assert_streq(t_read(t_audit_path) + mid,
      "{\"agent_id\":\"31\",\"details\":\"Agent killed via emergency kill switch\",\"event_type\":\"emergency_kill\",\"source\":\"security-ui\",\"timestamp\":\"2025-10-09T08:53:22+00:00\"}\n",
      "kill appends its exact line");
    var kal = vec_get(sec_ui_alerts(au), 0);
    assert_streq(sec_alert_title(kal), "Emergency Kill: Agent 31", "kill alert title names the agent");
    assert_streq(sec_alert_source(kal), "security-ui", "kill alert source");

    # The default is Rust's path (read only — never written by this suite).
    sec_ui_set_audit_log_path(0);
    assert_streq(sec_ui_audit_log_path(), "/var/log/agnos/audit.log", "default audit path");
    sec_ui_set_audit_log_path(t_audit_path);
    assert_streq(sec_ui_audit_log_path(), t_audit_path, "injected audit path");

    # A path that cannot be opened (its "directory" is our temp file): warns,
    # returns -1, and every caller still succeeds with its in-model effect.
    var bad_sb = str_builder_new();
    str_builder_add_cstr(bad_sb, t_audit_path);
    str_builder_add_cstr(bad_sb, "/nested.log");
    var bad = str_data(str_builder_build(bad_sb));
    var size_before_bad = strlen(t_read(t_audit_path));
    sec_ui_set_audit_log_path(bad);
    assert_eq(sec_write_audit_log("x", 1, "d", 0), 0 - 1, "unopenable path -> -1");
    var bu = sec_ui_new();
    assert_eq(sec_ui_grant_permission_enforced(bu, 32, "a", "file:read", 1760000000),
      SecErr.SEC_ERR_OK, "unopenable log: grant still OK");
    assert_eq(sec_agentperm_has(sec_ui_get_agent_permission(bu, 32), "file:read"), 1,
      "unopenable log: grant still applied");
    assert_eq(sec_ui_revoke_permission_enforced(bu, 32, "file:read", SecPid.SEC_PID_NONE, 1760000000),
      SecErr.SEC_ERR_OK, "unopenable log: revoke still OK");
    assert_eq(sec_ui_emergency_kill_agent(bu, 32, SecPid.SEC_PID_NONE, 1760000000),
      SecErr.SEC_ERR_OK, "unopenable log: kill still OK");
    assert_eq(vec_len(sec_ui_alerts(bu)), 1, "unopenable log: kill alert still recorded");
    sec_ui_set_audit_log_path(t_audit_path);
    assert_eq(strlen(t_read(t_audit_path)), size_before_bad, "unopenable log: temp log untouched");
    return 0;
}

# ---------------------------------------------------------------------------
# Signals: the pid guard, SIGHUP on revoke, SIGKILL on kill — forked children only.
# ---------------------------------------------------------------------------
fn t_signals(): i64 {
    test_group("security_ui — pid guard");
    assert_eq(sec_pid_ok(1), 1, "pid 1 signalable");
    assert_eq(sec_pid_ok(0x7FFFFFFF), 1, "pid i32::MAX signalable");
    assert_eq(sec_pid_ok(0), 0, "pid 0 refused (own process group)");
    assert_eq(sec_pid_ok(0 - 1), 0, "pid -1 refused (every process)");
    assert_eq(sec_pid_ok(0 - 2), 0, "pid -2 refused (a process group)");
    assert_eq(sec_pid_ok(0x80000000), 0, "pid i32::MAX + 1 refused");
    assert_eq(sec_pid_ok(0x100000001), 0, "pid 2^32 + 1 refused (would truncate to 1)");
    assert_eq(sec_pid_ok(0 - 0x80000000), 0, "pid -2^31 refused");

    test_group("security_ui — emergency kill: invalid pid blocked, no effect");
    var size0 = strlen(t_read(t_audit_path));
    # 3 == SEC_ERR_ACTION_BLOCKED and no alert -> exit code 1003.
    assert_eq(t_effect_in_child(0, 0), 1003, "kill pid 0 -> ACTION_BLOCKED, no alert, no signal");
    var iu = sec_ui_new();
    assert_eq(sec_ui_emergency_kill_agent(iu, 78, 0x80000000, 1760000000),
      SecErr.SEC_ERR_ACTION_BLOCKED, "kill pid i32::MAX + 1 -> ACTION_BLOCKED");
    assert_eq(sec_ui_emergency_kill_agent(iu, 78, 0 - 0x80000001, 1760000000),
      SecErr.SEC_ERR_ACTION_BLOCKED, "kill pid -2^31 - 1 -> ACTION_BLOCKED");
    assert_eq(vec_len(sec_ui_alerts(iu)), 0, "blocked kills record no alert");
    assert_eq(strlen(t_read(t_audit_path)), size0, "blocked kills write no audit line");

    # Revoke: Rust's Some(0) would SIGHUP the whole group; the port skips it.
    # 0 == SEC_ERR_OK, no alert -> exit code 1000.
    assert_eq(t_effect_in_child(1, 0), 1000, "revoke pid 0 -> OK, no signal sent");
    assert_eq(t_effect_in_child(1, 0x80000000), 1000, "revoke pid i32::MAX + 1 -> OK");

    # None: the revoke sends nothing; the kill sends nothing and still records
    # its alert (0 + 100 -> exit code 1100).
    assert_eq(t_effect_in_child(1, SecPid.SEC_PID_NONE), 1000, "revoke pid None -> OK, no signal sent");
    assert_eq(t_effect_in_child(0, SecPid.SEC_PID_NONE), 1100, "kill pid None -> OK + alert, no signal sent");

    test_group("security_ui — SIGHUP on enforced revoke");
    var hu = sec_ui_new();
    sec_ui_grant_permission_enforced(hu, 40, "agent", "file:read", 1760000000);
    var hup_child = t_fork_paused();
    assert_eq(hup_child > 0, 1, "forked a child for SIGHUP");
    if (hup_child > 0) {
        assert_eq(sec_ui_revoke_permission_enforced(hu, 40, "file:read", hup_child, 1760000000),
          SecErr.SEC_ERR_OK, "revoke with pid OK");
        assert_eq(t_reap(hup_child), 1, "child ended by SIGHUP (1)");
    }
    # No agent entry -> NOT_FOUND before any signal.
    var nf_child = t_fork_paused();
    if (nf_child > 0) {
        assert_eq(sec_ui_revoke_permission_enforced(hu, 4040, "file:read", nf_child, 1760000000),
          SecErr.SEC_ERR_PERMISSION_NOT_FOUND, "revoke unknown agent -> NOT_FOUND");
        assert_eq(t_reap(nf_child), 0 - 1, "NOT_FOUND revoke sends no signal");
    }

    test_group("security_ui — SIGKILL on emergency kill");
    var ku = sec_ui_new();
    var kill_child = t_fork_paused();
    assert_eq(kill_child > 0, 1, "forked a child for SIGKILL");
    if (kill_child > 0) {
        var ksize = strlen(t_read(t_audit_path));
        assert_eq(sec_ui_emergency_kill_agent(ku, 41, kill_child, 1760000000),
          SecErr.SEC_ERR_OK, "kill with pid OK");
        assert_eq(t_reap(kill_child), 9, "child ended by SIGKILL (9)");
        assert_eq(vec_len(sec_ui_alerts(ku)), 1, "kill with pid records its alert");
        assert_eq(strlen(t_read(t_audit_path)) > ksize, 1, "kill with pid writes its audit line");
    }
    # A pid nobody has: i32::MAX passes the guard but is above Linux's
    # PID_MAX_LIMIT (2^22), so kill fails (-ESRCH); the kill still completes
    # with its alert, as Rust's did after a failed libc::kill.
    var gone_alerts = vec_len(sec_ui_alerts(ku));
    assert_eq(sec_ui_emergency_kill_agent(ku, 42, SecPid.SEC_PID_MAX, 1760000000),
      SecErr.SEC_ERR_OK, "kill of a pid nobody has still OK");
    assert_eq(vec_len(sec_ui_alerts(ku)), gone_alerts + 1, "kill of a pid nobody has records its alert");
    return 0;
}

# ---------------------------------------------------------------------------
# Rust's four eviction tests, re-expressed (0.17.5).
# Rust only asserted len <= MAX; these pin which entry goes.
# ---------------------------------------------------------------------------
# Every field of the security records survives its constructor (Rust's struct literals in the
# test_security_alert_* / test_permission_request_* / test_permission_definition_* / test_agent_permissions_*
# tests read them back). These are the fields the dashboard and the dialogs show.
fn t_record_fields(): i64 {
    test_group("security_ui — record fields round-trip through their constructors");
    var ra = sec_alert_new(9, "Title", "Description", SecThreatLevel.SEC_TL_HIGH, "agent-runtime", 1234, 1, 0);
    assert_streq(sec_alert_description(ra), "Description", "alert description");
    assert_eq(sec_alert_timestamp(ra), 1234, "alert timestamp");
    sec_alert_set_title(ra, "Renamed");
    sec_alert_set_threat(ra, SecThreatLevel.SEC_TL_CRITICAL);
    sec_alert_set_resolved(ra, 1);
    assert_streq(sec_alert_title(ra), "Renamed", "alert title set");
    assert_eq(sec_alert_threat(ra), SecThreatLevel.SEC_TL_CRITICAL, "alert threat set");
    assert_eq(sec_alert_is_resolved(ra), 1, "alert resolved set");
    var rq = sec_permreq_new(5, 42, "agent-a", "file:read", "/home/user/doc.txt", "needs the doc", 2222, 0);
    assert_eq(sec_permreq_agent_id(rq), 42, "request agent id");
    assert_streq(sec_permreq_agent_name(rq), "agent-a", "request agent name");
    assert_streq(sec_permreq_permission(rq), "file:read", "request permission");
    assert_streq(sec_permreq_resource(rq), "/home/user/doc.txt", "request resource");
    assert_streq(sec_permreq_reason(rq), "needs the doc", "request reason");
    assert_eq(sec_permreq_timestamp(rq), 2222, "request timestamp");
    sec_permreq_set_granted(rq, 1);
    assert_eq(sec_permreq_is_granted(rq), 1, "request granted set");
    var rd = sec_permdef_new("network:connect", "Open network connections", "network", 1);
    assert_streq(sec_permdef_name(rd), "network:connect", "definition name");
    assert_streq(sec_permdef_description(rd), "Open network connections", "definition description");
    assert_streq(sec_permdef_category(rd), "network", "definition category");
    assert_eq(sec_permdef_requires_confirmation(rd), 1, "definition requires confirmation");
    var rp = sec_agentperm_new(42, "agent-a", vec_new(), 3000, 9000);
    assert_streq(sec_agentperm_agent_name(rp), "agent-a", "agent permissions name");
    assert_eq(sec_agentperm_granted_at(rp), 3000, "agent permissions granted_at");
    assert_eq(sec_agentperm_expires_at(rp), 9000, "agent permissions expires_at (Some)");
    var ro = sec_override_new(7, "agent-b", "kill", "runaway", 4000, 0, 0);
    assert_streq(sec_override_agent_name(ro), "agent-b", "override agent name");
    assert_streq(sec_override_action(ro), "kill", "override action");
    assert_streq(sec_override_reason(ro), "runaway", "override reason");
    return 0;
}

fn t_evictions(): i64 {
    test_group("security_ui — alert eviction at max capacity");
    var eu = sec_ui_new();
    var ei = 0;
    while (ei < SecCap.SEC_MAX_ALERTS) {
        sec_ui_show_security_alert(eu, sec_alert_new(ei + 1, "Alert", "", SecThreatLevel.SEC_TL_LOW, "", 1000, 0, 0));
        ei = ei + 1;
    }
    assert_eq(vec_len(sec_ui_get_active_alerts(eu)), SecCap.SEC_MAX_ALERTS, "500 active alerts");
    sec_ui_show_security_alert(eu, sec_alert_new(9001, "Overflow alert", "", SecThreatLevel.SEC_TL_HIGH, "", 1000, 0, 0));
    var ea = sec_ui_alerts(eu);
    assert_eq(vec_len(ea), SecCap.SEC_MAX_ALERTS, "overflow: still 500");
    assert_eq(sec_alert_id(vec_get(ea, 0)), 2, "overflow: oldest (1) evicted");
    assert_eq(sec_alert_id(vec_get(ea, SecCap.SEC_MAX_ALERTS - 1)), 9001, "overflow: newest last");

    test_group("security_ui — alert eviction drops resolved first");
    var ru = sec_ui_new();
    var ri = 0;
    while (ri < SecCap.SEC_MAX_ALERTS) {
        var rres = 0;
        if (ri % 2 == 0) { rres = 1; }
        sec_ui_show_security_alert(ru, sec_alert_new(ri + 1, "Alert", "", SecThreatLevel.SEC_TL_LOW, "", 1000, 0, rres));
        ri = ri + 1;
    }
    sec_ui_show_security_alert(ru, sec_alert_new(9002, "New alert", "", SecThreatLevel.SEC_TL_MEDIUM, "", 1000, 0, 0));
    var ra = sec_ui_alerts(ru);
    assert_eq(vec_len(ra), 251, "resolved-first: 250 unresolved + the new one");
    assert_eq(sec_alert_id(vec_get(ra, 0)), 2, "resolved-first: oldest unresolved kept");
    var rresolved = 0;
    var rj = 0;
    while (rj < vec_len(ra)) {
        rresolved = rresolved + sec_alert_is_resolved(vec_get(ra, rj));
        rj = rj + 1;
    }
    assert_eq(rresolved, 0, "resolved-first: every resolved alert gone");

    test_group("security_ui — permission request eviction");
    var pu = sec_ui_new();
    var pi = 0;
    while (pi < SecCap.SEC_MAX_PERMISSION_REQUESTS) {
        sec_ui_request_permission(pu, sec_permreq_new(pi + 1, pi + 1, "agent", "file:read", "/home", "test", 1000, 0));
        pi = pi + 1;
    }
    sec_ui_request_permission(pu, sec_permreq_new(9003, 9003, "overflow-agent", "file:read", "/home", "test", 1000, 0));
    var pa = sec_ui_perm_requests(pu);
    assert_eq(vec_len(pa), SecCap.SEC_MAX_PERMISSION_REQUESTS, "requests: still 200");
    assert_eq(sec_permreq_id(vec_get(pa, 0)), 2, "requests: oldest (1) evicted");
    assert_eq(sec_permreq_id(vec_get(pa, SecCap.SEC_MAX_PERMISSION_REQUESTS - 1)), 9003, "requests: newest last");

    test_group("security_ui — override request eviction");
    var ou = sec_ui_new();
    var first_oid = sec_ui_request_human_override(ou, "agent-0", "action", "reason", 1000);
    var oi = 1;
    while (oi < SecCap.SEC_MAX_OVERRIDE_REQUESTS) {
        sec_ui_request_human_override(ou, "agent", "action", "reason", 1000);
        oi = oi + 1;
    }
    var last_oid = sec_ui_request_human_override(ou, "overflow-agent", "action", "reason", 1000);
    var oa = sec_ui_overrides(ou);
    assert_eq(vec_len(oa), SecCap.SEC_MAX_OVERRIDE_REQUESTS, "overrides: still 100");
    assert_eq(sec_override_id(vec_get(oa, 0)), first_oid + 1, "overrides: oldest evicted");
    assert_eq(sec_override_id(vec_get(oa, SecCap.SEC_MAX_OVERRIDE_REQUESTS - 1)), last_oid, "overrides: newest last");
    return 0;
}

# Rust test_grant_permission_lockdown: a FRESH UI in Lockdown blocks file:write
# ("Lockdown" in the error text -> the ACTION_BLOCKED code, ADR 0003) and grants
# nothing; and test_security_ui_permission_definitions_initialized: the six names.
fn t_lockdown_and_defs(): i64 {
    test_group("security_ui — grant_permission_lockdown (fresh UI)");
    var lu = sec_ui_new();
    sec_ui_set_security_level(lu, SecLevel.SEC_LVL_LOCKDOWN);
    var lsize = strlen(t_read(t_audit_path));
    assert_eq(sec_ui_grant_permission_enforced(lu, 50, "test-agent", "file:write", 1760000000),
      SecErr.SEC_ERR_ACTION_BLOCKED, "fresh lockdown blocks file:write");
    assert_eq(sec_ui_get_agent_permission(lu, 50), 0, "blocked grant creates no agent entry");
    assert_eq(strlen(t_read(t_audit_path)), lsize, "blocked grant writes no audit line");

    test_group("security_ui — permission definitions initialized");
    var du = sec_ui_new();
    assert_eq(vec_len(sec_ui_perm_defs(du)), 6, "6 definitions");
    assert(t_ok(sec_ui_find_perm_def(du, "file:read")), "defs contain file:read");
    assert(t_ok(sec_ui_find_perm_def(du, "file:write")), "defs contain file:write");
    assert(t_ok(sec_ui_find_perm_def(du, "file:delete")), "defs contain file:delete");
    assert(t_ok(sec_ui_find_perm_def(du, "network:outbound")), "defs contain network:outbound");
    assert(t_ok(sec_ui_find_perm_def(du, "process:spawn")), "defs contain process:spawn");
    assert(t_ok(sec_ui_find_perm_def(du, "agent:delegate")), "defs contain agent:delegate");
    return 0;
}

# ⛔ The preflight (see the helpers' header): -> 1 when the pid guard refuses
# every pid that would reach beyond the suite's own children, else 0.
fn t_pid_preflight(): i64 {
    test_group("security_ui — pid guard preflight");
    var pf = 1;
    assert_eq(SecPid.SEC_PID_NONE & 0xFFFFFFFF, 0x80000000, "None truncates to INT_MIN");
    assert_eq(SecPid.SEC_PID_NONE < 0, 1, "None is negative");
    if ((SecPid.SEC_PID_NONE & 0xFFFFFFFF) != 0x80000000) { pf = 0; }
    if (SecPid.SEC_PID_NONE >= 0) { pf = 0; }
    assert_eq(sec_pid_ok(0 - 1), 0, "preflight: -1 refused");
    assert_eq(sec_pid_ok(0), 0, "preflight: 0 refused");
    assert_eq(sec_pid_ok(0 - 2), 0, "preflight: -2 refused");
    assert_eq(sec_pid_ok(SecPid.SEC_PID_NONE), 0, "preflight: None refused");
    if (sec_pid_ok(0 - 1) != 0) { pf = 0; }
    if (sec_pid_ok(0) != 0) { pf = 0; }
    if (sec_pid_ok(0 - 2) != 0) { pf = 0; }
    if (sec_pid_ok(SecPid.SEC_PID_NONE) != 0) { pf = 0; }
    return pf;
}

fn main() {
    alloc_init();

    # ⛔ Before any enforced call: a broken pid guard stops the suite here.
    if (t_pid_preflight() != 1) { return assert_summary(); }

    # ⛔ Before any enforced call: the audit log goes to a temp file of our own.
    var tp_sb = str_builder_new();
    str_builder_add_cstr(tp_sb, "/tmp/aethersafha-sec-audit-");
    str_builder_add_int(tp_sb, sys_getpid());
    str_builder_add_cstr(tp_sb, ".log");
    t_audit_path = str_data(str_builder_build(tp_sb));
    # ⚠ A run that crashed left its log; a later run with the same pid (a container's pid is often
    # the same every time) would then fail O_EXCL. unlink removes a planted symlink, not its target.
    sys_unlink(t_audit_path);
    var tfd = file_open(t_audit_path, O_WRONLY | O_CREAT | O_EXCL, 0x180);
    assert_eq(tfd >= 0, 1, "created the temp audit log");
    if (tfd < 0) { return assert_summary(); }
    file_close(tfd);
    sec_ui_set_audit_log_path(t_audit_path);

    # -----------------------------------------------------------------------
    # The emergency kill deregisters the agent with daimon (security_ui.rs:546-559): a DELETE the
    # kill starts and the frame loop's daimon_step finishes. Against a listener of our own.
    # -----------------------------------------------------------------------
    test_group("security_ui — the emergency kill DELETEs the agent from daimon, never blocking");
    var dl = t_bind_lo(1);
    assert_eq(dl >= 0, 1, "a listener of our own on 127.0.0.1");
    if (dl < 0) { return assert_summary(); }
    daimon_set_endpoint(0x0100007F, t_dport);
    var dku = sec_ui_new();
    var dai = ai_new();
    assert_eq(sec_ui_emergency_kill_agent(dku, 77, SecPid.SEC_PID_NONE, 1760000000), SecErr.SEC_ERR_OK, "kill with no pid -> OK");
    assert_eq(daimon_delete_busy(), 1, "  ...and one DELETE is under way");
    var want = "DELETE /v1/agents/77 HTTP/1.1\r\n";
    var wlen = strlen(want);
    var rbuf = alloc(1024);
    var conn = 0 - 1;
    var dgot = 0;
    var dsteps = 0;
    while ((dsteps < 3000) && (dgot < wlen)) {
        daimon_step(dai, t_now_us());
        if (conn < 0) {
            var ac = sys_accept4(dl, 0, 0, 2048);              # SOCK_NONBLOCK
            if (ac >= 0) { conn = ac; }
        }
        if (conn >= 0) {
            var rn = sys_read(conn, rbuf + dgot, 1023 - dgot);
            if (rn > 0) { dgot = dgot + rn; }
        }
        if (dgot < wlen) { t_sleep_1ms(); }
        dsteps = dsteps + 1;
    }
    store8(rbuf + dgot, 0);
    assert_eq(dgot >= wlen, 1, "the request arrived");
    assert_eq(memeq(rbuf, want, wlen), 1, "  ...as DELETE /v1/agents/77");
    if (conn >= 0) { sys_close(conn); }
    var dwait = 0;
    while ((dwait < 3000) && (daimon_delete_busy() != 0)) {
        daimon_step(dai, t_now_us());
        t_sleep_1ms();
        dwait = dwait + 1;
    }
    assert_eq(daimon_delete_busy(), 0, "a hang-up ends it: the slot is free again");
    sys_close(dl);
    # ⛔ Every later kill (and every forked child's) goes to a port of ours that refuses at once.
    var drefuse = t_bind_lo(0);
    assert_eq(drefuse >= 0, 1, "a refusing port of our own for the rest of the suite");
    daimon_set_endpoint(0x0100007F, t_dport);

    # -----------------------------------------------------------------------
    # SecurityAlert::default() — Low threat, no action required, unresolved.
    # (test_security_alert_default)
    # -----------------------------------------------------------------------
    test_group("security_ui — SecurityAlert default");
    var da = sec_alert_default(1, 1000);
    assert(t_ok(da), "sec_alert_default non-null");
    assert_eq(sec_alert_threat(da), SecThreatLevel.SEC_TL_LOW, "default threat == Low");
    assert_eq(sec_alert_requires_action(da), 0, "default !requires_action");
    assert_eq(sec_alert_is_resolved(da), 0, "default !is_resolved");

    # Custom alert (test_security_alert_custom).
    var ca = sec_alert_new(2, "Suspicious", "Unusual", SecThreatLevel.SEC_TL_HIGH,
      "agent-runtime", 1000, 1, 0);
    assert_eq(sec_alert_threat(ca), SecThreatLevel.SEC_TL_HIGH, "custom threat == High");
    assert_eq(sec_alert_requires_action(ca), 1, "custom requires_action");

    # -----------------------------------------------------------------------
    # ThreatLevel ordering (test_threat_level_ordering / _info_ordering).
    # Ordered ascending: Info < Low < Medium < High < Critical.
    # -----------------------------------------------------------------------
    test_group("security_ui — ThreatLevel ordering");
    var crit_gt_high = 0;
    if (SecThreatLevel.SEC_TL_CRITICAL > SecThreatLevel.SEC_TL_HIGH) { crit_gt_high = 1; }
    assert(crit_gt_high, "Critical > High");
    var med_gt_low = 0;
    if (SecThreatLevel.SEC_TL_MEDIUM > SecThreatLevel.SEC_TL_LOW) { med_gt_low = 1; }
    assert(med_gt_low, "Medium > Low");
    var info_lt_low = 0;
    if (SecThreatLevel.SEC_TL_INFO < SecThreatLevel.SEC_TL_LOW) { info_lt_low = 1; }
    assert(info_lt_low, "Info < Low");

    # -----------------------------------------------------------------------
    # SecurityUI::new — empty active/pending, 6 perm defs, Standard level.
    # (test_security_ui_new / _permission_definitions_initialized /
    #  test_security_ui_set_security_level default)
    # -----------------------------------------------------------------------
    test_group("security_ui — SecurityUI::new");
    var ui = sec_ui_new();
    assert(t_ok(ui), "sec_ui_new non-null");
    var act0 = sec_ui_get_active_alerts(ui);
    assert_eq(vec_len(act0), 0, "new: no active alerts");
    var pend0 = sec_ui_get_pending_permissions(ui);
    assert_eq(vec_len(pend0), 0, "new: no pending permissions");
    assert_eq(vec_len(sec_ui_perm_defs(ui)), 6, "new: 6 permission definitions");
    assert_eq(sec_ui_get_security_level(ui), SecLevel.SEC_LVL_STANDARD, "new: level Standard");
    assert_eq(sec_ui_is_emergency_mode(ui), 0, "new: not emergency");
    assert_eq(sec_ui_human_override_enabled(ui), 1, "new: human override enabled");

    # find_perm_def for a seeded name resolves; unknown -> 0.
    var def_fr = sec_ui_find_perm_def(ui, "file:read");
    assert(t_ok(def_fr), "find_perm_def file:read");
    assert_eq(sec_permdef_requires_confirmation(def_fr), 0, "file:read no confirmation");
    var def_fw = sec_ui_find_perm_def(ui, "file:write");
    assert_eq(sec_permdef_requires_confirmation(def_fw), 1, "file:write requires confirmation");
    assert_eq(sec_ui_find_perm_def(ui, "unknown:perm"), 0, "find_perm_def unknown -> 0");

    # -----------------------------------------------------------------------
    # Show + dismiss alert (test_security_ui_show_alert / _dismiss_alert /
    #  test_dismiss_nonexistent_alert_succeeds).
    # -----------------------------------------------------------------------
    test_group("security_ui — show / dismiss alert");
    var al = sec_alert_new(10, "Test Alert", "Test", SecThreatLevel.SEC_TL_MEDIUM,
      "test", 1000, 1, 0);
    sec_ui_show_security_alert(ui, al);
    var act1 = sec_ui_get_active_alerts(ui);
    assert_eq(vec_len(act1), 1, "show: 1 active alert");

    # Dismiss by id -> resolved -> drops out of active set.
    var derr = sec_ui_dismiss_alert(ui, 10);
    assert_eq(derr, SecErr.SEC_ERR_OK, "dismiss returns OK");
    var act2 = sec_ui_get_active_alerts(ui);
    assert_eq(vec_len(act2), 0, "dismiss: 0 active alerts");
    # Dismiss nonexistent id still returns OK (Rust: Ok(()) always).
    assert_eq(sec_ui_dismiss_alert(ui, 9999), SecErr.SEC_ERR_OK, "dismiss missing -> OK");

    # -----------------------------------------------------------------------
    # Request / grant / deny permission (test_security_ui_request_permission,
    #  _grant_permission, _deny_permission, grant/deny nonexistent succeed).
    # -----------------------------------------------------------------------
    test_group("security_ui — request / grant / deny permission");
    var pr = sec_permreq_new(20, 100, "test", "file:read", "/home", "Read files", 1000, 0);
    sec_ui_request_permission(ui, pr);
    var pend1 = sec_ui_get_pending_permissions(ui);
    assert_eq(vec_len(pend1), 1, "request: 1 pending");

    # Grant marks granted -> no longer pending.
    var gerr = sec_ui_grant_permission(ui, 20);
    assert_eq(gerr, SecErr.SEC_ERR_OK, "grant returns OK");
    assert_eq(sec_permreq_is_granted(pr), 1, "grant: request is_granted");
    var pend2 = sec_ui_get_pending_permissions(ui);
    assert_eq(vec_len(pend2), 0, "grant: 0 pending");
    # Grant nonexistent still OK.
    assert_eq(sec_ui_grant_permission(ui, 9999), SecErr.SEC_ERR_OK, "grant missing -> OK");

    # Deny removes the request outright.
    var pr2 = sec_permreq_new(21, 100, "test", "file:read", "/home", "Read", 1000, 0);
    sec_ui_request_permission(ui, pr2);
    var pend3 = sec_ui_get_pending_permissions(ui);
    assert_eq(vec_len(pend3), 1, "second request: 1 pending");
    var yerr = sec_ui_deny_permission(ui, 21);
    assert_eq(yerr, SecErr.SEC_ERR_OK, "deny returns OK");
    var pend4 = sec_ui_get_pending_permissions(ui);
    assert_eq(vec_len(pend4), 0, "deny: 0 pending");
    assert_eq(sec_ui_deny_permission(ui, 9999), SecErr.SEC_ERR_OK, "deny missing -> OK");

    # -----------------------------------------------------------------------
    # Agent permissions map (test_security_ui_set_agent_permissions,
    #  _revoke_agent_permissions, _revoke_nonexistent, set overwrite).
    # -----------------------------------------------------------------------
    test_group("security_ui — agent permissions map");
    var perms = vec_new();
    vec_push(perms, "read");
    sec_ui_set_agent_permissions(ui, 500, "test-agent", perms, 1000);
    var apget = sec_ui_get_agent_permission(ui, 500);
    assert(t_ok(apget), "set_agent_permissions stored");
    assert_eq(sec_agentperm_agent_id(apget), 500, "agent id stored");
    var has_read = sec_agentperm_has(apget, "read");
    assert_eq(has_read, 1, "agent perm has read");

    # Overwrite: second set replaces the whole entry (test_set..overwrite).
    var perms2 = vec_new();
    vec_push(perms2, "write");
    sec_ui_set_agent_permissions(ui, 500, "test-agent", perms2, 1001);
    var apget2 = sec_ui_get_agent_permission(ui, 500);
    var has_write = sec_agentperm_has(apget2, "write");
    assert_eq(has_write, 1, "overwrite: has write");
    var has_read2 = sec_agentperm_has(apget2, "read");
    assert_eq(has_read2, 0, "overwrite: no longer has read");

    # Revoke present -> OK; revoke absent -> PERMISSION_NOT_FOUND.
    var rerr = sec_ui_revoke_agent_permissions(ui, 500);
    assert_eq(rerr, SecErr.SEC_ERR_OK, "revoke present -> OK");
    assert_eq(sec_ui_get_agent_permission(ui, 500), 0, "revoke: entry gone");
    var rerr2 = sec_ui_revoke_agent_permissions(ui, 4242);
    assert_eq(rerr2, SecErr.SEC_ERR_PERMISSION_NOT_FOUND, "revoke absent -> NOT_FOUND");

    # -----------------------------------------------------------------------
    # AgentPermission add/remove/has dedup + expiry (test_grant_duplicate,
    #  _agent_permission, expires_at). Uses the entry accessors directly.
    # -----------------------------------------------------------------------
    test_group("security_ui — AgentPermission add/remove/expire");
    var ap = sec_agentperm_new(600, "a", 0, 1000, 0);
    assert(t_ok(ap), "agentperm_new non-null");
    var added1 = sec_agentperm_add(ap, "read");
    assert_eq(added1, 1, "add read -> 1 (added)");
    var added_dup = sec_agentperm_add(ap, "read");
    assert_eq(added_dup, 0, "add dup read -> 0 (already present)");
    var added2 = sec_agentperm_add(ap, "write");
    assert_eq(added2, 1, "add write -> 1 (added)");
    assert_eq(vec_len(sec_agentperm_permissions(ap)), 2, "dedup: 2 permissions");
    var removed = sec_agentperm_remove(ap, "read");
    assert_eq(removed, 1, "remove read -> count 1");
    assert_eq(sec_agentperm_has(ap, "read"), 0, "removed: no read");
    assert_eq(sec_agentperm_has(ap, "write"), 1, "removed: still write");
    # Expiry: 0 == None -> never expires; set future/past.
    assert_eq(sec_agentperm_is_expired(ap, 5000), 0, "expires_at None -> not expired");
    sec_agentperm_set_expires_at(ap, 2000);
    assert_eq(sec_agentperm_is_expired(ap, 1500), 0, "now < exp -> not expired");
    assert_eq(sec_agentperm_is_expired(ap, 2500), 1, "now >= exp -> expired");

    # -----------------------------------------------------------------------
    # Human override request / approve (test_..request_human_override,
    #  _approve_override, _approve_nonexistent, multiple_overrides_then_approve).
    # -----------------------------------------------------------------------
    test_group("security_ui — human override");
    var oid1 = sec_ui_request_human_override(ui, "agent", "delete", "test", 1000);
    var ovreq1 = sec_ui_get_override_requests(ui);
    assert_eq(vec_len(ovreq1), 1, "override: 1 pending");
    var oid2 = sec_ui_request_human_override(ui, "b", "y", "r", 1000);
    var ovreq2 = sec_ui_get_override_requests(ui);
    assert_eq(vec_len(ovreq2), 2, "override: 2 pending");
    # Approve id1 -> only id2 remains pending.
    var aerr = sec_ui_approve_override(ui, oid1, "admin");
    assert_eq(aerr, SecErr.SEC_ERR_OK, "approve returns OK");
    var ovreq3 = sec_ui_get_override_requests(ui);
    assert_eq(vec_len(ovreq3), 1, "approve: 1 pending remains");
    var remaining = vec_get(ovreq3, 0);
    assert_eq(sec_override_id(remaining), oid2, "remaining override is id2");
    # Approve nonexistent -> ALERT_NOT_FOUND (Rust reuses AlertNotFound).
    var aerr2 = sec_ui_approve_override(ui, 999999, "admin");
    assert_eq(aerr2, SecErr.SEC_ERR_ALERT_NOT_FOUND, "approve missing -> NOT_FOUND");

    # -----------------------------------------------------------------------
    # Emergency kill switch (test_..emergency_kill_switch, _deactivate,
    #  _revokes_overrides, _keeps_human_override_enabled).
    # -----------------------------------------------------------------------
    test_group("security_ui — emergency kill switch");
    # Approve id2 so it is approved before the kill switch un-approves it.
    sec_ui_approve_override(ui, oid2, "admin");
    var before_kill = sec_ui_get_override_requests(ui);
    assert_eq(vec_len(before_kill), 0, "both overrides approved before kill");
    sec_ui_emergency_kill_switch(ui);
    assert_eq(sec_ui_is_emergency_mode(ui), 1, "kill switch: emergency on");
    assert_eq(sec_ui_human_override_enabled(ui), 1, "kill switch: human override kept");
    # All overrides un-approved -> both pending again.
    var after_kill = sec_ui_get_override_requests(ui);
    assert_eq(vec_len(after_kill), 2, "kill switch: overrides un-approved");
    # Deactivate clears emergency but keeps human override.
    sec_ui_deactivate_emergency(ui);
    assert_eq(sec_ui_is_emergency_mode(ui), 0, "deactivate: emergency off");
    assert_eq(sec_ui_human_override_enabled(ui), 1, "deactivate: human override kept");

    # -----------------------------------------------------------------------
    # Security level transitions (test_..set_security_level, _transitions).
    # -----------------------------------------------------------------------
    test_group("security_ui — security level transitions");
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_ELEVATED);
    assert_eq(sec_ui_get_security_level(ui), SecLevel.SEC_LVL_ELEVATED, "level Elevated");
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_LOCKDOWN);
    assert_eq(sec_ui_get_security_level(ui), SecLevel.SEC_LVL_LOCKDOWN, "level Lockdown");
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_STANDARD);
    assert_eq(sec_ui_get_security_level(ui), SecLevel.SEC_LVL_STANDARD, "level back to Standard");

    # -----------------------------------------------------------------------
    # Enforcement paths (test_grant_permission_enforced, _lockdown,
    #  _no_confirmation_in_lockdown, _revoke_enforced, _not_found, dedup,
    #  multiple, elevated, network_outbound_lockdown_ok).
    # -----------------------------------------------------------------------
    test_group("security_ui — enforced grant / revoke");
    # Known permission grants OK; creates the agent entry with the permission.
    var e1 = sec_ui_grant_permission_enforced(ui, 700, "test-agent", "file:read", 1000);
    assert_eq(e1, SecErr.SEC_ERR_OK, "enforced grant file:read OK");
    var ent700 = sec_ui_get_agent_permission(ui, 700);
    assert(t_ok(ent700), "enforced grant created agent entry");
    assert_eq(sec_agentperm_has(ent700, "file:read"), 1, "entry has file:read");
    # Unknown permission -> PERMISSION_NOT_FOUND.
    var e2 = sec_ui_grant_permission_enforced(ui, 700, "test-agent", "unknown:perm", 1000);
    assert_eq(e2, SecErr.SEC_ERR_PERMISSION_NOT_FOUND, "enforced grant unknown -> NOT_FOUND");
    # Duplicate grant is deduped -> still one entry for file:read.
    sec_ui_grant_permission_enforced(ui, 700, "test-agent", "file:read", 1000);
    assert_eq(vec_len(sec_agentperm_permissions(ent700)), 1, "enforced dedup: 1 perm");
    # Add a second permission -> 2.
    sec_ui_grant_permission_enforced(ui, 700, "test-agent", "network:outbound", 1000);
    assert_eq(vec_len(sec_agentperm_permissions(ent700)), 2, "enforced grant 2nd -> 2 perms");

    # Lockdown blocks confirmation-required perms; allows no-confirm perms.
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_LOCKDOWN);
    var e3 = sec_ui_grant_permission_enforced(ui, 701, "agent", "file:write", 1000);
    assert_eq(e3, SecErr.SEC_ERR_ACTION_BLOCKED, "lockdown blocks file:write");
    var e4 = sec_ui_grant_permission_enforced(ui, 701, "agent", "file:delete", 1000);
    assert_eq(e4, SecErr.SEC_ERR_ACTION_BLOCKED, "lockdown blocks file:delete");
    var e5 = sec_ui_grant_permission_enforced(ui, 701, "agent", "process:spawn", 1000);
    assert_eq(e5, SecErr.SEC_ERR_ACTION_BLOCKED, "lockdown blocks process:spawn");
    var e6 = sec_ui_grant_permission_enforced(ui, 701, "agent", "file:read", 1000);
    assert_eq(e6, SecErr.SEC_ERR_OK, "lockdown allows file:read (no confirm)");
    var e7 = sec_ui_grant_permission_enforced(ui, 701, "agent", "network:outbound", 1000);
    assert_eq(e7, SecErr.SEC_ERR_OK, "lockdown allows network:outbound (no confirm)");

    # Elevated (not Lockdown) allows confirmation-required perms.
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_ELEVATED);
    var e8 = sec_ui_grant_permission_enforced(ui, 702, "test-agent", "file:write", 1000);
    assert_eq(e8, SecErr.SEC_ERR_OK, "elevated allows file:write");
    sec_ui_set_security_level(ui, SecLevel.SEC_LVL_STANDARD);

    # Revoke enforced removes only the named perm; missing agent -> NOT_FOUND.
    var rv1 = sec_ui_revoke_permission_enforced(ui, 700, "file:read", SecPid.SEC_PID_NONE, 1000);
    assert_eq(rv1, SecErr.SEC_ERR_OK, "revoke enforced OK");
    assert_eq(sec_agentperm_has(ent700, "file:read"), 0, "revoke removed file:read");
    assert_eq(sec_agentperm_has(ent700, "network:outbound"), 1, "revoke kept network:outbound");
    var rv2 = sec_ui_revoke_permission_enforced(ui, 9999, "file:read", SecPid.SEC_PID_NONE, 1000);
    assert_eq(rv2, SecErr.SEC_ERR_PERMISSION_NOT_FOUND, "revoke missing agent -> NOT_FOUND");

    # -----------------------------------------------------------------------
    # Dashboard aggregation (test_..get_dashboard, _with_alerts_and_perms,
    #  _no_active_alerts_returns_low). Critical / Info / escalation follow in
    #  their own groups below. Use a fresh UI to control counts precisely.
    # -----------------------------------------------------------------------
    test_group("security_ui — dashboard aggregation");
    var ui2 = sec_ui_new();
    var d0 = sec_ui_get_security_dashboard(ui2, 2000);
    assert_eq(sec_dash_active_alerts(d0), 0, "empty dash: 0 active alerts");
    assert_eq(sec_dash_pending_permissions(d0), 0, "empty dash: 0 pending");
    assert_eq(sec_dash_threat_level(d0), SecThreatLevel.SEC_TL_LOW, "empty dash: Low threat");
    assert_eq(sec_dash_last_scan(d0), 2000, "empty dash: last_scan == now");

    # 2 alerts (1 High unresolved, 1 Medium resolved), 1 pending req, 1 agent.
    var h = sec_alert_new(30, "Alert 1", "", SecThreatLevel.SEC_TL_HIGH, "s", 2000, 0, 0);
    sec_ui_show_security_alert(ui2, h);
    var mrez = sec_alert_new(31, "Alert 2", "", SecThreatLevel.SEC_TL_MEDIUM, "s", 2000, 0, 1);
    sec_ui_show_security_alert(ui2, mrez);
    var req = sec_permreq_new(40, 100, "test", "file:read", "/home", "test", 2000, 0);
    sec_ui_request_permission(ui2, req);
    var emptyv = vec_new();
    sec_ui_set_agent_permissions(ui2, 900, "a", emptyv, 2000);
    var d1 = sec_ui_get_security_dashboard(ui2, 2100);
    assert_eq(sec_dash_active_alerts(d1), 1, "dash: 1 active alert (unresolved only)");
    assert_eq(sec_dash_pending_permissions(d1), 1, "dash: 1 pending permission");
    assert_eq(sec_dash_running_agents(d1), 1, "dash: 1 running agent");
    assert_eq(sec_dash_threat_level(d1), SecThreatLevel.SEC_TL_HIGH, "dash: max threat High");

    # test_security_ui_critical_alert_shows — a lone Critical alert.
    var uic = sec_ui_new();
    var crit = sec_alert_new(1, "CRITICAL", "", SecThreatLevel.SEC_TL_CRITICAL, "", 2000, 0, 0);
    sec_ui_show_security_alert(uic, crit);
    var dc = sec_ui_get_security_dashboard(uic, 2000);
    assert_eq(sec_dash_threat_level(dc), SecThreatLevel.SEC_TL_CRITICAL, "dash: lone Critical -> Critical");

    # test_get_dashboard_with_info_level_alert — Low is the no-alert fallback,
    # not a floor: an Info-only dashboard reports Info.
    var uii = sec_ui_new();
    var info = sec_alert_new(1, "Info", "", SecThreatLevel.SEC_TL_INFO, "", 2000, 0, 0);
    sec_ui_show_security_alert(uii, info);
    var di = sec_ui_get_security_dashboard(uii, 2000);
    assert_eq(sec_dash_threat_level(di), SecThreatLevel.SEC_TL_INFO, "dash: Info-only -> Info");
    # Resolving the only alert drops back to the Low fallback.
    sec_ui_dismiss_alert(uii, 1);
    var di2 = sec_ui_get_security_dashboard(uii, 2000);
    assert_eq(sec_dash_threat_level(di2), SecThreatLevel.SEC_TL_LOW, "dash: Info resolved -> Low");
    # Resolved alerts are outside the max: Info + resolved Critical -> Info.
    var uir = sec_ui_new();
    sec_ui_show_security_alert(uir, sec_alert_new(1, "Info", "", SecThreatLevel.SEC_TL_INFO, "", 2000, 0, 0));
    sec_ui_show_security_alert(uir, sec_alert_new(2, "Old", "", SecThreatLevel.SEC_TL_CRITICAL, "", 2000, 0, 1));
    var dir = sec_ui_get_security_dashboard(uir, 2000);
    assert_eq(sec_dash_active_alerts(dir), 1, "dash: Info + resolved Critical -> 1 active");
    assert_eq(sec_dash_threat_level(dir), SecThreatLevel.SEC_TL_INFO, "dash: Info + resolved Critical -> Info");

    # -----------------------------------------------------------------------
    # system_tests.rs test_e2e_security_alert_escalation_flow:
    # none -> Low, + Info -> Info, + Medium -> Medium, + Critical -> Critical.
    # -----------------------------------------------------------------------
    test_group("security_ui — alert escalation flow");
    var ues = sec_ui_new();
    var de0 = sec_ui_get_security_dashboard(ues, 4000);
    assert_eq(sec_dash_active_alerts(de0), 0, "escalation: start 0 active");
    assert_eq(sec_dash_threat_level(de0), SecThreatLevel.SEC_TL_LOW, "escalation: start Low");
    sec_ui_show_security_alert(ues, sec_alert_new(1, "Info event", "Informational",
        SecThreatLevel.SEC_TL_INFO, "system", 4000, 0, 0));
    var de1 = sec_ui_get_security_dashboard(ues, 4000);
    assert_eq(sec_dash_active_alerts(de1), 1, "escalation: Info -> 1 active");
    assert_eq(sec_dash_threat_level(de1), SecThreatLevel.SEC_TL_INFO, "escalation: Info -> Info");
    sec_ui_show_security_alert(ues, sec_alert_new(2, "Suspicious activity",
        "Unusual network traffic", SecThreatLevel.SEC_TL_MEDIUM, "network", 4000, 0, 0));
    var de2 = sec_ui_get_security_dashboard(ues, 4000);
    assert_eq(sec_dash_active_alerts(de2), 2, "escalation: Medium -> 2 active");
    assert_eq(sec_dash_threat_level(de2), SecThreatLevel.SEC_TL_MEDIUM, "escalation: Medium -> Medium");
    sec_ui_show_security_alert(ues, sec_alert_new(3, "Breach detected", "Unauthorized access",
        SecThreatLevel.SEC_TL_CRITICAL, "ids", 4000, 1, 0));
    var de3 = sec_ui_get_security_dashboard(ues, 4000);
    assert_eq(sec_dash_active_alerts(de3), 3, "escalation: Critical -> 3 active");
    assert_eq(sec_dash_threat_level(de3), SecThreatLevel.SEC_TL_CRITICAL, "escalation: Critical -> Critical");

    # -----------------------------------------------------------------------
    # emergency_kill_agent — records a RESOLVED critical alert (test_..no_pid).
    # Resolved -> does NOT count as active, but is recorded in the alert vec.
    # -----------------------------------------------------------------------
    test_group("security_ui — emergency kill agent");
    var ui3 = sec_ui_new();
    var kerr = sec_ui_emergency_kill_agent(ui3, 123, SecPid.SEC_PID_NONE, 3000);
    assert_eq(kerr, SecErr.SEC_ERR_OK, "kill agent -> OK");
    # The alert was recorded (raw alerts vec has 1) but resolved (0 active).
    assert_eq(vec_len(sec_ui_alerts(ui3)), 1, "kill agent: 1 alert recorded");
    var act_after_kill = sec_ui_get_active_alerts(ui3);
    assert_eq(vec_len(act_after_kill), 0, "kill agent: alert is resolved (0 active)");
    var killed_alert = vec_get(sec_ui_alerts(ui3), 0);
    assert_eq(sec_alert_threat(killed_alert), SecThreatLevel.SEC_TL_CRITICAL, "kill alert Critical");
    assert_eq(sec_alert_is_resolved(killed_alert), 1, "kill alert resolved");

    # -----------------------------------------------------------------------
    # Minted vs caller-supplied alert ids. The kill path mints its alert id; a
    # caller counting its own ids from 1 must not land on it, or dismiss_alert's
    # first match resolves the (already resolved) kill alert instead. The
    # contract is "every minted id > SEC_ID_MINTED_BASE"; the sweep then shows
    # no caller id 1..16 is shadowed by a minted one.
    # -----------------------------------------------------------------------
    test_group("security_ui — minted ids never meet caller ids");
    var uid = sec_ui_new();
    sec_ui_emergency_kill_agent(uid, 7, SecPid.SEC_PID_NONE, 5000);
    var oid_m = sec_ui_request_human_override(uid, "agent", "rm", "why", 5000);
    sec_ui_emergency_kill_agent(uid, 8, SecPid.SEC_PID_NONE, 5000);
    sec_ui_emergency_kill_agent(uid, 9, SecPid.SEC_PID_NONE, 5000);
    var minted = sec_alert_id(vec_get(sec_ui_alerts(uid), 0));
    var minted3 = sec_alert_id(vec_get(sec_ui_alerts(uid), 2));
    assert_eq(minted > SecIdSpace.SEC_ID_MINTED_BASE, 1, "kill alert id > SEC_ID_MINTED_BASE");
    assert_eq(oid_m > SecIdSpace.SEC_ID_MINTED_BASE, 1, "override id > SEC_ID_MINTED_BASE");
    assert_eq(minted3 > SecIdSpace.SEC_ID_MINTED_BASE, 1, "third kill alert id > SEC_ID_MINTED_BASE");
    var mine_v = vec_new();
    var ci = 1;
    while (ci <= 16) {
        var mine = sec_alert_new(ci, "caller", "", SecThreatLevel.SEC_TL_HIGH, "agent", 5000, 1, 0);
        sec_ui_show_security_alert(uid, mine);
        vec_push(mine_v, mine);
        ci = ci + 1;
    }
    var own_hits = 0;
    ci = 1;
    while (ci <= 16) {
        sec_ui_dismiss_alert(uid, ci);
        own_hits = own_hits + sec_alert_is_resolved(vec_get(mine_v, ci - 1));
        ci = ci + 1;
    }
    assert_eq(own_hits, 16, "dismiss(1..16) each resolves the caller's own alert");
    assert_eq(vec_len(sec_ui_get_active_alerts(uid)), 0, "after dismiss(1..16): 0 active");

    # -----------------------------------------------------------------------
    # WindowBadgeManager (badge_tests: new_empty, assign_and_get, get_missing,
    #  remove, remove_missing, badges_by_trust, color_for_trust, overwrite).
    # -----------------------------------------------------------------------
    test_group("security_ui — WindowBadgeManager");
    var mgr = sec_badge_mgr_new();
    assert(t_ok(mgr), "badge_mgr_new non-null");
    assert_eq(sec_badge_mgr_is_empty(mgr), 1, "new mgr is empty");
    assert_eq(sec_badge_mgr_len(mgr), 0, "new mgr len 0");

    var col_ver = sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_VERIFIED);
    var b1 = sec_badge_new("agent-001", "test-agent", SecTrustLevel.SEC_TRUST_VERIFIED,
      SecSandboxStatus.SEC_SB_FULL, col_ver, SecBadgeIcon.SEC_ICON_AGENT);
    sec_badge_mgr_assign(mgr, 1, b1);
    var got = sec_badge_mgr_get(mgr, 1);
    assert(t_ok(got), "assign then get badge");
    assert_eq(sec_badge_trust_level(got), SecTrustLevel.SEC_TRUST_VERIFIED, "badge trust Verified");
    assert_eq(sec_badge_mgr_len(mgr), 1, "mgr len 1 after assign");
    assert_eq(sec_badge_mgr_is_empty(mgr), 0, "mgr not empty after assign");
    assert_eq(sec_badge_mgr_get(mgr, 999), 0, "get missing surface -> 0");

    # Overwrite same surface -> len stays 1, new badge wins.
    var b1b = sec_badge_new("agent-002", "new-agent", SecTrustLevel.SEC_TRUST_UNVERIFIED,
      SecSandboxStatus.SEC_SB_FULL, 0, SecBadgeIcon.SEC_ICON_AGENT);
    sec_badge_mgr_assign(mgr, 1, b1b);
    assert_eq(sec_badge_mgr_len(mgr), 1, "overwrite: len stays 1");
    var got2 = sec_badge_mgr_get(mgr, 1);
    assert_eq(sec_badge_trust_level(got2), SecTrustLevel.SEC_TRUST_UNVERIFIED, "overwrite: new trust");

    # badges_by_trust — 2 Verified + 1 Untrusted across fresh surfaces.
    var mgr2 = sec_badge_mgr_new();
    var v_a = sec_badge_new(0, "a", SecTrustLevel.SEC_TRUST_VERIFIED,
      SecSandboxStatus.SEC_SB_FULL, 0, SecBadgeIcon.SEC_ICON_AGENT);
    var v_b = sec_badge_new(0, "b", SecTrustLevel.SEC_TRUST_UNTRUSTED,
      SecSandboxStatus.SEC_SB_FULL, 0, SecBadgeIcon.SEC_ICON_AGENT);
    var v_c = sec_badge_new(0, "c", SecTrustLevel.SEC_TRUST_VERIFIED,
      SecSandboxStatus.SEC_SB_FULL, 0, SecBadgeIcon.SEC_ICON_AGENT);
    sec_badge_mgr_assign(mgr2, 10, v_a);
    sec_badge_mgr_assign(mgr2, 11, v_b);
    sec_badge_mgr_assign(mgr2, 12, v_c);
    var verified = sec_badge_mgr_badges_by_trust(mgr2, SecTrustLevel.SEC_TRUST_VERIFIED);
    assert_eq(vec_len(verified), 2, "badges_by_trust Verified -> 2");
    var untrusted = sec_badge_mgr_badges_by_trust(mgr2, SecTrustLevel.SEC_TRUST_UNTRUSTED);
    assert_eq(vec_len(untrusted), 1, "badges_by_trust Untrusted -> 1");
    var system = sec_badge_mgr_badges_by_trust(mgr2, SecTrustLevel.SEC_TRUST_SYSTEM);
    assert_eq(vec_len(system), 0, "badges_by_trust System -> 0");

    # remove returns the badge and empties; remove missing -> 0.
    var rmv = sec_badge_mgr_remove(mgr2, 10);
    assert(t_ok(rmv), "remove returns the badge");
    assert_eq(sec_badge_mgr_len(mgr2), 2, "remove: len 2");
    assert_eq(sec_badge_mgr_remove(mgr2, 9999), 0, "remove missing -> 0");

    # color_for_trust constants (test_badge_color_for_trust).
    assert_eq(sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_SYSTEM), 0xFF4488FF, "color System");
    assert_eq(sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_VERIFIED), 0xFF44CC44, "color Verified");
    assert_eq(sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_UNVERIFIED), 0xFFCCCC44, "color Unverified");
    assert_eq(sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_UNTRUSTED), 0xFFCC4444, "color Untrusted");
    assert_eq(sec_badge_color_for_trust(SecTrustLevel.SEC_TRUST_SANDBOXED), 0xFFCC8844, "color Sandboxed");

    t_audit_format();
    t_audit_file();
    t_signals();
    t_evictions();
    t_record_fields();
    t_lockdown_and_defs();

    xunlink(t_audit_path);
    return assert_summary();
}

var ec = main();
syscall(60, ec);
